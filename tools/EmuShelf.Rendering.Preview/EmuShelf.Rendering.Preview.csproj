<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EmuShelf.Rendering.Preview</AssemblyName>
    <RootNamespace>EmuShelf.Rendering.Preview</RootNamespace>
    <!-- Linux-only developer tool, deliberately outside the shipped app. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmuShelf.Rendering\EmuShelf.Rendering.csproj" />
    <!-- For KnownSystems.CoverAspectRatio, so the stand-in cover art is the shape the scraper
         really returns rather than a fourth copy of those ratios. Integrations is Core-only with
         no UI or GL dependency, unlike EmuShelf.App, which this tool still cannot reference. -->
    <ProjectReference Include="..\..\src\EmuShelf.Integrations\EmuShelf.Integrations.csproj" />
  </ItemGroup>
</Project>
