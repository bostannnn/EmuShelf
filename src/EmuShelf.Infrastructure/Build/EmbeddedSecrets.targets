<!--
  Generates obj/EmbeddedSecrets.Generated.cs from build-time environment variables, so
  application-identity credentials ship inside the binary without ever being committed to the repo.

  Provide these when producing a release build (locally or in CI):
    SCREENSCRAPER_DEV_ID, SCREENSCRAPER_DEV_PASSWORD, SCREENSCRAPER_SOFTNAME   (ScreenScraper devid)
    EMUSHELF_GOOGLE_OAUTH_CLIENT_ID, EMUSHELF_GOOGLE_OAUTH_CLIENT_SECRET       (Google Drive client)

  The task reads these environment variables directly (rather than receiving them as MSBuild task
  parameters) so the secret values never appear in MSBuild's task-parameter logging or a binary log.
  Any that are absent produce an empty constant, and the app falls back to its prior behaviour
  (developer env vars for ScreenScraper, rclone's shared client for Google Drive).
-->
<Project>

  <UsingTask
    TaskName="GenerateEmbeddedSecrets"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using System.IO;
        using System.Text;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public class GenerateEmbeddedSecrets : Task
        {
            // Must match EmbeddedSecrets.Key in the hand-written partial class.
            private static readonly byte[] Key = Encoding.UTF8.GetBytes("EmuShelf.embedded.v1");

            public string OutputPath { get; set; }

            public override bool Execute()
            {
                var builder = new StringBuilder();
                builder.Append("// <auto-generated />\n");
                builder.Append("namespace EmuShelf.Infrastructure.Build;\n\n");
                builder.Append("internal static partial class EmbeddedSecrets\n{\n");
                Append(builder, "ScreenScraperDevIdEncoded", Environment.GetEnvironmentVariable("SCREENSCRAPER_DEV_ID"));
                Append(builder, "ScreenScraperDevPasswordEncoded", Environment.GetEnvironmentVariable("SCREENSCRAPER_DEV_PASSWORD"));
                Append(builder, "ScreenScraperSoftNameEncoded", Environment.GetEnvironmentVariable("SCREENSCRAPER_SOFTNAME"));
                Append(builder, "GoogleOAuthClientIdEncoded", Environment.GetEnvironmentVariable("EMUSHELF_GOOGLE_OAUTH_CLIENT_ID"));
                Append(builder, "GoogleOAuthClientSecretEncoded", Environment.GetEnvironmentVariable("EMUSHELF_GOOGLE_OAUTH_CLIENT_SECRET"));
                builder.Append("}\n");

                var content = builder.ToString();
                // Rewrite only on change so an unchanged build does not force a recompile.
                if (!File.Exists(OutputPath) || File.ReadAllText(OutputPath) != content)
                {
                    Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
                    File.WriteAllText(OutputPath, content);
                }

                return true;
            }

            private static void Append(StringBuilder builder, string name, string value)
            {
                builder.Append("    private const string ");
                builder.Append(name);
                builder.Append(" = \"");
                builder.Append(Encode(value));
                builder.Append("\";\n");
            }

            private static string Encode(string value)
            {
                if (string.IsNullOrEmpty(value))
                    return string.Empty;

                var bytes = Encoding.UTF8.GetBytes(value);
                for (var i = 0; i < bytes.Length; i++)
                    bytes[i] = (byte)(bytes[i] ^ Key[i % Key.Length]);
                return Convert.ToBase64String(bytes);
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateEmbeddedSecrets" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <EmbeddedSecretsGeneratedFile>$(IntermediateOutputPath)EmbeddedSecrets.Generated.cs</EmbeddedSecretsGeneratedFile>
    </PropertyGroup>

    <GenerateEmbeddedSecrets OutputPath="$(EmbeddedSecretsGeneratedFile)" />

    <ItemGroup>
      <Compile Include="$(EmbeddedSecretsGeneratedFile)" />
    </ItemGroup>
  </Target>

</Project>
