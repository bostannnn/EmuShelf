<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bakes application-identity credentials into the build from environment variables. -->
  <Import Project="Build\EmbeddedSecrets.targets" />

  <ItemGroup>
    <ProjectReference Include="..\EmuShelf.Core\EmuShelf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Native SDL2 binaries only (win/linux/osx incl. arm64). EmuShelf uses its own minimal
         P/Invoke in SdlGamepadReader, so the managed SDL2-CS binding assembly is excluded. -->
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" ExcludeAssets="compile;runtime" />
    <!-- .7z (RPCS3, PCSX2) and .tar.xz (PCSX2 macOS) extraction for the emulator install manager. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmuShelf.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
