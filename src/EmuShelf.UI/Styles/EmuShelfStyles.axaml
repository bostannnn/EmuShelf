<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared EmuShelf control/class styles for both the Desktop and Android heads, and for
         the headless render tests (TestApp includes this too). Moved out of MainWindow.axaml's
         Window.Styles during the A1 gamepad-shell extraction; no selector targets the Window
         type, so application scope is behaviour-identical. Two overlay styles that bind to
         #GamepadOverlayHost by name stay in the gamepad view's namescope, not here. -->
        <!-- ============================ Motion ============================
             Durations are deliberately short. These transitions exist to keep state changes from
             snapping, not to be noticed: a cover appearing, a toast arriving, a hover landing.
             Every one is on Opacity or RenderTransform, which are composited and do not trigger
             layout, so they stay cheap across a fully realized grid.

             IsVisible cannot be animated — a collapsed element is not rendered at all — so the
             things that fade (covers, toasts) are always visible and driven by Opacity classes
             instead, with hit testing switched off separately where it matters. -->

        <!-- Covers crossfade over their placeholder. Both layers stay rendered so there is no
             frame in between showing an empty well, and virtualization recycling a tile onto a
             new game replays the fade rather than swapping artwork instantly. -->
        <!-- Grid in the cover views, Image in the list's small thumbnail well. -->
        <Style Selector="Grid.cover-placeholder, Image.cover-placeholder">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.cover-placeholder.covered, Image.cover-placeholder.covered">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Image.cover-image">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.cover-image.loaded">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The toast rises a few pixels as it fades in, so a message replacing another one reads
             as new rather than as text quietly changing in place. -->
        <Style Selector="Border.status-toast">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(8px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.status-toast.showing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Border.status-toast.progress">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuProgressBrush}" />
        </Style>
        <Style Selector="Border.status-toast.error">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
        </Style>

        <!-- Desktop cards reserve four pixels of row headroom and lift into it on hover. This
             keeps motion inside the virtualized cell instead of scaling beyond its clip bounds. -->
        <Style Selector="StackPanel.game-tile">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.game-tile:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>

        <!-- Deliberately NOT animated: the gamepad hover and focus rings. They are the only
             indication of where you are when navigating with a controller, and fading them in
             costs the input a frame of feedback for no visual gain. -->

        <Style Selector="Button.toolbar-button, Button.add-library, Button.collection-item">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Library surface: dips out and eases back as a new scope loads, so switching platform or
             collection dissolves instead of blanking and popping the incoming grid in. A cached scope
             swaps synchronously (the flag never renders as true), so it stays instant with no fade. -->
        <Style Selector="ScrollViewer.library-surface, Grid.library-surface, ListBox.library-surface">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <!-- 0.10s, not the 0.18s the couch shipped with: on an LB/RB platform switch the
                         fade runs TWICE (out around the empty grid, in over the ready one), so its
                         duration is paid double on top of the build itself — 0.18s each way read as
                         "platform switching is slow" on the Thor. 0.10s still softens the swap. -->
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer.library-surface.loading, Grid.library-surface.loading, ListBox.library-surface.loading">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- The gamepad overlay (menus, achievements, settings, scraper) fades its scrim in and lifts
             the sheet from a slight scale-down, mirroring the status toast. Both layers stay rendered and
             driven by Opacity so the sheet can animate — IsVisible would snap. Pointer hit testing is
             gated separately on the scrim so a closed overlay never swallows input behind it. -->
        <Style Selector="Grid.gamepad-scrim">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.gamepad-root.overlay-open Grid.gamepad-scrim">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-overlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <!-- Transitions live in the open state, so the sheet animates IN but snaps OUT. On close the
             sheet's size/alignment class drops and it would otherwise revert to the default centred
             620px card, flashing for a frame while it faded; snapping opacity to 0 hides that. The scrim
             above still fades out, so the close still reads as a soft dissolve rather than a hard cut. -->
        <Style Selector="Grid.gamepad-root.overlay-open Border.gamepad-overlay">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <!-- The toolbar search grows from the trigger rather than snapping open: the box eases its width
             and opacity while the * title column absorbs the change. Width animates layout, but this is a
             one-off deliberate action, and the box clips its contents as it expands. -->
        <Style Selector="Border.search-box">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.search-box.open">
            <Setter Property="Width" Value="218" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- ========================== End motion ========================== -->

        <Style Selector="Button.toolbar-button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.toolbar-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
        </Style>
        <Style Selector="Button.caption-button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.caption-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption-button.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.add-library">
            <Setter Property="Background" Value="{DynamicResource EmuAddButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.add-library:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.add-library /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.collection-item">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.collection-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.collection-item.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-game">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Gamepad controls draw one explicit logical-focus treatment. Keep native Avalonia
             focus for routing/accessibility, but suppress Fluent's second focus-adorners: on
             Linux/SteamOS that extra compositor layer can render as black corner rectangles. -->
        <Style Selector="Button.gamepad-game, Button.gamepad-platform, Button.gamepad-modal-option, Button.gamepad-play-action, Button.gamepad-empty-action, Button.gamepad-achievement-tab, Button.gamepad-achievement-command, Button.gamepad-settings-nav, Button.gamepad-settings-save, Button.gamepad-settings-row, Button.gamepad-settings-confirm, Panel.gamepad-achievement-tile">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gamepad-game.focused">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The button spans the shared mixed-platform shelf height, which can be much taller
             than a DS/GBA-style cover. Never paint that outer hit target; hover is rendered by
             the cover-sized overlay below so no grey cell appears around short artwork. -->
        <Style Selector="Button.gamepad-game:pointerover, Button.gamepad-game:focus, Button.gamepad-game:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-game:pointerover Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- While a controller drives the couch the mouse hover ring stays hidden. The class lives on
             the grid's ScrollViewer (GamepadRowList) and reaches the pooled tiles through this
             descendant selector — one class binding on the surface, instead of one per pooled tile. -->
        <Style Selector="ScrollViewer.controller-input Button.gamepad-game:pointerover Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Per-tile controller focus ring: hidden by default, shown on the focused tile. Opacity
             (not IsVisible) so it never disturbs layout. No transition — the selection must track the
             d-pad crisply and instantly, never lag or fade behind a fast move. -->
        <Style Selector="Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-game.focused Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="1" />
            <!-- Depth for the focused tile, cast by the invisible focus box so it exists only while
                 focused. Deliberately NEUTRAL (no accent halo): the coloured glow fought the cover
                 art. One shadowed element per grid, so it stays clear of the reduced-effects budget
                 that dropped the per-tile cover shadows on Android. -->
            <Setter Property="BoxShadow" Value="0 18 40 0 #B3000000" />
        </Style>
        <Style Selector="Border.gamepad-focus-pool">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-game.focused Border.gamepad-focus-pool">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Spotlight hero actions (Play / Achievements) reuse the grid's accent focus pad. -->
        <Style Selector="Panel.spotlight-action.focused Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Flat no-GL shelf fallback: every cover but the focused one recedes (smaller + dimmed) so the
             centred selection reads as the one "in your hands". No focus ring — the centre position and
             the size/opacity lift ARE the selector. Scale + opacity ease so browsing glides. -->
        <Style Selector="Panel.shelf-media">
            <!-- Percentages, not bare 0.5 — Avalonia parses "0.5,0.5" as an ABSOLUTE 0.5px origin (the
                 top-left corner), so the neighbour scale pivoted at the corner and shifted covers left,
                 making the focused cover's left/right margins unequal. "50%,50%" is the real centre. -->
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(0.66)" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.shelf-media.focused">
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The clickable Achievements widget is a bare button wrapping the pill, so it keeps the
             pill's own visuals and never draws its own chrome or focus adorner. -->
        <Style Selector="Button.spotlight-action-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.spotlight-action-button:pointerover /template/ ContentPresenter,
                         Button.spotlight-action-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Spotlight hero pill CONTENT layer (rating / achievements): transparent, so the translucent
             fill behind it (Border.spotlight-pill-fill) lets the fan art read through while the content
             stays fully opaque — the same layered trick the floating list card uses, so every hero
             surface reads as the same glass instead of a flat opaque slab. Content-sized by the cluster. -->
        <Style Selector="Border.spotlight-pill">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The translucent fill/stroke/shadow layer behind a hero pill. Matches the list card's
             surface (EmuPopoverBrush at the same alpha) so the pills and the card feel like one panel. -->
        <Style Selector="Border.spotlight-pill-fill">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- Lift the pill off the busy fan-art backdrop so it reads as a physical surface. -->
            <Setter Property="BoxShadow" Value="0 6 16 0 #4A000000" />
        </Style>
        <!-- Spotlight hero metadata chip: one scraped fact (genre / year / players / developer /
             publisher) as a translucent pill that reads over the fan art from the couch. -->
        <Style Selector="Border.spotlight-chip">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4" />
            <!-- No BoxShadow. The chip holds its label, and a shadow on a Border that holds content
                 draws that content offset out of the pill. The translucent fill and the light hairline
                 already lift it off the fan art; the shadow was barely visible over artwork anyway. -->
        </Style>
        <Style Selector="Grid.gamepad-root.overlay-open Border.gamepad-focus-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- The couch backdrop is set here rather than as an attribute on GamepadRoot, because a
             local value outranks every style setter in Avalonia: with Background written inline, the
             .tube rule below could never take effect and the capture came back as a solid sheet of
             library colour with the shelf hidden behind it. -->
        <Style Selector="Grid.gamepad-root">
            <Setter Property="Background" Value="{DynamicResource EmuLibraryBrush}" />
        </Style>

        <!-- Shelf mode draws its own backdrop inside the tube, so the couch root must not paint one:
             the capture of this tree is composited OVER the 3D scene, and an opaque fill here would
             hide the shelf behind that flat sheet. -->
        <Style Selector="Grid.gamepad-root.tube">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.gamepad-platform">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <!-- Unselected console badges recede so the active tab is the rail's one bright point;
             selection/focus restores full strength. Opacity (not a recolour) keeps each console's
             own badge art. -->
        <Style Selector="Button.gamepad-platform Image, Button.gamepad-platform PathIcon">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="Button.gamepad-platform.selected Image, Button.gamepad-platform.selected PathIcon,
                         Button.gamepad-platform.focused Image, Button.gamepad-platform.focused PathIcon,
                         Button.gamepad-platform:pointerover Image, Button.gamepad-platform:pointerover PathIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.gamepad-platform:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
        </Style>
        <Style Selector="Button.gamepad-platform.controller-input:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- The selection background is drawn by the sliding GamepadRailIndicator pill (positioned in
             code-behind), so the highlight glides left/right between tabs rather than popping in place.
             The tab itself only brightens its icon/label so the active platform reads immediately. -->
        <Style Selector="Button.gamepad-platform.selected">
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <!-- The rail pill that slides between tabs. Code-behind sizes it to the active tab and drives a
             translate transform to overlay it. ONLY the translate eases (it is GPU-composited, so the
             glide stays smooth even while the library relayouts on a platform switch); Width is set
             instantly, because animating it is a per-frame layout pass on the UI thread that stutters. -->
        <Style Selector="Border.gamepad-platform-indicator">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gamepad-platform.focused">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- Focus is a SOLID accent fill with inverted text — the one selection language the couch
             menus and the view-mode/sort cards now share, instead of the barely-visible wash+ring. -->
        <Style Selector="Button.gamepad-modal-option.focused, Button.gamepad-modal-option:focus">
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuWindowBackgroundBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.controller-input:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.focused.controller-input:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.destructive">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.destructive.focused, Button.gamepad-modal-option.destructive:focus">
            <Setter Property="Background" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuWindowBackgroundBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-key TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-a">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadAButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-b">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadBButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadBButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-x">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadXButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadXButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-y">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadYButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadYButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-a TextBlock, Border.gamepad-key.action-b TextBlock, Border.gamepad-key.action-x TextBlock, Border.gamepad-key.action-y TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
        </Style>
        <Style Selector="StackPanel.gamepad-hint">
            <Setter Property="Spacing" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.gamepad-hint &gt; TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-play-action">
            <Setter Property="MinWidth" Value="144" />
            <Setter Property="Width" Value="144" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-play-action:pointerover, Button.gamepad-play-action:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-play-action Border.gamepad-key.action-a">
            <Setter Property="Background" Value="#25000000" />
            <Setter Property="BorderBrush" Value="#38000000" />
        </Style>
        <Style Selector="Button.gamepad-empty-action">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-dock-pill">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-overlay">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="620" />
        </Style>
        <Style Selector="Border.gamepad-overlay.system-menu">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <!-- 500, not 460: with the check badges gone the third view-mode card still needs the
                 room for "Shelf" at the Thor's density instead of truncating to "Sh…". -->
            <Setter Property="Width" Value="500" />
        </Style>
        <!-- Confirmations are compact modals, not the 620px picker sheet: a tighter card centres its
             title/body/buttons as one group. -->
        <Style Selector="Border.gamepad-overlay.confirmation">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="500" />
        </Style>
        <!-- The two dialog buttons share one row as equal halves (a couch-native button bar), so neither
             floats against an edge. Reuses the settings-confirm focus/danger brushes. -->
        <Style Selector="Button.gamepad-confirm-button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- The focus ring colour follows the controller prompts: the confirm half rings green (the A
             button), the Cancel half rings red (the B button). Destructive confirms additionally keep red
             label text as a warning. -->
        <Style Selector="Button.gamepad-confirm-button.focused, Button.gamepad-confirm-button:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadAButtonBrush}" />
        </Style>
        <Style Selector="Button.gamepad-confirm-button.cancel.focused, Button.gamepad-confirm-button.cancel:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadBButtonBrush}" />
        </Style>
        <Style Selector="Button.gamepad-confirm-button.danger">
            <Setter Property="Foreground" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Border.gamepad-overlay.side-sheet">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Width" Value="460" />
        </Style>
        <Style Selector="Border.gamepad-overlay.achievements">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="1120" />
            <Setter Property="Height" Value="640" />
        </Style>
        <Style Selector="Border.gamepad-overlay.scraper">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="1000" />
            <Setter Property="Height" Value="640" />
        </Style>
        <Style Selector="Border.gamepad-overlay.batch-scraper">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="720" />
            <Setter Property="Height" Value="520" />
        </Style>
        <!-- One controller-focusable row in the scraper overlay (a field/media toggle or candidate). -->
        <Style Selector="Border.gamepad-scraper-row">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.gamepad-scraper-row.focused">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Border.gamepad-scraper-cover">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="294" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource EmuCoverWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.gamepad-scraper-field.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- Compact focusable Apply / Revert buttons in a matrix row and the two global actions.
             Reuses the same focus brushes as gamepad-modal-option; only the size differs. -->
        <Style Selector="Button.gamepad-hotkey-action">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-hotkey-action.focused, Button.gamepad-hotkey-action:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-hotkey-action:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.gamepad-settings-nav">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Selected but not focused (the content column owns focus): an accent outline + accent text
             marks the current section without a filled wash that would compete with the focused row.
             The rail-active override below adds the bright fill when the rail itself is focused. -->
        <Style Selector="Button.gamepad-settings-nav.selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- When the rail owns focus, its selected section reads as the active column with a thicker,
             filled accent treatment; the content column dims to show it is inactive. -->
        <Style Selector="Button.gamepad-settings-nav.selected.rail-active">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
        </Style>
        <!-- The one-line status under each rail entry (game count, "Not signed in", the platform that
             needs attention). Secondary colour; warning colour when the section needs a look. -->
        <Style Selector="TextBlock.gamepad-settings-nav-status">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <Style Selector="TextBlock.gamepad-settings-nav-status.warning">
            <Setter Property="Foreground" Value="{DynamicResource EmuWarningBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-nav.selected.rail-active TextBlock.gamepad-settings-nav-status">
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
        </Style>
        <Style Selector="Grid.rail-dimmed">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.gamepad-settings-save">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-save.focused, Button.gamepad-settings-save:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-row">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.focused, Button.gamepad-settings-row:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- Destructive rows read as ordinary settings until focused; the danger cue is the tinted
             action circle plus the confirmation gate, not a wall of red titles across the section. -->
        <Style Selector="Button.gamepad-settings-row.destructive.focused, Button.gamepad-settings-row.destructive:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <!-- Read-only rows (inventory, logs, connected account) are a flat list, not solid cards, so
             a long texture-pack inventory reads as reference data rather than dead action buttons. -->
        <Style Selector="Button.gamepad-settings-row.info">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.info.focused, Button.gamepad-settings-row.info:focus">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Grouped rows are indented beneath their platform header so the section reads as a tree. -->
        <Style Selector="Button.gamepad-settings-row.grouped">
            <Setter Property="Margin" Value="24,0,0,10" />
        </Style>
        <!-- Compact rows (the Emulators section): one-line descriptions, so a platform's rows fit
             beneath its summary without pushing the next platform off screen. -->
        <Style Selector="Button.gamepad-settings-row.compact">
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.compact.grouped">
            <Setter Property="Margin" Value="24,0,0,8" />
        </Style>
        <!-- Platform summary rows: one line — artwork, name, "emulator · N games", chevron. -->
        <Style Selector="Button.gamepad-settings-row.summary">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <!-- A row's description or summary value that reports a problem. -->
        <Style Selector="Button.gamepad-settings-row TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource EmuWarningBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.gamepad-theme-card">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gamepad-theme-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- Same focus signature as the settings rows (accent fill + accent outline at a constant
             thickness), so the focused element reads the same everywhere and the preview doesn't
             reflow from a 2→3px border change. -->
        <Style Selector="Button.gamepad-theme-card.focused, Button.gamepad-theme-card:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- Start-menu view-mode selector: two Grid/List tiles styled like the theme cards. The active
             mode is filled with the accent wash; an accent glow wraps the pair while the controller ring
             is on the row (Left/Right switch and apply live). -->
        <Style Selector="Button.gamepad-viewmode-card">
            <Setter Property="Height" Value="50" />
            <!-- Tight, because three cards share the menu panel's width and each has to fit an icon,
                 a label and the space the check badge reserves. -->
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gamepad-viewmode-card.selected">
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuWindowBackgroundBrush}" />
        </Style>
        <!-- The check badge is always laid out and only fades in, so the label has the same width
             whether or not its card is the selected one.

             It used to be IsVisible-bound, which meant the selected card gave up twenty-two pixels
             plus a gap that the other two kept — so the selected label, and only the selected label,
             was squeezed until the badge sat on top of it: "Grid" rendered as "Gri●" and "Shelf" as
             "Shel✓". It also meant the labels reflowed every time the selection moved. -->
        <Style Selector="Border.gamepad-viewmode-check">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-viewmode-card.selected Border.gamepad-viewmode-check">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-viewmode-row">
            <Setter Property="CornerRadius" Value="18" />
            <!-- A transparent 2px outline + padding reserves the space so focusing the row never shifts
                 the tiles; only the brush changes on focus. -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <!-- The A/Reverse affordance in the "Sort by" header. Reserved always, shown on focus: the
             row style below promises that focusing a row never shifts the tiles, and an affordance
             that appears out of nowhere above them breaks exactly that promise. -->
        <Style Selector="StackPanel.gamepad-sort-reverse-hint">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="StackPanel.gamepad-sort-reverse-hint.focused">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-viewmode-row.focused">
            <!-- The accent outline is the focus cue, and it is now the only one. A BoxShadow on a
                 Border that has children draws those children offset from where they are laid out —
                 up and to the left, by roughly the shadow's extent. That is why the cards in this row
                 flew out of the panel the moment it took focus and nowhere else, why every layout
                 assertion passed while they did, and why a bitmap the window rendered of itself came
                 back correct. The outline was always the guaranteed cue; the glow was an enhancement
                 that cost the row its contents. -->
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Border.gamepad-settings-switch">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.gamepad-settings-switch.on">
            <Setter Property="Background" Value="{DynamicResource EmuAccentMutedBrush}" />
        </Style>
        <Style Selector="Border.gamepad-settings-affordance">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.gamepad-settings-action-button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.destructive Border.gamepad-settings-action-button">
            <Setter Property="Background" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm.focused, Button.gamepad-settings-confirm:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm.danger.focused, Button.gamepad-settings-confirm.danger:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-achievement-tab, Button.gamepad-achievement-command">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- These pills set an explicit Height, so the presenter has slack to distribute. The
                 inherited alignment is Stretch, which leaves the label sitting on the top padding
                 instead of on the pill's centre line. -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.gamepad-achievement-tab.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.gamepad-achievement-detail">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-achievement">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EmuCoverWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ItemsControl.gamepad-overlay-options">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="ItemsControl.gamepad-overlay-options.top-aligned">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- Controller focus is the same accent-frame ring the library grid uses: a pad behind the
             tile revealed on .focused (styled at Border.gamepad-focus-tile-ring above), not a border
             recolour. Shown via opacity so it never disturbs layout and tracks the d-pad instantly. -->
        <Style Selector="Panel.gamepad-achievement-tile.focused Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.gamepad-achievement-badge.locked">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <!-- Hardcore unlock: a gold ring around the badge, matching the desktop achievements list. -->
        <Style Selector="Border.gamepad-achievement.hardcore">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
        </Style>
        <Style Selector="Border.gamepad-achievement-badge-frame.hardcore">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <!-- Fluent scrollbars overlay their content. Gamepad cards reserve a gutter so the
             thumb reads as scrolling chrome instead of a broken right-hand card border. -->
        <Style Selector="ScrollViewer.gamepad-scroll /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MaxWidth" Value="8" />
            <Setter Property="Margin" Value="7,0,1,0" />
        </Style>
        <Style Selector="ScrollViewer.gamepad-scroll /template/ ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <!-- Sidebar scroll region (consoles + collections). Slim overlay thumb so the console
             icons keep their full width; mirrors the gamepad rail's scrollbar treatment. -->
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MaxWidth" Value="8" />
            <Setter Property="Margin" Value="1,0,1,0" />
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll /template/ ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.achievement-mark">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.achievement-mark:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
        </Style>
        <!-- Texture-pack mark: informational only, so it is a Border rather than a Button. There
             is nothing to open, and EmuShelf never installs, repairs, or removes a pack. -->
        <Style Selector="Border.texture-mark">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:checked">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem">
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The row highlight lives on an inner Border (Border.nav-row) rather than the whole item, so
             the manufacturer header that shares the item above the first system of each group is never
             covered by the hover/selection fill. The item's own fills are cleared like GamepadRowList. -->
        <Style Selector="ListBox.system-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Border.nav-row">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:pointerover Border.nav-row">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected Border.nav-row">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <!-- Manufacturer group header inside the console list (Nintendo / Sega / Sony / Arcade). An
             explicit tertiary Foreground keeps the selected item's accent tint off the header text. -->
        <Style Selector="TextBlock.nav-group-header">
            <Setter Property="Margin" Value="12,12,12,4" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.1" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <Style Selector="Border.nav-icon-well">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource EmuNavIconWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuNavIconBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.nav-icon-well Image">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected Border.nav-icon-well, Button.collection-item.selected Border.nav-icon-well">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="StackPanel.game-tile.unavailable, Grid.game-row.unavailable">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <!-- Gamepad tiles dim the artwork and title rather than the whole button: the focus
             ring is the only way to tell where you are on a controller, so it stays full
             strength even when the game's files are missing. -->
        <Style Selector="Button.gamepad-game.unavailable Border.gamepad-cover-frame">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <Style Selector="Button.gamepad-game.unavailable TextBlock.gamepad-tile-title">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <!-- A faint light edge instead of the theme border: on artwork it reads as a catch-light on
             the tile's rim, giving the cover a slight physical lip against the dark backdrop. -->
        <Style Selector="Border.gamepad-cover-frame">
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Unfocused covers step back a notch so the focused tile owns the light. Rides the existing
             0.2s cover-image opacity transition, so focus moves fade rather than pop. -->
        <Style Selector="Button.gamepad-game:not(.focused) Image.cover-image.loaded">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <!-- Titles follow the same hierarchy: dimmed at rest, full strength under the focus ring. -->
        <Style Selector="TextBlock.gamepad-tile-title">
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-game.focused TextBlock.gamepad-tile-title">
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <!-- The sheen is one extra translucent layer over every realized tile, so the reduced-effects
             (Android) grid drops it the same way it drops the per-tile cover shadows. -->
        <Style Selector="Grid.gamepad-root.reduced-effects Border.gamepad-cover-sheen">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The tile's drop shadow, on a Border of its own with nothing inside it.
             It used to sit on the cover frame, which holds the artwork — and a BoxShadow on a Border
             with children draws those children offset up and to the left. The cover slid out of its
             own tile, and only on the unfocused tiles, because the focused style already removed the
             shadow for an unrelated reason. Casting it from an empty sibling keeps the depth and
             leaves the artwork where it was put. -->
        <Style Selector="Border.gamepad-cover-shadow">
            <Setter Property="BoxShadow" Value="0 8 20 0 #40000000" />
        </Style>
        <!-- On focus the solid accent ring is the sole depth cue. The cover drops its shadow entirely
             (even the base 0 8 20 shadow spills past the 6px ring frame) and the ring's own EmuFocusGlow
             is removed at the tile (inline, above), so nothing haloes the ring. Unfocused tiles keep
             their shadow for depth against the library background. -->
        <Style Selector="Button.gamepad-game.focused Border.gamepad-cover-shadow">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <!-- Android (reduced-effects): drop the tile drop-shadow entirely. A 20px blurred BoxShadow on
             every one of the ~40 realized tiles is recomposited each frame while the library scrolls, and
             on a handheld GPU that is the dominant grid cost (the fan-on-scroll investigation). Collapsing
             the empty shadow sibling also removes one full-tile overdraw layer. Desktop keeps the depth. -->
        <Style Selector="Grid.gamepad-root.reduced-effects Border.gamepad-cover-shadow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The focused tile lifts with a small scale. It is applied to the whole cover STACK (accent
             ring + well + cover together) so the concentric focus frame scales as one unit and its even
             6px border is preserved. Scaling only the cover grows it into the fixed ring and eats the
             frame at the corners. RenderTransform is composited and post-layout, so no row reflow; the
             ring's opacity (which tile is focused) stays instant — only the size eases. -->
        <!-- The zoom rides the WHOLE tile (cover + title strip together, class on TileRoot), not
             just the cover stack: with the ringless selector the cover's growth would otherwise eat
             the fixed title's breathing room, leaving the label crowded under a zoomed cover. Scaling
             them as one unit keeps the cover-to-title gap proportional. -->
        <Style Selector="Grid.gamepad-tile-zoom">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.13" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gamepad-game.focused Grid.gamepad-tile-zoom">
            <Setter Property="RenderTransform" Value="scale(1.09)" />
        </Style>
        <!-- Couch-distance counterpart to the desktop cover marks (Button.achievement-mark
             and Border.texture-mark), which are sized for a pointer at desk distance. -->
        <Style Selector="Border.gamepad-mark">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.cover-card">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuCoverBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- The desktop tile's shadow, cast by an empty sibling. Identical construct to the
             couch tile: a BoxShadow on the Border that holds the artwork drew that artwork
             offset out of its own frame. -->
        <Style Selector="Border.cover-card-shadow">
            <Setter Property="BoxShadow" Value="0 8 18 0 #38000000" />
        </Style>
        <Style Selector="StackPanel.game-tile:pointerover Border.cover-card-shadow">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BoxShadow" Value="0 13 30 0 #54000000" />
        </Style>
        <!-- Selection is shown by an overlay ring outside the fixed frame (see the tile),
             not by thickening this border — a thicker border would shrink the content box
             and reflow/rescale the cover on click. -->
        <Style Selector="StackPanel.game-tile.selected Border.cover-card-shadow">
            <Setter Property="BoxShadow" Value="0 12 30 0 #66000000" />
        </Style>
        <Style Selector="Grid.game-row.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <Style Selector="ListBox.game-list ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ItemsControl.list-header TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Clickable list-view column headers: no chrome, so they read as the header labels
             but sort the library on click (with a ▲/▼ direction glyph on the active column). -->
        <Style Selector="Button.sort-header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sort-header /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sort-header:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
</Styles>
