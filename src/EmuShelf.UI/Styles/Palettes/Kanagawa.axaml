<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kanagawa: Warm sumi-ink surfaces with parchment text and a calm wave-aqua accent, like an aged scroll.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#221F1A" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#24211B" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#23201A" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#26231D" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#23201B" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#2D2922" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#3A362F" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#2C2821" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#2A2620" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#2D2922" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#2C2821" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#4A453A" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B221F1A" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#484236" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#625C52" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#3D382E" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#DCD7BA" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#B6AF96" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#8F8773" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E7AA89F" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#2B2721" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#625C52" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#7AA89F" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#337AA89F" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#7AA89F" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B07AA89F</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 14 42 0 #80000000, 0 0 56 0 #A67AA89F</BoxShadows>
</ResourceDictionary>
