<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokyo Night: Deep navy with soft neon blue. Moody but highly readable.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#1A1B26" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#1C1D29" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#1B1C27" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#1E202E" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#1B1C28" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#24283B" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#313547" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#232739" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#222536" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#24283B" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#232739" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#3D4157" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B1A1B26" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#2F344A" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#4C5063" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#2B2F44" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#C0CAF5" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#9CA3C7" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#787C99" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E7AA2F7" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#222637" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#4C5063" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#7AA2F7" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#337AA2F7" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#7AA2F7" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B07AA2F7</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 8 22 0 #80000000, 0 0 26 0 #B37AA2F7</BoxShadows>
</ResourceDictionary>
