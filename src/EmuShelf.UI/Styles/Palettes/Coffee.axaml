<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Coffee: Warm and cozy. Roasted brown surfaces with caramel and amber highlights.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#241A14" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#261C15" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#251B14" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#2A1E17" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#261B15" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#33251C" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#3F322A" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#32241B" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#2F221A" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#33251C" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#32241B" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#564538" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B241A14" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#463328" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#605046" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#3E2D23" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F2E6DA" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#CCBAAA" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#A68F7A" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EC8802D" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#30231B" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#605046" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#C8802D" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33C8802D" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#C8802D" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0C8802D</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 8 22 0 #80000000, 0 0 26 0 #B3C8802D</BoxShadows>
</ResourceDictionary>
