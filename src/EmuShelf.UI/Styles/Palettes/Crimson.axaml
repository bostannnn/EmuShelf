<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Crimson: Deep wine and burgundy surfaces lit by a vivid crimson accent. Dramatic and bold.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#1C0F12" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#1E1013" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#1D0F12" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#221215" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#1E1013" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#2B161A" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#382428" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#2A1519" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#271418" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#2B161A" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#2A1519" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#54393D" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B1C0F12" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#47252B" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#614449" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#3C1F24" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F6E2E4" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#D6B6BA" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#B58B90" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EEE3B54" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#281519" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#614449" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#EE3B54" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33EE3B54" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#EE3B54" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0EE3B54</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 8 22 0 #80000000, 0 0 26 0 #B3EE3B54</BoxShadows>
</ResourceDictionary>
