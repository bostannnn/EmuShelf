<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Oxocarbon: IBM Carbon-inspired near-black surfaces with a vivid magenta accent and cyan highlights.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#0F0F14" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#101016" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#101015" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#121218" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#101015" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#18181F" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#26262C" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#17171E" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#16161C" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#18181F" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#17171E" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#3A3A43" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B0F0F14" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#2A2A33" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#484850" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#23232B" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#BEBFC8" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#8A8A97" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EEE5396" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#16161D" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#484850" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#EE5396" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33EE5396" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#EE5396" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0EE5396</BoxShadows>
</ResourceDictionary>
