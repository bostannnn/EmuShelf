<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OLED: True black for OLED panels. Maximum contrast and reduced power draw.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#020202" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#010101" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#050505" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#010101" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#0C0C0C" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#0C0C0C" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#323236" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B000000" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#3E3E3E" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#181818" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F0F0F5" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#BDBDC5" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#8A8A95" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E5B58D9" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#0B0B0B" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#3E3E3E" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#5B58D9" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#335B58D9" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#5B58D9" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B05B58D9</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 12 34 0 #59000000, 0 0 44 0 #595B58D9</BoxShadows>
</ResourceDictionary>
