<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gruvbox: Warm earthy retro-terminal palette with a bright orange accent and yellow, green and aqua highlights.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#2B2B2A" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#292929" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#302E2D" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#2A2A29" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#3C3836" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#484442" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#3A3635" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#373432" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#3C3836" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#3A3635" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#564E49" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B282828" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#665C54" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#7B736C" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#554E48" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#EBDBB2" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#BEAF93" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#928374" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EFE8019" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#383533" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#7B736C" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#FE8019" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33FE8019" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#FE8019" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0FE8019</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 14 42 0 #80000000, 0 0 56 0 #A6FE8019</BoxShadows>
</ResourceDictionary>
