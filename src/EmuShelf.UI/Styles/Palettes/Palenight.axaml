<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palenight: A softer, hazier Material-style cousin of Dracula. Muted indigo with pastel blue.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#292D3E" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#2C3042" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#2A2E40" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#2F3448" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#2B2F41" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#3A3F58" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#464B62" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#383D55" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#363A52" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#3A3F58" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#383D55" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#535872" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B292D3E" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#444A63" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#5E6379" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#40465F" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#EEFFFF" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#BEC8D6" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#8D92AD" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E82AAFF" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#373C53" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#5E6379" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#82AAFF" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#3382AAFF" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#82AAFF" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B082AAFF</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 12 34 0 #59000000, 0 0 44 0 #5982AAFF</BoxShadows>
</ResourceDictionary>
