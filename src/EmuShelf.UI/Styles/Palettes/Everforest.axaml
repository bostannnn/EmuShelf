<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Everforest: Soft, low-contrast woodland greens over a warm dark base. Cozy and gentle on the eyes.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#2D353B" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#2E373C" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#2D363C" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#30393E" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#2E363C" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#343F44" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#404B4F" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#333E43" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#323C42" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#343F44" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#333E43" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#4C5859" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B2D353B" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#4F585E" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#686F75" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#444E54" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#D3C6AA" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#ACAC9A" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#859289" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EA7C080" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#333D42" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#686F75" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#A7C080" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33A7C080" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#A7C080" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0A7C080</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 8 22 0 #80000000, 0 0 26 0 #B3A7C080</BoxShadows>
</ResourceDictionary>
