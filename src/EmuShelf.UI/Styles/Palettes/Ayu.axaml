<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ayu: Clean cool near-black surfaces lit by a warm amber accent. Crisp and focused.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#0C0F16" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#0B0F15" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#0E1119" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#0C0F15" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#131721" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#21252E" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#121620" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#11151E" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#131721" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#121620" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#272B36" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B0B0E14" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#2D3640" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#4A525B" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#232A34" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#BFBDB6" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#8A8C8E" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#565B66" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EFFB454" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#12151F" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#4A525B" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33FFB454" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0FFB454</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 12 34 0 #59000000, 0 0 44 0 #59FFB454</BoxShadows>
</ResourceDictionary>
