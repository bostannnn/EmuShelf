<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Horizon: Warm dark plum with a dusty rose-red accent. Softer than a pure neutral dark.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#1C1E26" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#1F212A" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#1D1F27" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#23252F" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#1E2028" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#2E303E" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#3B3C4A" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#2C2E3C" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#2A2C38" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#2E303E" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#2C2E3C" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#4F5060" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B1C1E26" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#3B3D4D" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#565866" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#363847" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#E0DEF4" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#BEBCD2" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#9C9BB0" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EE95678" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#2B2D3A" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#565866" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#E95678" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33E95678" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#E95678" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0E95678</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 14 42 0 #80000000, 0 0 56 0 #A6E95678</BoxShadows>
</ResourceDictionary>
