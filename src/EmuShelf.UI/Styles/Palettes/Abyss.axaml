<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Abyss: Near-black teal with a single acid-green accent. Terminal-like and high focus.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#0A1512" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#0C1A16" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#0B1714" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#0F211C" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#0B1815" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#16342C" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#244039" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#153129" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#132C26" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#16342C" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#153129" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#36554B" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B0A1512" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#1D4038" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#3D5B54" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#1A3B33" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#DFF2E6" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#AFCABC" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#7FA393" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E9ECF00" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#142E27" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#3D5B54" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#9ECF00" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#339ECF00" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#9ECF00" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B09ECF00</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 14 42 0 #80000000, 0 0 56 0 #A69ECF00</BoxShadows>
</ResourceDictionary>
