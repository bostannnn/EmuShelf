<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solarized: The precise low-contrast classic: desaturated teal-navy surfaces with a clean blue accent.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#002B36" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#012D38" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#002C37" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#032F3B" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#012C37" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#073642" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#16424D" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#063541" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#05333F" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#073642" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#063541" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#1F4751" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B002B36" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#17515F" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#376975" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#114653" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#93A1A1" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#76888B" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#586E75" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E268BD2" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#063440" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#376975" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33268BD2" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0268BD2</BoxShadows>
    <BoxShadows x:Key="EmuGamepadFocusGlow">0 14 42 0 #80000000, 0 0 56 0 #A6268BD2</BoxShadows>
</ResourceDictionary>
