<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EmuSidebarBrush" Color="#F4F4F4" />
            <SolidColorBrush x:Key="EmuToolbarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EmuLibraryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EmuStatusBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="EmuCardBrush" Color="#F4F1FB" />
            <SolidColorBrush x:Key="EmuPopoverBrush" Color="#FAF8FD" />
            <SolidColorBrush x:Key="EmuInputBrush" Color="#FAF8FD" />
            <SolidColorBrush x:Key="EmuSegmentBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#FAF8FD" />
            <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6BFFFFFF" />
            <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#12000000" />
            <SolidColorBrush x:Key="EmuBorderBrush" Color="#E0DCED" />
            <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#BCB9C7" />
            <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#E8E4F3" />
            <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#1E1B2E" />
            <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#454257" />
            <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#6C6880" />
            <SolidColorBrush x:Key="EmuHoverBrush" Color="#12000000" />
            <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#267C6CE0" />
            <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#BCB9C7" />
            <SolidColorBrush x:Key="EmuAccentBrush" Color="#7C6CE0" />
            <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#337C6CE0" />
            <SolidColorBrush x:Key="EmuSelectionBrush" Color="#7C6CE0" />
            <SolidColorBrush x:Key="EmuAchievementBrush" Color="#A96400" />
            <SolidColorBrush x:Key="EmuAchievementSoftcoreBrush" Color="#78828F" />
            <SolidColorBrush x:Key="EmuInfoBrush" Color="#28749A" />
            <SolidColorBrush x:Key="EmuProgressBrush" Color="#28749A" />
            <SolidColorBrush x:Key="EmuSuccessBrush" Color="#287A59" />
            <SolidColorBrush x:Key="EmuWarningBrush" Color="#A85E00" />
            <SolidColorBrush x:Key="EmuDangerBrush" Color="#B42332" />
            <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B07C6CE0</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#1E1E2A" />
            <SolidColorBrush x:Key="EmuSidebarBrush" Color="#20202C" />
            <SolidColorBrush x:Key="EmuToolbarBrush" Color="#1F1F2B" />
            <SolidColorBrush x:Key="EmuLibraryBrush" Color="#23232F" />
            <SolidColorBrush x:Key="EmuStatusBrush" Color="#1F1F2B" />
            <SolidColorBrush x:Key="EmuCardBrush" Color="#2A2A38" />
            <SolidColorBrush x:Key="EmuPopoverBrush" Color="#373744" />
            <SolidColorBrush x:Key="EmuInputBrush" Color="#292937" />
            <SolidColorBrush x:Key="EmuSegmentBrush" Color="#272734" />
            <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#2A2A38" />
            <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#292937" />
            <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#4C4C5C" />
            <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B1E1E2A" />
            <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="EmuBorderBrush" Color="#3A3A4C" />
            <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#565665" />
            <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#343444" />
            <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#E8E8F0" />
            <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#C1C1D0" />
            <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#9A9AB0" />
            <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2E5B58D9" />
            <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#282835" />
            <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#565665" />
            <SolidColorBrush x:Key="EmuAccentBrush" Color="#5B58D9" />
            <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#335B58D9" />
            <SolidColorBrush x:Key="EmuSelectionBrush" Color="#5B58D9" />
            <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
            <SolidColorBrush x:Key="EmuAchievementSoftcoreBrush" Color="#C3C9D4" />
            <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
            <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
            <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
            <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
            <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
            <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B05B58D9</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Controller semantics stay fixed across every palette. -->
    <SolidColorBrush x:Key="EmuGamepadAButtonBrush" Color="#57CF8C" />
    <SolidColorBrush x:Key="EmuGamepadBButtonBrush" Color="#F06A94" />
    <SolidColorBrush x:Key="EmuGamepadXButtonBrush" Color="#66A8FF" />
    <SolidColorBrush x:Key="EmuGamepadYButtonBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuGamepadButtonTextBrush" Color="#101217" />

    <!-- App icon geometries and the content-only gamepad game-button ControlTheme. Moved here
         from MainWindow.axaml's Window.Resources during the A1 extraction so both heads and the
         render tests resolve them at Application scope. -->
        <!-- Neutral trophy glyph (mdi-trophy) for the achievement mark; not RA branding. -->
        <!-- mdi-layers: a neutral "replacement images" mark. Not emulator or vendor branding. -->
        <StreamGeometry x:Key="TexturePackLayersGeometry">M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z</StreamGeometry>
        <!-- mdi-alert: marks a failed operation in the status toast. -->
        <StreamGeometry x:Key="StatusWarningGeometry">M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16</StreamGeometry>
        <!-- mdi-sync: circular arrows, the Gamepad save-sync panel's "transferring" mark. -->
        <StreamGeometry x:Key="CloudSyncGeometry">M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z</StreamGeometry>
        <StreamGeometry x:Key="AchievementTrophyGeometry">M18,2H6V4H2V9C2,11.21 3.79,13 6,13V13.5C6,15.43 7.5,17 9.34,17.15L9,18H7V20H17V18H15L14.66,17.15C16.5,17 18,15.43 18,13.5V13C20.21,13 22,11.21 22,9V4H18V2M6,11C4.9,11 4,10.1 4,9V6H6V11M20,9C20,10.1 19.1,11 18,11V6H20V9Z</StreamGeometry>
        <!-- mdi-refresh / mdi-close: the second-screen achievements header's icon buttons. -->
        <StreamGeometry x:Key="EmuRefreshGeometry">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="EmuCloseGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <!-- The Fluent Button theme paints its internal presenter on pointer/pressed states even
             when Button.Background is transparent. Game tiles provide cover-sized hover/focus
             overlays, so their button template is deliberately content-only. -->
        <ControlTheme x:Key="GamepadGameButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      ClipToBounds="False"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
</ResourceDictionary>
