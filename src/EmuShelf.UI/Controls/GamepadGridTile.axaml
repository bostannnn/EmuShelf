<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             x:Class="EmuShelf.App.Controls.GamepadGridTile"
             x:DataType="vm:GameViewModel"
             x:CompileBindings="True"
             ClipToBounds="False">
    <!-- This tree is hosted by GamepadGridPanel's tile pool: the controls are constructed ONCE and
         stay permanently attached; only their bindings re-evaluate as the panel re-binds tiles while
         rows scroll through the viewport. The mouse hover-ring suppression while a controller is
         active is styled from the .controller-input class on the grid's ScrollViewer (GamepadRowList)
         via a descendant selector (one binding on the surface), not a per-tile class binding — see
         EmuShelfStyles. -->
    <Button Classes="gamepad-game"
            Classes.focused="{Binding IsFocused}"
            Classes.unavailable="{Binding !IsAvailable}"
            Theme="{StaticResource GamepadGameButtonTheme}"
            Width="{Binding CoverWidth}" Padding="0" Margin="0"
            ClipToBounds="False" VerticalAlignment="Top"
            Background="Transparent" BorderThickness="2"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            Click="OnClicked" DoubleTapped="OnDoubleTapped">
        <!-- The 58 here is the label strip under the cover. GamepadGridPanel computes every row's
             band height and tile rect from GamepadGridTile.LabelStripHeight; the ctor re-applies that
             constant to this RowDefinition so the two can never drift. -->
        <Grid x:Name="TileRoot" Classes="gamepad-tile-zoom" Width="{Binding CoverWidth}" RowDefinitions="Auto,58" ClipToBounds="False">
            <!-- The cover frame is this tile's packed size: the packer framed it to
                 the platform's canonical ratio and scaled the row to fill the width.
                 UniformToFill below crops off-ratio art to fill it; every cover in a
                 row shares one height, so the row's covers line up top and bottom. -->
            <Panel Grid.Row="0" Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"
                   Classes="gamepad-cover-stack" ClipToBounds="False">
                <!-- Controller focus: NO ring — light does the selecting. This invisible box is only
                     the shadow caster: on .focused (styles) it gains a deep neutral drop shadow while
                     the cover stack scales up, and the unfocused tiles' dimming supplies the brightness
                     contrast. A small accent light pool under the tile (gamepad-focus-pool, below)
                     grounds the lifted cover. Rings were tried twice — the solid accent pad read as a
                     sticker frame, the thin white ring + coloured glow fought the cover art's own
                     colours ("cover lights"). Must stay first/bottom-most so the shadow projects from
                     UNDER the cover. Shown by opacity on .focused; no transition, tracks the d-pad. -->
                <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                        Margin="-7" CornerRadius="19"
                        Background="Transparent" />
                <!-- Opaque well between the focus pad and the cover, sized to the cover
                     (the pad is 6px larger). It is never dimmed, so when an unavailable
                     cover drops to 58% opacity its centre reveals this dark well rather
                     than the accent pad behind it — the pad stays a clean 6px edge frame. -->
                <Border IsHitTestVisible="False" CornerRadius="12"
                        Background="{DynamicResource EmuCoverWellBrush}" />
                <Border Classes="gamepad-cover-shadow" IsHitTestVisible="False"
                        CornerRadius="12"
                        Background="{DynamicResource EmuCoverWellBrush}" />
                <!-- Tiles stay attached; a pooled tile shows a different game purely by DataContext
                     re-bind, so the cover (re)load rides DataContextChanged. AttachedToVisualTree
                     covers the one-time first attach of a freshly built tile. -->
                <Border Classes="gamepad-cover-frame" CornerRadius="12"
                        Background="{DynamicResource EmuCoverWellBrush}"
                        ClipToBounds="True"
                        AttachedToVisualTree="OnCoverAttached"
                        DataContextChanged="OnCoverDataContextChanged">
                    <Panel>
                        <!-- The "artwork missing" placeholder is built by a ContentControl
                             whose content is non-null ONLY while the tile is uncovered
                             (UncoveredPlaceholder). A covered tile therefore never
                             instantiates this Grid + medallion + second Image. Covers are
                             prefetched ahead of the scroll, so realized tiles are almost
                             always already covered. It only ever appears (no crossfade
                             needed) because it is removed, not dimmed, the moment a
                             cover arrives. -->
                        <ContentControl Content="{Binding UncoveredPlaceholder}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:GameViewModel">
                                    <Grid RowDefinitions="5,*"
                                          Background="{DynamicResource EmuCoverWellBrush}">
                                        <Border Grid.Row="0" Background="{Binding AccentColor}" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Spacing="12">
                                            <Border Width="88" Height="88" CornerRadius="44"
                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                <Image Width="62" Height="62" Source="{Binding PlatformArtwork}"
                                                       RenderOptions.BitmapInterpolationMode="None" />
                                            </Border>
                                            <TextBlock Text="ARTWORK MISSING" FontSize="8" FontWeight="Bold"
                                                       LetterSpacing="1.2"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <!-- UniformToFill so covers fill the frame with no letterbox bars.
                             In a single-platform view the frame is that platform's true
                             shape, so this is an exact fill; only a mixed view's uniform
                             frame crops the off-ratio minority (wide SNES, square PS1). -->
                        <Image Source="{Binding CoverImage}" Classes="cover-image"
                               Classes.loaded="{Binding HasCoverImage}"
                               Stretch="UniformToFill" />
                        <Border IsVisible="{Binding IsMultiDisc}" Background="#D9000000"
                                CornerRadius="4" Padding="9,5" Margin="10"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding DiscBadgeText}" FontSize="10" FontWeight="Bold"
                                       LetterSpacing="0.8" Foreground="White" />
                        </Border>
                    </Panel>
                </Border>
                <!-- A faint diagonal catch-light across the cover's top-left, so tiles read as glossy
                     inserts instead of flat stickers. One static gradient layer per tile — dropped
                     wholesale under .reduced-effects (styles) to protect the Android scroll budget. -->
                <Border Classes="gamepad-cover-sheen" IsHitTestVisible="False" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="65%,100%">
                            <GradientStop Offset="0" Color="#17FFFFFF" />
                            <GradientStop Offset="0.28" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Same marks the desktop grid shows, sized for a couch viewing
                     distance. Both are Borders here: a focusable button inside a
                     tile button would capture controller focus, and every gamepad
                     action for a game is reached through the Y actions overlay. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border Classes="gamepad-mark" IsVisible="{Binding ShowAchievementMark}">
                        <PathIcon Width="16" Height="16"
                                  Data="{StaticResource AchievementTrophyGeometry}"
                                  Foreground="{DynamicResource EmuAchievementBrush}" />
                    </Border>
                    <Border Classes="gamepad-mark" IsVisible="{Binding ShowTextureMark}">
                        <PathIcon Width="16" Height="16"
                                  Data="{StaticResource TexturePackLayersGeometry}"
                                  Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <Border IsVisible="{Binding !IsAvailable}"
                        Background="#E1292D34" CornerRadius="5"
                        Padding="9,5" Margin="10"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding UnavailableBadgeText}" FontSize="10" FontWeight="Bold"
                               LetterSpacing="0.9" Foreground="White" />
                </Border>
                <Border Classes="gamepad-hover-ring" IsHitTestVisible="False"
                        CornerRadius="12" BorderBrush="{DynamicResource EmuStrongBorderBrush}"
                        BorderThickness="2" />
                <!-- The focused tile's accent light pool: a soft radial puddle spilling from under the
                     cover's bottom edge onto the stage, in the theme accent. The OpacityMask is fine
                     here — the element is ~250x26 on ONE tile, not a full-screen layer. -->
                <Border Classes="gamepad-focus-pool" IsHitTestVisible="False"
                        Height="26" VerticalAlignment="Bottom" Margin="18,0,18,-26"
                        Background="{DynamicResource EmuAccentBrush}">
                    <Border.OpacityMask>
                        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%"
                                             RadiusX="55%" RadiusY="100%">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </RadialGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Panel>
            <TextBlock Grid.Row="1" Classes="gamepad-tile-title" Text="{Binding DisplayTitle}"
                       Margin="2,10,2,0" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource EmuGpLabelSize}" FontWeight="SemiBold"
                       TextAlignment="Center" HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" MaxWidth="{Binding CoverWidth}" />
        </Grid>
    </Button>
</UserControl>
