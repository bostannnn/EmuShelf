<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:controls="using:EmuShelf.App.Controls"
             xmlns:sys="using:EmuShelf.Core.Systems"
             xmlns:settings="using:EmuShelf.Core.Settings"
             x:Class="EmuShelf.App.Views.GamepadShellView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Border.gamepad-overlay.settings">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="{Binding #GamepadOverlayHost.Bounds.Width}" />
            <Setter Property="Height" Value="{Binding #GamepadOverlayHost.Bounds.Height}" />
        </Style>
        <!-- The game-actions side sheet anchors to the host's full height: a centred, content-sized
             card floated at arbitrary offsets from the screen edges; anchored chrome reads as part of
             the shell. Width stays the side-sheet's own (EmuShelfStyles). -->
        <Style Selector="Border.gamepad-overlay.side-sheet">
            <Setter Property="Height" Value="{Binding #GamepadOverlayHost.Bounds.Height}" />
        </Style>
        <!-- The Hotkeys overlay is a dense per-emulator × per-action matrix, so like Settings it fills
             the host and lets its matrix column scroll rather than centring a fixed-size card. -->
        <Style Selector="Border.gamepad-overlay.hotkeys">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="{Binding #GamepadOverlayHost.Bounds.Width}" />
            <Setter Property="Height" Value="{Binding #GamepadOverlayHost.Bounds.Height}" />
        </Style>
        <!-- Grid/list rail: instead of a second flat slab over the library (with a visible colour step
             where the two meet), the rail is a translucent dark ramp that fades into the backdrop, held
             off the content by a subtle hairline. Both are theme-agnostic alphas over the themed root. -->
        <Style Selector="Border.gamepad-toolbar">
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#66000000" />
                        <GradientStop Offset="1" Color="#14000000" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- In shelf view the platform rail sits directly over the 3D shelf's own backdrop; paint it the
             same backdrop brush so there is no colour step (the "line") where the paler toolbar meets the
             brighter shelf. In grid/list the toolbar keeps its own ramp to separate from the content. -->
        <Style Selector="Border.gamepad-toolbar.shelf-view">
            <Setter Property="Background" Value="{DynamicResource EmuLibraryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <!-- The gamepad shell: the couch UI subtree (GamepadRoot) plus the CRT tube host that composites
         it, extracted from MainWindow so the Android single-view head hosts the identical tree. Both
         children carry their own IsVisible bindings, so on the desktop head this whole view simply
         collapses when the window is in Desktop mode. -->
    <Grid>
    <Grid x:Name="GamepadRoot" Classes="gamepad-root" Classes.overlay-open="{Binding HasGamepadOverlay}"
          Classes.tube="{Binding IsShelfTubeActive}"
          Classes.reduced-effects="{Binding IsReducedEffectsPlatform}"
          IsVisible="{Binding IsGamepadMode}" IsHitTestVisible="False" RowDefinitions="100,*,0"
          TextElement.FontFamily="{StaticResource EmuGamepadFontFamily}">
        <!-- Grid-mode ambient backdrop, painted over the flat EmuLibraryBrush root: a vertical light
             ramp (lit top, settling darker toward the dock) plus a soft radial wash in the focused
             game's per-system accent, so the stage responds to what is selected instead of being one
             flat sheet. The wash brush is swapped by UpdateAmbientGlow (code-behind) as focus moves and
             cross-fades via its BrushTransition. Both layers are static gradients — no per-frame work —
             and only exist in grid layout: shelf and spotlight paint their own backdrops. -->
        <Grid Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
              IsVisible="{Binding IsGamepadGridLayout}">
            <!-- Full-bleed platform tint: the whole stage takes a low hue shift toward the focused
                 game's accent, so switching platforms recolours the room, not just a corner. Same
                 code-behind swap + cross-fade as the corner pool below. -->
            <Border x:Name="GamepadAmbientTint" Opacity="0.10">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.45" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#1CFFFFFF" />
                        <GradientStop Offset="0.45" Color="#00000000" />
                        <GradientStop Offset="1" Color="#66000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- The corner pool. Painted as a DIRECT radial gradient (accent fading to transparent,
                 built in UpdateAmbientGlow) — an OpacityMask here forced a full-screen offscreen
                 compose on every frame of a scroll, which is real GPU money on the Thor. Colour
                 changes snap; the tint layer's cross-fade above carries the perceived transition. -->
            <Border x:Name="GamepadAmbientGlow" />
        </Grid>
        <Border Grid.Row="0" Padding="42,18,42,12" Classes="gamepad-toolbar"
                Classes.shelf-view="{Binding IsGamepadShelfView}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
                <Border Classes="gamepad-key" VerticalAlignment="Center">
                    <TextBlock Text="LB" />
                </Border>
                <ScrollViewer x:Name="GamepadRailScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" SizeChanged="OnGamepadRailSizeChanged">
                    <Panel>
                        <!-- Behind the tabs, snapped over the active one by UpdateRailIndicator. -->
                        <Border x:Name="GamepadRailIndicator" Classes="gamepad-platform-indicator"
                                Width="0" Height="54" IsVisible="False" />
                        <StackPanel x:Name="GamepadRailTabs" Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                        <Button x:Name="GamepadAllGamesTab" Classes="gamepad-platform"
                                Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                                Command="{Binding ShowAllGamesCommand}"
                                Classes.selected="{Binding IsAllGamesSelected}"
                                ToolTip.Tip="All Games" AutomationProperties.Name="All Games"
                                MinHeight="54" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- No bitmap exists for "everything", so a 2x2 grid glyph stands in for
                                     the console badges the other tabs carry. -->
                                <PathIcon Width="30" Height="30"
                                          Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                                <TextBlock Text="All Games" VerticalAlignment="Center" Margin="10,0,2,0"
                                           IsVisible="{Binding IsAllGamesSelected}"
                                           FontSize="{DynamicResource EmuGpLabelSize}" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding GamepadPlatforms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GamepadPlatformTabViewModel">
                                    <!-- Icon-only rail: the name is dropped to declutter and only
                                         reappears on the active tab so "you are here" stays legible.
                                         Tooltip/automation keep the name for pointer and screen readers. -->
                                    <Button Classes="gamepad-platform"
                                            Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                            Classes.selected="{Binding IsActive}" MinHeight="54" Padding="14,10"
                                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).SelectPlatformCommand}"
                                            CommandParameter="{Binding System}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="30" Height="30" Source="{Binding Artwork}"
                                                   RenderOptions.BitmapInterpolationMode="None" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,2,0"
                                                       IsVisible="{Binding IsActive}"
                                                       FontSize="{DynamicResource EmuGpLabelSize}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
                <Border Grid.Column="2" Classes="gamepad-key" VerticalAlignment="Center">
                    <TextBlock Text="RB" />
                </Border>
            </Grid>
        </Border>
        <!-- Row-virtualized grid. GamepadGridPanel keeps a fixed pool of permanently-attached
             tiles and re-binds/repositions them as the offset crosses rows, with exact row geometry
             from the packer (see the panel's remarks for the measured on-device reasons a ListBox +
             VirtualizingStackPanel could not scroll smoothly here). The surface is passive —
             navigation and the focus ring are driven by the flat Games list.
             .controller-input here (not per tile) drives the hover-ring suppression style for every
             pooled tile through a descendant selector — one binding instead of one per tile. -->
        <!-- Vertical margin is 26 MINUS GamepadGridPanel.EdgeInset (24): the panel now carries that
             headroom inside its scrollable extent so edge-row focus rings aren't viewport-clipped. -->
        <ScrollViewer x:Name="GamepadRowList" Grid.Row="1" Margin="52,2,52,2"
                      Classes="library-surface" Classes.loading="{Binding IsLibraryLoading}"
                      Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                      Background="Transparent" Padding="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      IsVisible="{Binding ShowGamepadGrid}"
                      SizeChanged="OnGamepadLibrarySizeChanged"
                      IsHitTestVisible="{Binding !HasGamepadOverlay}">
            <!-- Transparent background so the WHOLE surface hit-tests: a touch pan started in the
                 gutter or between tiles must reach the scroller, not fall through the panel. -->
            <controls:GamepadGridPanel x:Name="GamepadGridSurface" Rows="{Binding GamepadRows}"
                                       Background="Transparent" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsLibraryEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
            <TextBlock Text="{Binding EmptyLibraryTitle}" FontSize="30" FontWeight="Bold"
                       TextAlignment="Center" />
            <TextBlock Text="{Binding GamepadEmptyLibraryPrompt}"
                       FontSize="17" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <Button x:Name="GamepadEmptyMenuButton"
                    Classes="gamepad-empty-action" HorizontalAlignment="Center"
                    Command="{Binding OpenGamepadMenuCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Classes="gamepad-key"><TextBlock Text="Start" /></Border>
                    <TextBlock Text="Menu" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsSearchEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="No matching games" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Press X to edit or clear the search."
                       FontSize="17" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
        </StackPanel>
        <!-- ZIndex keeps the toast above the library content it shares a cell with — in particular the
             opaque single-game spotlight backdrop and the focused dock, which are declared after it and
             would otherwise paint over it, hiding launch errors in Spotlight view. It stays below the
             overlay scrim (ZIndex 2) so an open overlay still covers it. -->
        <Border Grid.Row="1" ZIndex="1" Classes="status-toast" Classes.showing="{Binding ShowGamepadStatusToast}"
                Classes.progress="{Binding IsStatusProgress}"
                Classes.error="{Binding IsStatusError}"
                IsHitTestVisible="{Binding ShowGamepadStatusToast}"
                HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="560"
                Margin="36" Padding="16,12" CornerRadius="10"
                Background="{DynamicResource EmuPopoverBrush}"
                BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Panel VerticalAlignment="Center" Width="16" Height="16">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource EmuInfoBrush}"
                             IsVisible="{Binding IsStatusInfo}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource EmuProgressBrush}"
                             IsVisible="{Binding IsStatusProgress}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <PathIcon Width="16" Height="16" IsVisible="{Binding IsStatusError}"
                              Data="{StaticResource StatusWarningGeometry}"
                              Foreground="{DynamicResource EmuDangerBrush}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="15"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <!-- Messages expire on their own here as they do on the desktop, but a pointer is
                     still usable in Gamepad mode and this was previously the one toast with no
                     way at all to get rid of it. -->
                <Button Grid.Column="2" Width="30" Height="30" Padding="7"
                        CornerRadius="15" Background="Transparent" BorderThickness="0"
                        Command="{Binding ClearStatusCommand}" ToolTip.Tip="Dismiss">
                    <PathIcon Width="11" Height="11"
                              Data="M2,1 L10,9 L9,10 L1,2 Z M9,1 L10,2 L2,10 L1,9 Z" />
                </Button>
            </Grid>
        </Border>
        <!-- Grid/spotlight retain the large save-sync surface. Physical-shelf mode deliberately uses
             the corner progress toast instead, keeping the selected cartridge and launch choreography
             visible while saves are pulled before process start or pushed after emulator exit. -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="1" IsVisible="{Binding ShowBlockingLaunchSaveSync}"
                Background="#B0000000" IsHitTestVisible="False">
            <Border Padding="44,34" CornerRadius="18" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource EmuPopoverBrush}"
                    BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <PathIcon Width="46" Height="46"
                              Data="{StaticResource CloudSyncGeometry}"
                              Foreground="{DynamicResource EmuProgressBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="21" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="360" Height="4" />
                    <TextBlock Text="Game files are never uploaded — only emulator saves."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Border>
        <!-- The dock is an OVERLAY on the grid's lower edge, not a layout row: covers scroll
             beneath it through a transparent-to-dark fade, and the grid gains the ~104px the old
             slab row occupied. GamepadGridPanel.EdgeInsetBottom keeps the clamped last row (and the
             centred focused row) clear of it. -->
        <Border x:Name="GamepadFocusedDock" Grid.Row="1" VerticalAlignment="Bottom"
                Padding="36,48,36,12" IsVisible="{Binding IsGamepadGridLayout}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.32" Color="#99000000" />
                    <GradientStop Offset="1" Color="#E6000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="GamepadDockPrimaryRow" IsVisible="{Binding HasGames}"
                  ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <StackPanel MinWidth="0" Margin="0,0,12,0" VerticalAlignment="Center" Spacing="2">
                    <!-- Letterspaced caps: the system reads as a quiet eyebrow label over the title
                         instead of an accent-coloured link. -->
                    <TextBlock Text="{Binding FocusedGame.SystemName, Converter={x:Static vm:TextConverters.Uppercase}}"
                               FontSize="{DynamicResource EmuGpCaptionSize}"
                               FontWeight="Bold" LetterSpacing="3.4" Foreground="{DynamicResource EmuAccentBrush}" />
                    <TextBlock Text="{Binding FocusedGame.Title}" FontSize="{DynamicResource EmuGpTitleSize}" FontWeight="Bold"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="GamepadFocusedSubtitle" Text="{Binding FocusedGame.GamepadSubtitle}"
                               FontSize="{DynamicResource EmuGpCaptionSize}" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>

                <Border x:Name="GamepadAchievementWidget" Grid.Column="1" Classes="gamepad-dock-pill"
                        ToolTip.Tip="{Binding FocusedGame.AchievementsTooltip}"
                        IsVisible="{Binding FocusedGame.ShowAchievementMark}"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource EmuFormatPillBrush}"
                                VerticalAlignment="Center">
                            <PathIcon Width="18" Height="18"
                                      Data="{StaticResource AchievementTrophyGeometry}"
                                      Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </Border>
                        <!-- Both RA modes at once: softcore (silver) over hardcore (gold). A hardcore
                             unlock always implies the softcore one, so the gold bar can only trail the
                             silver one. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusedGame.GamepadAchievementCountText}"
                                           FontSize="12" FontWeight="Bold" MinWidth="42"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                                <Border x:Name="GamepadAchievementTrack" Grid.Column="1"
                                        Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        ClipToBounds="True"
                                        Background="{DynamicResource EmuFormatPillBrush}">
                                    <Border x:Name="GamepadAchievementFill"
                                            Background="{DynamicResource EmuAchievementSoftcoreBrush}"
                                            RenderTransformOrigin="0%,50%">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding FocusedGame.GamepadAchievementProgressRatio}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusedGame.GamepadHardcoreCountText}"
                                           FontSize="12" FontWeight="Bold" MinWidth="42"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuAchievementBrush}" />
                                <Border x:Name="GamepadHardcoreTrack" Grid.Column="1"
                                        Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        ClipToBounds="True"
                                        Background="{DynamicResource EmuFormatPillBrush}">
                                    <Border x:Name="GamepadHardcoreFill"
                                            Background="{DynamicResource EmuAchievementBrush}"
                                            RenderTransformOrigin="0%,50%">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding FocusedGame.GamepadHardcoreProgressRatio}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="GamepadPlayButton" Grid.Column="2" Classes="gamepad-play-action"
                        Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                        Command="{Binding LaunchFocusedGameCommand}"
                        IsEnabled="{Binding FocusedGame.IsAvailable}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="gamepad-key action-a" Width="32" Height="32">
                            <TextBlock Text="A" FontSize="13" />
                        </Border>
                        <TextBlock Text="PLAY" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!-- ===================== Spotlight (couch) layout =====================
             A large fan-art backdrop that fills the whole content area, with a floating game list on
             the left and the hero's title/logo/actions on the right. Shown in place of the cover grid
             and the focused-game dock when the couch view is toggled to spotlight. It reuses the same
             FocusedGame model, so LB/RB, A/Y and every overlay behave exactly as over the grid. The
             window's tunnel key handler consumes the d-pad before the list can double-handle it, so
             the list is a passive selection surface (SelectedItem tracks FocusedGame, auto-scrolling
             it into view). -->
        <Panel Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowGamepadSpotlight}"
               ClipToBounds="True"
               IsHitTestVisible="{Binding !HasGamepadOverlay}">
            <!-- Backdrop: the focused game's fan art, edge to edge behind everything. UniformToFill
                 overflows its bounds by design, so the Panel clips it to the content area (never over
                 the platform rail or window edges). -->
            <!-- Themed gradient base (dark base + an accent glow that fades). Always present so it
                 recolours with the ambient palette, stands in for games with no fan art, and shows
                 through while the fan art cross-fades over it. -->
            <Panel>
                <Border Background="{DynamicResource EmuLibraryBrush}" />
                <Border Background="{DynamicResource EmuAccentBrush}" Opacity="0.30">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="15%,0%" EndPoint="85%,100%">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Panel>
            <!-- Fan art, edge to edge over the gradient. A plain Image, NOT a cross-fading
                 TransitioningContentControl: the focused game's fan-art bitmap is disposed as focus
                 moves (to keep spotlight memory bounded), and a CrossFade keeps the *outgoing* bitmap
                 rendered during the fade — so it renders a disposed Bitmap and the render thread aborts
                 (SIGABRT in SkiaSharp). Restoring a cross-fade needs deferred disposal. See DECISIONS.
                 UniformToFill overflows by design; the backdrop Panel's ClipToBounds keeps it inside. -->
            <Image Source="{Binding FocusedGame.FanartImage}" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding FocusedGame.HasFanartImage}" />
            <!-- Legibility scrims: darken the bottom (title/actions) and the left (list). -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="0.80" Color="#8C000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#8C000000" />
                        <GradientStop Offset="0.44" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Foreground: floating list + hero content, inset from the screen edges. -->
            <Grid ColumnDefinitions="452,*" ColumnSpacing="36" Margin="52,24,52,22">
                <!-- Left: the game list. A translucent, floating card so the fan art reads through it
                     (the backdrop's left scrim keeps the titles legible). The palette surface sits on its
                     own layer at partial alpha — Opacity never touches the list content, so the titles
                     stay fully opaque — and that same filled layer casts the drop shadow and draws the
                     hairline stroke, lifting the card off the backdrop. -->
                <!-- Bottom margin matches the hero column's 10px inset, so the list card's lower edge
                     lines up with the action cluster's pills. -->
                <Border Grid.Column="0" Margin="0,0,0,10">
                    <Panel>
                        <Border CornerRadius="20" Background="{DynamicResource EmuPopoverBrush}" Opacity="0.72"
                                BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1"
                                BoxShadow="0 16 36 0 #85000000" />
                    <!-- The focused game's platform already shows in the top rail, so the list needs no
                         header of its own. -->
                    <!-- The vertical Margin (not Padding) holds a permanent gap between the card's
                         edge and the rows: padding lives inside the scroll extent, so mid-scroll rows
                         still kissed the card's top and bottom. -->
                    <ListBox x:Name="GamepadSpotlightList"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding FocusedGame, Mode=TwoWay}"
                             Margin="0,18"
                             Background="Transparent" BorderThickness="0" Padding="8,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="8,3" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
                                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter,
                                                 ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameViewModel">
                                    <TextBlock Text="{Binding DisplayTitle}" Margin="18,13"
                                               FontSize="{DynamicResource EmuGpBodySize}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </Border>

                <!-- Right: the hero — logo, metadata chips, rating, achievements, Play — over the
                     backdrop. The title itself is dropped: the logo carries the identity, and the
                     game name still shows in the left list. -->
                <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0,6,10"
                      RowDefinitions="Auto,Auto" RowSpacing="22">
                    <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Stretch">
                        <!-- Game logo (ScreenScraper wheel), centred. Capped so a wide/tall logo stays
                             contained, and given a soft drop shadow so the transparent art lifts off the
                             busy fan-art backdrop instead of blending in. -->
                        <Image Source="{Binding FocusedGame.WheelImage}" Stretch="Uniform"
                               MaxHeight="118" MaxWidth="440" HorizontalAlignment="Center"
                               Margin="0,0,0,4" IsVisible="{Binding FocusedGame.HasWheelImage}">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="22" OffsetX="0" OffsetY="6"
                                                  Opacity="0.7" />
                            </Image.Effect>
                        </Image>
                        <!-- Fallback identity: games with no logo art would otherwise show only chips,
                             so the title stands in for the logo. Scrolls itself when it is too long. -->
                        <controls:MarqueeTextBlock Text="{Binding FocusedGame.DisplayTitle}"
                                                   FontSize="{DynamicResource EmuGpDisplaySize}" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   IsVisible="{Binding FocusedGame.ShowSpotlightTitleFallback}" />
                        <!-- Scraped metadata as chips, split across two independently-centred rows:
                             genre / year / players on top, developer / publisher below. Two rows (not
                             one WrapPanel) because a WrapPanel left-packs its wrapped remainder, which
                             leaves a partial second line hugging the left instead of centred. The
                             second row hides itself when there is nothing to spill onto it. -->
                        <StackPanel Spacing="0" HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding FocusedGame.SpotlightFactsPrimary}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="spotlight-chip">
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource EmuGpLabelSize}"
                                                       FontWeight="SemiBold" Foreground="#F0FFFFFF" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding FocusedGame.SpotlightFactsSecondary}"
                                          HorizontalAlignment="Center"
                                          IsVisible="{Binding FocusedGame.HasSpotlightSecondaryFacts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="spotlight-chip">
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource EmuGpLabelSize}"
                                                       FontWeight="SemiBold" Foreground="#F0FFFFFF" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- The launch source (file/disc that A will run), a dim caption under the chips. -->
                        <TextBlock Text="{Binding FocusedGame.GamepadSubtitle}" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource EmuGpCaptionSize}" Foreground="#99FFFFFF"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <!-- Play activity (total time • times launched), shown only once the game has
                             been played so an unplayed hero keeps a clean single caption. -->
                        <TextBlock Text="{Binding FocusedGame.GamepadPlaytimeSummary}" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource EmuGpCaptionSize}" Foreground="#99FFFFFF"
                                   IsVisible="{Binding FocusedGame.HasGamepadPlaytime}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- The action cluster sits centred under the hero (matching the centred logo and
                         chips) instead of spanning edge to edge. Rating, Achievements and Play are each
                         sized to their own content and share the list card's translucent pill surface, so
                         the row reads as one balanced group with no dead space; a collapsed
                         rating/texture/achievement pill takes no room, so it stays centred. D-pad
                         Left/Right moves the accent focus ring between Achievements and Play (A fires the
                         armed one; Play is the default); Achievements is also clickable.
                         Because the cluster is content-sized it could outgrow a narrow (windowed) hero
                         column and clip Play, so it lives in a Viewbox: DownOnly keeps it at natural size
                         at real couch resolutions (Deck/TV, >=1280) and only shrinks it to fit when the
                         window is squeezed. ClipToBounds=False lets the focused action's ring (-5 margin)
                         and glow (12px blur) spill past the Viewbox instead of being clipped, so no inset
                         is needed and the pills' bottom edge stays flush with the list card. -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Center" ClipToBounds="False">
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Star rating. Content-sized, but held to a minimum so it stays legible and
                             keeps the cluster balanced next to the Play button. -->
                        <Panel MinWidth="118" VerticalAlignment="Center"
                               IsVisible="{Binding FocusedGame.HasRating}">
                            <Border Classes="spotlight-pill-fill" />
                            <Border Classes="spotlight-pill">
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Width="22" Height="22"
                                              Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"
                                              Foreground="{DynamicResource EmuAchievementBrush}" />
                                    <TextBlock Text="{Binding FocusedGame.RatingText}" FontSize="{DynamicResource EmuGpHeadingSize}"
                                               FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!-- Optional "texture pack installed" indicator; collapses when no pack is installed. -->
                        <Panel Width="64" VerticalAlignment="Center"
                               IsVisible="{Binding FocusedGame.ShowTextureMark}"
                               ToolTip.Tip="Texture pack installed">
                            <Border Classes="spotlight-pill-fill" />
                            <Border Classes="spotlight-pill">
                                <PathIcon Width="26" Height="26"
                                          Data="{StaticResource TexturePackLayersGeometry}"
                                          Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>

                        <!-- Achievements — armed with Left, opens on A or a click. Content-sized with its
                             trophy, count and progress bar centred, so it never stretches into dead space
                             or clips its own count/bar the way the old fill-the-middle column did. -->
                        <Panel Classes="spotlight-action"
                               Classes.focused="{Binding IsSpotlightAchievementsFocused}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding FocusedGame.ShowAchievementMark}">
                            <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                                    Margin="-5" CornerRadius="17"
                                    Background="{DynamicResource EmuAccentBrush}"
                                    BoxShadow="{DynamicResource EmuFocusGlow}" />
                            <Button Classes="spotlight-action-button"
                                    Command="{Binding OpenFocusedAchievementsCommand}"
                                    ToolTip.Tip="{Binding FocusedGame.AchievementsTooltip}">
                                <Panel>
                                    <Border Classes="spotlight-pill-fill" />
                                    <Border Classes="spotlight-pill">
                                        <StackPanel Orientation="Horizontal" Spacing="12"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                                    Background="{DynamicResource EmuFormatPillBrush}">
                                                <PathIcon Width="17" Height="17"
                                                          Data="{StaticResource AchievementTrophyGeometry}"
                                                          Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </Border>
                                            <!-- Softcore (silver) over hardcore (gold), both shown at once. -->
                                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding FocusedGame.GamepadAchievementCountText}"
                                                               FontSize="13" FontWeight="Bold" MinWidth="48"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                                                    <Border Width="120" Height="4" CornerRadius="2" ClipToBounds="True"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource EmuFormatPillBrush}">
                                                        <Border Background="{DynamicResource EmuAchievementSoftcoreBrush}"
                                                                RenderTransformOrigin="0%,50%">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding FocusedGame.GamepadAchievementProgressRatio}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding FocusedGame.GamepadHardcoreCountText}"
                                                               FontSize="13" FontWeight="Bold" MinWidth="48"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EmuAchievementBrush}" />
                                                    <Border Width="120" Height="4" CornerRadius="2" ClipToBounds="True"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource EmuFormatPillBrush}">
                                                        <Border Background="{DynamicResource EmuAchievementBrush}"
                                                                RenderTransformOrigin="0%,50%">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding FocusedGame.GamepadHardcoreProgressRatio}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Button>
                        </Panel>

                        <!-- Play — the default action. -->
                        <Panel Classes="spotlight-action"
                               Classes.focused="{Binding IsSpotlightPlayFocused}"
                               VerticalAlignment="Center">
                            <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                                    Margin="-5" CornerRadius="17"
                                    Background="{DynamicResource EmuAccentBrush}"
                                    BoxShadow="{DynamicResource EmuFocusGlow}" />
                            <Button Classes="gamepad-play-action" Width="176" HorizontalContentAlignment="Center"
                                    Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                                    Command="{Binding LaunchFocusedGameCommand}"
                                    IsEnabled="{Binding FocusedGame.IsAvailable}">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Border Classes="gamepad-key action-a" Width="32" Height="32">
                                        <TextBlock Text="A" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="PLAY" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Panel>
                    </StackPanel>
                    </Viewbox>
                    </Grid>
                </Grid>
        </Panel>

        <!-- ===================== Physical-media shelf (couch) layout =====================
             The GPU path is one bounded 3D world containing the focused medium and nearby games;
             ShelfPosition moves that world continuously through a fixed product-photography camera.
             If GL initialization fails, the old translated flat strip remains a complete fallback.
             The root is a Border (not a bare Panel) so the spotlight backdrop stays the sole top-level Panel.
             See docs/couch-physical-media-shelf.md. -->
        <Border x:Name="GamepadShelf" Grid.Row="0" Grid.RowSpan="3"
                IsVisible="{Binding ShowShelfTube}"
                ClipToBounds="True"
                IsHitTestVisible="{Binding !HasGamepadOverlay}">
            <Panel>
                <!-- Calm monochrome backdrop with an accent wash over it. The wash follows the focused
                     system while "Match colours to game artwork" is on, so the whole screen shifts
                     colour as you browse platforms; with the setting off it rests on the chosen
                     theme's accent, so moving the highlight recolours nothing. Two Borders rather
                     than one converter-driven brush: each source is a plain binding this way.

                     Only the no-GL fallback paints these. When the scene is up — in either mode, since
                     one renderer draws the shelf whether the effect is on or off — it resolves the
                     couch library colour itself and draws opaque over it, so a backdrop sheet here
                     would only be something to paint out. The
                     wrapping Panel carries the condition so each inner Border keeps its own plain
                     binding. Its top margin clears the platform rail (100px): the rail is an opaque
                     toolbar drawn in the couch root beneath this, and a full-height sheet painted it
                     out. -->
                <Panel IsVisible="{Binding ShowShelfFlatBackdrop}" Margin="0,100,0,0">
                    <Border Background="{DynamicResource EmuLibraryBrush}" />
                    <Border x:Name="ShelfPlatformAccentWash"
                            Background="{Binding FocusedGame.AccentColor}" Opacity="0.16"
                            IsVisible="{Binding AmbientThemeFromArtwork}" />
                    <Border x:Name="ShelfThemeAccentWash"
                            Background="{DynamicResource EmuAccentBrush}" Opacity="0.16"
                            IsVisible="{Binding !AmbientThemeFromArtwork}" />
                </Panel>

                <!-- Top margin clears the platform rail. The media host fills the WHOLE area and the
                     title/metadata is a bottom overlay on top of it, rather than a second grid row that
                     steals height from the scene. That split made the scene taller whenever HasGames was
                     briefly false during a platform switch (metadata collapsed) and shorter once it
                     returned — the shared GL surface resized, rebuilt, and the media visibly "popped big
                     then shrank" on every LB/RB. A single-cell layout keeps the scene viewport a constant
                     size, so the media stays put and stays large. -->
                <Grid Margin="0,112,0,0">
                    <!-- Coverflow strip viewport. GamepadShelfStrip is translated by the code-behind so
                         the focused slot lands on centre; the viewport's ClipToBounds hides the off-screen
                         covers. Slots are a uniform 410px wide (matching MainWindow.ShelfSlotWidth) so the
                         centring is exact arithmetic, independent of each cover's own aspect.
                         The strip itself must NOT clip: a Left-aligned child wider than its slot is arranged
                         to the viewport width, so a self-clip would cut off every cover whose translated
                         position lands past that width — i.e. the focused cover vanishes once you scroll a
                         few games in. The viewport Panel is the sole clipper. -->
                    <!-- Responsive host for the shared scene plus its flat no-GL fallback. The star
                         row gives physical media the available couch viewport while the title keeps
                         its own automatic row. -->
                    <!-- The media host fills all the way to the bottom so the 3D shadow can extend into
                         (and be seen behind) the title text below, rather than being clipped at a surface
                         edge above it. The title is an overlay drawn on top of this same scene. -->
                    <!-- Edge to edge: any inset here prints the flat root colour as stripes around the
                         scene's gradient backdrop. The rail band above is the one deliberate boundary,
                         and the shader's ramp starts at exactly the rail's fill so they meet without a
                         seam. -->
                    <Grid x:Name="GamepadShelfMediaHost">
                    <Panel x:Name="GamepadShelfViewport" ClipToBounds="True"
                           IsVisible="{Binding !ShelfSceneSupported}"
                           SizeChanged="OnGamepadShelfViewportSizeChanged">
                        <ItemsControl x:Name="GamepadShelfStrip" ItemsSource="{Binding Games}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ClipToBounds="False">
                            <ItemsControl.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.26" Easing="CubicEaseOut" />
                                </Transitions>
                            </ItemsControl.Transitions>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <!-- CompileBindings on: the shelf strip re-templates its focused item and
                                     neighbours every glide frame; compiling these bindings against the
                                     declared GameViewModel drops the reflection cost from that hot path. -->
                                <DataTemplate x:DataType="vm:GameViewModel" x:CompileBindings="True">
                                    <!-- Uniform-width slot; the cover is centred inside and scales with
                                         focus. Width MUST match MainWindow.ShelfSlotWidth (410). -->
                                    <Panel Classes="shelf-media" Classes.focused="{Binding IsFocused}"
                                           Width="410" VerticalAlignment="Center" ClipToBounds="False">
                                        <Border CornerRadius="10" IsHitTestVisible="False"
                                                IsVisible="{Binding !ShelfUses3DHero}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="{Binding GamepadShelfCoverWidth}"
                                                Height="{Binding GamepadShelfCoverHeight}"
                                                Background="{DynamicResource EmuCoverWellBrush}"
                                                BoxShadow="0 16 38 0 #8A000000" />
                                        <Border CornerRadius="10" ClipToBounds="True"
                                                IsVisible="{Binding !ShelfUses3DHero}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="{Binding GamepadShelfCoverWidth}"
                                                Height="{Binding GamepadShelfCoverHeight}"
                                                Background="{DynamicResource EmuCoverWellBrush}"
                                                AttachedToVisualTree="OnGameCoverAttached"
                                                DataContextChanged="OnGameCoverDataContextChanged">
                                            <Panel>
                                                <Grid Classes="cover-placeholder" Classes.covered="{Binding HasCoverImage}"
                                                      RowDefinitions="6,*" Background="{DynamicResource EmuCoverWellBrush}">
                                                    <Border Grid.Row="0" Background="{Binding AccentColor}" />
                                                    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Width="96" Height="96" CornerRadius="48"
                                                            Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                        <Image Width="66" Height="66" Source="{Binding PlatformArtwork}"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                </Grid>
                                                <Image Source="{Binding CoverImage}" Classes="cover-image"
                                                       Classes.loaded="{Binding HasCoverImage}"
                                                       Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>

                    <!-- The in-place 3D shelf: the preferred effect-off renderer. Unlike the tube at
                         the window root, this one sits inside the shelf's own slot, so the couch UI
                         stacks around it for free — the rail above, the title below, any overlay over
                         it — as live Avalonia, with no capture and a redraw only when the shelf itself
                         moves. It has no ChromeSource for exactly that reason, and renders opaque over
                         its own backdrop so it does not depend on the GL surface being alpha-blended
                         into the window. Its support is tracked separately (InlineSceneSupported): if
                         it cannot bring up GL — the Steam Deck — its failure disables only this path
                         (OnGamepadInlineShelfFailed), and the effect-off shelf falls back to the tube
                         drawn flat rather than dropping every model to flat covers. With the effect on
                         this stays hidden and the window-covering tube draws the shelf. -->
                    <controls:MediaShelf3DHost x:Name="GamepadShelfInlineScene"
                                               IsHitTestVisible="False"
                                               IsVisible="{Binding ShowInlineShelfScene}"
                                               IsActive="{Binding ShowInlineShelfScene}"
                                               IsSceneSupported="{Binding InlineSceneSupported}"
                                               Crt="{Binding InlineShelfCrt}"
                                               FrameFillScale="{Binding ShelfFillScale}"
                                               TintBackdropWithAccent="False"
                                               Items="{Binding ShelfSceneItems}"
                                               FocusedItem="{Binding FocusedGame}"
                                               ShelfPosition="{Binding ShelfPosition}"
                                               Yaw="{Binding ShelfHeroYaw}"
                                               Pitch="{Binding ShelfHeroPitch}"
                                               DeparturePose="{Binding ShelfDeparturePose}"
                                               LaunchPose="{Binding ShelfLaunchPose}"
                                               InitializationFailed="OnGamepadInlineShelfFailed" />
                    </Grid>

                    <!-- Focused game's title + achievements, overlaid tight against the bottom of the shelf
                         (the dock is hidden here). Bottom-aligned overlay, not a grid row, so it never
                         resizes the scene. The platform name is dropped here — the rail already shows the
                         active platform — which frees vertical room for the media. -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,24"
                                HorizontalAlignment="Center" Spacing="4" IsVisible="{Binding HasGames}">
                        <TextBlock Text="{Binding FocusedGame.DisplayTitle}" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource EmuGpTitleSize}" FontWeight="Bold"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <!-- Achievements whisper line: a silver (softcore) then gold (hardcore) trophy,
                             each with its unlock count. No bars — the shelf keeps the calm, so this is the
                             glyph-and-count reduction of the spotlight dock. Collapses whole for games with
                             no RetroAchievements support, so non-RA titles add no third line. -->
                        <!-- Reserve the whisper line's height whether or not it is shown, so the title
                             above it keeps a constant baseline as focus moves between games with and
                             without an achievement mark. -->
                        <Panel Height="22" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18"
                                    VerticalAlignment="Center" IsVisible="{Binding FocusedGame.ShowAchievementMark}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                          Data="{StaticResource AchievementTrophyGeometry}"
                                          Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                                <TextBlock Text="{Binding FocusedGame.GamepadAchievementCountText}"
                                           FontSize="{DynamicResource EmuGpCaptionSize}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                          Data="{StaticResource AchievementTrophyGeometry}"
                                          Foreground="{DynamicResource EmuAchievementBrush}" />
                                <TextBlock Text="{Binding FocusedGame.GamepadHardcoreCountText}"
                                           FontSize="{DynamicResource EmuGpCaptionSize}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuAchievementBrush}" />
                            </StackPanel>
                        </StackPanel>
                        </Panel>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>

        <!-- One in-window host owns all controller input while open. No Gamepad workflow opens a child window.
             ZIndex 2 keeps the scrim and its overlay above the elevated toast/save-sync layer (ZIndex 1). -->
        <Grid Grid.RowSpan="3" ZIndex="2" Classes="gamepad-scrim" IsHitTestVisible="{Binding HasGamepadOverlay}" Background="#B9000000">
            <!-- The panel is the overlay's height budget: it keeps a margin off the screen edges,
                 and the overlay's MaxHeight tracks it so a 720p or windowed viewport shrinks the
                 sheet instead of clipping it. Height is the preferred size, not the actual one. -->
            <Panel x:Name="GamepadOverlayHost" Margin="36">
            <Border Classes="gamepad-overlay" Classes.system-menu="{Binding IsGamepadSystemMenuOpen}"
                    Classes.side-sheet="{Binding IsGameActionsOpen}"
                    Classes.achievements="{Binding IsGamepadAchievementsOpen}"
                    Classes.scraper="{Binding IsGamepadScraperOpen}"
                    Classes.batch-scraper="{Binding IsGamepadBatchScraperOpen}"
                    Classes.settings="{Binding IsGamepadSettingsOpen}"
                    Classes.hotkeys="{Binding IsGamepadHotkeysOpen}"
                    Classes.confirmation="{Binding IsGamepadConfirmationOverlay}"
                    VerticalAlignment="Center"
                    MaxHeight="{Binding #GamepadOverlayHost.Bounds.Height}"
                    MaxWidth="{Binding #GamepadOverlayHost.Bounds.Width}"
                    Padding="28" CornerRadius="16" Background="{DynamicResource EmuPopoverBrush}"
                    BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <Grid>
                        <Grid IsVisible="{Binding IsGamepadAchievementsOpen}"
                              ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Achievements" FontSize="26" FontWeight="Bold" />
                                <TextBlock Text="{Binding GamepadAchievementDetails.GameTitle}"
                                           FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                            <!-- Same two-row stat block as the desktop card: softcore (silver) over
                                 hardcore (gold), each with count, bar, and its own points aligned in
                                 shared columns. -->
                            <Border Grid.Column="1" Padding="18,14" CornerRadius="14"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource EmuFormatPillBrush}">
                                <Grid ColumnDefinitions="Auto,200,Auto" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="16" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding GamepadAchievementDetails.ProgressText}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                                    <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0"
                                                 Maximum="{Binding GamepadAchievementDetails.ProgressMaximum}"
                                                 Value="{Binding GamepadAchievementDetails.UnlockedCount}"
                                                 Height="7" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" MinWidth="110"
                                               Text="{Binding GamepadAchievementDetails.PointsText}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding GamepadAchievementDetails.HardcoreProgressText}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuAchievementBrush}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0"
                                                 Maximum="{Binding GamepadAchievementDetails.ProgressMaximum}"
                                                 Value="{Binding GamepadAchievementDetails.HardcoreUnlockedCount}"
                                                 Height="7" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource EmuAchievementBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" MinWidth="110"
                                               Text="{Binding GamepadAchievementDetails.HardcorePointsText}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource EmuAchievementBrush}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel IsVisible="{Binding ShowsGamepadOverlayChromeTitle}" Spacing="6">
                            <TextBlock Text="{Binding GamepadOverlayTitle}"
                                       FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock IsVisible="{Binding HasGamepadOverlayEyebrow}"
                                       Text="{Binding GamepadOverlayEyebrow, Converter={x:Static vm:TextConverters.Uppercase}}"
                                       FontSize="12" FontWeight="Bold" LetterSpacing="3"
                                       Foreground="{DynamicResource EmuAccentBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                        <!-- System-menu body: the View mode / Sort picker and the option list share ONE
                             scroll region so a short couch panel (e.g. the AYN Thor at ~396dip usable
                             height) scrolls to every entry instead of starving the option row to zero and
                             hiding Settings/Quit. The same scroller carries the options for the disc /
                             actions / import overlays too — its header is gated to the system menu, so those
                             overlays see just the option list. Kept on Grid.Row=1 so the disc/actions
                             overlays stay pixel-for-pixel where they were (Row 0 is empty for them). -->
                        <ScrollViewer x:Name="GamepadOverlayOptionsScroller" Grid.Row="1" Classes="gamepad-scroll"
                                      VerticalScrollBarVisibility="Auto"
                                      MinHeight="{Binding GamepadOverlayOptionsMinHeight}"
                                      IsVisible="{Binding ShowsGamepadOverlayOptions}">
                        <!-- Right inset reserves the scroll gutter for BOTH the picker and the options, so
                             the thumb never overlaps the rightmost picker card when the menu scrolls. -->
                        <StackPanel Spacing="12" Margin="0,0,18,0">
                        <!-- Couch layout picker at the top of the start menu, gated to the system menu.
                             The active mode is filled; the pair lights up when the controller ring is on
                             the row. -->
                        <StackPanel x:Name="GamepadSystemMenuPicker" IsVisible="{Binding IsGamepadSystemMenuOpen}"
                                    Spacing="9" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="VIEW MODE" FontSize="12" FontWeight="Bold"
                                           LetterSpacing="2.4"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LibraryCountText}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </Grid>
                            <Border x:Name="GamepadViewModeRow" Classes="gamepad-viewmode-row"
                                    Classes.focused="{Binding IsGamepadViewModeRowFocused}">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Button Grid.Column="0" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsGridViewModeSelected}"
                                            Command="{Binding SelectGridViewModeCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <PathIcon Grid.Column="0" Width="18" Height="18"
                                                      Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
                                            <TextBlock Grid.Column="1" Text="Grid" VerticalAlignment="Center"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsListViewModeSelected}"
                                            Command="{Binding SelectListViewModeCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <PathIcon Grid.Column="0" Width="18" Height="18"
                                                      Data="M2,3 H18 V6 H2 Z M2,8.5 H18 V11.5 H2 Z M2,14 H18 V17 H2 Z" />
                                            <TextBlock Grid.Column="1" Text="List" VerticalAlignment="Center"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="2" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsShelfViewModeSelected}"
                                            Command="{Binding SelectShelfViewModeCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <!-- A cartridge/case silhouette: a rounded body with a label band. -->
                                            <PathIcon Grid.Column="0" Width="18" Height="18"
                                                      Data="M5,1 H15 V19 H5 Z M5,5 H15 M7,1 V5 M13,1 V5" />
                                            <TextBlock Grid.Column="1" Text="Shelf" VerticalAlignment="Center"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SORT BY" FontSize="12" FontWeight="Bold"
                                           LetterSpacing="2.4"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <!-- Current direction (always shown) plus the A=Reverse affordance, which
                                     appears only while the sort row owns focus (A reverses only there). -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <!-- Always laid out, and only faded in. The A pill is taller than
                                         the text beside it, so making it appear on focus grew this
                                         header by nine pixels and pushed the sort row and the entire
                                         options list down with it — the menu moved under the player on
                                         every d-pad press between rows, and back up on the way out.
                                         It sits BEFORE the direction chip so the chip stays flush with
                                         the panel's right edge instead of drifting toward the centre. -->
                                    <StackPanel Orientation="Horizontal" Spacing="7"
                                                Classes="gamepad-sort-reverse-hint"
                                                Classes.focused="{Binding IsGamepadSortRowFocused}">
                                        <Border Classes="gamepad-key action-a">
                                            <TextBlock Text="A" />
                                        </Border>
                                        <TextBlock Text="Reverse" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource EmuSegmentBrush}"
                                            BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding GamepadSortDirectionArrow}" FontSize="14"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuAccentBrush}" />
                                            <TextBlock Text="{Binding GamepadSortDirectionSummary}" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <!-- Sort row: same gamepad-viewmode-row / -card component as View mode above,
                                 four cards across one row so Up/Down move between menu sections (exactly
                                 like the View-mode row) and Left/Right step through the sorts. Each card
                                 drives the shared SortColumn via SelectGamepadSortCommand; the selected card
                                 is filled by the .selected accent wash. Labels are short so all four fit the
                                 row — the full name is on the tooltip / automation name. -->
                            <Border x:Name="GamepadSortRow" Classes="gamepad-viewmode-row"
                                    Classes.focused="{Binding IsGamepadSortRowFocused}">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Button Grid.Column="0" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsGamepadSortRecentlyPlayedSelected}"
                                            Command="{Binding SelectGamepadSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySortColumn.LastPlayed}"
                                            ToolTip.Tip="Recently played" AutomationProperties.Name="Recently played">
                                        <TextBlock Text="Played" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsGamepadSortRecentlyAddedSelected}"
                                            Command="{Binding SelectGamepadSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySortColumn.DateAdded}"
                                            ToolTip.Tip="Recently added" AutomationProperties.Name="Recently added">
                                        <TextBlock Text="Added" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsGamepadSortTitleSelected}"
                                            Command="{Binding SelectGamepadSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySortColumn.Title}"
                                            ToolTip.Tip="Title A–Z" AutomationProperties.Name="Title A to Z">
                                        <TextBlock Text="A–Z" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="gamepad-viewmode-card"
                                            Classes.selected="{Binding IsGamepadSortRatingSelected}"
                                            Command="{Binding SelectGamepadSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySortColumn.Rating}"
                                            ToolTip.Tip="Rating" AutomationProperties.Name="Rating">
                                        <TextBlock Text="Rating" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Height="1" Background="{DynamicResource EmuBorderBrush}" />
                        </StackPanel>
                            <ItemsControl x:Name="GamepadOverlayOptions" Classes="gamepad-overlay-options"
                                          Classes.top-aligned="{Binding AreGamepadOverlayOptionsTopAligned}"
                                          ItemsSource="{Binding GamepadOverlayPrimaryOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamepadOverlayOptionViewModel">
                                        <Button Classes="gamepad-modal-option"
                                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                Classes.focused="{Binding IsFocused}" Command="{Binding Command}">
                                            <StackPanel Orientation="Horizontal" Spacing="15">
                                                <PathIcon Width="20" Height="20" Data="{Binding Icon}"
                                                          IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                        <!-- Destructive zone: Remove / Quit live OUTSIDE the scroller, pinned above the
                             hint legend behind a hairline — always visible (never under a scroll fold)
                             and always a deliberate reach past the safe rows. -->
                        <StackPanel Grid.Row="2" IsVisible="{Binding ShowsGamepadDestructiveZone}">
                            <Border Height="1" Margin="6,0,24,8" Background="{DynamicResource EmuBorderBrush}" />
                            <!-- Named so RevealGamepadOverlayFocus can move keyboard focus onto these rows
                                 too: the reveal walks BOTH option lists, and a row that never took focus
                                 would leave the last focused primary row lit by :focus alongside it. -->
                            <ItemsControl x:Name="GamepadOverlayDestructiveOptions"
                                          ItemsSource="{Binding GamepadOverlayDestructiveOptions}" Margin="0,0,18,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamepadOverlayOptionViewModel">
                                        <Button Classes="gamepad-modal-option destructive"
                                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                Classes.focused="{Binding IsFocused}" Command="{Binding Command}">
                                            <StackPanel Orientation="Horizontal" Spacing="15">
                                                <PathIcon Width="20" Height="20" Data="{Binding Icon}"
                                                          IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Grid.RowSpan="3" IsVisible="{Binding IsGamepadAchievementsOpen}"
                              RowDefinitions="Auto,*" RowSpacing="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsAllFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.AllFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowAllAchievementsCommand}" />
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsLockedFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.LockedFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowLockedAchievementsCommand}" />
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsUnlockedFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.UnlockedFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowUnlockedAchievementsCommand}" />
                                </StackPanel>
                                <!-- Sort and Refresh sit together on the right of the filter row so the
                                     two commands read as one group instead of floating on separate rows. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                    <Button Classes="gamepad-achievement-command"
                                            Command="{Binding CycleGamepadAchievementSortCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="gamepad-key action-y"><TextBlock Text="Y" /></Border>
                                            <TextBlock Text="Sort:" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding GamepadAchievementDetails.SortText}"
                                                       VerticalAlignment="Center" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="gamepad-achievement-command"
                                            Command="{Binding GamepadAchievementDetails.RefreshCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="gamepad-key action-x"><TextBlock Text="X" /></Border>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="24"
                                  IsVisible="{Binding GamepadAchievementDetails.HasVisibleAchievements}">
                                <!-- The preview hugs its content (Top, not the column's full height):
                                     stretching it left a card-sized well of dead space under the
                                     text, since the detail is only ever a few short lines. -->
                                <Border Classes="gamepad-achievement-detail" VerticalAlignment="Top">
                                    <Grid>
                                        <StackPanel IsVisible="{Binding HasFocusedGamepadAchievement}"
                                                    Spacing="14">
                                            <!-- Badge + the achievement's stats side by side; the three
                                                 stacked lines are sized to land within the badge's 96px.
                                                 Title and description then get the card's FULL width on
                                                 their own rows below, instead of the ~180px strip beside
                                                 the badge that ellipsized both. -->
                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                                                <Border Width="96" Height="96" CornerRadius="15"
                                                        Classes="gamepad-achievement-badge-frame"
                                                        Classes.hardcore="{Binding FocusedGamepadAchievement.IsHardcore}"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource EmuCoverWellBrush}">
                                                    <Grid Classes="gamepad-achievement-badge"
                                                          Classes.locked="{Binding FocusedGamepadAchievement.IsLocked}">
                                                        <PathIcon Width="32" Height="32"
                                                                  IsVisible="{Binding !FocusedGamepadAchievement.HasBadge}"
                                                                  Data="{StaticResource AchievementTrophyGeometry}"
                                                                  Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                        <Image Source="{Binding FocusedGamepadAchievement.Badge}"
                                                               IsVisible="{Binding FocusedGamepadAchievement.HasBadge}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="7"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <Border Padding="10,4" CornerRadius="12"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource EmuFormatPillBrush}">
                                                        <TextBlock Text="{Binding FocusedGamepadAchievement.PointsText}"
                                                                   FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Padding="10,4" CornerRadius="12"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource EmuFormatPillBrush}">
                                                        <TextBlock Text="{Binding FocusedGamepadAchievement.UnlockStateText}"
                                                                   FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <!-- Wraps rather than trims: the month name is
                                                         culture-dependent, so this line has no width
                                                         it can be guaranteed to fit on. -->
                                                    <TextBlock Text="{Binding FocusedGamepadAchievement.EarnedText}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="6">
                                                <!-- Line budgets cover the field limits RetroAchievements
                                                     itself enforces (64-char title, 255-char description)
                                                     at this width, so the trim only ever fires on text the
                                                     service could not have served. They are set against
                                                     the WIDEST shipped font stack, not the local one: the
                                                     same 64-char title wraps to three lines on macOS and
                                                     four on the Linux runner, so budgets sized to what
                                                     macOS needs would clip elsewhere. -->
                                                <TextBlock Text="{Binding FocusedGamepadAchievement.Title}"
                                                           FontSize="21" FontWeight="Bold"
                                                           TextWrapping="Wrap" MaxLines="5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FocusedGamepadAchievement.Description}"
                                                           FontSize="14" TextWrapping="Wrap" MaxLines="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row-virtualized grid: a ListBox renders one ROW per line and its
                                     VirtualizingStackPanel realizes only the on-screen rows. Each row
                                     holds exactly GamepadAchievementColumnCount tiles, so the rendered
                                     column count always equals the navigation stride, and it has none of
                                     the phantom-cell / top-left-hole defects a virtualized
                                     UniformGridLayout had (which dropped achievement tiles). The ListBox
                                     is a passive renderer — the focus ring is driven by IsFocused on the
                                     flat VisibleAchievements list, not its selection — so its
                                     selection/focus visuals are styled away below. -->
                                <ListBox x:Name="GamepadAchievementRowList" Grid.Column="1"
                                         ItemsSource="{Binding GamepadAchievementRows}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         SizeChanged="OnGamepadAchievementsSizeChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FocusAdorner" Value="{x:Null}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter,
                                                         ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- One row of badge tiles. 6px side padding gives the first/last
                                                 tile's focus frame room inside the row container; 12px gutters
                                                 match the old grid. ClipToBounds="False" on the row and its
                                                 StackPanel is what lets the focus ring's 6px vertical overflow
                                                 (Margin="-6") render past the tile-height row box — without it
                                                 the ring is clipped flat at the tile's top and bottom edges,
                                                 exactly as the library grid guards against. -->
                                            <ItemsControl ItemsSource="{Binding}" Margin="0,6,0,6" Padding="6,0,6,0"
                                                          ClipToBounds="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" ClipToBounds="False" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AchievementRowViewModel">
                                                        <Panel Classes="gamepad-achievement-tile"
                                                               Classes.focused="{Binding IsFocused}"
                                                               ClipToBounds="False" Focusable="True"
                                                               AttachedToVisualTree="OnGamepadAchievementAttached"
                                                               DataContextChanged="OnGamepadAchievementDataContextChanged">
                                                            <!-- Same accent frame as the library grid: a solid pad
                                                                 BEHIND the tile, 6px larger with a concentric radius
                                                                 (14 + 6), so the opaque tile masks its centre and it
                                                                 reads as an even 6px accent frame. Must stay
                                                                 first/bottom-most; shown by opacity on .focused. -->
                                                            <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                                                                    Margin="-6" CornerRadius="20"
                                                                    Background="{DynamicResource EmuAccentBrush}"
                                                                    BoxShadow="{DynamicResource EmuFocusGlow}" />
                                                            <Border Classes="gamepad-achievement"
                                                                    Classes.hardcore="{Binding IsHardcore}">
                                                                <Grid Classes="gamepad-achievement-badge"
                                                                      Classes.locked="{Binding IsLocked}">
                                                                    <PathIcon Width="30" Height="30"
                                                                              IsVisible="{Binding !HasBadge}"
                                                                              Data="{StaticResource AchievementTrophyGeometry}"
                                                                              Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    <Image Source="{Binding Badge}" IsVisible="{Binding HasBadge}"
                                                                           Stretch="UniformToFill" />
                                                                </Grid>
                                                            </Border>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Grid.Row="1"
                                    IsVisible="{Binding GamepadAchievementDetails.HasFilteredEmptyState}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="24,20" CornerRadius="12"
                                    Background="{DynamicResource EmuCardBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding GamepadAchievementDetails.FilterEmptyStateText}"
                                           FontSize="18" FontWeight="SemiBold" />
                            </Border>

                            <Border Grid.Row="1"
                                    IsVisible="{Binding !GamepadAchievementDetails.HasAchievements}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="390" Padding="24,20" CornerRadius="12"
                                    Background="{DynamicResource EmuCardBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <ProgressBar IsVisible="{Binding GamepadAchievementDetails.IsRefreshing}"
                                                 IsIndeterminate="True" Height="4" />
                                    <TextBlock Text="{Binding GamepadAchievementDetails.EmptyStateTitle}"
                                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding GamepadAchievementDetails.EmptyStateDescription}"
                                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadSettingsOpen}"
                              ColumnDefinitions="1*,3*" ColumnSpacing="26">
                            <Border Grid.Column="0" Padding="16" CornerRadius="14"
                                    Background="{DynamicResource EmuWindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource EmuBorderBrush}" />
                                    <!-- The rail can hold up to nine sections; scroll it (with the selected
                                         section brought into view from code-behind) so it never overflows the
                                         column at 1280×720 or clips the About entry behind Save. -->
                                    <!-- Hidden (not Auto) scrollbar: the couch pages sections with LB/RB and
                                         the selection is always scrolled into view, so a bar would only inset
                                         the buttons from the full-width Save action below. -->
                                    <ScrollViewer Grid.Row="2" x:Name="GamepadSettingsNavScroller"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <Button Grid.Row="0" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsGeneralSection}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.General}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsGeneralSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Library" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.LibraryRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.LibraryRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="1" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsEmulatorsSection}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.Emulators}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsEmulatorsSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Emulators" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Classes.warning="{Binding GamepadSettings.IsEmulatorsRailWarning}" Text="{Binding GamepadSettings.EmulatorsRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.EmulatorsRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="2" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsHotkeysSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasHotkeys}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.Hotkeys}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsHotkeysSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Hotkeys" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.HotkeysRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.HotkeysRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="3" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsRetroAchievementsSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasRetroAchievements}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.RetroAchievements}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsRetroAchievementsSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="RetroAchievements" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.RetroAchievementsRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.RetroAchievementsRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="4" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsArtworkMetadataSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasScreenScraper}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.ArtworkMetadata}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsArtworkMetadataSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Artwork &amp; Metadata" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.ArtworkRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.ArtworkRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="5" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsSavesSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasCloudSaves}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.Saves}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsSavesSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Saves" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.SavesRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.SavesRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="6" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsTexturePacksSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasTexturePacks}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.TexturePacks}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsTexturePacksSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Texture Packs" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.TexturePacksRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.TexturePacksRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <!-- Themes sits in Desktop's slot — right before About — so both surfaces read
                                             top-to-bottom identically. About stays the always-visible last row. -->
                                        <Button Grid.Row="7" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsThemesSection}"
                                                IsVisible="{Binding GamepadSettings.ShowThemes}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectThemesCommand}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsThemesSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="Themes" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.ThemesRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.ThemesRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="8" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsAboutSection}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.About}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsAboutSection}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="About" />
                                                    <TextBlock Classes="gamepad-settings-nav-status" Text="{Binding GamepadSettings.AboutRailStatus}"
                                                               IsVisible="{Binding GamepadSettings.AboutRailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    </ScrollViewer>
                                    <Button x:Name="GamepadSettingsSaveButton" Grid.Row="3"
                                            Classes="gamepad-settings-save"
                                            Classes.focused="{Binding GamepadSettings.SaveRow.IsFocused}"
                                            IsEnabled="{Binding GamepadSettings.SaveRow.IsEnabled}"
                                            Command="{Binding GamepadSettings.SaveRow.SelectCommand}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Classes="gamepad-key"><TextBlock Text="START" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Save and close" FontWeight="Bold" />
                                                <TextBlock Text="Apply changes" FontSize="13"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16"
                                  Classes.rail-dimmed="{Binding GamepadSettings.IsRailFocused}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding GamepadSettings.SectionTitle}"
                                                   FontSize="26" FontWeight="Bold" />
                                        <TextBlock Text="{Binding GamepadSettings.SectionDescription}"
                                                   FontSize="15" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding GamepadSettings.HasStatus}"
                                            MaxWidth="430" Padding="14,9" CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource EmuFormatPillBrush}"
                                            BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding GamepadSettings.StatusText}"
                                                       FontSize="14" TextWrapping="Wrap" MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <!-- Section-scoped "working" bar so long actions (rescan, sync,
                                                 refresh, scan) don't sit on a static line the way they used
                                                 to; hides on completion, leaving the outcome text. -->
                                            <ProgressBar IsIndeterminate="True" Height="3"
                                                         IsVisible="{Binding GamepadSettings.IsWorkingInSection}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="GamepadSettingsScroller"
                                                  IsVisible="{Binding GamepadSettings.IsRowsVisible}"
                                                  Classes="gamepad-scroll"
                                                  SizeChanged="OnGamepadSettingsScrollerSizeChanged"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsRepeater x:Name="GamepadSettingsRows"
                                                       HorizontalAlignment="Left"
                                                       ItemsSource="{Binding GamepadSettings.Rows}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GamepadSettingsRowViewModel">
                                                    <Panel>
                                                        <!-- Non-focusable platform group header: artwork + name give the
                                                             section a visible hierarchy over a flat list of equal rows. -->
                                                        <Grid IsVisible="{Binding IsHeader}"
                                                              ColumnDefinitions="Auto,*" ColumnSpacing="16"
                                                              Margin="18,16,0,8">
                                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                                    IsVisible="{Binding HasPlatformIcon}"
                                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                                <Image Width="30" Height="30"
                                                                       Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                                       RenderOptions.BitmapInterpolationMode="None" />
                                                            </Border>
                                                            <!-- Generic group (sign-in / advanced): an accent bar stands in for the
                                                                 missing artwork so the header reads as a clear group divider, and the
                                                                 label is accent-coloured to separate it from ordinary rows. -->
                                                            <Border Grid.Column="0" Width="5" Height="26" CornerRadius="3"
                                                                    IsVisible="{Binding !HasPlatformIcon}"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource EmuAccentBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15"
                                                                       FontWeight="Bold" LetterSpacing="0.4" VerticalAlignment="Center"
                                                                       IsVisible="{Binding HasPlatformIcon}"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15"
                                                                       FontWeight="Bold" LetterSpacing="0.6" VerticalAlignment="Center"
                                                                       IsVisible="{Binding !HasPlatformIcon}"
                                                                       Foreground="{DynamicResource EmuAccentBrush}" />
                                                        </Grid>

                                                        <Button Classes="gamepad-settings-row"
                                                                Classes.focused="{Binding IsFocused}"
                                                                Classes.destructive="{Binding IsDestructive}"
                                                                Classes.info="{Binding IsInformation}"
                                                                Classes.grouped="{Binding IsGrouped}"
                                                                Classes.compact="{Binding IsCompact}"
                                                                Classes.summary="{Binding IsSummary}"
                                                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                                IsVisible="{Binding IsNormalRow}"
                                                                IsEnabled="{Binding IsEnabled}"
                                                                HorizontalAlignment="Stretch"
                                                                AutomationProperties.AutomationId="{Binding ParityId}"
                                                                Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                                            <!-- Leading icon: platform artwork for platform-scoped rows,
                                                                 otherwise a glyph that categorises the row. Read-only info
                                                                 rows stay icon-free so inventory reads as a light list. -->
                                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding !IsInformation}"
                                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                                <Panel>
                                                                    <Image Width="30" Height="30"
                                                                           IsVisible="{Binding HasPlatformIcon}"
                                                                           Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                                           RenderOptions.BitmapInterpolationMode="None" />
                                                                    <TextBlock IsVisible="{Binding !HasPlatformIcon}"
                                                                               Text="{Binding LeadingGlyph}" FontSize="19"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                </Panel>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="{Binding Label}" FontSize="17"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                <!-- Compact rows (Emulators) keep the description to one state-first
                                                                     line; a row reporting a problem (emulator missing, Shizuku grant
                                                                     absent) paints it in the warning colour so it reads at a glance. -->
                                                                <TextBlock Text="{Binding Description}" FontSize="14"
                                                                           IsVisible="{Binding HasDescription}"
                                                                           Classes.warning="{Binding IsWarning}"
                                                                           TextWrapping="Wrap" MaxLines="{Binding DescriptionMaxLines}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                            </StackPanel>

                                                            <!-- Platform summary: "emulator · N games" on the right and a chevron that
                                                                 turns when the platform's rows are expanded beneath it. -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                                                        IsVisible="{Binding IsSummary}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}" FontSize="14" MaxWidth="420"
                                                                           Classes.warning="{Binding IsWarning}"
                                                                           VerticalAlignment="Center" TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding SummaryChevron}" FontSize="22" Width="18"
                                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuAccentBrush}" />
                                                            </StackPanel>

                                                            <Border Grid.Column="2" Classes="gamepad-settings-switch"
                                                                    Classes.on="{Binding IsToggleOn}"
                                                                    IsVisible="{Binding IsToggle}"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Value}"
                                                                               IsVisible="{Binding !IsToggleOn}"
                                                                               Margin="0,0,14,0" HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding Value}"
                                                                               IsVisible="{Binding IsToggleOn}"
                                                                               Margin="14,0,0,0" HorizontalAlignment="Left"
                                                                               VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                                    <Border Width="40" Height="40" Margin="4"
                                                                            IsVisible="{Binding !IsToggleOn}"
                                                                            HorizontalAlignment="Left" CornerRadius="20"
                                                                            Background="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    <Border Width="40" Height="40" Margin="4"
                                                                            IsVisible="{Binding IsToggleOn}"
                                                                            HorizontalAlignment="Right" CornerRadius="20"
                                                                            Background="{DynamicResource EmuAccentBrush}">
                                                                        <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Column="2" Classes="gamepad-settings-affordance"
                                                                    IsVisible="{Binding IsChoice}"
                                                                    VerticalAlignment="Center" MinWidth="250">
                                                                <!-- Both arrows are real controls: Left/Right select adjacent
                                                                     values, while A opens the complete labelled choice list. -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <TextBlock Grid.Column="0" Text="‹" FontSize="24" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuAccentBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               TextAlignment="Center" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuAccentBrush}" />
                                                                </Grid>
                                                            </Border>

                                                            <Grid Grid.Column="2" IsVisible="{Binding IsEditableValue}"
                                                                  MaxWidth="380" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                                                  VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                                                                           TextAlignment="Right" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <Border Grid.Column="1" Classes="gamepad-settings-action-button">
                                                                    <TextBlock Text="{Binding ActionGlyph}" FontSize="24" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- When an action is running the row disables; show its working
                                                                 label ("CONNECTING…", "SCANNING…") beside the circle so the
                                                                 feedback sits on the row the user just pressed A on, not only
                                                                 in the far-away status pill. -->
                                                            <Grid Grid.Column="2" IsVisible="{Binding IsAction}"
                                                                  ColumnDefinitions="Auto,Auto" ColumnSpacing="12"
                                                                  VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="{Binding ActionButtonText}"
                                                                           IsVisible="{Binding ShowsWorkingLabel}"
                                                                           VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <Border Grid.Column="1" Classes="gamepad-settings-action-button">
                                                                    <TextBlock Text="{Binding ActionGlyph}" FontSize="24" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Grid.Column="2" IsVisible="{Binding IsInformation}"
                                                                       Text="{Binding Value}" MaxWidth="390"
                                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                                       TextWrapping="Wrap" MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </Grid>
                                                    </Button>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <Grid IsVisible="{Binding GamepadSettings.IsThemesVisible}"
                                          RowDefinitions="Auto,Auto,*" RowSpacing="16">
                                        <!-- Ambient (cover-art recolour) toggle: a focus target above the
                                             theme grid so the setting is reachable on a controller. Up from
                                             the top grid row lands here; A toggles it. -->
                                        <!-- CRT toggle: the topmost focus target in the Themes view
                                             (the -2 sentinel), above the ambient toggle. -->
                                        <Button Grid.Row="0" Classes="gamepad-settings-row"
                                                Classes.focused="{Binding GamepadSettings.IsCrtToggleFocused}"
                                                IsVisible="{Binding GamepadSettings.IsThemesVisible}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding GamepadSettings.ToggleCrtCommand}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="CRT screen effect" FontSize="17"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="Show the shelf through a curved, scanned picture tube. Costs GPU time and keeps the shelf redrawing."
                                                               FontSize="14" TextWrapping="Wrap" MaxLines="2"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="gamepad-settings-switch"
                                                        Classes.on="{Binding GamepadSettings.CrtScreenEffect}"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="OFF" IsVisible="{Binding !GamepadSettings.CrtScreenEffect}"
                                                                   Margin="0,0,14,0" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                        <TextBlock Text="ON" IsVisible="{Binding GamepadSettings.CrtScreenEffect}"
                                                                   Margin="14,0,0,0" HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                        <Border Width="40" Height="40" Margin="4"
                                                                IsVisible="{Binding !GamepadSettings.CrtScreenEffect}"
                                                                HorizontalAlignment="Left" CornerRadius="20"
                                                                Background="{DynamicResource EmuTextTertiaryBrush}" />
                                                        <Border Width="40" Height="40" Margin="4"
                                                                IsVisible="{Binding GamepadSettings.CrtScreenEffect}"
                                                                HorizontalAlignment="Right" CornerRadius="20"
                                                                Background="{DynamicResource EmuAccentBrush}">
                                                            <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="1" Classes="gamepad-settings-row"
                                                Classes.focused="{Binding GamepadSettings.IsAmbientToggleFocused}"
                                                IsVisible="{Binding GamepadSettings.IsThemesVisible}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding GamepadSettings.ToggleAmbientCommand}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="Match colours to game artwork" FontSize="17"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="Recolour the interface from the highlighted game; the theme below is the fallback."
                                                               FontSize="14" TextWrapping="Wrap" MaxLines="2"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="gamepad-settings-switch"
                                                        Classes.on="{Binding GamepadSettings.AmbientThemeFromArtwork}"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="OFF" IsVisible="{Binding !GamepadSettings.AmbientThemeFromArtwork}"
                                                                   Margin="0,0,14,0" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                        <TextBlock Text="ON" IsVisible="{Binding GamepadSettings.AmbientThemeFromArtwork}"
                                                                   Margin="14,0,0,0" HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                        <Border Width="40" Height="40" Margin="4"
                                                                IsVisible="{Binding !GamepadSettings.AmbientThemeFromArtwork}"
                                                                HorizontalAlignment="Left" CornerRadius="20"
                                                                Background="{DynamicResource EmuTextTertiaryBrush}" />
                                                        <Border Width="40" Height="40" Margin="4"
                                                                IsVisible="{Binding GamepadSettings.AmbientThemeFromArtwork}"
                                                                HorizontalAlignment="Right" CornerRadius="20"
                                                                Background="{DynamicResource EmuAccentBrush}">
                                                            <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <ScrollViewer Grid.Row="2" x:Name="GamepadThemeScroller"
                                                      Classes="gamepad-scroll"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="GamepadThemeGallery"
                                                      ItemsSource="{Binding GamepadSettings.ThemeChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                                                    <Button Classes="gamepad-theme-card"
                                                            Classes.focused="{Binding IsFocused}"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).GamepadSettings.SelectThemeChoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                                            <!-- A miniature app window rendered from the palette's own
                                                                 swatches, so the card previews the theme without a
                                                                 hardcoded color anywhere. -->
                                                            <Border Grid.Row="0" CornerRadius="12" Height="112" ClipToBounds="True"
                                                                    Background="{Binding PreviewBackground}"
                                                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                                                <Grid Margin="14" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewAccent}" />
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewText}" Opacity="0.45" />
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewText}" Opacity="0.25" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Row="1" ColumnDefinitions="*,2.4*,*" ColumnSpacing="8">
                                                                        <Border Background="{Binding PreviewSurface}" CornerRadius="6" />
                                                                        <Border Grid.Column="1" Background="{Binding PreviewSurface}" CornerRadius="6">
                                                                            <Border Width="34" Height="34" CornerRadius="17"
                                                                                    Background="{Binding PreviewAccent}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="2" Background="{Binding PreviewSurface}" CornerRadius="6" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                                                        <Border Width="26" Height="8" CornerRadius="4" Background="{Binding PreviewAccent}" />
                                                                        <Border Width="46" Height="8" CornerRadius="4"
                                                                                Background="{Binding PreviewText}" Opacity="0.3" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="1" IsVisible="{Binding IsSelected}"
                                                                        Width="26" Height="26" CornerRadius="13"
                                                                        Background="{DynamicResource EmuAccentBrush}">
                                                                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    </Grid>

                                    <!-- Choice rows open an explicit controller-native list. Left/Right on
                                         the underlying row remains the fast path; this modal is the clear,
                                         inspectable path for emulator/core lists and other settings. -->
                                    <Border IsVisible="{Binding GamepadSettings.IsChoicePickerOpen}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            MaxWidth="760" Margin="24" Padding="24" CornerRadius="16"
                                            Background="{DynamicResource EmuCardBrush}"
                                            BorderBrush="{DynamicResource EmuAccentBrush}" BorderThickness="2">
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                                            <TextBlock Text="{Binding GamepadSettings.ChoicePickerTitle}"
                                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Text="{Binding GamepadSettings.ChoicePickerDescription}"
                                                       FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <ScrollViewer Grid.Row="2" MaxHeight="480"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsRepeater x:Name="GamepadSettingsChoiceOptions"
                                                               ItemsSource="{Binding GamepadSettings.ChoiceOptions}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:GamepadChoiceOptionViewModel">
                                                            <Button Classes="gamepad-modal-option"
                                                                    Classes.focused="{Binding IsFocused}"
                                                                    Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                                    Command="{Binding SelectCommand}">
                                                                <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                                            IsVisible="{Binding IsSelected}"
                                                                            Background="{DynamicResource EmuAccentBrush}">
                                                                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource EmuGamepadButtonTextBrush}" />
                                                                    </Border>
                                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                                            IsVisible="{Binding !IsSelected}"
                                                                            BorderBrush="{DynamicResource EmuStrongBorderBrush}"
                                                                            BorderThickness="2" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                               FontSize="18" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Border IsVisible="{Binding GamepadSettings.IsTextEntryOpen}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            MaxWidth="700" Margin="24" Padding="24" CornerRadius="16"
                                            Background="{DynamicResource EmuCardBrush}"
                                            BorderBrush="{DynamicResource EmuAccentBrush}" BorderThickness="2">
                                        <StackPanel Spacing="13">
                                            <TextBlock Text="{Binding GamepadSettings.TextEntryTitle}"
                                                       FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{Binding GamepadSettings.TextEntryDescription}"
                                                       TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <TextBox x:Name="GamepadSettingsTextBox"
                                                     IsVisible="{Binding !GamepadSettings.IsSecretEntry}"
                                                     Text="{Binding GamepadSettings.DraftText, Mode=TwoWay}"
                                                     FontSize="22" KeyDown="OnGamepadTextInputKeyDown" />
                                            <TextBox x:Name="GamepadSettingsSecretBox"
                                                     IsVisible="{Binding GamepadSettings.IsSecretEntry}"
                                                     Text="{Binding GamepadSettings.DraftText, Mode=TwoWay}"
                                                     PasswordChar="{Binding GamepadSettings.RevealSecret, Converter={x:Static vm:GamepadSettingsViewModel.SecretMaskChar}}"
                                                     FontSize="22"
                                                     KeyDown="OnGamepadTextInputKeyDown" />
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding GamepadSettings.IsSecretEntry}">
                                                <Border Classes="gamepad-key"><TextBlock Text="Y" /></Border>
                                                <TextBlock Text="Show or hide what you type" VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding GamepadSettings.KeyboardHint}" FontSize="14"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                <Button Classes="gamepad-settings-confirm" Content="Cancel"
                                                        Command="{Binding GamepadSettings.DismissTextEntryCommand}" />
                                                <Button Classes="gamepad-settings-confirm focused" Content="Save entry"
                                                        Command="{Binding GamepadSettings.SaveTextEntryCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding GamepadSettings.IsConfirmationOpen}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            MaxWidth="700" Margin="24" Padding="26" CornerRadius="16"
                                            Background="{DynamicResource EmuCardBrush}"
                                            BorderBrush="{DynamicResource EmuDangerBrush}" BorderThickness="2">
                                        <StackPanel Spacing="15">
                                            <TextBlock Text="{Binding GamepadSettings.ConfirmationTitle}"
                                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GamepadSettings.ConfirmationText}"
                                                       FontSize="15" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                                <Button x:Name="GamepadSettingsKeepButton"
                                                        Classes="gamepad-settings-confirm"
                                                        Classes.focused="{Binding !GamepadSettings.IsConfirmChoiceSelected}"
                                                        Content="Keep current"
                                                        Command="{Binding GamepadSettings.ChooseConfirmationCancelCommand}" />
                                                <Button x:Name="GamepadSettingsConfirmButton"
                                                        Classes="gamepad-settings-confirm danger"
                                                        Classes.focused="{Binding GamepadSettings.IsConfirmChoiceSelected}"
                                                        Content="Confirm"
                                                        Command="{Binding GamepadSettings.ChooseConfirmationConfirmCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsGamepadSearchOpen}" Spacing="14">
                            <TextBlock Text="Search your library" FontSize="17" />
                            <!-- A normal editable field on every platform: on Android a screen tap positions the
                                 caret and raises the system keyboard; a gamepad-driven open forces the IME up from
                                 the view (see GamepadTextEntryRevision). Desktop types straight in. -->
                            <TextBox x:Name="GamepadSearchBox" Text="{Binding SearchText, Mode=TwoWay}" FontSize="24"
                                     PlaceholderText="Enter a game title" KeyDown="OnGamepadTextInputKeyDown" />
                            <TextBlock Text="{Binding LibraryCountText}" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGamepadRenameOpen}" Spacing="14">
                            <TextBlock Text="Enter a new title" FontSize="17" />
                            <TextBlock Text="{Binding FocusedGame.Title}" FontSize="16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            <TextBox x:Name="GamepadRenameBox" Text="{Binding FocusedGame.DraftTitle, Mode=TwoWay}" FontSize="24"
                                     PlaceholderText="Enter a new title" KeyDown="OnGamepadTextInputKeyDown" />
                        </StackPanel>
                        <!-- Self-contained confirmation dialog (Remove / Desktop switch / Quit). Spans both
                             body rows and centres the whole group — title, explanation, then an equal-halves
                             button bar — so nothing floats against an edge the way the shared picker layout
                             (top-left body, bottom-right buttons) did. Bound to the same GamepadOverlayOptions
                             the pickers use, so D-pad focus and A/B routing are unchanged. -->
                        <StackPanel x:Name="GamepadConfirmationCard" Grid.RowSpan="3"
                                    IsVisible="{Binding IsGamepadConfirmationOverlay}"
                                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="22">
                            <TextBlock Text="{Binding GamepadOverlayTitle}"
                                       IsVisible="{Binding IsGamepadConfirmationOverlay}"
                                       FontSize="26" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            <StackPanel x:Name="GamepadRemoveBody" IsVisible="{Binding IsGamepadRemoveOpen}" Spacing="8">
                                <TextBlock Text="{Binding FocusedGame.Title}" FontSize="18" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                                <TextBlock Text="This removes only EmuShelf’s library record. Your game files and cover files are not deleted."
                                           FontSize="15" TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" MaxWidth="380"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock IsVisible="{Binding IsGamepadDesktopModeConfirmationOpen}"
                                       Text="Gamepad mode will close and the desktop library will be shown."
                                       FontSize="16" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" MaxWidth="400"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            <TextBlock IsVisible="{Binding IsGamepadQuitConfirmationOpen}"
                                       Text="Any running library work will stop and EmuShelf will close. Your game files are never changed."
                                       FontSize="16" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" MaxWidth="400"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            <ItemsControl x:Name="GamepadConfirmationActions" Margin="0,6,0,0"
                                          ItemsSource="{Binding GamepadOverlayOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamepadOverlayOptionViewModel">
                                        <Button Classes="gamepad-confirm-button" Margin="7,0"
                                                Classes.danger="{Binding IsDestructive}"
                                                Classes.cancel="{Binding IsCancel}"
                                                Classes.focused="{Binding IsFocused}"
                                                Content="{Binding Label}" Command="{Binding Command}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGamepadCoverHandoffOpen}" Spacing="12">
                            <TextBlock Text="{Binding GamepadCoverHandoffTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding GamepadCoverHandoffDescription}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource EmuTextSecondaryBrush}" FontSize="16" />
                        </StackPanel>
                        <!-- Controller-native ScreenScraper scraper: the shared GameScraperViewModel
                             with a D-pad focus model layered on top; never hands off to Desktop. -->
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadScraperOpen}">
                            <Grid DataContext="{Binding GamepadScraperDetails}" x:DataType="vm:GamepadScraperViewModel"
                                  RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Scraper.GameTitle}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Scraper.QuotaText}" FontSize="12"
                                               IsVisible="{Binding Scraper.QuotaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                </StackPanel>

                                <Panel Grid.Row="1">
                                    <!-- Loading -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowLoading}" Width="360"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <ProgressBar IsIndeterminate="True" Height="4" />
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Terminal messages: applied / failure / unsupported -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowMessage}" Width="470"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="16" />
                                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Border Classes="gamepad-key action-b"><TextBlock Text="B" /></Border>
                                            <TextBlock Text="Back to library" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Fingerprint consent (auto-hash is default, but handle it) -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowConsent}" Width="450"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="15"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsComputeFocused}"
                                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                                Command="{Binding Scraper.ComputeFingerprintCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Compute hash and match" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Connect (not connected / provider disabled) -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowConnect}" Width="440"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <TextBlock Text="Connect your ScreenScraper account" FontSize="18"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Sign in with your screenscraper.fr username and password."
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <TextBox x:Name="GamepadScraperUsernameBox" Classes="gamepad-scraper-field"
                                                 Classes.focused="{Binding IsUsernameFocused}" FontSize="18"
                                                 Text="{Binding Scraper.Username, Mode=TwoWay}" PlaceholderText="Username"
                                                 KeyDown="OnGamepadScraperTextKeyDown" />
                                        <TextBox x:Name="GamepadScraperPasswordBox" Classes="gamepad-scraper-field"
                                                 Classes.focused="{Binding IsPasswordFocused}" FontSize="18"
                                                 Text="{Binding Scraper.Password, Mode=TwoWay}" PasswordChar="•"
                                                 PlaceholderText="Password" KeyDown="OnGamepadScraperTextKeyDown" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsConnectFocused}"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding Scraper.ConnectCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Connect" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar IsIndeterminate="True" Height="3"
                                                     IsVisible="{Binding Scraper.IsConnecting}" />
                                        <TextBlock Text="{Binding Scraper.ConnectStatus}" TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   IsVisible="{Binding Scraper.ConnectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- No exact match: title search + candidate list -->
                                    <Grid IsVisible="{Binding Scraper.ShowSearch}" RowDefinitions="Auto,Auto,*" Margin="4">
                                        <TextBlock Grid.Row="0" Text="{Binding Scraper.StatusMessage}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                            <TextBox Grid.Column="0" x:Name="GamepadScraperSearchBox"
                                                     Classes="gamepad-scraper-field"
                                                     Classes.focused="{Binding IsSearchFieldFocused}" FontSize="18"
                                                     Text="{Binding Scraper.SearchQuery, Mode=TwoWay}"
                                                     PlaceholderText="Game title" KeyDown="OnGamepadScraperTextKeyDown" />
                                            <Button Grid.Column="1" Classes="gamepad-modal-option" MinWidth="130"
                                                    Classes.focused="{Binding IsSearchFocused}"
                                                    HorizontalContentAlignment="Center"
                                                    Command="{Binding Scraper.SearchCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                    <TextBlock Text="Search" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2"
                                                     IsIndeterminate="True" IsVisible="{Binding Scraper.IsSearching}" />
                                        <ScrollViewer Grid.Row="2" Classes="gamepad-scroll"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Candidates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GamepadScraperCandidateViewModel">
                                                        <Button Classes="gamepad-modal-option" Margin="0,3,0,0"
                                                                Classes.focused="{Binding IsFocused}"
                                                                Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).GamepadScraperDetails.Scraper.SelectCandidateCommand}"
                                                                CommandParameter="{Binding Match}">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding System}" FontSize="11"
                                                                           IsVisible="{Binding HasSystem}"
                                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Ready: pick fields + media, box art alongside, then Apply -->
                                    <Grid IsVisible="{Binding Scraper.ShowData}" ColumnDefinitions="*,Auto"
                                          RowDefinitions="*,Auto" ColumnSpacing="20">
                                        <ScrollViewer Grid.Row="0" Grid.Column="0" Classes="gamepad-scroll"
                                                      x:Name="GamepadScraperFieldsScroller"
                                                      VerticalScrollBarVisibility="Auto"
                                                      ScrollChanged="OnGamepadScraperScrollChanged">
                                            <StackPanel Spacing="2">
                                                <ItemsControl ItemsSource="{Binding Scraper.Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ScraperFieldRowViewModel">
                                                            <Border Classes="gamepad-scraper-row"
                                                                    Classes.focused="{Binding IsFocused}">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                                              IsEnabled="{Binding CanApply}"
                                                                              VerticalAlignment="Top" />
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ProposedValue}"
                                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                        <TextBlock Text="Kept — you edited this"
                                                                                   FontSize="11"
                                                                                   IsVisible="{Binding IsUserOwned}"
                                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Classes="gamepad-scraper-row"
                                                        Classes.focused="{Binding Scraper.CoverArtRow.IsFocused}"
                                                        IsVisible="{Binding Scraper.CoverArtRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                        <CheckBox IsChecked="{Binding Scraper.CoverArtRow.IsSelected}"
                                                                  IsEnabled="{Binding Scraper.CoverArtRow.CanApply}"
                                                                  VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="64" Height="84" CornerRadius="5"
                                                                ClipToBounds="True" VerticalAlignment="Center"
                                                                Background="{DynamicResource EmuCoverWellBrush}">
                                                            <Image Source="{Binding Scraper.CoverArtRow.Preview}"
                                                                   Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Scraper.CoverArtRow.Label}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Scraper.CoverArtRow.ProposedText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Scraper.OtherMedia}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ScraperMediaRowViewModel">
                                                            <Border Classes="gamepad-scraper-row"
                                                                    Classes.focused="{Binding IsFocused}">
                                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                                              IsEnabled="{Binding CanApply}"
                                                                              VerticalAlignment="Center" />
                                                                    <Border Grid.Column="1" Width="64" Height="84"
                                                                            CornerRadius="5" ClipToBounds="True"
                                                                            VerticalAlignment="Center"
                                                                            Background="{DynamicResource EmuCoverWellBrush}">
                                                                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="2" Spacing="2"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ProposedText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                        <TextBlock Text="Kept — your image" FontSize="11"
                                                                                   IsVisible="{Binding IsUserOwned}"
                                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,12,0,0">
                                            <Border Classes="gamepad-scraper-row"
                                                    Classes.focused="{Binding IsRefreshFocused}">
                                                <CheckBox Content="Replace values ScreenScraper already set"
                                                          IsChecked="{Binding Scraper.RefreshOwnedValues}" />
                                            </Border>
                                            <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsApplyFocused}"
                                                    HorizontalContentAlignment="Center"
                                                    Command="{Binding Scraper.ApplyCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                    <TextBlock Text="Apply selected" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding Scraper.StatusMessage}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Border Classes="gamepad-scraper-cover">
                                                <Panel>
                                                    <TextBlock Text="{Binding Scraper.CoverArtEmptyText}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="12"
                                                               IsVisible="{Binding Scraper.CoverArtPreview, Converter={x:Static ObjectConverters.IsNull}}"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <Image Source="{Binding Scraper.CoverArtPreview}" Stretch="Uniform" />
                                                </Panel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Grid>
                        </Grid>
                        <!-- Controller-native web cover search: the shared CoverSearchViewModel behind a
                             D-pad focus wrapper. Search web images and pick one; "Choose a file" hands
                             off to Desktop for the OS file picker, which is not controller-safe. -->
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadCoverSearchOpen}">
                            <Grid DataContext="{Binding GamepadCoverSearchDetails}"
                                  x:DataType="vm:GamepadCoverSearchViewModel"
                                  RowDefinitions="Auto,Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" x:Name="GamepadCoverSearchBox"
                                             Classes="gamepad-scraper-field"
                                             Classes.focused="{Binding IsSearchFieldFocused}" FontSize="18"
                                             Text="{Binding Search.SearchText, Mode=TwoWay}"
                                             PlaceholderText="Game title" KeyDown="OnGamepadCoverSearchTextKeyDown" />
                                    <Button Grid.Column="1" Classes="gamepad-modal-option" MinWidth="130"
                                            Classes.focused="{Binding IsSearchFocused}"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding Search.SearchCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                            <TextBlock Text="Search" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
                                    <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding Search.IsBusy}" />
                                    <TextBlock Text="{Binding Search.StatusText}" TextWrapping="Wrap"
                                               IsVisible="{Binding Search.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="2" Classes="gamepad-scroll" VerticalScrollBarVisibility="Auto"
                                              x:Name="GamepadCoverSearchScroller">
                                    <ItemsControl ItemsSource="{Binding Search.Results}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CoverSearchResultViewModel">
                                                <Button Classes="gamepad-modal-option" Margin="6" Padding="6"
                                                        Classes.focused="{Binding IsFocused}"
                                                        Command="{Binding SelectCommand}">
                                                    <StackPanel Spacing="4" Width="150">
                                                        <Image Source="{Binding Preview}" Height="200" Stretch="Uniform" />
                                                        <TextBlock Text="{Binding ResolutionText}" FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                        <TextBlock Text="{Binding SourceText}" FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="3" Spacing="10" Margin="0,10,0,0">
                                    <Button Classes="gamepad-modal-option" HorizontalContentAlignment="Center"
                                            Classes.focused="{Binding IsChooseLocalFocused}"
                                            Command="{Binding ChooseLocalCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                            <TextBlock Text="Choose a file on Desktop instead" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Classes="gamepad-hint" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                        <TextBlock Text="Choose cover" Margin="0,0,14,0" />
                                        <Border Classes="gamepad-key action-b"><TextBlock Text="B" /></Border>
                                        <TextBlock Text="Back" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <!-- Controller-native batch scraper: the shared GameBatchScraperViewModel with a
                             linear D-pad focus model. Configuring → determinate progress → summary. -->
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadBatchScraperOpen}">
                            <Grid DataContext="{Binding GamepadBatchScraperDetails}"
                                  x:DataType="vm:GamepadBatchScraperViewModel" RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Batch.Heading}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="Matches by hash and serial only. Unmatched games are skipped — nothing is guessed."
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                </StackPanel>

                                <Panel Grid.Row="1">
                                    <!-- Configure: one couch-relevant choice, then Start. -->
                                    <StackPanel IsVisible="{Binding Batch.IsConfiguring}" Spacing="14"
                                                VerticalAlignment="Center" MaxWidth="560">
                                        <TextBlock Text="{Binding Batch.StatusMessage}" TextWrapping="Wrap"
                                                   TextAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Border Classes="gamepad-scraper-row" Classes.focused="{Binding IsRefreshFocused}">
                                            <CheckBox Content="Replace values ScreenScraper already set"
                                                      IsChecked="{Binding Batch.RefreshOwnedValues}" />
                                        </Border>
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsStartFocused}"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding Batch.StartCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Start scraping" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Running: determinate bar over the current game, plus Cancel. -->
                                    <StackPanel IsVisible="{Binding Batch.IsRunning}" Spacing="16"
                                                VerticalAlignment="Center" MaxWidth="560">
                                        <ProgressBar Minimum="0" Maximum="{Binding Batch.ProgressTotal}"
                                                     Value="{Binding Batch.ProgressCompleted}" Height="8" />
                                        <TextBlock Text="{Binding Batch.StatusMessage}" TextAlignment="Center"
                                                   HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Batch.CurrentGameTitle}" TextAlignment="Center"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Batch.CurrentGameTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsCancelFocused}"
                                                HorizontalContentAlignment="Center" HorizontalAlignment="Center"
                                                MinWidth="200" Command="{Binding Batch.CancelCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Stop" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Done: summary + Close. -->
                                    <StackPanel IsVisible="{Binding Batch.IsDone}" Spacing="18"
                                                VerticalAlignment="Center" MaxWidth="560">
                                        <ProgressBar Minimum="0" Maximum="{Binding Batch.ProgressTotal}"
                                                     Value="{Binding Batch.ProgressCompleted}" Height="8" />
                                        <TextBlock Text="{Binding Batch.StatusMessage}" TextAlignment="Center"
                                                   TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="16" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsCloseFocused}"
                                                HorizontalContentAlignment="Center" HorizontalAlignment="Center"
                                                MinWidth="200" Command="{Binding Batch.CloseCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Done" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </Grid>
                        </Grid>
                        <!-- Controller-native Hotkeys overlay. Renders the same per-emulator hotkey
                             feature the Desktop Settings > Hotkeys section shows, wrapped by
                             GamepadHotkeysViewModel for D-pad focus. Top: the two global actions. Below:
                             the emulators × actions matrix (left) beside the controller-setup card
                             (right). Gamepad-native — no Desktop window is ever opened. -->
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadHotkeysOpen}">
                        <Grid DataContext="{Binding GamepadHotkeys}" x:DataType="vm:GamepadHotkeysViewModel"
                              RowDefinitions="Auto,*" RowSpacing="14">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="gamepad-modal-option" MinWidth="220"
                                            Classes.focused="{Binding IsApplyAllFocused}"
                                            HorizontalContentAlignment="Center"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding ApplyAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                            <TextBlock Text="Apply to all emulators" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="gamepad-modal-option" MinWidth="260"
                                            Classes.focused="{Binding IsInstallFocused}"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding InstallSteamTemplateCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                            <TextBlock Text="Install Steam Input template" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding SteamTemplateStatus}" FontSize="13" TextWrapping="Wrap"
                                           IsVisible="{Binding HasSteamTemplateStatus}"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="24">
                                <!-- Emulators × actions matrix. Fixed-width action columns keep the
                                     header aligned with every row; each row's status + Apply / Revert
                                     sit on a line below, matching the Desktop matrix. -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid Grid.Row="0" Margin="14,0,14,0"
                                          ColumnDefinitions="*,52,52,52,52,52">
                                        <TextBlock Grid.Column="0" Text="EMULATOR" FontSize="10" FontWeight="Bold"
                                                   LetterSpacing="1" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                        <TextBlock Grid.Column="1" TextAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" Text="rewind&#x0a;R" />
                                        <TextBlock Grid.Column="2" TextAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" Text="fast-fwd&#x0a;L" />
                                        <TextBlock Grid.Column="3" TextAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" Text="save&#x0a;F2" />
                                        <TextBlock Grid.Column="4" TextAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" Text="load&#x0a;F4" />
                                        <TextBlock Grid.Column="5" TextAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" Text="close&#x0a;F8" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" x:Name="GamepadHotkeysScroller" Classes="gamepad-scroll"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Emulators}" Margin="0,0,8,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HotkeyEmulatorRowViewModel">
                                                    <Border Classes="settings-card" Margin="0,0,0,8" Padding="14,10">
                                                        <StackPanel Spacing="7">
                                                            <Grid VerticalAlignment="Center"
                                                                  ColumnDefinitions="*,52,52,52,52,52">
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" FontSize="15"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Rewind.Mark}"
                                                                           ToolTip.Tip="{Binding Rewind.Detail}"
                                                                           TextAlignment="Center" FontSize="16" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding FastForward.Mark}"
                                                                           ToolTip.Tip="{Binding FastForward.Detail}"
                                                                           TextAlignment="Center" FontSize="16" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding SaveState.Mark}"
                                                                           ToolTip.Tip="{Binding SaveState.Detail}"
                                                                           TextAlignment="Center" FontSize="16" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="4" Text="{Binding LoadState.Mark}"
                                                                           ToolTip.Tip="{Binding LoadState.Detail}"
                                                                           TextAlignment="Center" FontSize="16" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="5" Text="{Binding CloseGame.Mark}"
                                                                           ToolTip.Tip="{Binding CloseGame.Detail}"
                                                                           TextAlignment="Center" FontSize="16" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                                           FontSize="12" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding CanOperate}">
                                                                    <Button Classes="gamepad-hotkey-action"
                                                                            Classes.focused="{Binding IsApplyFocused}"
                                                                            Content="Apply" IsEnabled="{Binding CanRun}"
                                                                            Command="{Binding ApplyCommand}" />
                                                                    <Button Classes="gamepad-hotkey-action"
                                                                            Classes.focused="{Binding IsRevertFocused}"
                                                                            Content="Revert" IsEnabled="{Binding CanRun}"
                                                                            Command="{Binding RevertCommand}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Controller-setup reference: the scheme summary and the hold-Select
                                     mapping a controller-only player needs to drive the keys. -->
                                <Border Grid.Column="1" Classes="settings-card" Padding="16,14">
                                    <ScrollViewer Classes="gamepad-scroll" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12" Margin="0,0,6,0">
                                            <TextBlock Text="CONTROLLER SETUP" FontSize="11" FontWeight="Bold"
                                                       LetterSpacing="1"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            <TextBlock Text="{Binding SchemeSummary}" TextWrapping="Wrap" FontSize="13"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                       Text="Hold Select (Back / View — the share-side button) and press:" />
                                            <ItemsControl ItemsSource="{Binding ControllerMapping}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GamepadHotkeyMappingRow">
                                                        <Grid ColumnDefinitions="Auto,12,*" Margin="0,0,0,4">
                                                            <TextBlock Grid.Column="0" Text="{Binding Combo}"
                                                                       FontFamily="Monospace" FontSize="12"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="12"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                                       Text="Square / Circle / Triangle / Cross are the PlayStation face buttons; on an Xbox pad they are X / B / Y / A by position." />
                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                                       Text="Steam Deck: add each emulator as a non-Steam game, open its Controller Settings → Edit Layout, make Select a hold Action Layer, and bind the buttons above to those keys. On desktop, launch the emulator through Steam so the layout applies." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="GamepadOverlayHints" Grid.Row="2" Orientation="Horizontal" Spacing="18">
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding UsesGamepadDefaultOverlayHints}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Choose" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <!-- Confirmations: Left/Right pick between Cancel and the action, A confirms
                             the focused one, B cancels — the couch reading of a standard dialog. -->
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding ShowsGamepadConfirmationActions}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Choose" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadAchievementsOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="LB/RB" /></Border>
                            <TextBlock Text="Filter" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Browse" />
                            <Border Classes="gamepad-key action-y" Margin="8,0,0,0"><TextBlock Text="Y" /></Border>
                            <TextBlock Text="Sort" />
                            <Border Classes="gamepad-key action-x" Margin="8,0,0,0"><TextBlock Text="X" /></Border>
                            <TextBlock Text="Refresh" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSearchOpen}">
                            <Border Classes="gamepad-key action-b"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                     IsVisible="{Binding IsGamepadRenameOpen}">
                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Save" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadScraperOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Move" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadBatchScraperOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Move" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadHotkeysOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Move" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSettingsNormal}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Navigate" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="LB/RB" /></Border>
                            <TextBlock Text="Sections" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"
                                    IsVisible="{Binding GamepadSettings.IsChoiceRowFocused}"><TextBlock Text="← →" /></Border>
                            <TextBlock Text="Change" IsVisible="{Binding GamepadSettings.IsChoiceRowFocused}" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Options" IsVisible="{Binding GamepadSettings.IsChoiceRowFocused}" />
                            <TextBlock Text="Select" IsVisible="{Binding !GamepadSettings.IsChoiceRowFocused}" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="START" /></Border>
                            <TextBlock Text="Save" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                            <Border Classes="gamepad-key action-y" Margin="8,0,0,0"
                                    IsVisible="{Binding GamepadSettings.HasActionsHint}"><TextBlock Text="Y" /></Border>
                            <TextBlock Text="{Binding GamepadSettings.ActionsHint}" IsVisible="{Binding GamepadSettings.HasActionsHint}" />
                        </StackPanel>
                        <!-- The text-entry and confirmation modals only honour A/B (and D-pad in the
                             confirm dialog), so the footer swaps to a legend that matches. -->
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSettingsTextEntryOpen}">
                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Save entry" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSettingsConfirmationOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Choose" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Confirm" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Keep" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSettingsChoicePickerOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Choose" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Use" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </Panel>
        </Grid>
    </Grid>

    <!-- Borderless chrome keeps the theme continuous on Windows 10/11. Thin native-role grips
         retain ordinary edge and corner resizing without putting platform behavior in the view
         model or replacing Avalonia's window sizing implementation. -->
    <!-- ===================== The tube =====================
         Declared here, beside GamepadRoot rather than inside it, and that placement is the whole
         mechanism: this control captures GamepadRoot into a texture and composites it into the
         scene BEFORE the barrel warp, so the platform rail and the focused title are part of the
         picture the CRT is displaying instead of flat overlays sitting on a curved image. A scene
         inside that subtree would be capturing itself.

         With the effect on it presents the tube (CouchCrt → Default) over every couch layout. With
         the effect off it is normally idle — the in-place host (GamepadShelfInlineScene) draws the
         shelf — and comes up only as the fallback when that host cannot bring up GL: there it presents
         flat (CouchCrt → Flat) on the shelf so the models stay 3D. ShowCouchScene carries exactly that
         condition (effect on, or effect-off shelf with the in-place host ruled out). Its own GL
         support is tracked separately (TubeSceneSupported), so the in-place host failing never
         disables it — the bug behind the Steam Deck blackout. See DECISIONS 2026-08-16.

         It is opaque and covers the window, which is what hides the un-warped original: the couch
         UI still lays out and animates normally underneath, it is simply never the thing you see.
         Non-hit-testable so the window's resize edges below still work.
         See docs/couch-physical-media-shelf.md. -->
    <controls:MediaShelf3DHost x:Name="GamepadShelfScene"
                               IsHitTestVisible="False"
                               IsVisible="{Binding ShowCouchScene}"
                               IsActive="{Binding ShowCouchScene}"
                               IsSceneSupported="{Binding TubeSceneSupported}"
                               Crt="{Binding CouchCrt}"
                               ChromeSource="{Binding #GamepadRoot}"
                               FrameFillScale="{Binding ShelfFillScale}"
                               Items="{Binding ShelfSceneItems}"
                               FocusedItem="{Binding FocusedGame}"
                               ShelfPosition="{Binding ShelfPosition}"
                               Yaw="{Binding ShelfHeroYaw}"
                               Pitch="{Binding ShelfHeroPitch}"
                               DeparturePose="{Binding ShelfDeparturePose}"
                               LaunchPose="{Binding ShelfLaunchPose}"
                               InitializationFailed="OnGamepadShelfHeroFailed" />

    </Grid>
</UserControl>
