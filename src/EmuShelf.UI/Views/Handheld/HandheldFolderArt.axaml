<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             x:Class="EmuShelf.App.Views.Handheld.HandheldFolderArt"
             x:CompileBindings="False">

  <!--
    A platform (or, from H4, a user) folder: a back plate, the first three covers tucked inside, and the
    front flap with the folder's face. Drawn at 416 px and scaled to fit (a home tile is 176 px, the Stage's
    big folder 416). Its states are classes set by whoever shows it: `peek` tilts the flap so the covers peek
    out (focus), `open` swings it open (A), `instant` skips the transitions. Transform-only transitions on the
    flap and the covers.
    DataContext: anything with AccentBrush, Monogram, FolderGlyph, HasFolderGlyph, PeekA, PeekB, PeekC (a home slot, the Stage).
  -->

  <UserControl.Styles>
    <Style Selector="Border.front">
      <Setter Property="RenderTransformOrigin" Value="50%,100%" />
      <Setter Property="RenderTransform" Value="scaleY(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.34" Y1="1.3" X2="0.64" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="vh|HandheldFolderArt.peek Border.front">
      <Setter Property="RenderTransform" Value="scaleY(0.86)" />
    </Style>
    <Style Selector="vh|HandheldFolderArt.open Border.front">
      <Setter Property="RenderTransform" Value="scaleY(0.5)" />
    </Style>

    <Style Selector="Border.peek-cover">
      <Setter Property="Width" Value="148" />
      <Setter Property="Height" Value="208" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.PeekCoverRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CoverPlaceholder}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,24,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.36">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.34" Y1="1.3" X2="0.64" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <!-- Closed, each cover sits low behind the flap; a peek lifts them; open lifts them clear. -->
    <Style Selector="Border.peek-cover.left"><Setter Property="RenderTransform" Value="translate(-64px,84px) rotate(-9deg)" /></Style>
    <Style Selector="Border.peek-cover.middle"><Setter Property="RenderTransform" Value="translate(0px,80px)" /></Style>
    <Style Selector="Border.peek-cover.right"><Setter Property="RenderTransform" Value="translate(64px,84px) rotate(9deg)" /></Style>
    <Style Selector="vh|HandheldFolderArt.peek Border.peek-cover.left"><Setter Property="RenderTransform" Value="translate(-64px,8px) rotate(-9deg)" /></Style>
    <Style Selector="vh|HandheldFolderArt.peek Border.peek-cover.middle"><Setter Property="RenderTransform" Value="translate(0px,0px)" /></Style>
    <Style Selector="vh|HandheldFolderArt.peek Border.peek-cover.right"><Setter Property="RenderTransform" Value="translate(64px,8px) rotate(9deg)" /></Style>
    <Style Selector="vh|HandheldFolderArt.open Border.peek-cover.left"><Setter Property="RenderTransform" Value="translate(-72px,-28px) rotate(-12deg)" /></Style>
    <Style Selector="vh|HandheldFolderArt.open Border.peek-cover.middle"><Setter Property="RenderTransform" Value="translate(0px,-36px)" /></Style>
    <Style Selector="vh|HandheldFolderArt.open Border.peek-cover.right"><Setter Property="RenderTransform" Value="translate(72px,-28px) rotate(12deg)" /></Style>

    <!-- `instant` lands a state without its transition (the Stage's folder arriving already open on a close). -->
    <Style Selector="vh|HandheldFolderArt.instant Border.front"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector="vh|HandheldFolderArt.instant Border.peek-cover"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <!-- `frozen`: never animated, only pictured (the native Stage draws the screen). -->
    <Style Selector="vh|HandheldFolderArt.frozen Border.front"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector="vh|HandheldFolderArt.frozen Border.peek-cover"><Setter Property="Transitions" Value="{x:Null}" /></Style>
  </UserControl.Styles>

  <!-- Not clipped: the shadow spills past the folder's own square. -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Panel x:Name="ArtRoot" Width="416" Height="416" ClipToBounds="False">
      <vh:HandheldShadow x:Name="ArtShadow" Radius="{x:Static vm:HandheldTokens.ClassicFolderShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicFolderShadowBlur}" Margin="-16,26,-16,-36" Color="{x:Static vm:HandheldTokens.ClassicFolderShadow}" Filled="True" />
      <!-- Back plate: the platform colour, darker. -->
      <Border x:Name="ArtBack" Margin="12,54,12,16" CornerRadius="{x:Static vm:HandheldTokens.FolderBackRadius}" Background="{Binding AccentBrush}">
        <Border CornerRadius="{x:Static vm:HandheldTokens.FolderBackRadius}" Background="{x:Static vm:HandheldTokens.ClassicFolderBackShade}" />
      </Border>
      <!-- The covers inside (none drawn until they are decoded). -->
      <Panel x:Name="CoverPanel" Margin="34,16,34,0" Height="276" VerticalAlignment="Top">
        <Border x:Name="CoverLeft" Classes="peek-cover left" IsVisible="{Binding PeekB, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{Binding PeekB}" Stretch="UniformToFill" />
        </Border>
        <Border x:Name="CoverRight" Classes="peek-cover right" IsVisible="{Binding PeekC, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{Binding PeekC}" Stretch="UniformToFill" />
        </Border>
        <Border x:Name="CoverMiddle" Classes="peek-cover middle" IsVisible="{Binding PeekA, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{Binding PeekA}" Stretch="UniformToFill" />
        </Border>
      </Panel>
      <!-- Front flap: the folder's face, hinged at the bottom. -->
      <Border x:Name="ArtFront" Classes="front" Margin="12,112,12,16" CornerRadius="{x:Static vm:HandheldTokens.FolderFlapRadius}" Background="{Binding AccentBrush}">
        <Grid>
          <Border CornerRadius="{x:Static vm:HandheldTokens.FolderFlapRadius}">
            <Border.Background>
              <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicFlapGlossTop}" />
                <GradientStop Offset="0.75" Color="{x:Static vm:HandheldTokens.ClassicFlapGlossClear}" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <!-- The flap's top edge catches the light. -->
          <Border CornerRadius="{x:Static vm:HandheldTokens.FolderFlapRadius}" BorderBrush="{x:Static vm:HandheldTokens.ClassicFlapEdge}" BorderThickness="0,3,0,0" />
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="48,24">
            <TextBlock Text="{Binding Monogram}" FontSize="{x:Static vm:HandheldTokens.Monogram}" FontWeight="{x:Static vm:HandheldTokens.MonogramWeight}" Foreground="{x:Static vm:HandheldTokens.OnFolder}" />
          </Viewbox>
          <!-- Your folders and Recent: a glyph instead of a monogram, so they read as yours at a glance (decision 7). -->
          <PathIcon Data="{Binding FolderGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                    IsVisible="{Binding HasFolderGlyph}" Width="128" Height="128" Foreground="{x:Static vm:HandheldTokens.OnFolder}" />
        </Grid>
      </Border>
    </Panel>
  </Viewbox>
</UserControl>
