<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:controls="using:EmuShelf.App.Controls"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             x:Class="EmuShelf.App.Views.HandheldStageView"
             x:DataType="vm:HandheldShellViewModel">

  <!--
    Handheld mode's top screen: whatever the Launcher has focused, shown large, with the name plate and
    the corner pills (status top-right, achievements bottom-left, button hints bottom-right). A pure view
    onto HandheldShellViewModel.Stage, drawn on a fixed 1920×1080 canvas and fitted, never cropped. The
    cover art and the folder faces carry the colour, over the era backdrop (HandheldEraBackdrop); the plate and
    pills are quiet white surfaces. The motion (the centre pop, the folder's flap, the launch landing) is
    HandheldStageMotion.
  -->

  <!-- The gradient fills the whole window, including any letterbox bands around the fitted canvas. -->
  <UserControl.Background>
    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Offset="0" Color="#F5F6F9" />
      <GradientStop Offset="1" Color="#E1E5EC" />
    </LinearGradientBrush>
  </UserControl.Background>

  <UserControl.Styles>
    <!-- Corner pills: one height, one padding, one type size. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#E6FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
    </Style>
    <Style Selector="TextBlock.pill-text">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- Room for a pill's shadow when the native Stage pictures it; the margins around it are 24 less. -->
    <Style Selector="Border.shot">
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.button-glyph">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="#4B5274" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <!--
    Backdrops fill the whole window. A folder or a game: its system's era motif in the system's colour (a
    pixel grid with drifting blocks for cartridges, scanlines with a rolling bar for discs; on a Title page
    without fan art, in the colour picked from the cover), crossfading when the focus changes system. Apps,
    empty slots and the menu keep the plain light gradient. A Title page with fan art: the art itself,
    full-bleed, darkened toward the logo and meta line.
  -->
  <vh:HandheldEraBackdrop x:Name="EraBackdrop" Backdrop="{Binding Stage.Backdrop}" />
  <Panel x:Name="HeroBackdrop" IsVisible="{Binding Stage.IsHeroArt}">
    <Image Source="{Binding Stage.Fanart}" Stretch="UniformToFill" />
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="#9E080A14" />
          <GradientStop Offset="0.52" Color="#2E080A14" />
          <GradientStop Offset="1" Color="#00080A14" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
          <GradientStop Offset="0" Color="#8C080A14" />
          <GradientStop Offset="0.42" Color="#00080A14" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Panel>

  <Viewbox Stretch="Uniform">
    <Grid x:Name="StageCanvas" Width="1920" Height="1080">

      <!-- What changes with the focus: the hero, the centre art and the plate. -->
      <Panel x:Name="StageContent">
      <!-- The Title page hero over the fan art: the logo (or the title set in type), then the meta line. -->
      <Panel x:Name="HeroContent" IsVisible="{Binding Stage.IsHeroArt}">
        <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="112,128,0,0" Width="808" Height="560">
          <Image Source="{Binding Stage.Logo}" IsVisible="{Binding Stage.HasLogo}" Stretch="Uniform"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
            <Image.Effect>
              <DropShadowEffect OffsetX="0" OffsetY="10" BlurRadius="26" Color="#8C000000" />
            </Image.Effect>
          </Image>
          <TextBlock Text="{Binding Stage.Title}" IsVisible="{Binding !Stage.HasLogo}" FontSize="96" FontWeight="SemiBold"
                     Foreground="White" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Panel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="112,0,0,76" MaxWidth="1150" Spacing="8">
          <TextBlock Text="{Binding Stage.Title}" IsVisible="{Binding Stage.HasLogo}" FontSize="40" FontWeight="SemiBold"
                     Foreground="White" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Stage.HasAchievements}">
              <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="34" Height="34" Foreground="#F2AE2E" />
              <TextBlock Text="{Binding Stage.AchievementText}" FontSize="32" FontWeight="SemiBold" Foreground="White"
                         VerticalAlignment="Center" FontFeatures="+tnum" />
            </StackPanel>
            <TextBlock Text="{Binding Stage.Subtitle}" FontSize="32" Foreground="#E6FFFFFF" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
          </StackPanel>
        </StackPanel>
      </Panel>

      <!--
        Centre: a folder, a game's cover, an app icon, or a glyph card; it sits above the plate. The wrapper
        fills the canvas above the plate, so the pop always grows from the same middle.
      -->
      <Panel x:Name="CentreWrap" Margin="0,0,0,160">
      <!-- The padding leaves room for the art's shadow when the native Stage pictures it (CentreShot). -->
      <Border x:Name="CentreShot" Padding="96" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Panel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Stage.IsCentreVisible}">
        <!-- A folder: after a beat its flap tilts so the first covers peek out; it swings open with the folder. -->
        <Panel IsVisible="{Binding Stage.IsFolder}">
          <vh:HandheldFolderArt x:Name="StageFolder" DataContext="{Binding Stage}" Width="448" Height="448" />
        </Panel>

        <Panel IsVisible="{Binding Stage.IsGame}">
          <!--
            The game's physical medium (case, cartridge, card) with its cover printed on, turned by the right
            stick, swaying at rest, springing in when the selection changes. Platforms without an authored
            medium, and devices whose GPU path fails, keep the flat cover below.
          -->
          <controls:Media3DControl x:Name="Medium" IsVisible="{Binding Stage.HasMedium}" Width="1400" Height="820"
                                   Shell="{Binding Stage.Medium}" Cover="{Binding Stage.Art}"
                                   Accent="{Binding Stage.MediumAccent}"
                                   Yaw="{Binding Stage.MediumYaw}" Pitch="{Binding Stage.MediumPitch}" />
          <Border IsVisible="{Binding Stage.HasFlatCover}">
          <Panel>
          <Border IsVisible="{Binding Stage.HasArt}" CornerRadius="24" ClipToBounds="True"
                  BoxShadow="0 28 64 0 #33000000" MaxHeight="640" MaxWidth="960">
            <Image Source="{Binding Stage.Art}" Stretch="Uniform" />
          </Border>
          <!-- No cover yet (or none at all): a finished-looking card with the title, not an empty hole. -->
          <Border IsVisible="{Binding !Stage.HasArt}" Width="448" Height="608" CornerRadius="24"
                  Background="#D5D9E4" BoxShadow="0 28 64 0 #29000000">
            <TextBlock Text="{Binding Stage.Title}" FontSize="40" FontWeight="SemiBold" Foreground="#5B6176"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          </Panel>
          </Border>
        </Panel>

        <Border IsVisible="{Binding Stage.IsApp}" Width="384" Height="384" CornerRadius="96" ClipToBounds="True"
                Background="#FFFFFF" BoxShadow="0 24 56 0 #2E000000">
          <Image Source="{Binding Stage.AppIcon}" Stretch="Uniform" Margin="32" />
        </Border>

        <!-- All apps, the menu, an empty slot, the folder header: a quiet card with what it is. -->
        <Border IsVisible="{Binding Stage.IsGlyph}" Width="384" Height="384" CornerRadius="96"
                Background="#FFFFFF" BorderBrush="#141C2033" BorderThickness="1" BoxShadow="0 16 40 0 #1F000000">
          <PathIcon Data="{Binding Stage.Glyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                    Width="144" Height="144" Foreground="#5B6176" />
        </Border>
      </Panel>
      </Border>
      </Panel>

      <!-- Name plate. -->
      <Panel x:Name="PlateWrap">
      <Border x:Name="PlateShot" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32">
      <Border IsVisible="{Binding Stage.HasPlate}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              MinWidth="560" MaxWidth="1080" Padding="48,20" CornerRadius="32"
              Background="#F2FFFFFF" BorderBrush="#141C2033" BorderThickness="1" BoxShadow="0 6 24 0 #14000000">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Stage.Title}" FontSize="52" FontWeight="SemiBold" Foreground="#1C2033"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Stage.Subtitle}" FontSize="28" Foreground="#5B6176" FontFeatures="+tnum"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      </Border>
      </Panel>
      </Panel>


      <!-- Launch: the cover that lifted off the Launcher lands here, then zooms into the emulator. -->
      <Border x:Name="LaunchFly" IsVisible="False" Width="448" Height="632" CornerRadius="28" ClipToBounds="True"
              HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D5D9E4"
              BorderBrush="#D9FFFFFF" BorderThickness="8" IsHitTestVisible="False">
        <Image x:Name="LaunchFlyImage" Stretch="UniformToFill" />
      </Border>

      <!-- The app's status message (launching, a failure), which Gamepad mode shows as a toast. -->
      <Border x:Name="MessageShot" Classes="shot" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
      <Border Classes="pill" IsVisible="{Binding HasStatusMessage}" MaxWidth="1080">
        <TextBlock Classes="pill-text" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </Border>
      </Border>

      <!-- Status pill: Wi-Fi, battery, time. -->
      <Border x:Name="StatusShot" Classes="shot" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0">
      <Border Classes="pill">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <!-- Wi-Fi: solid when connected, faded when not. -->
          <PathIcon Data="{x:Static vm:HandheldIcons.Wifi}" Width="32" Height="32" Foreground="#4B5274"
                    IsVisible="{Binding HasWifiState}" Opacity="{Binding WifiOpacity}" />
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasBattery}">
            <PathIcon Data="{x:Static vm:HandheldIcons.Charging}" Width="28" Height="28" Foreground="#4B5274"
                      IsVisible="{Binding IsCharging}" />
            <TextBlock Classes="pill-text" Text="{Binding BatteryText}" />
          </StackPanel>
          <TextBlock Classes="pill-text" Text="{Binding TimeText}" />
        </StackPanel>
      </Border>
      </Border>

      <!-- Achievements pill (games with RetroAchievements data). -->
      <Border x:Name="AchievementShot" Classes="shot" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,52">
      <Border Classes="pill" IsVisible="{Binding Stage.ShowAchievementPill}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="32" Height="32" Foreground="#C98A12" />
          <TextBlock Classes="pill-text" Text="{Binding Stage.AchievementText}" />
        </StackPanel>
      </Border>
      </Border>

      <!-- Button hints. -->
      <Border x:Name="HintsShot" Classes="shot" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,52">
      <Border Classes="pill">
        <ItemsControl ItemsSource="{Binding Hints}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="24" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldHint">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="button-glyph">
                  <Panel>
                    <TextBlock Text="{Binding Button}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    <PathIcon Data="{Binding Icon, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                              Width="24" Height="24" Foreground="White" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
                <TextBlock Classes="pill-text" Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      </Border>
    </Grid>
  </Viewbox>
  </Panel>
</UserControl>
