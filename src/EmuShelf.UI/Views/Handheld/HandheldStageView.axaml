<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:controls="using:EmuShelf.App.Controls"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             x:Class="EmuShelf.App.Views.HandheldStageView"
             x:DataType="vm:HandheldShellViewModel">

  <!--
    Handheld mode's top screen: whatever the Launcher has focused, shown large, with the name plate and
    the corner pills (status top-right, achievements bottom-left, button hints bottom-right). A pure view
    onto HandheldShellViewModel.Stage, drawn on a fixed 1920×1080 canvas (1240×1080 once the screens are swapped, M45 H5) and fitted, never cropped. The
    cover art and the folder faces carry the colour, over the era backdrop (HandheldEraBackdrop); the plate and
    pills are quiet white surfaces. The motion (the centre pop, the folder's flap, the launch landing) is
    HandheldStageMotion.
  -->

  <!-- The gradient fills the whole window, including any letterbox bands around the fitted canvas. -->
  <UserControl.Background>
    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicStageGroundTop}" />
      <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicStageGroundBottom}" />
    </LinearGradientBrush>
  </UserControl.Background>

  <UserControl.Styles>
    <!-- Corner pills: one height, one padding, one type size. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicPillFill}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicPillRadius}" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicPillShadow}" />
    </Style>
    <Style Selector="TextBlock.pill-text">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.StageCorner}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.StageCornerWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.StageInk}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- Room for a pill's shadow when the native Stage pictures it; the margins around it are 24 less. -->
    <Style Selector="Border.shot">
      <Setter Property="Padding" Value="24" />
    </Style>
    <!--
      Where the corner pieces sit, as styles so the narrow screen can move them (a value set on the element itself
      would win over any style). The narrow screen (M45 H5, the screens swapped): the bottom corners cannot share a
      row with the plate, so the hints and the achievements pill go top-left under the status pill's line, the
      message drops below them, the plate may take nearly the whole width, and the hero's logo and meta line and
      the medium fit the narrower canvas.
    -->
    <Style Selector="Border#HintsShot">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,24,52" />
    </Style>
    <Style Selector="Border#AchievementShot">
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="24,0,0,52" />
    </Style>
    <Style Selector="Border#MessageShot">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="Border#PlateBox">
      <Setter Property="MaxWidth" Value="1080" />
    </Style>
    <Style Selector="Panel#LogoBox">
      <Setter Property="Margin" Value="112,128,0,0" />
      <Setter Property="Width" Value="808" />
      <Setter Property="Height" Value="560" />
    </Style>
    <Style Selector="StackPanel#HeroMeta">
      <Setter Property="Margin" Value="112,0,0,76" />
      <Setter Property="MaxWidth" Value="1150" />
    </Style>
    <Style Selector="controls|Media3DControl#Medium">
      <Setter Property="Width" Value="1400" />
    </Style>
    <Style Selector="Grid.narrow Border#HintsShot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="24,24,0,0" />
    </Style>
    <Style Selector="Grid.narrow Border#AchievementShot">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="24,100,0,0" />
    </Style>
    <Style Selector="Grid.narrow Border#MessageShot">
      <Setter Property="Margin" Value="0,176,0,0" />
    </Style>
    <Style Selector="Grid.narrow Border#PlateBox">
      <Setter Property="MaxWidth" Value="1144" />
    </Style>
    <Style Selector="Grid.narrow Panel#LogoBox">
      <Setter Property="Margin" Value="64,176,0,0" />
      <Setter Property="Width" Value="768" />
      <Setter Property="Height" Value="400" />
    </Style>
    <Style Selector="Grid.narrow StackPanel#HeroMeta">
      <Setter Property="Margin" Value="64,0,64,76" />
      <Setter Property="MaxWidth" Value="1112" />
    </Style>
    <Style Selector="Grid.narrow controls|Media3DControl#Medium">
      <Setter Property="Width" Value="1240" />
    </Style>
    <!-- Settings' card (M45 H6a): as wide as the 16:9 Stage's medium, or the narrow canvas less the shot's padding. -->
    <Style Selector="Border#SettingCard">
      <Setter Property="Width" Value="1400" />
    </Style>
    <Style Selector="Grid.narrow Border#SettingCard">
      <Setter Property="Width" Value="1048" />
    </Style>
    <!-- A panel's card (M45 H6c), the same width as Settings'; its picture shrinks on the narrow canvas. -->
    <Style Selector="Border#PanelCard">
      <Setter Property="Width" Value="1400" />
    </Style>
    <Style Selector="Grid.narrow Border#PanelCard">
      <Setter Property="Width" Value="1048" />
    </Style>
    <Style Selector="Border.panel-picture">
      <Setter Property="Width" Value="360" />
      <Setter Property="Height" Value="480" />
    </Style>
    <Style Selector="Border.panel-picture.square">
      <Setter Property="Width" Value="320" />
      <Setter Property="Height" Value="320" />
    </Style>
    <Style Selector="Grid.narrow Border.panel-picture">
      <Setter Property="Width" Value="280" />
      <Setter Property="Height" Value="380" />
    </Style>
    <Style Selector="Grid.narrow Border.panel-picture.square">
      <Setter Property="Width" Value="240" />
      <Setter Property="Height" Value="240" />
    </Style>
    <Style Selector="TextBlock.panel-value">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="TextBlock.panel-value.warning">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Warning}" />
    </Style>
    <!-- The app's messages (M45 H6c): the pill's look, two lines at most, marked by what kind of message it is. -->
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicToastFill}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicPillRadius}" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="24,12,32,12" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicPillShadow}" />
      <Setter Property="MaxWidth" Value="1240" />
    </Style>
    <Style Selector="Border.toast.error">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicToastErrorFill}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicToastErrorEdge}" />
    </Style>
    <Style Selector="Border.toast PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Border.toast.error PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Warning}" />
    </Style>
    <Style Selector="Grid.narrow Border.toast">
      <Setter Property="MaxWidth" Value="1144" />
    </Style>
    <!-- In styles, not on the element: a value set on the element would beat the warning style. -->
    <Style Selector="TextBlock.setting-value">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="TextBlock.setting-value.warning">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Warning}" />
    </Style>
    <Style Selector="Border.button-glyph">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.StageHintGlyph}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.StageHintGlyph}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.StageHintGlyphRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.HintGlyphFill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <!--
    Backdrops fill the whole window. A folder or a game: its system's era motif in the system's colour (a
    pixel grid with drifting blocks for cartridges, scanlines with a rolling bar for discs; on a Title page
    without fan art, in the colour picked from the cover), crossfading when the focus changes system. Apps,
    empty slots and the menu keep the plain light gradient. A Title page with fan art: the art itself,
    full-bleed, darkened toward the logo and meta line.
  -->
  <!-- Big Type (M47 B4): the focused item's flat colour under everything, seen where no backdrop draws. -->
  <Border IsVisible="{x:Static vm:HandheldTokens.IsBigType}" Background="{Binding LauncherGroundBrush}" />
  <vh:HandheldEraBackdrop x:Name="EraBackdrop" Backdrop="{Binding Stage.Backdrop}" />
  <Panel x:Name="HeroBackdrop" IsVisible="{Binding Stage.IsHeroArt}">
    <Image Source="{Binding Stage.Fanart}" Stretch="UniformToFill" />
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicHeroVeilLeft}" />
          <GradientStop Offset="0.52" Color="{x:Static vm:HandheldTokens.ClassicHeroVeilMid}" />
          <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicHeroVeilClear}" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicHeroVeilFoot}" />
          <GradientStop Offset="0.42" Color="{x:Static vm:HandheldTokens.ClassicHeroVeilClear}" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Panel>

  <Viewbox Stretch="Uniform">
    <Grid x:Name="StageCanvas" Width="1920" Height="1080">

      <!-- Big Type (M47 B4): the veils behind the three text zones, in the dark ink at their resting strength. -->
      <vh:HandheldBigTypeVeils x:Name="BtVeils" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" Deep="{Binding StageDeep}"
                               NameBoxWidth="{Binding Stage.NameBoxWidth}" NameLeft="{x:Static vm:HandheldTokens.StageNameLeft}" />

      <!-- What changes with the focus: the hero, the centre art and the plate. -->
      <Panel x:Name="StageContent">
      <!-- The Title page hero over the fan art: the logo (or the title set in type), then the meta line. -->
      <Panel x:Name="HeroContent" IsVisible="{Binding Stage.IsHeroArt}">
        <Panel x:Name="LogoBox" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Image Source="{Binding Stage.Logo}" IsVisible="{Binding Stage.HasLogo}" Stretch="Uniform"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
            <Image.Effect>
              <DropShadowEffect OffsetX="0" OffsetY="10" BlurRadius="{x:Static vm:HandheldTokens.ClassicHeroTextShadowBlur}" Color="{x:Static vm:HandheldTokens.ClassicHeroTextShadow}" />
            </Image.Effect>
          </Image>
          <TextBlock Text="{Binding Stage.Title}" IsVisible="{Binding !Stage.HasLogo}" FontSize="{x:Static vm:HandheldTokens.HeroTitle}" FontWeight="{x:Static vm:HandheldTokens.HeroWeight}"
                     Foreground="{x:Static vm:HandheldTokens.OnHero}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Panel>
        <StackPanel x:Name="HeroMeta" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="8">
          <!-- The idle drift (M45 H6d) says why this game is on screen. -->
          <TextBlock Text="Recently played" IsVisible="{Binding Stage.IsDrift}" FontSize="{x:Static vm:HandheldTokens.HeroEyebrow}" FontWeight="{x:Static vm:HandheldTokens.HeroWeight}"
                     Foreground="{x:Static vm:HandheldTokens.OnHeroMuted}" />
          <TextBlock Text="{Binding Stage.Title}" IsVisible="{Binding Stage.HasLogo}" FontSize="{x:Static vm:HandheldTokens.HeroLogoTitle}" FontWeight="{x:Static vm:HandheldTokens.HeroWeight}"
                     Foreground="{x:Static vm:HandheldTokens.OnHero}" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Stage.HasAchievements}">
              <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="34" Height="34" Foreground="{x:Static vm:HandheldTokens.TrophyBright}" />
              <TextBlock Text="{Binding Stage.AchievementText}" FontSize="{x:Static vm:HandheldTokens.HeroLine}" FontWeight="{x:Static vm:HandheldTokens.HeroWeight}" Foreground="{x:Static vm:HandheldTokens.OnHero}"
                         VerticalAlignment="Center" FontFeatures="+tnum" />
            </StackPanel>
            <TextBlock Text="{Binding Stage.Subtitle}" FontSize="{x:Static vm:HandheldTokens.HeroLine}" Foreground="{x:Static vm:HandheldTokens.OnHeroSoft}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
          </StackPanel>
        </StackPanel>
      </Panel>

      <!--
        Centre: a folder, a game's cover, an app icon, or a glyph card; it sits above the plate. The wrapper
        fills the canvas above the plate, so the pop always grows from the same middle.
      -->
      <Panel x:Name="CentreWrap" Margin="0,0,0,160">
      <!-- The padding leaves room for the art's shadow when the native Stage pictures it (CentreShot). -->
      <Border x:Name="CentreShot" Padding="96" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Panel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Stage.IsCentreVisible}">
        <!-- A folder: after a beat its flap tilts so the first covers peek out; it swings open with the folder. -->
        <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <Panel IsVisible="{Binding Stage.IsFolder}">
          <vh:HandheldFolderArt x:Name="StageFolder" DataContext="{Binding Stage}" Width="448" Height="448" />
        </Panel>
        </Panel>

        <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <Panel IsVisible="{Binding Stage.IsGame}">
          <!--
            The game's physical medium (case, cartridge, card) with its cover printed on, turned by the right
            stick, swaying at rest, springing in when the selection changes. Platforms without an authored
            medium, and devices whose GPU path fails, keep the flat cover below.
          -->
          <controls:Media3DControl x:Name="Medium" IsVisible="{Binding Stage.HasMedium}" Height="820"
                                   Shell="{Binding Stage.Medium}" Cover="{Binding Stage.Art}"
                                   Accent="{Binding Stage.MediumAccent}"
                                   Yaw="{Binding Stage.MediumYaw}" Pitch="{Binding Stage.MediumPitch}" />
          <Border IsVisible="{Binding Stage.HasFlatCover}">
          <Panel>
          <Border IsVisible="{Binding Stage.HasArt}" CornerRadius="{x:Static vm:HandheldTokens.StageArtRadius}" ClipToBounds="True"
                  BoxShadow="{x:Static vm:HandheldTokens.ClassicStageArtShadow}" MaxHeight="640" MaxWidth="960">
            <Image Source="{Binding Stage.Art}" Stretch="Uniform" />
          </Border>
          <!-- No cover yet (or none at all): a finished-looking card with the title, not an empty hole. -->
          <Border IsVisible="{Binding !Stage.HasArt}" Width="448" Height="608" CornerRadius="{x:Static vm:HandheldTokens.StageArtRadius}"
                  Background="{x:Static vm:HandheldTokens.CoverPlaceholder}" BoxShadow="{x:Static vm:HandheldTokens.ClassicStagePlaceholderShadow}">
            <TextBlock Text="{Binding Stage.Title}" FontSize="{x:Static vm:HandheldTokens.StageCoverTitle}" FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}" Foreground="{x:Static vm:HandheldTokens.StageInkMuted}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          </Panel>
          </Border>
        </Panel>
        </Panel>

        <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <Border IsVisible="{Binding Stage.IsApp}" Width="384" Height="384" CornerRadius="{x:Static vm:HandheldTokens.StageAppRadius}" ClipToBounds="True"
                Background="{x:Static vm:HandheldTokens.ClassicSurface}" BoxShadow="{x:Static vm:HandheldTokens.ClassicStageAppShadow}">
          <Image Source="{Binding Stage.AppIcon}" Stretch="Uniform" Margin="32" />
        </Border>

        <!-- The Settings tile (decision 18): its glyph on the indigo accent, the way a dock app shows its icon. -->
        <Border IsVisible="{Binding Stage.IsSettingsTile}" Width="384" Height="384" CornerRadius="{x:Static vm:HandheldTokens.StageAppRadius}"
                BoxShadow="{x:Static vm:HandheldTokens.ClassicStageSettingsShadow}">
          <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicSettingsFaceTop}" />
              <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicSettingsFaceBottom}" />
            </LinearGradientBrush>
          </Border.Background>
          <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="176" Height="176" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
        </Border>

        <!-- The Activity tile (M46 P4): its glyph on its teal, as the Settings tile shows on the accent. -->
        <Border IsVisible="{Binding Stage.IsActivityTile}" Width="384" Height="384" CornerRadius="{x:Static vm:HandheldTokens.StageAppRadius}"
                BoxShadow="{x:Static vm:HandheldTokens.ClassicStageActivityShadow}">
          <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicActivityFaceTop}" />
              <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicActivityFaceBottom}" />
            </LinearGradientBrush>
          </Border.Background>
          <PathIcon Data="{x:Static vm:HandheldIcons.Activity}" Width="176" Height="176" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
        </Border>
        </Panel>

        <!--
          Settings open (M45 H6a): the detail half of its master-detail. Where the focused row sits, what it is, its value,
          its description, and the section's status line (a scan's progress, an account) when there is one.
        -->
        <Border x:Name="SettingCard" IsVisible="{Binding Stage.ShowsSettingCard}" MinHeight="420" CornerRadius="{x:Static vm:HandheldTokens.StageCardRadius}"
                Background="{x:Static vm:HandheldTokens.ClassicSurface}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1" BoxShadow="{x:Static vm:HandheldTokens.ClassicStageCardShadow}"
                Padding="72,56">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Border Width="56" Height="56" CornerRadius="{x:Static vm:HandheldTokens.StageCardGlyphRadius}" Background="{x:Static vm:HandheldTokens.ClassicAccent}" VerticalAlignment="Center">
                <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="32" Height="32" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
              </Border>
              <TextBlock Text="{Binding Stage.SettingEyebrow}" FontSize="{x:Static vm:HandheldTokens.CardEyebrow}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}" Foreground="{x:Static vm:HandheldTokens.StageInkMuted}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding Stage.Title}" FontSize="{x:Static vm:HandheldTokens.CardTitle}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}" Foreground="{x:Static vm:HandheldTokens.StageInk}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="setting-value" Classes.warning="{Binding Stage.IsSettingWarning}" Text="{Binding Stage.SettingValue}"
                       IsVisible="{Binding Stage.HasSettingValue}" FontSize="{x:Static vm:HandheldTokens.CardValue}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
            <TextBlock Text="{Binding Stage.SettingDescription}" IsVisible="{Binding Stage.HasSettingDescription}" FontSize="{x:Static vm:HandheldTokens.CardDescription}"
                       Foreground="{x:Static vm:HandheldTokens.StageInkSoft}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" LineHeight="{x:Static vm:HandheldTokens.CardDescriptionLineHeight}" />
            <Border IsVisible="{Binding Stage.HasSettingStatus}" Background="{x:Static vm:HandheldTokens.ClassicCardInsetFill}" CornerRadius="{x:Static vm:HandheldTokens.CardInsetRadius}" Padding="24,14"
                    Margin="0,6,0,0" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Stage.SettingStatus}" FontSize="{x:Static vm:HandheldTokens.CardStatus}" Foreground="{x:Static vm:HandheldTokens.StageInkSoft}" TextWrapping="Wrap" MaxLines="3"
                         TextTrimming="CharacterEllipsis" />
            </Border>
          </StackPanel>
        </Border>

        <!--
          A panel open (M45 H6c): the scraper's field or preview, a cover found on the web, an achievement's badge, Search's
          matches fanned out, a title as typed. Where it is, what it is, its value large, a description, a status line.
        -->
        <Border x:Name="PanelCard" IsVisible="{Binding Stage.ShowsPanelCard}" MinHeight="420" CornerRadius="{x:Static vm:HandheldTokens.StageCardRadius}"
                Background="{x:Static vm:HandheldTokens.ClassicSurface}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1" BoxShadow="{x:Static vm:HandheldTokens.ClassicStageCardShadow}"
                Padding="64,52">
          <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Stage.PanelCard}" x:DataType="vm:HandheldPanelCard">
            <Border Classes="panel-picture" Classes.square="{Binding IsSquareImage}" IsVisible="{Binding HasImage}"
                    CornerRadius="{x:Static vm:HandheldTokens.PanelPictureRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.ClassicPictureFill}" Margin="0,0,56,0" VerticalAlignment="Center">
              <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Center">
              <!-- Search's first matches, fanned out. -->
              <ItemsControl ItemsSource="{Binding FanCovers}" IsVisible="{Binding HasFan}" HorizontalAlignment="Center" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="-44" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HandheldFanCover">
                    <Border Width="172" Height="236" CornerRadius="{x:Static vm:HandheldTokens.FanCoverRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}"
                            BorderBrush="{x:Static vm:HandheldTokens.ClassicEdge}" BorderThickness="6" BoxShadow="{x:Static vm:HandheldTokens.ClassicFanCoverShadow}"
                            RenderTransform="{Binding Transform}">
                      <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="56" Height="56" CornerRadius="{x:Static vm:HandheldTokens.StageCardGlyphRadius}" Background="{x:Static vm:HandheldTokens.ClassicAccent}" VerticalAlignment="Center"
                        IsVisible="{Binding HasGlyph}">
                  <PathIcon Data="{Binding Glyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}" Width="32" Height="32"
                            Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                </Border>
                <TextBlock Text="{Binding Eyebrow}" FontSize="{x:Static vm:HandheldTokens.CardEyebrow}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}" Foreground="{x:Static vm:HandheldTokens.StageInkMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1100" />
              </StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="{x:Static vm:HandheldTokens.PanelCardTitle}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}" Foreground="{x:Static vm:HandheldTokens.StageInk}"
                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="panel-value" Classes.warning="{Binding IsWarning}" Text="{Binding Value}"
                         IsVisible="{Binding HasValue}" FontSize="{x:Static vm:HandheldTokens.CardValue}" FontWeight="{x:Static vm:HandheldTokens.CardWeight}"
                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
              <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="{x:Static vm:HandheldTokens.CardDescription}"
                         Foreground="{x:Static vm:HandheldTokens.StageInkSoft}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" LineHeight="{x:Static vm:HandheldTokens.CardDescriptionLineHeight}" />
              <!-- A run's progress (the batch scraper): a static bar, pictured once per step. -->
              <Border IsVisible="{Binding HasProgress}" Height="16" CornerRadius="{x:Static vm:HandheldTokens.CardProgressRadius}" Background="{x:Static vm:HandheldTokens.CardProgressTrack}" ClipToBounds="True">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="16" MinHeight="16"
                             CornerRadius="{x:Static vm:HandheldTokens.CardProgressRadius}" Background="Transparent" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}" />
              </Border>
              <Border IsVisible="{Binding HasStatus}" Background="{x:Static vm:HandheldTokens.ClassicCardInsetFill}" CornerRadius="{x:Static vm:HandheldTokens.CardInsetRadius}" Padding="24,14"
                      Margin="0,6,0,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}" FontSize="{x:Static vm:HandheldTokens.CardStatus}" Foreground="{x:Static vm:HandheldTokens.StageInkSoft}" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- All apps, the menu, an empty slot, the folder header: a quiet card with what it is. -->
        <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <Border IsVisible="{Binding Stage.IsGlyph}" Width="384" Height="384" CornerRadius="{x:Static vm:HandheldTokens.StageAppRadius}"
                Background="{x:Static vm:HandheldTokens.ClassicSurface}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1" BoxShadow="{x:Static vm:HandheldTokens.ClassicStageGlyphCardShadow}">
          <PathIcon Data="{Binding Stage.Glyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                    Width="144" Height="144" Foreground="{x:Static vm:HandheldTokens.StageInkMuted}" />
        </Border>
        </Panel>
      </Panel>
      </Border>
      </Panel>

      <!-- Name plate. -->
      <Panel x:Name="PlateWrap">
      <Border x:Name="PlateShot" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32">
      <Border x:Name="PlateBox" IsVisible="{Binding Stage.HasPlate}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              MinWidth="560" Padding="48,20" CornerRadius="{x:Static vm:HandheldTokens.ClassicPlateRadius}"
              Background="{x:Static vm:HandheldTokens.ClassicPlateFill}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1" BoxShadow="{x:Static vm:HandheldTokens.ClassicPlateShadow}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Stage.Title}" FontSize="{x:Static vm:HandheldTokens.DisplayName}" FontWeight="{x:Static vm:HandheldTokens.DisplayNameWeight}" Foreground="{x:Static vm:HandheldTokens.StageInk}"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Stage.Subtitle}" FontSize="{x:Static vm:HandheldTokens.Line}" Foreground="{x:Static vm:HandheldTokens.StageInkMuted}" FontFeatures="+tnum"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      </Border>
      </Panel>
      </Panel>


      <!--
        Big Type (M47 B4): the name is the picture, with plain type in the corners and a game's medium (or its flat cover) in
        its own corner. Each corner is its own shot for the native Stage, which draws it in its zone's ink. Text is white here:
        the Avalonia Stage runs no backdrop shader, and over the pictured fallback the rule gives white.
      -->
      <Panel x:Name="BigTypeStage" IsVisible="{x:Static vm:HandheldTokens.IsBigType}">
        <controls:Media3DControl x:Name="BtMedium" IsVisible="{Binding Stage.HasBigTypeMedium}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.StageMediumFrameMargin}"
                                 Width="{x:Static vm:HandheldTokens.StageMediumFrameWidth}" Height="{x:Static vm:HandheldTokens.StageMediumFrameHeight}"
                                 Shell="{Binding Stage.Medium}" Cover="{Binding Stage.Art}" Accent="{Binding Stage.MediumAccent}"
                                 Yaw="{Binding Stage.MediumYaw}" Pitch="{Binding Stage.MediumPitch}" />
        <Border x:Name="BtCoverShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{Binding Stage.HasBigTypeCover}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="{x:Static vm:HandheldTokens.StageCoverMargin}" Width="{x:Static vm:HandheldTokens.StageMediumWidth}" Height="{x:Static vm:HandheldTokens.StageMediumHeight}">
          <Panel>
            <Panel IsVisible="{Binding !Stage.HasListCover}">
            <Border IsVisible="{Binding Stage.HasArt}" CornerRadius="{x:Static vm:HandheldTokens.StageCoverRadius}" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding Stage.Art}" Stretch="Uniform" />
            </Border>
            <Border IsVisible="{Binding !Stage.HasArt}" CornerRadius="{x:Static vm:HandheldTokens.StageCoverRadius}" Background="{x:Static vm:HandheldTokens.StageNoCoverFill}"
                    Padding="{x:Static vm:HandheldTokens.StageNoCoverPadding}">
              <TextBlock Text="{Binding Stage.Title}" FontSize="{x:Static vm:HandheldTokens.StageNoCoverTitle}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}"
                         LineHeight="{x:Static vm:HandheldTokens.StageNoCoverTitleLineHeight}" Foreground="{x:Static vm:HandheldTokens.StageBigTypeInk}" TextWrapping="Wrap"
                         TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            </Panel>
            <!-- Cover search's candidate, where the game's cover would be (M47 B7). -->
            <Border IsVisible="{Binding Stage.HasListCover}" CornerRadius="{x:Static vm:HandheldTokens.StageCoverRadius}" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding Stage.ListCover}" Stretch="Uniform" />
            </Border>
          </Panel>
        </Border>

        <vh:HandheldBigTypeName x:Name="BtName" RenderOptions.TextRenderingMode="Antialias" IsTyped="{Binding Stage.IsTyped}" IsPlaceholder="{Binding Stage.IsPlaceholder}"
                                Text="{Binding Stage.Name}" IsVisible="{Binding Stage.HasBigTypeName}"
                                TextOpacity="{Binding Stage.NameOpacity}" Foreground="{Binding StageInk}"
                                BoxHeight="{x:Static vm:HandheldTokens.StageNameHeight}"
                                Width="{Binding Stage.NameBoxWidth}" Height="{x:Static vm:HandheldTokens.StageNameControlHeight}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{x:Static vm:HandheldTokens.StageNameMargin}" />

        <Border x:Name="BtLabelShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{Binding Stage.HasBigTypeName}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="{x:Static vm:HandheldTokens.StageLabelShotMargin}" Padding="{x:Static vm:HandheldTokens.StageShotPadding}">
          <TextBlock Text="{Binding Stage.Label}" FontSize="{x:Static vm:HandheldTokens.StageLabel}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}" Foreground="{Binding StageInk}" />
        </Border>
        <Border x:Name="BtLineShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{Binding Stage.HasBigTypeName}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="{x:Static vm:HandheldTokens.StageLineShotMargin}" Padding="{x:Static vm:HandheldTokens.StageShotPadding}">
          <vh:HandheldRollingText x:Name="BtLine" Text="{Binding Stage.Line}" FontSize="{x:Static vm:HandheldTokens.StageLine}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}" Foreground="{Binding StageInk}" FontFeatures="+tnum"
                                  TextTrimming="CharacterEllipsis" />
        </Border>
        <Border x:Name="BtFactsShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{Binding Stage.HasBigTypeName}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="{x:Static vm:HandheldTokens.StageFactsShotMargin}" Padding="{x:Static vm:HandheldTokens.StageShotPadding}">
          <TextBlock x:Name="BtFacts" Text="{Binding Stage.Facts}" FontSize="{x:Static vm:HandheldTokens.StageFacts}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}" Foreground="{Binding StageFactsInk}" FontFeatures="+tnum"
                     TextTrimming="CharacterEllipsis" />
        </Border>
      </Panel>

      <!-- Launch: the cover that lifted off the Launcher lands here, then zooms into the emulator. -->
      <Border x:Name="LaunchFly" IsVisible="False" Width="{x:Static vm:HandheldTokens.LaunchCardWidth}" Height="{x:Static vm:HandheldTokens.LaunchCardHeight}" CornerRadius="{x:Static vm:HandheldTokens.LaunchCardRadius}" ClipToBounds="True"
              HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}"
              BorderBrush="{x:Static vm:HandheldTokens.ClassicLaunchCardEdge}" BorderThickness="{x:Static vm:HandheldTokens.ClassicLaunchCardEdgeThickness}" IsHitTestVisible="False">
        <Image x:Name="LaunchFlyImage" Stretch="UniformToFill" />
      </Border>

      <!--
        The app's messages, which Gamepad mode shows as a toast (M45 H6c): a launch, a sync, a scan, a scrape finished, an
        update to install, what an edit did; a failure says so in the warning colour with the alert mark.
      -->
      <Border x:Name="MessageShot" Classes="shot" HorizontalAlignment="Center" VerticalAlignment="Top">
      <Border Classes="toast" Classes.error="{Binding IsStatusError}" IsVisible="{Binding HasStatusMessage}">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <PathIcon Data="{Binding StatusGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}" Width="30" Height="30"
                    VerticalAlignment="Center" IsVisible="{Binding HasStatusGlyph}" />
          <TextBlock Classes="pill-text" Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxLines="2" LineHeight="{x:Static vm:HandheldTokens.StageCornerLineHeight}"
                     TextTrimming="CharacterEllipsis" MaxWidth="1080" />
        </StackPanel>
      </Border>
      </Border>

      <!-- Status pill: Wi-Fi, battery, time. -->
      <Border x:Name="StatusShot" Classes="shot" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0" IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
      <Border Classes="pill">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <!-- Wi-Fi: solid when connected, faded when not. -->
          <PathIcon Data="{x:Static vm:HandheldIcons.Wifi}" Width="32" Height="32" Foreground="{x:Static vm:HandheldTokens.StageGlyph}"
                    IsVisible="{Binding HasWifiState}" Opacity="{Binding WifiOpacity}" />
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasBattery}">
            <PathIcon Data="{x:Static vm:HandheldIcons.Charging}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.StageGlyph}"
                      IsVisible="{Binding IsCharging}" />
            <TextBlock Classes="pill-text" Text="{Binding BatteryText}" />
          </StackPanel>
          <TextBlock Classes="pill-text" Text="{Binding TimeText}" />
        </StackPanel>
      </Border>
      </Border>

      <!-- Achievements pill (games with RetroAchievements data). -->
      <Border x:Name="AchievementShot" Classes="shot" HorizontalAlignment="Left" IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
      <Border Classes="pill" IsVisible="{Binding Stage.ShowAchievementPill}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="32" Height="32" Foreground="{x:Static vm:HandheldTokens.Trophy}" />
          <TextBlock Classes="pill-text" Text="{Binding Stage.AchievementText}" />
        </StackPanel>
      </Border>
      </Border>

      <!-- Button hints. -->
      <!-- No hints (the idle drift, M45 H6d): no pill. -->
      <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
      <Border x:Name="HintsShot" Classes="shot" IsVisible="{Binding !!Hints.Count}">
      <Border Classes="pill">
        <ItemsControl ItemsSource="{Binding Hints}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="24" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldHint">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="button-glyph">
                  <Panel>
                    <TextBlock Text="{Binding Button}" FontSize="{x:Static vm:HandheldTokens.HintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.HintGlyphWeight}" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    <PathIcon Data="{Binding Icon, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                              Width="24" Height="24" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
                <TextBlock Classes="pill-text" Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      </Border>
      </Panel>

      <!-- Big Type (M47 B4): battery and clock top right, the hints bottom right, as plain type. -->
      <Border x:Name="BtStatusShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="{x:Static vm:HandheldTokens.StageStatusShotMargin}" Padding="{x:Static vm:HandheldTokens.StageShotPadding}">
        <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.StageStatusGap}">
          <vh:HandheldRollingText Text="{Binding BatteryText}" IsVisible="{Binding HasBattery}" FontSize="{x:Static vm:HandheldTokens.StageBattery}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}"
                     Margin="{x:Static vm:HandheldTokens.StageBatteryMargin}"
                     VerticalAlignment="Bottom" Foreground="{Binding StageBatteryInk}" FontFeatures="+tnum" />
          <vh:HandheldRollingText Text="{Binding TimeText}" FontSize="{x:Static vm:HandheldTokens.StageClock}" FontWeight="{x:Static vm:HandheldTokens.WeightDisplay}" LetterSpacing="{x:Static vm:HandheldTokens.StageClockSpacing}" VerticalAlignment="Bottom" Foreground="{Binding StageInk}" FontFeatures="+tnum" />
        </StackPanel>
      </Border>
      <Border x:Name="BtHintsShot" RenderOptions.TextRenderingMode="Antialias" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="{x:Static vm:HandheldTokens.StageHintsShotMargin}" Padding="{x:Static vm:HandheldTokens.StageShotPadding}">
        <ItemsControl ItemsSource="{Binding Hints}" Foreground="{Binding StageInk}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.StageHintGap}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldHint">
              <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.StageHintGlyphGap}">
                <Border Width="{x:Static vm:HandheldTokens.StageHintGlyphOuter}" Height="{x:Static vm:HandheldTokens.StageHintGlyphOuter}" CornerRadius="{x:Static vm:HandheldTokens.StageHintGlyphCorner}"
                        BorderThickness="{x:Static vm:HandheldTokens.StageHintGlyphStroke}" BorderBrush="{Binding $parent[ItemsControl].Foreground}" VerticalAlignment="Center">
                  <Panel>
                    <TextBlock Text="{Binding Button}" FontSize="{x:Static vm:HandheldTokens.StageHintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.WeightDisplay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    <PathIcon Data="{Binding Icon, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                              Width="{x:Static vm:HandheldTokens.StageHintGlyphIcon}" Height="{x:Static vm:HandheldTokens.StageHintGlyphIcon}" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.StageHint}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!--
        Big Type (M47 B8, the mock's launch): the console's colour takes the Stage over through a circle from the case (HandheldStageMotion
        clips it), the title's letters land in it and the status line rolls under it. Over everything else; it fades when the game ends.
      -->
      <Panel x:Name="BtLaunch" IsVisible="{Binding IsPlaying}" IsHitTestVisible="False">
        <Border x:Name="BtLaunchColour" Background="{Binding Playing.ColourBrush, FallbackValue={x:Null}}" />
        <StackPanel x:Name="BtLaunchBlock" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{x:Static vm:HandheldTokens.LaunchGap}">
          <vh:HandheldBigTypeLaunchTitle x:Name="BtLaunchTitle" RenderOptions.TextRenderingMode="Antialias" HorizontalAlignment="Center"
                                         Text="{Binding Playing.Title, FallbackValue={x:Null}}" Started="{Binding Playing.Started, FallbackValue=0}" />
          <Border x:Name="BtLaunchStatusShot" RenderOptions.TextRenderingMode="Antialias" HorizontalAlignment="Center" Padding="{x:Static vm:HandheldTokens.StageShotPadding}"
                  Margin="{x:Static vm:HandheldTokens.LaunchStatusShotMargin}">
            <vh:HandheldRollingText x:Name="BtLaunchStatus" Text="{Binding Playing.Status, FallbackValue={x:Null}}" FontSize="{x:Static vm:HandheldTokens.LaunchStatus}"
                                    FontWeight="{x:Static vm:HandheldTokens.WeightStrong}" Foreground="{x:Static vm:HandheldTokens.LaunchStatusInk}" FontFeatures="+tnum" />
          </Border>
        </StackPanel>
      </Panel>
    </Grid>
  </Viewbox>
  </Panel>
</UserControl>
