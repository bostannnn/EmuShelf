<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:controls="using:EmuShelf.App.Controls"
             xmlns:ai="using:Avalonia.Input"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             x:Class="EmuShelf.App.Views.HandheldCompanionView"
             x:DataType="vm:HandheldCompanionViewModel">

  <!--
    Handheld mode's companion (M45 H6b): the bottom screen while a game runs, in a darker version of the Launcher's
    look so it doesn't pull the eye from the game. From the top: a slim Now playing row, the Achievements / Photos tabs,
    one big panel showing the chosen tab, and the dock. Over it: every badge (A on the panel), the photo viewer, All
    apps. Resting, it dims to a faint cover and title. Drawn on a fixed canvas, 1240×1080 on the bottom screen or
    1920×1080 on the 16:9 one (the companion takes whichever screen the game does not use), fitted, never cropped.
    The same view, without its body, shows All apps and the badge grid when they open over the Launcher.

    Rhythm as on the Launcher: a 48 px edge, a 4 px grid, radii that nest. The one accent is the selector, a lighter
    indigo on the dark ground with the Launcher's white keylines; the gold is the achievements'.
  -->

  <UserControl.Styles>
    <!-- ===== The selector: white keyline, indigo frame, white keyline, a soft glow (the mockup's ring) ===== -->
    <Style Selector="Border.ring">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicRingKeyline}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.ClassicCompanionRingOuterKeylineThickness}" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicCompanionRingGlow}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ring > Border">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.CompanionRing}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.CompanionRingStrokeThickness}" />
    </Style>
    <Style Selector="Border.ring > Border > Border">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicRingKeyline}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.ClassicCompanionRingInnerKeylineThickness}" />
    </Style>
    <Style Selector="Panel.focused > Border.ring">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The focused element lifts a little on the pop curve, as the Launcher's do. -->
    <Style Selector="Panel.lift">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.34" Y1="1.42" X2="0.64" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.lift.focused">
      <Setter Property="RenderTransform" Value="scale(1.13)" />
    </Style>
    <Style Selector="Panel#PanelBox.lift.focused">
      <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>

    <!-- ===== Type ===== -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInk}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInkMuted}" />
    </Style>
    <Style Selector="TextBlock.quiet">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInkQuiet}" />
    </Style>

    <!-- ===== Tabs and chips ===== -->
    <Style Selector="Border.tab">
      <Setter Property="Height" Value="80" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CompanionTabRadius}" />
      <Setter Property="Padding" Value="32,0" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicCompanionTabFill}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.CompanionTab}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.CompanionWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInkSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tab PathIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInkSoft}" />
    </Style>
    <Style Selector="Border.tab.on">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CompanionTabOn}" />
    </Style>
    <Style Selector="Border.tab.on TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionTabOnInk}" />
    </Style>
    <Style Selector="Border.tab.on PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionTabOnInk}" />
    </Style>
    <Style Selector="Border.tab.small">
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CompanionTabSmallRadius}" />
      <Setter Property="Padding" Value="24,0" />
    </Style>
    <Style Selector="Border.tab.small TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.CompanionTabSmall}" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- A round touch target in a layer's header (Refresh, Close, Clear slot). -->
    <Style Selector="Border.chip">
      <Setter Property="Height" Value="72" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CompanionChipRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicCompanionChipFill}" />
      <Setter Property="Padding" Value="20,0" />
    </Style>
    <Style Selector="Border.chip PathIcon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInk}" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.CompanionChip}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.CompanionWeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Button hints: a round glyph and what it does ===== -->
    <Style Selector="Border.glyph">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CompanionHintGlyphRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CompanionHintGlyphFill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.glyph TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.HintGlyphLetter}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.HintGlyphWeight}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.CompanionHint}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.CompanionWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.CompanionInkSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Refresh turns while a refresh is in flight (bound to the model's flag, only while the grid is up). -->
    <Style Selector="PathIcon.spin">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- ===== Badges ===== -->
    <Style Selector="Panel.badge.locked Image">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.badge-face">
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CompanionBadgeRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CompanionTileRest}" />
    </Style>
    <Style Selector="Border.badge-face.hardcore">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.AchievementGold}" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>

    <!-- ===== Entrances (the mockup's: up and in on the spring; layers a little less far) ===== -->
    <Style Selector="Grid#Body[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.46" FillMode="Backward">
          <Animation.Easing>
            <SplineEasing X1="0.3" Y1="1.3" X2="0.5" Y2="1" />
          </Animation.Easing>
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="64" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Grid.layer[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.34" FillMode="Backward">
          <Animation.Easing>
            <SplineEasing X1="0.3" Y1="1.3" X2="0.5" Y2="1" />
          </Animation.Easing>
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="54" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel#ViewerLayer[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.28" FillMode="Backward">
          <Animation.Easing>
            <CubicEaseOut />
          </Animation.Easing>
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- ===== Rest: a near-black wash with the game's cover and title faintly over it ===== -->
    <Style Selector="Panel#RestLayer">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#RestLayer.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- ===== All apps: dark in a game, the Launcher's light look over the Launcher ===== -->
    <Style Selector="Grid#DrawerLayer">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CompanionDrawerGround}" />
    </Style>
    <Style Selector="Border.app-face">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.CompanionTileRest}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.app-face">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
          <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Grid#DrawerLayer.light TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.MenuRowInk}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light TextBlock.hint">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.glyph">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.HintGlyphFill}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.glyph TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.HintGlyphInk}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.chip">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.chip PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Glyph}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.ring > Border">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.Ring}" />
    </Style>
    <Style Selector="Grid#DrawerLayer.light Border.ring">
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicCompanionRingGlowLight}" />
    </Style>
    <!-- ===== Big Type (M47 B8) ===== -->
    <!--
      The mock sets every line at line-height 1.15 and clips none of them; a TextBlock clips to its own box, and this face's
      descenders fall below a 1.15 box, so the companion's text draws past its box as the mock's does (the tops stay put).
      A rolling text's pieces are still cut to their own cells while they roll.
    -->
    <Style Selector="Panel#BtBody TextBlock">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="TextBlock.bt-label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.InGameLabel}" />
      <Setter Property="LineHeight" Value="{x:Static vm:HandheldTokens.InGameLabelLine}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightStrong}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="Opacity" Value="{x:Static vm:HandheldTokens.InGameLabelOpacity}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.bt-tab">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.InGameTab}" />
      <Setter Property="LineHeight" Value="{x:Static vm:HandheldTokens.InGameTabLine}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightStrong}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="Opacity" Value="{x:Static vm:HandheldTokens.InGameTabRestOpacity}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{x:Static vm:HandheldTokens.InGameTabFade}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.bt-tab.on">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.bt-stat">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.InGameStat}" />
      <Setter Property="LineHeight" Value="{x:Static vm:HandheldTokens.InGameStatLine}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightDisplay}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.bt-stat-label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.InGameStatLabel}" />
      <Setter Property="LineHeight" Value="{x:Static vm:HandheldTokens.InGameStatLabelLine}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightStrong}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="Opacity" Value="{x:Static vm:HandheldTokens.InGameStatLabelOpacity}" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="{x:Static vm:HandheldTokens.InGameStatLabelMargin}" />
    </Style>
    <Style Selector="TextBlock.bt-corner">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.DockCorner}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightStrong}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="Opacity" Value="{x:Static vm:HandheldTokens.DockCornerOpacity}" />
    </Style>
    <Style Selector="Panel.bt-dock Border.bt-dock-face">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.TileRest}" />
    </Style>
    <Style Selector="Panel.bt-dock PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
    </Style>
    <Style Selector="Panel.bt-dock.focused Border.bt-dock-face">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.TileFocus}" />
    </Style>
    <Style Selector="Panel.bt-dock.focused PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[UserControl].((vm:HandheldCompanionViewModel)DataContext).InGameBrush, FallbackValue={x:Null}}" />
    </Style>
    <Style Selector="Panel.bt-dock Border.bt-ring">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.bt-dock.focused Border.bt-ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Panel.bt-dock.focused">
      <Setter Property="RenderTransform" Value="{x:Static vm:HandheldTokens.InGameDockFocusTransform}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root">
    <!-- The companion's ground fills the window, letterbox included. -->
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="130%" RadiusY="95%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicCompanionGroundTop}" />
          <GradientStop Offset="0.58" Color="{x:Static vm:HandheldTokens.ClassicCompanionGroundMid}" />
          <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicCompanionGroundBottom}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <!-- Big Type (M47 B8): the in-game colour, the console's mixed toward the dark, letterbox included. -->
    <Border Background="{Binding InGameBrush}" IsVisible="{Binding ShowsBigTypeBody}" />

    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid x:Name="Canvas" Width="1240" Height="1080" ClipToBounds="False">

        <!--
          ===================== Big Type (M47 B8): the companion while a game runs, as type on the in-game colour =====================
          The mock's in-game screen: Now playing, the title, three tabs, the session's time (or the achievements figure, or six photos),
          the bar; the dock row keeps today's dock (All apps and the pinned apps) in the Launcher's dock style. Each part arrives and
          leaves on HandheldCompanionMotion's clock; the whole rests to InGameRestOpacity.
        -->
        <Panel x:Name="BtBody" IsVisible="{Binding ShowsBigTypeBody}" RenderOptions.TextRenderingMode="Antialias" ClipToBounds="False">
          <TextBlock x:Name="BtKicker" Classes="bt-label" Text="Now playing" Margin="{x:Static vm:HandheldTokens.InGameKickerMargin}" />
          <Viewbox x:Name="BtTitle" ClipToBounds="False" Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="{x:Static vm:HandheldTokens.InGameTitleMaxWidth}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameTitleMargin}">
            <TextBlock Text="{Binding InGameTitle}" FontSize="{x:Static vm:HandheldTokens.InGameTitle}" FontWeight="{x:Static vm:HandheldTokens.WeightDisplay}"
                       LineHeight="{x:Static vm:HandheldTokens.InGameTitleLine}"
                       Foreground="{x:Static vm:HandheldTokens.OnColour}" LetterSpacing="{x:Static vm:HandheldTokens.HeadingSpacing}" />
          </Viewbox>
          <StackPanel x:Name="BtTabs" Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.InGameTabsGap}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="{x:Static vm:HandheldTokens.InGameTabsMargin}">
            <TextBlock Classes="bt-tab" Classes.on="{Binding IsSessionTab}" Text="Session" Tapped="OnSessionTabTapped" />
            <TextBlock Classes="bt-tab" Classes.on="{Binding IsAchievementsTab}" Text="Achievements" Tapped="OnAchievementsTabTapped" />
            <TextBlock Classes="bt-tab" Classes.on="{Binding IsPhotosTab}" Text="Photos" Tapped="OnPhotosTabTapped" />
          </StackPanel>

          <!-- Session: the time so far, "this session", the total and the achievements. -->
          <Panel x:Name="BtSession" IsVisible="{Binding IsSessionTab}">
            <vh:HandheldRollingText Text="{Binding SessionTime}" FontSize="{x:Static vm:HandheldTokens.SessionTimer}" FontWeight="{x:Static vm:HandheldTokens.WeightDisplay}"
                                    LineHeight="{x:Static vm:HandheldTokens.SessionTimerLine}"
                                    Foreground="{x:Static vm:HandheldTokens.OnColour}" FontFeatures="+tnum" LetterSpacing="{x:Static vm:HandheldTokens.HeadingSpacing}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameTimerMargin}" />
            <TextBlock Classes="bt-label" Text="this session" Margin="{x:Static vm:HandheldTokens.InGameLabelMargin}" />
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameStatsMargin}">
              <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.InGameStatGap}">
                <vh:HandheldRollingText Classes="bt-stat" Text="{Binding TotalTime}" />
                <TextBlock Classes="bt-stat-label" Text="in total" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.InGameStatGap}" IsVisible="{Binding HasAchievementSet}">
                <vh:HandheldRollingText Classes="bt-stat" Text="{Binding ProgressCount}" />
                <TextBlock Classes="bt-stat-label" Text="achievements" />
              </StackPanel>
            </Grid>
          </Panel>

          <!-- Achievements: the figure, "unlocked", the three latest. A opens every badge (today's grid). -->
          <Panel x:Name="BtAchievements" IsVisible="{Binding IsAchievementsTab}">
            <vh:HandheldRollingText Text="{Binding ProgressCount}" IsVisible="{Binding HasAchievementSet}" FontSize="{x:Static vm:HandheldTokens.InGameFigure}"
                                    LineHeight="{x:Static vm:HandheldTokens.InGameFigureLine}"
                                    FontWeight="{x:Static vm:HandheldTokens.WeightDisplay}" Foreground="{x:Static vm:HandheldTokens.OnColour}" FontFeatures="+tnum"
                                    LetterSpacing="{x:Static vm:HandheldTokens.HeadingSpacing}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameFigureMargin}" />
            <TextBlock Classes="bt-label" Text="{Binding UnlockedText}" Margin="{x:Static vm:HandheldTokens.InGameFigureLabelMargin}" />
            <ItemsControl ItemsSource="{Binding RecentUnlocks}" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameRecentMargin}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AchievementRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" Height="{x:Static vm:HandheldTokens.InGameRecentHeight}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontSize="{x:Static vm:HandheldTokens.InGameRecent}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}"
                               LineHeight="{x:Static vm:HandheldTokens.InGameRecentLine}"
                               Foreground="{x:Static vm:HandheldTokens.OnColour}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding EarnedText}" FontSize="{x:Static vm:HandheldTokens.InGameRecentWhen}" FontWeight="{x:Static vm:HandheldTokens.WeightStrong}"
                               LineHeight="{x:Static vm:HandheldTokens.InGameRecentWhenLine}"
                               Foreground="{x:Static vm:HandheldTokens.OnColour}" Opacity="{x:Static vm:HandheldTokens.InGameRecentWhenOpacity}" VerticalAlignment="Top"
                               Margin="{x:Static vm:HandheldTokens.InGameRecentWhenMargin}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>

          <!-- Photos: six, two rows of three; A opens the viewer (today's). -->
          <Panel x:Name="BtPhotos" IsVisible="{Binding IsPhotosTab}">
            <ItemsControl ItemsSource="{Binding Shots}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameShotsMargin}"
                          Width="{x:Static vm:HandheldTokens.InGameShotsWidth}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="{x:Static vm:HandheldTokens.InGameShotPitchX}" ItemHeight="{x:Static vm:HandheldTokens.InGameShotPitchY}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldCompanionShotViewModel">
                  <Border Width="{x:Static vm:HandheldTokens.InGameShotWidth}" Height="{x:Static vm:HandheldTokens.InGameShotHeight}" CornerRadius="{x:Static vm:HandheldTokens.InGameShotCorner}"
                          ClipToBounds="True" Background="{x:Static vm:HandheldTokens.TileRest}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Panel>
                      <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Play}" Width="{x:Static vm:HandheldTokens.InGameShotGlyph}" Height="{x:Static vm:HandheldTokens.InGameShotGlyph}"
                                Foreground="{x:Static vm:HandheldTokens.OnColour}" IsVisible="{Binding IsVideo}" />
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="bt-label" Text="{Binding ShotsText}" Margin="{x:Static vm:HandheldTokens.InGameShotsLabelMargin}" />
          </Panel>

          <!-- The achievements bar: white over white at BarTrackOpacity, its fill stretching on SessionAchievementBar. -->
          <Border x:Name="BtBar" Height="{x:Static vm:HandheldTokens.ProgressHeight}" CornerRadius="{x:Static vm:HandheldTokens.InGameBarCorner}" ClipToBounds="True"
                  Background="{x:Static vm:HandheldTokens.InGameBarTrack}" VerticalAlignment="Top" Margin="{x:Static vm:HandheldTokens.InGameBarMargin}" IsVisible="{Binding HasAchievementSet}">
            <Border x:Name="BtBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="{x:Static vm:HandheldTokens.InGameBarCorner}" Background="{x:Static vm:HandheldTokens.OnColour}" />
          </Border>

          <!-- The dock row: today's dock (All apps, the five pinned apps) as the Launcher's dock buttons, and the way back in the corner. -->
          <ItemsControl x:Name="BtDock" ItemsSource="{Binding DockItems}" HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="False"
                        Margin="{x:Static vm:HandheldTokens.InGameDockMargin}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.DockGap}" ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldCompanionDockItemViewModel">
                <Panel Classes="bt-dock" Classes.focused="{Binding IsFocused}" Width="{x:Static vm:HandheldTokens.DockTile}" Height="{x:Static vm:HandheldTokens.DockTile}"
                       Background="Transparent" ai:InputElement.IsHoldingEnabled="True" Tapped="OnDockItemTapped" Holding="OnDockItemHolding">
                  <Border Classes="bt-dock-face" CornerRadius="{x:Static vm:HandheldTokens.DockRadius}">
                    <Panel>
                      <PathIcon Data="{x:Static vm:HandheldIcons.AllApps}" Width="{x:Static vm:HandheldTokens.GlyphDock}" Height="{x:Static vm:HandheldTokens.GlyphDock}" IsVisible="{Binding IsAllApps}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Plus}" Width="{x:Static vm:HandheldTokens.GlyphDock}" Height="{x:Static vm:HandheldTokens.GlyphDock}" IsVisible="{Binding Slot.IsEmpty, FallbackValue=False}" />
                      <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" ClipToBounds="True" IsVisible="{Binding Slot.HasIcon, FallbackValue=False}">
                        <Image Source="{Binding Slot.Icon}" Stretch="Uniform" />
                      </Border>
                    </Panel>
                  </Border>
                  <Border Classes="bt-ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusDock}" Margin="{x:Static vm:HandheldTokens.RingOutsetDock}"
                          BorderBrush="{x:Static vm:HandheldTokens.OnColour}" BorderThickness="{x:Static vm:HandheldTokens.InGameRingThickness}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="BtWayBack" Classes="bt-corner" Text="{x:Static vm:HandheldTokens.InGameWayBack}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="{x:Static vm:HandheldTokens.InGameCornerMargin}" />
        </Panel>

        <!-- ===================== The companion while a game runs ===================== -->
        <Grid x:Name="Body" RowDefinitions="*,144" IsVisible="{Binding ShowsClassicBody}" ClipToBounds="False">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>

          <!-- Now playing: a small cover, the title, the platform and the play time. -->
          <Grid x:Name="NowPlaying" Margin="48,32,48,0" Height="136" VerticalAlignment="Top" ColumnDefinitions="Auto,*"
                ColumnSpacing="28">
            <Border Width="96" Height="136" CornerRadius="{x:Static vm:HandheldTokens.CompanionCoverRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CompanionTileRest}"
                    BoxShadow="{x:Static vm:HandheldTokens.ClassicCompanionCoverShadow}">
              <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" IsVisible="{Binding HasNowPlayingCover}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
              <Border HorizontalAlignment="Left" CornerRadius="{x:Static vm:HandheldTokens.CompanionLiveRadius}" Padding="14,4" Background="{x:Static vm:HandheldTokens.ClassicCompanionLiveFill}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="14" Height="14" Fill="{x:Static vm:HandheldTokens.CompanionLive}" VerticalAlignment="Center" />
                  <TextBlock Text="Now playing" FontSize="{x:Static vm:HandheldTokens.CompanionLiveLabel}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" Foreground="{x:Static vm:HandheldTokens.CompanionLiveInk}" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="NowPlayingTitle" Text="{Binding NowPlayingTitle}" FontSize="{x:Static vm:HandheldTokens.CompanionTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Classes="muted" Text="{Binding NowPlayingLine}" FontSize="{x:Static vm:HandheldTokens.CompanionLine}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Grid>

          <!-- The two tabs; LB / RB or a tap switches between them. -->
          <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="12" Margin="48,200,48,0" VerticalAlignment="Top">
            <Border x:Name="AchievementsTab" Classes="tab" Classes.on="{Binding IsAchievementsTab}" Tapped="OnAchievementsTabTapped">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" />
                <TextBlock Text="Achievements" />
              </StackPanel>
            </Border>
            <Border x:Name="PhotosTab" Classes="tab" Classes.on="{Binding IsPhotosTab}" Tapped="OnPhotosTabTapped">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{x:Static vm:HandheldIcons.Photo}" />
                <TextBlock Text="Photos" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Classes="quiet" Text="LB / RB" FontSize="{x:Static vm:HandheldTokens.CompanionHint}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" Margin="0,226,48,0"
                     HorizontalAlignment="Right" VerticalAlignment="Top" />

          <!-- The big panel: the chosen tab. The selector frames it while it has focus. -->
          <Panel x:Name="PanelBox" Classes="lift" Classes.focused="{Binding IsPanelFocused}" Margin="48,312,48,40"
                 Background="Transparent" Tapped="OnPanelTapped"
                 PointerPressed="OnPanelPointerPressed" PointerReleased="OnPanelPointerReleased">
            <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.CompanionRingRadiusPanel}" Margin="-18">
              <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingBandRadiusPanel}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingInnerRadiusPanel}" /></Border>
            </Border>
            <Border CornerRadius="{x:Static vm:HandheldTokens.CompanionPanelRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.ClassicCompanionPanelFill}" BorderBrush="{x:Static vm:HandheldTokens.ClassicCompanionPanelEdge}" BorderThickness="3">
              <Panel>
                <!-- Achievements: a big progress ring with count and points, and the three most recent unlocks. -->
                <Grid x:Name="AchievementsPanel" IsVisible="{Binding IsAchievementsTab}" Margin="36,28"
                      ColumnDefinitions="Auto,Auto" ColumnSpacing="48" HorizontalAlignment="Center">
                  <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding HasAchievementSet}">
                    <Panel Width="260" Height="260">
                      <Ellipse Stroke="{x:Static vm:HandheldTokens.CompanionProgressTrack}" StrokeThickness="26" Margin="13" />
                      <Arc StartAngle="-90" SweepAngle="{Binding ProgressSweep}" Stroke="{x:Static vm:HandheldTokens.AchievementGold}" StrokeThickness="26"
                           StrokeLineCap="Round" Margin="13" />
                      <TextBlock Text="{Binding ProgressPercent}" FontSize="{x:Static vm:HandheldTokens.CompanionFigure}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" FontFeatures="+tnum"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <TextBlock Text="{Binding ProgressCount}" FontSize="{x:Static vm:HandheldTokens.CompanionStat}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" FontFeatures="+tnum"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{Binding ProgressPoints}" FontSize="{x:Static vm:HandheldTokens.CompanionStatLabel}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                               FontFeatures="+tnum" HorizontalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16" IsVisible="{Binding HasAchievementSet}"
                              Width="640">
                    <TextBlock Classes="muted" Text="Recently unlocked" FontSize="{x:Static vm:HandheldTokens.CompanionSection}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" />
                    <TextBlock Classes="muted" Text="Nothing unlocked yet." FontSize="{x:Static vm:HandheldTokens.CompanionSection}"
                               IsVisible="{Binding !HasRecentUnlocks}" />
                    <ItemsControl ItemsSource="{Binding RecentUnlocks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementRowViewModel">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <Border Classes="badge-face" Classes.hardcore="{Binding IsHardcore}" Width="88" Height="88"
                                    CornerRadius="{x:Static vm:HandheldTokens.CompanionUnlockRadius}">
                              <Panel>
                                <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="36" Height="36"
                                          Foreground="{x:Static vm:HandheldTokens.CompanionInkQuiet}" IsVisible="{Binding !HasBadge}" />
                                <Image Source="{Binding Badge}" Stretch="UniformToFill" IsVisible="{Binding HasBadge}" />
                              </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}" FontSize="{x:Static vm:HandheldTokens.CompanionItemTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                              <TextBlock Classes="muted" Text="{Binding EarnedText}" FontSize="{x:Static vm:HandheldTokens.CompanionItemMeta}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- No set: loading, not linked, not connected. -->
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding AchievementsMessage}" IsVisible="{Binding !HasAchievementSet}"
                             FontSize="{x:Static vm:HandheldTokens.CompanionMessage}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" Foreground="{x:Static vm:HandheldTokens.CompanionInkSoft}" TextWrapping="Wrap" LineHeight="{x:Static vm:HandheldTokens.CompanionMessageLineHeight}"
                             MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Grid>

                <!-- Photos: one large screenshot; left / right pages through them here. -->
                <Panel x:Name="PhotosPanel" IsVisible="{Binding IsPhotosTab}">
                  <Image Source="{Binding PanelPhoto}" Stretch="UniformToFill" IsVisible="{Binding HasPanelPhoto}" />
                  <Border IsVisible="{Binding IsPhotoVideo}" Background="{x:Static vm:HandheldTokens.ClassicCompanionVideoShade}" />
                  <Border Width="132" Height="132" CornerRadius="{x:Static vm:HandheldTokens.CompanionPlayRadius}" Background="{x:Static vm:HandheldTokens.CompanionPlayFill}" BorderBrush="{x:Static vm:HandheldTokens.CompanionPlayEdge}"
                          BorderThickness="4" IsVisible="{Binding IsPhotoVideo}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static vm:HandheldIcons.Play}" Width="56" Height="56" Foreground="{x:Static vm:HandheldTokens.CompanionGlyph}"
                              Margin="8,0,0,0" />
                  </Border>
                  <!-- The caption and the dots, on a soft shade at the foot of the photo. -->
                  <Border VerticalAlignment="Bottom" Padding="32,56,32,24" IsVisible="{Binding HasPhotos}">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicCompanionCaptionClear}" />
                        <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicCompanionCaptionShade}" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                      <TextBlock Text="{Binding PhotoCaption}" FontSize="{x:Static vm:HandheldTokens.CompanionCaption}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding PhotoDots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HandheldPageDotViewModel">
                            <Border Height="{x:Static vm:HandheldTokens.CompanionPhotoDot}" CornerRadius="{x:Static vm:HandheldTokens.CompanionPhotoDotRadius}"
                                    Width="{Binding IsCurrent, Converter={x:Static vm:HandheldCompanionConverters.DotWidth}}"
                                    Background="{Binding IsCurrent, Converter={x:Static vm:HandheldCompanionConverters.DotBrush}}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                  <!-- No photos yet. -->
                  <StackPanel IsVisible="{Binding !HasPhotos}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="12" Margin="48">
                    <TextBlock Text="No photos yet" FontSize="{x:Static vm:HandheldTokens.CompanionEmptyTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" Text="Screenshots and videos appear here once EmuShelf has fetched them."
                               FontSize="{x:Static vm:HandheldTokens.CompanionEmptyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="800" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                                IsVisible="{Binding Model.CanFetchMedia}">
                      <Border Classes="glyph"><TextBlock Text="Y" /></Border>
                      <TextBlock Classes="hint" Text="Fetch missing artwork" />
                    </StackPanel>
                  </StackPanel>
                </Panel>
              </Panel>
            </Border>
            <!-- What A does here, in the panel's corner. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0" Padding="10,8,20,8"
                    CornerRadius="{x:Static vm:HandheldTokens.CompanionHintPillRadius}" Background="{x:Static vm:HandheldTokens.ClassicCompanionHintPill}" IsVisible="{Binding HasPanelHint}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="glyph"><TextBlock Text="A" /></Border>
                <TextBlock Classes="hint" Text="{Binding PanelHint}" Foreground="{x:Static vm:HandheldTokens.CompanionOnPhoto}" />
              </StackPanel>
            </Border>
          </Panel>

          <!-- The dock: All apps, then the five pinned apps (today's dock, the same slots). -->
          <Border x:Name="Dock" Grid.Row="1" Margin="48,0,48,32" Height="112" CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionDockPillRadius}" Background="{x:Static vm:HandheldTokens.ClassicCompanionDockFill}"
                  BorderBrush="{x:Static vm:HandheldTokens.ClassicCompanionDockEdge}" BorderThickness="3" ClipToBounds="False" VerticalAlignment="Bottom">
            <ItemsControl x:Name="DockItems" ItemsSource="{Binding DockItems}" ClipToBounds="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="32" ClipToBounds="False" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldCompanionDockItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="32">
                    <Panel Classes="lift" Classes.focused="{Binding IsFocused}" Width="80" Height="80" Background="Transparent"
                           ai:InputElement.IsHoldingEnabled="True" Tapped="OnDockItemTapped" Holding="OnDockItemHolding">
                      <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" Background="{x:Static vm:HandheldTokens.CompanionTileRest}" IsVisible="{Binding IsAllApps}">
                        <PathIcon Data="{x:Static vm:HandheldIcons.AllApps}" Width="36" Height="36" Foreground="{x:Static vm:HandheldTokens.CompanionDockGlyph}" />
                      </Border>
                      <Panel IsVisible="{Binding IsApp}">
                        <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" BorderBrush="{x:Static vm:HandheldTokens.CompanionEmptySlotEdge}" BorderThickness="3" IsVisible="{Binding Slot.IsEmpty}">
                          <PathIcon Data="{x:Static vm:HandheldIcons.Plus}" Width="32" Height="32" Foreground="{x:Static vm:HandheldTokens.CompanionInkQuiet}" />
                        </Border>
                        <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" ClipToBounds="True" IsVisible="{Binding Slot.HasIcon}">
                          <Image Source="{Binding Slot.Icon}" Stretch="Uniform" />
                        </Border>
                      </Panel>
                      <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.CompanionRingRadiusDock}" Margin="-18">
                        <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingBandRadiusDock}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingInnerRadiusDock}" /></Border>
                      </Border>
                    </Panel>
                    <!-- All apps stands apart from the pinned apps. -->
                    <Border Width="3" Height="56" CornerRadius="{x:Static vm:HandheldTokens.CompanionDividerRadius}" Background="{x:Static vm:HandheldTokens.CompanionDivider}" VerticalAlignment="Center"
                            IsVisible="{Binding IsAllApps}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>

        <!-- ===================== Every badge (A on the panel; the Title page's Achievements) ===================== -->
        <Grid x:Name="GridLayer" Classes="layer" Background="{x:Static vm:HandheldTokens.CompanionLayerGround}" RowDefinitions="Auto,Auto,*,Auto"
              IsVisible="{Binding IsAchievementsLayer}">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>
          <!-- The game, the progress line, Refresh and Close. -->
          <Grid Margin="48,32,48,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="20" Height="80">
            <TextBlock Text="Achievements" FontSize="{x:Static vm:HandheldTokens.CompanionHeading}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Model.AchievementsSummary}" FontSize="{x:Static vm:HandheldTokens.CompanionSummary}"
                       FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" FontFeatures="+tnum" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="chip" IsVisible="{Binding Model.CanRefresh}" Tapped="OnRefreshTapped">
              <PathIcon x:Name="RefreshIcon" Data="{DynamicResource EmuRefreshGeometry}"
                        Classes.spin="{Binding Model.IsAchievementsRefreshing}">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
            </Border>
            <Border Grid.Column="3" Classes="chip" Tapped="OnCloseTapped">
              <PathIcon Data="{DynamicResource EmuCloseGeometry}" Width="22" Height="22" />
            </Border>
          </Grid>
          <!-- All / Locked / Unlocked, on LB / RB. -->
          <Grid Grid.Row="1" Margin="48,20,48,0" ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="tab small" Classes.on="{Binding IsAllFilter}" Tapped="OnAllFilterTapped">
                <TextBlock Text="{Binding AllFilterText}" />
              </Border>
              <Border Classes="tab small" Classes.on="{Binding IsLockedFilter}" Tapped="OnLockedFilterTapped">
                <TextBlock Text="{Binding LockedFilterText}" />
              </Border>
              <Border Classes="tab small" Classes.on="{Binding IsUnlockedFilter}" Tapped="OnUnlockedFilterTapped">
                <TextBlock Text="{Binding UnlockedFilterText}" />
              </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="quiet" Text="LB / RB" FontSize="{x:Static vm:HandheldTokens.CompanionHint}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <!--
            The badges: rows of a fixed count (seven here, eleven on the 16:9 screen), each badge 120 px at a 170 px pitch so
            the selector ring and its glow fit between them. Row-virtualized, so a 400-badge set realizes only what shows.
          -->
          <!-- The outer badges' 25 px margins sit inside the 48 px edge, so the grid lines up with the header. -->
          <!-- Whole rows only: the view fits the list to the most 170 px rows the space holds (HandheldScrolling). -->
          <Panel x:Name="BadgeHost" Grid.Row="2" Margin="23,16,23,0">
            <ListBox x:Name="BadgeList" ItemsSource="{Binding Model.AchievementRows}" IsVisible="{Binding IsAchievementsLayer}"
                     Background="Transparent" BorderThickness="0" Padding="0" ClipToBounds="True" VerticalAlignment="Top"
                     AutoScrollToSelectedItem="False" HorizontalAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="FocusAdorner" Value="{x:Null}" />
                  <Setter Property="ClipToBounds" Value="False" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" ClipToBounds="False" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AchievementRowViewModel">
                        <Panel Classes="badge" Classes.locked="{Binding IsLocked}" Classes.focused="{Binding IsFocused}"
                               Width="120" Height="120" Margin="25" Background="Transparent"
                               Tapped="OnBadgeTapped" AttachedToVisualTree="OnBadgeAttached"
                               DataContextChanged="OnBadgeDataContextChanged">
                          <Border Classes="badge-face" Classes.hardcore="{Binding IsHardcore}">
                            <Panel>
                              <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="44" Height="44" Foreground="{x:Static vm:HandheldTokens.CompanionInkQuiet}"
                                        IsVisible="{Binding !HasBadge}" />
                              <Image Source="{Binding Badge}" Stretch="UniformToFill" IsVisible="{Binding HasBadge}" />
                            </Panel>
                          </Border>
                          <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.CompanionRingRadiusBadge}" Margin="-18">
                            <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingBandRadiusBadge}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingInnerRadiusBadge}" /></Border>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- No set, or nothing under this filter. -->
            <TextBlock Text="{Binding Model.AchievementsStatus}" IsVisible="{Binding !Model.HasAchievements}"
                       FontSize="{x:Static vm:HandheldTokens.CompanionMessage}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" Foreground="{x:Static vm:HandheldTokens.CompanionInkSoft}" TextWrapping="Wrap" LineHeight="{x:Static vm:HandheldTokens.CompanionMessageLineHeight}"
                       MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            <StackPanel IsVisible="{Binding IsFilterEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="Nothing here yet" FontSize="{x:Static vm:HandheldTokens.CompanionEmptyTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding FilterEmptyText}" FontSize="{x:Static vm:HandheldTokens.CompanionEmptyText}" HorizontalAlignment="Center" />
            </StackPanel>
            <!-- A status over a loaded grid (offline, an error), floating at its foot so no badge moves. -->
            <Border IsVisible="{Binding Model.HasInlineStatus}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,16" Padding="28,12" CornerRadius="{x:Static vm:HandheldTokens.CompanionHintPillRadius}" Background="{x:Static vm:HandheldTokens.ClassicCompanionStatusFill}" BorderBrush="{x:Static vm:HandheldTokens.ClassicCompanionStatusEdge}"
                    BorderThickness="2">
              <TextBlock Text="{Binding Model.AchievementsStatus}" FontSize="{x:Static vm:HandheldTokens.CompanionStatus}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}"
                         TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" MaxWidth="900" />
            </Border>
          </Panel>
          <!-- The selected badge: its picture, title, description, and points with when it was earned. -->
          <Grid Grid.Row="3" Margin="48,0,48,32" Height="184" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
            <Border Grid.ColumnSpan="3" Height="3" Background="{x:Static vm:HandheldTokens.CompanionRule}" VerticalAlignment="Top" />
            <Panel Classes="badge" Classes.locked="{Binding Model.SelectedAchievement.IsLocked, FallbackValue=False}"
                   Width="128" Height="128" VerticalAlignment="Center" IsVisible="{Binding Model.HasSelectedAchievement}">
              <Border Classes="badge-face">
                <Image Source="{Binding Model.SelectedAchievement.Badge}" Stretch="UniformToFill" />
              </Border>
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding Model.HasSelectedAchievement}">
              <TextBlock Text="{Binding Model.SelectedAchievement.Title}" FontSize="{x:Static vm:HandheldTokens.CompanionDetailTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Classes="muted" Text="{Binding Model.SelectedAchievement.Description}" FontSize="{x:Static vm:HandheldTokens.CompanionDetailText}"
                         TextWrapping="Wrap" MaxLines="2" LineHeight="{x:Static vm:HandheldTokens.CompanionDetailLineHeight}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="quiet" Text="{Binding Model.SelectedAchievementMeta}" FontSize="{x:Static vm:HandheldTokens.CompanionItemMeta}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" />
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding GridHints}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="24" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldHint">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="{Binding Button}" /></Border>
                    <TextBlock Classes="hint" Text="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Grid>

        <!-- ===================== All apps (the dock's first button, or Y on a slot to change it) ===================== -->
        <Grid x:Name="DrawerLayer" Classes="layer" Classes.light="{Binding IsDrawerLight}" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding IsDrawerLayer}">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>
          <Grid Margin="48,32,48,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Height="88">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Model.DrawerTitle}" FontSize="{x:Static vm:HandheldTokens.CompanionHeading}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" TextTrimming="CharacterEllipsis" />
              <!-- What Pin to dock did (Y, or a long press on an app). -->
              <TextBlock Classes="hint" Text="{Binding DrawerNotice}" IsVisible="{Binding HasDrawerNotice}" FontSize="{x:Static vm:HandheldTokens.CompanionHint}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" Classes="chip" IsVisible="{Binding Model.CanClearSlot}" Tapped="OnClearSlotTapped">
              <TextBlock Text="Clear slot" />
            </Border>
            <Border Grid.Column="2" Classes="chip" Tapped="OnCloseTapped">
              <PathIcon Data="{DynamicResource EmuCloseGeometry}" Width="22" Height="22" />
            </Border>
          </Grid>
          <!--
            Whole rows only: the view sizes the scroller to a whole number of rows and scrolls a row at a time, so no row ever
            shows cut at an edge (HandheldScrolling). The scroller does not clip, so the lifted ring and its glow reach past
            its top edge; the view hides every row not wholly inside it instead.
          -->
          <Panel x:Name="DrawerScrollHost" Grid.Row="1" Margin="0,8,0,0">
          <ScrollViewer x:Name="DrawerScroll" Padding="48,0" VerticalAlignment="Top" ClipToBounds="False"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <ScrollViewer.Styles>
              <Style Selector="ScrollViewer#DrawerScroll /template/ ScrollContentPresenter">
                <Setter Property="ClipToBounds" Value="False" />
              </Style>
            </ScrollViewer.Styles>
            <ItemsControl x:Name="DrawerApps" ItemsSource="{Binding DrawerApps}" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{ReflectionBinding $parent[ItemsControl].DataContext.DrawerColumns}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldDrawerAppViewModel">
                  <!--
                    One row is 216 px, so four fit on either screen: 20 above the icon, the 112 px icon, 36 to a 32 px label,
                    16 below. The lifted ring reaches 28 px past the icon, clearing both labels by 8.
                  -->
                  <StackPanel Spacing="36" Margin="0,20,0,16" Background="Transparent" Tapped="OnDrawerAppTapped"
                              ai:InputElement.IsHoldingEnabled="True" Holding="OnDrawerAppHolding">
                    <Panel Classes="lift" Classes.focused="{Binding IsFocused}" Width="112" Height="112"
                           HorizontalAlignment="Center">
                      <Border Classes="app-face" CornerRadius="{x:Static vm:HandheldTokens.CompanionAppRadius}" ClipToBounds="True">
                        <Image Source="{Binding App.Icon}" Stretch="Uniform" IsVisible="{Binding App.HasIcon}" />
                      </Border>
                      <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.CompanionRingRadiusApp}" Margin="-18">
                        <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingBandRadiusApp}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicCompanionRingInnerRadiusApp}" /></Border>
                      </Border>
                    </Panel>
                    <TextBlock Text="{Binding App.Label}" FontSize="{x:Static vm:HandheldTokens.CompanionAppLabel}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="200" Height="32" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Panel>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding DrawerHints}" HorizontalAlignment="Right" Margin="48,0,48,40">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="24" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHint">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph"><TextBlock Text="{Binding Button}" /></Border>
                  <TextBlock Classes="hint" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Viewbox>

    <!--
      ===================== The photo viewer =====================
      Full window and unscaled: the muted video is a native Android view, which sits above Avalonia at the control's own
      bounds, so it is not put under the canvas's scaling. Screenshots, then the video, which only downloads on play.
    -->
    <Panel x:Name="ViewerLayer" Background="{x:Static vm:HandheldTokens.CompanionViewerGround}" IsVisible="{Binding IsPhotosLayer}" ClipToBounds="True"
           PointerPressed="OnViewerPointerPressed" PointerReleased="OnViewerPointerReleased">
      <Image Source="{Binding Model.MediaImage}" Stretch="Uniform" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Model.IsMediaLoading}" Height="2" Width="72"
                   Foreground="{x:Static vm:HandheldTokens.CompanionViewerInk}" Background="{x:Static vm:HandheldTokens.CompanionViewerTrack}" VerticalAlignment="Bottom" Margin="0,0,0,48" />
      <TextBlock Text="{Binding Model.MediaStatus}" Foreground="{x:Static vm:HandheldTokens.CompanionViewerInk}" FontSize="{x:Static vm:HandheldTokens.CompanionViewerStatus}" Margin="40" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Border Classes="viewer-button" Width="64" Height="64" CornerRadius="{x:Static vm:HandheldTokens.CompanionViewerPlayRadius}" Background="{x:Static vm:HandheldTokens.CompanionPlayFill}" BorderBrush="{x:Static vm:HandheldTokens.CompanionPlayEdge}"
              BorderThickness="2" IsVisible="{Binding Model.ShowMediaPlay}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Tapped="OnPlayTapped">
        <PathIcon Data="{x:Static vm:HandheldIcons.Play}" Width="26" Height="26" Foreground="{x:Static vm:HandheldTokens.CompanionGlyph}" Margin="4,0,0,0" />
      </Border>
      <ContentControl IsVisible="{Binding Model.IsVideoPlaying}" Content="{Binding Model.PlayingVideoPath}" Margin="0,48,0,40"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <controls:CompanionVideoHost Source="{Binding}" AttachedToVisualTree="OnVideoAttached" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <!-- Title and close on top, the caption and hints at the foot, each on a shade. -->
      <Border Height="72" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding Model.IsMediaChromeVisible}">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicCompanionViewerTopShade}" />
            <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicCompanionCaptionClear}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid Margin="16,12" Height="32" VerticalAlignment="Top" ColumnDefinitions="*,Auto" IsVisible="{Binding Model.IsMediaChromeVisible}">
        <TextBlock Text="{Binding Model.MediaTitle}" FontSize="{x:Static vm:HandheldTokens.CompanionViewerTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Classes="viewer-button" Width="32" Height="32" CornerRadius="{x:Static vm:HandheldTokens.CompanionViewerCloseRadius}" Background="{x:Static vm:HandheldTokens.CompanionViewerButtonFill}"
                Tapped="OnCloseTapped">
          <PathIcon Data="{DynamicResource EmuCloseGeometry}" Width="11" Height="11" Foreground="{x:Static vm:HandheldTokens.CompanionGlyph}" />
        </Border>
      </Grid>
      <Border Height="64" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding Model.IsMediaChromeVisible}">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicCompanionCaptionClear}" />
            <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicCompanionViewerFootShade}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid Margin="16,8" Height="24" VerticalAlignment="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12"
            IsVisible="{Binding Model.IsMediaChromeVisible}">
        <TextBlock Text="{Binding Model.MediaCaption}" FontSize="{x:Static vm:HandheldTokens.CompanionViewerCaption}" Foreground="{x:Static vm:HandheldTokens.CompanionViewerInk}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding ViewerHints}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldHint">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="18" Height="18" CornerRadius="{x:Static vm:HandheldTokens.CompanionViewerGlyphRadius}" Background="{x:Static vm:HandheldTokens.CompanionViewerButtonFill}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Button}" FontSize="{x:Static vm:HandheldTokens.CompanionViewerGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.CompanionViewerCaption}" Foreground="{x:Static vm:HandheldTokens.CompanionInkSoft}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Panel>

    <!--
      ===================== Resting =====================
      After a few seconds alone the companion dims to a faint cover and title, easy on a panel prone to burn-in. It takes
      the waking touch (only while it is up), so the first touch never lands on whatever is under the finger.
    -->
    <Panel x:Name="RestLayer" Classes.on="{Binding ShowsClassicRest}" Background="{x:Static vm:HandheldTokens.CompanionRestGround}" Tapped="OnRestTapped">
      <Viewbox Stretch="Uniform">
        <Panel x:Name="RestCanvas" Width="1240" Height="1080">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <StackPanel Opacity="0.2" Spacing="24">
              <Border Width="260" Height="368" CornerRadius="{x:Static vm:HandheldTokens.CompanionRestCoverRadius}" ClipToBounds="True" HorizontalAlignment="Center"
                      IsVisible="{Binding HasNowPlayingCover}">
                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" />
              </Border>
              <TextBlock Text="{Binding NowPlayingTitle}" FontSize="{x:Static vm:HandheldTokens.CompanionTitle}" FontWeight="{x:Static vm:HandheldTokens.CompanionStrongWeight}" HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="1000" />
            </StackPanel>
            <TextBlock Text="Touch or press any button to wake" FontSize="{x:Static vm:HandheldTokens.CompanionRestHint}" FontWeight="{x:Static vm:HandheldTokens.CompanionWeight}" Opacity="0.3"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Viewbox>
    </Panel>
  </Panel>
</UserControl>
