<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             x:Class="EmuShelf.App.Views.HandheldLauncherView"
             x:DataType="vm:HandheldShellViewModel">

  <!--
    Handheld mode's bottom screen: home (5×4 slots, empty ones drawn faintly, page dots), an open folder
    (header bar + a 3-row grid scrolling by column), and the dock. A pure view onto
    HandheldShellViewModel, drawn on a fixed 1240×1080 canvas (the Thor's bottom panel) and fitted, never
    cropped. The colour lives in the covers and the platform folders; the chrome stays grey, and the one
    accent is the selector (a thick indigo frame with white keylines). H1 moves it with plain state
    changes; H3 made it travel: one selector (the layer at the end) springs between the focused elements,
    whose `Border.ring` children only say where it goes. The motion lives in HandheldLauncherMotion.

    Rhythm: a 48 px edge margin on every side (room for the selector ring and its future glow), a 4 px grid
    for every size, and radii that nest (a ring's radius is the tile's radius plus the ring's reach).
  -->

  <!-- The gradient fills the whole window, including any letterbox bands around the fitted canvas. -->
  <UserControl.Background>
    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
      <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
    </LinearGradientBrush>
  </UserControl.Background>

  <UserControl.Styles>
    <!-- The selector ring around whatever is focused: white keyline, indigo frame, white keyline. -->
    <!--
      Each focusable element's ring is an invisible anchor: its bounds and corner radius are where the one
      travelling selector frames it. The selector itself is drawn by the selector layer.
    -->
    <Style Selector="Border.ring">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.selector-ring">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicRingKeyline}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.ClassicRingKeylineThickness}" />
    </Style>
    <Style Selector="Border.selector-ring > Border">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.Ring}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.RingStrokeThickness}" />
    </Style>
    <Style Selector="Border.selector-ring > Border > Border">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicRingKeyline}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.ClassicRingKeylineThickness}" />
    </Style>
    <!-- Big Type (M47 B3): one white band, no keylines and no glow. The root carries the look's class (view wiring). -->
    <Style Selector="Panel.bigtype Border.selector-ring">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.RingBand}" />
      <Setter Property="BorderThickness" Value="{x:Static vm:HandheldTokens.RingStrokeThickness}" />
    </Style>
    <Style Selector="Panel.bigtype Border.selector-ring > Border">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Panel.bigtype Border.selector-ring > Border > Border">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Panel.bigtype vh|HandheldShadow#SelectorGlow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The focus lift lives on the element itself (fly-ins and pops live on its container). -->
    <Style Selector="Panel.focusable">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.34" Y1="1.42" X2="0.64" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.focusable.focused">
      <Setter Property="RenderTransform" Value="scale(1.13)" />
    </Style>
    <!-- Big Type's lifts (tokens.js shape.FocusScale and DockFocusScale; HandheldTokens.FocusScale and DockFocusScale). -->
    <Style Selector="Panel.bigtype Panel.focusable.focused">
      <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>
    <Style Selector="Panel.bigtype Panel.home-slot.focused, Panel.bigtype Panel.folder-tile.focused">
      <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <Style Selector="Panel.bigtype Panel.focusable.dock-tile.focused">
      <Setter Property="RenderTransform" Value="scale(1.14)" />
    </Style>
    <!-- Big Type's lift lands (M47 B5: tokens.js FocusLift, 380 ms on the Land curve); held still (battery saver), it simply lands. -->
    <Style Selector="Panel.bigtype Panel.focusable">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.2" Y1="1.5" X2="0.35" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.bigtype.still Panel.focusable">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <!-- A lifted tile casts a deeper shadow: a second pre-rendered shadow fades in under it. -->
    <Style Selector="vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.focusable.focused vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      Native mode (Android, M45 H4 option 5): this view is only pictured, so nothing in it animates (an invisible
      transition still costs Avalonia frames) and nothing is lifted (the native Launcher lifts its pictures).
    -->
    <Style Selector="Panel.native Panel.focusable">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ProgressBar.launch">
      <Setter Property="IsIndeterminate" Value="True" />
    </Style>
    <!-- The native Launcher draws its own bar; a hidden indeterminate bar would still animate. -->
    <Style Selector="Panel.native ProgressBar.launch">
      <Setter Property="IsIndeterminate" Value="False" />
    </Style>
    <Style Selector="Panel.native vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- Arranging home (H4): the carried tile rides high, empty slots light up, the New ribbon. -->
    <Style Selector="Panel.home-slot.carried">
      <Setter Property="RenderTransform" Value="translateY(-14px) scale(1.16)" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <!-- Big Type (M47 B9, the mock's .tile.held): the held tile grows above its neighbours; its face rocks (the Launcher's motion). -->
    <Style Selector="Panel.bigtype Panel.home-slot.carried">
      <Setter Property="RenderTransform" Value="{x:Static vm:HandheldTokens.HeldTransform}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.empty-slot.landing">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccentOutline}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicLandingFill}" />
    </Style>
    <Style Selector="Border.ribbon">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicRibbonRadius}" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="0,6,-12,0" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicEdge}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicRibbonShadow}" />
    </Style>
    <Style Selector="Border.ribbon TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.Ribbon}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RibbonWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <Style Selector="Border.edge">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicEdgeHintRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicEdgeHintFill}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.edge PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
    </Style>
    <!-- The actions sheet's and the naming panel's rows. -->
    <!-- One height, so the sheet and the choice list scroll in whole rows. -->
    <Style Selector="Border.sheet-row">
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.SheetRowRadius}" />
      <Setter Property="Height" Value="88" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.sheet-row.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Border.sheet-row TextBlock.label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.SheetRow}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
    </Style>
    <Style Selector="Border.sheet-row TextBlock.note">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.RowValue}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
    </Style>
    <Style Selector="Border.sheet-row.focused TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <!-- Remove from library: the one row that takes a game away, in the warning colour until focused. -->
    <Style Selector="Border.sheet-row TextBlock.label.destructive">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Danger}" />
    </Style>
    <Style Selector="Border.sheet-row.focused TextBlock.label.destructive">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <Style Selector="Border.colour-chip">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="88" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ColourChipRadius}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicEdge}" />
    </Style>
    <Style Selector="Border.colour-chip.focused">
      <Setter Property="BorderThickness" Value="6" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicChipFocusRing}" />
    </Style>
    <Style Selector="Border.name-field">
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.FieldRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicFieldFill}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicFieldEdge}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="24,8" />
    </Style>
    <Style Selector="Border.name-field.focused">
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <!-- The name field is the panel's own pill: the TextBox inside draws no box of its own in any state. -->
    <Style Selector="TextBox.name-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.name-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.name-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.Key}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.Key}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.KeyRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicKeyShadow}" />
    </Style>
    <Style Selector="Border.key TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.KeyLabel}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.key.wide">
      <Setter Property="Width" Value="300" />
    </Style>
    <Style Selector="Border.key.wide TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.KeyWide}" />
    </Style>
    <Style Selector="Border.key.done">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccentTint}" />
    </Style>
    <Style Selector="Border.key.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Border.key.focused TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>

    <!-- Header chips: a raised white surface with a hairline. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicChipRadius}" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicRaisedShadow}" />
    </Style>
    <!-- Title page: the big pill buttons (Play is the accent), the fact rows, the chooser cards. -->
    <Style Selector="Border.title-button">
      <Setter Property="Height" Value="88" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ClassicButtonRadius}" />
      <Setter Property="Padding" Value="32,0" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicButtonShadow}" />
    </Style>
    <Style Selector="Border.title-button.play">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicAccentShadow}" />
    </Style>
    <Style Selector="Border.title-button TextBlock.label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.TitleButton}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.title-button TextBlock.note">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.TitleButtonNote}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.title-button.play TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <Style Selector="Border.title-button PathIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Glyph}" />
    </Style>
    <Style Selector="Border.title-button.play PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <Style Selector="TextBlock.fact-label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.Facts}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
      <Setter Property="Margin" Value="0,0,24,12" />
    </Style>
    <Style Selector="TextBlock.fact-value">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.Facts}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.hint-glyph">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.HintGlyph}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.HintGlyph}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.HintGlyphRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.HintGlyphFill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.screen-card">
      <Setter Property="Width" Value="400" />
      <Setter Property="Height" Value="296" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.ScreenCardRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicCardShadow}" />
      <Setter Property="Padding" Value="32" />
    </Style>

    <!-- Settings (M45 H6a): the tile's face, the section list, the rows and their trailing controls. -->
    <Style Selector="Border.settings-face">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicSettingsFaceTop}" />
          <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicSettingsFaceBottom}" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- Activity (M46 P4): the play log's tile, on its own teal so it reads as EmuShelf's beside Settings. -->
    <Style Selector="Border.activity-face">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicActivityFaceTop}" />
          <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicActivityFaceBottom}" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- The setup wizard keeps room under its steps for the Continue button (M45 H6d). -->
    <Style Selector="Panel#SettingsSectionHost">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="Panel#SettingsSectionHost.setup">
      <Setter Property="Margin" Value="0,24,0,128" />
    </Style>
    <Style Selector="Border.settings-section">
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.RailRowRadius}" />
      <Setter Property="Height" Value="88" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.settings-section.selected">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicRaisedShadow}" />
    </Style>
    <Style Selector="Border.settings-section.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicAccentShadow}" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.title">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.RailRow}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.status">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.RailRowStatus}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.status.warning">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Warning}" />
    </Style>
    <Style Selector="Border.settings-section.focused TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <!-- One height for every row, so the lists scroll in whole rows and never show one cut at an edge. -->
    <Style Selector="Border.settings-row">
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.RowRadius}" />
      <Setter Property="Height" Value="92" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicHairline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-row.grouped">
      <Setter Property="Margin" Value="48,0,0,0" />
    </Style>
    <Style Selector="Border.settings-row.save">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccentTint}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccentHairline}" />
    </Style>
    <Style Selector="Border.settings-row.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
      <Setter Property="BoxShadow" Value="{x:Static vm:HandheldTokens.ClassicAccentShadow}" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.label">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.Row}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settings-row.disabled TextBlock.label">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundDisabled}" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.value">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.RowValue}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.value.warning">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Warning}" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.destructive">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Danger}" />
    </Style>
    <Style Selector="Border.settings-row.focused TextBlock">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <!-- While the list of sections has the pad, the row it will come back to keeps only an outline. -->
    <Style Selector="Grid.rail Border.settings-row.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSurface}" />
      <Setter Property="BorderBrush" Value="{x:Static vm:HandheldTokens.ClassicAccentOutline}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.save.focused">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccentTint}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused TextBlock.label">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused TextBlock.value">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGroundMuted}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Chevron}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.SwitchTrack}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch.on">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch.on > Border">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.SwitchKnobFill}" />
    </Style>
    <Style Selector="Border.settings-row PathIcon.chevron">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.Chevron}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settings-row.focused PathIcon">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <!-- A switch: a pill with its knob left (off) or right (on). -->
    <Style Selector="Border.switch">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.SwitchWidth}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.SwitchHeight}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.SwitchRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.SwitchTrack}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.switch.on">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSwitchTrackFocused}" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch.on">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicSwitchOnFocused}" />
    </Style>
    <Style Selector="Border.switch > Border">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.SwitchKnob}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.SwitchKnob}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.SwitchKnobRadius}" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.SwitchKnobFill}" />
    </Style>
    <Style Selector="Border.switch.on > Border">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch.on > Border">
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Border.key.mid">
      <Setter Property="Width" Value="160" />
    </Style>
    <Style Selector="Border.key.space">
      <Setter Property="Width" Value="252" />
    </Style>
    <Style Selector="Border.key.space TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.KeySpace}" />
    </Style>
    <Style Selector="Border.sheet-row PathIcon.pick">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.ClassicAccent}" />
    </Style>
    <Style Selector="Border.sheet-row.focused PathIcon.pick">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnAccent}" />
    </Style>
    <Style Selector="Border.key.mid TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.KeyMid}" />
    </Style>

    <!-- Big Type (M47 B3): the white corner mark on a missing file's tile ("!") and on a new folder (a dot). -->
    <Style Selector="Border.corner-mark">
      <Setter Property="Width" Value="{x:Static vm:HandheldTokens.CornerMark}" />
      <Setter Property="Height" Value="{x:Static vm:HandheldTokens.CornerMark}" />
      <Setter Property="CornerRadius" Value="{x:Static vm:HandheldTokens.CornerMarkRadius}" />
      <Setter Property="Background" Value="{x:Static vm:HandheldTokens.TileFocus}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="{x:Static vm:HandheldTokens.CornerMarkMargin}" />
    </Style>
    <Style Selector="Border.corner-mark TextBlock">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.CornerMarkLetter}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightDisplay}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.bt-tile-title">
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.TileTitleWeight}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="MaxLines" Value="4" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.dock-corner">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.DockCorner}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.WeightStrong}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnColour}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>

    <Style Selector="TextBlock.chip-text">
      <Setter Property="FontSize" Value="{x:Static vm:HandheldTokens.Chip}" />
      <Setter Property="FontWeight" Value="{x:Static vm:HandheldTokens.RowWeight}" />
      <Setter Property="Foreground" Value="{x:Static vm:HandheldTokens.OnGround}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!--
      Each item sits in a ContentPresenter container, and siblings paint in order, so a ZIndex on the
      tile itself does nothing and the tiles after the focused one cover its ring. Raise the container.
    -->
    <ControlTheme x:Key="HandheldTileContainer" TargetType="ContentPresenter">
      <Setter Property="ZIndex" Value="{ReflectionBinding IsFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}" />
    </ControlTheme>
  </UserControl.Resources>

  <Panel x:Name="Root">
  <!--
    Big Type (M47 B3): the whole screen is the focused item's flat colour, letterbox bands included. The native Launcher clears
    to the same colour, so a sheet that hands the screen back to this view shows the same ground.
  -->
  <Border x:Name="Ground" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" Background="{Binding LauncherGroundBrush}">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static vm:HandheldTokens.GroundFade}" />
      </Transitions>
    </Border.Transitions>
  </Border>
  <!-- Big Type (M47 B7): a new colour floods in as a circle over the ground (the view's motion grows it; the native Launcher has its own). -->
  <Border x:Name="GroundWave" IsVisible="False" IsHitTestVisible="False" />
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid x:Name="Canvas" Width="1240" Height="1080" RowDefinitions="*,144">

      <!-- ===== Home: every page on one track that slides on the track spring ===== -->
      <!-- Home on this Launcher's screen: the view gives this layer its HandheldHomeScreenViewModel (M45 H5). -->
      <Grid x:Name="HomeLayer" RowDefinitions="*,40" Margin="{x:Static vm:HandheldTokens.HomeLayerMargin}" x:DataType="vm:HandheldHomeScreenViewModel">
        <Panel x:Name="HomeClip" ClipToBounds="True">
          <ItemsControl x:Name="PageTrack" ItemsSource="{Binding Pages}" HorizontalAlignment="Left" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHomePageViewModel">
                <!--
                  5×4 slots (7×3 on the 16:9 screen, M45 H5): 176 px tiles on a 224 × 196 pitch, centred in the space
                  above the dock. A page is the canvas wide.
                -->
                <Panel Width="{Binding Width}">
                  <ItemsControl ItemsSource="{Binding Slots}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                                ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="{x:Static vm:HandheldTokens.HomeGridAlignment}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{ReflectionBinding $parent[ItemsControl].DataContext.Columns}"
                                     Rows="{ReflectionBinding $parent[ItemsControl].DataContext.Rows}" ClipToBounds="False" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HandheldHomeSlotViewModel">
                        <!-- Room for the folder's shadow when the native Launcher pictures it; layout unchanged. -->
                        <Border Classes="shot" Padding="48" Margin="-48">
                        <Panel Classes="focusable home-slot" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}"
                               Classes.carried="{Binding IsCarried}" Width="{x:Static vm:HandheldTokens.TileHome}" Height="{x:Static vm:HandheldTokens.TileHome}" Margin="{x:Static vm:HandheldTokens.HomeSlotMargin}" Background="Transparent">
                          <!-- Today's look (M47 B3 keeps it whole behind the look switch). -->
                          <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
                          <!-- A folder (a platform's, yours, Recent): its flap tilts while focused so the first covers peek out. -->
                          <vh:HandheldFolderArt IsVisible="{Binding IsFolder}" Classes.peek="{Binding IsFocused}" Margin="-8" />
                          <!-- A game pinned to home: its cover, cropped to the tile; dimmed when its file is missing. -->
                          <!-- Same footprint as a folder beside it (its back plate starts lower and sits a little wider). -->
                          <Panel IsVisible="{Binding IsGame}" Margin="-3,17,-3,0">
                            <vh:HandheldShadow Radius="{x:Static vm:HandheldTokens.ClassicHomeTileShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicHomeTileShadowBlur}" Margin="-16,-10,-16,-22" Filled="True" />
                            <Border CornerRadius="{x:Static vm:HandheldTokens.TileRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}"
                                    Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                              <Panel>
                                <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleHome}" FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}"
                                           Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxLines="4"
                                           TextTrimming="CharacterEllipsis" />
                                <Border IsVisible="{Binding HasCover}">
                                  <Border.Background>
                                    <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                                  </Border.Background>
                                </Border>
                              </Panel>
                            </Border>
                          </Panel>
                          <!--
                            Settings (decision 18): an app on the grid, its glyph on the indigo accent so it reads as neither a
                            platform's monogram nor your folder's star. Same footprint as a pinned game.
                          -->
                          <Panel IsVisible="{Binding IsSettings}" Margin="-3,17,-3,0">
                            <vh:HandheldShadow Radius="{x:Static vm:HandheldTokens.ClassicHomeTileShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicHomeTileShadowBlur}" Margin="-16,-10,-16,-22" Filled="True" />
                            <Border Classes="settings-face" CornerRadius="{x:Static vm:HandheldTokens.TileRadius}">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="80" Height="80" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                            </Border>
                          </Panel>
                          <!-- Activity (M46 P4): the play log, an app beside Settings with the same footprint. -->
                          <Panel IsVisible="{Binding IsActivity}" Margin="-3,17,-3,0">
                            <vh:HandheldShadow Radius="{x:Static vm:HandheldTokens.ClassicHomeTileShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicHomeTileShadowBlur}" Margin="-16,-10,-16,-22" Filled="True" />
                            <Border Classes="activity-face" CornerRadius="{x:Static vm:HandheldTokens.TileRadius}">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Activity}" Width="80" Height="80" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                            </Border>
                          </Panel>
                          <!-- An empty slot: home is a place with slots, so it is drawn faintly, not left out; in move mode it lights up. -->
                          <Border IsVisible="{Binding IsEmpty}" Classes="empty-slot" Classes.landing="{Binding IsLandingPlace}"
                                  CornerRadius="{x:Static vm:HandheldTokens.SlotRadius}" BorderBrush="{x:Static vm:HandheldTokens.ClassicEmptySlotEdge}" BorderThickness="2" Background="{x:Static vm:HandheldTokens.ClassicEmptySlotFill}" />
                          <!--
                            No games yet (M45 H6d): the first empty slot says where games come from. A on any empty slot adds
                            games then, since there is nothing to put in a folder.
                          -->
                          <Border IsVisible="{Binding IsAddGames}" CornerRadius="{x:Static vm:HandheldTokens.SlotRadius}" BorderBrush="{x:Static vm:HandheldTokens.ClassicAddGamesEdge}"
                                  BorderThickness="3" Background="{x:Static vm:HandheldTokens.ClassicAddGamesFill}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Add}" Width="64" Height="64" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}"
                                        HorizontalAlignment="Center" />
                              <TextBlock Text="Add games" FontSize="{x:Static vm:HandheldTokens.AddGames}" FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}"
                                         HorizontalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <!-- A platform folder that arrived since you last looked. -->
                          <Border IsVisible="{Binding IsNew}" Classes="ribbon" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="New" />
                          </Border>
                          </Panel>
                          <!--
                            Big Type (M47 B3): matte squarer tiles. A folder or an app is a flat tile with its monogram fitted to it
                            (76% of its width, at most 56% of its side) or its glyph; focused, it is white with its colour as the ink.
                            A game is its cover cropped square. Nothing has a shadow, a gloss or a gradient.
                          -->
                          <Panel Classes="bt-face" IsVisible="{x:Static vm:HandheldTokens.IsBigType}">
                            <Border IsVisible="{Binding IsFlatTile}" CornerRadius="{x:Static vm:HandheldTokens.TileRadius}" Background="{Binding FaceBrush}">
                              <Panel>
                                <Viewbox IsVisible="{Binding HasFaceMonogram}" Width="{x:Static vm:HandheldTokens.MonogramHomeWidth}" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Monogram}" FontSize="{x:Static vm:HandheldTokens.MonogramHome}" FontWeight="{x:Static vm:HandheldTokens.MonogramWeight}"
                                             LetterSpacing="{x:Static vm:HandheldTokens.MonogramHomeSpacing}" Foreground="{Binding InkBrush}" />
                                </Viewbox>
                                <PathIcon IsVisible="{Binding HasFaceGlyph}" Data="{Binding FaceGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                                          Width="{x:Static vm:HandheldTokens.GlyphHome}" Height="{x:Static vm:HandheldTokens.GlyphHome}" Foreground="{Binding InkBrush}" />
                              </Panel>
                            </Border>
                            <Border IsVisible="{Binding IsGame}" CornerRadius="{x:Static vm:HandheldTokens.TileRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.TileRest}"
                                    Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                              <Panel>
                                <TextBlock Classes="bt-tile-title" Text="{Binding Name}" IsVisible="{Binding !HasCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleBigHome}"
                                           LineHeight="{x:Static vm:HandheldTokens.TileTitleBigHomeLine}" Margin="{x:Static vm:HandheldTokens.TileTitleBigHomeMargin}" />
                                <Border IsVisible="{Binding HasCover}">
                                  <Border.Background>
                                    <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                                  </Border.Background>
                                </Border>
                              </Panel>
                            </Border>
                            <!-- An empty slot is a place: a faint dot; focused, a plus. -->
                            <Panel IsVisible="{Binding IsPlainEmpty}">
                              <Border IsVisible="{Binding !IsFocused}" Width="{x:Static vm:HandheldTokens.EmptySlotDot}" Height="{x:Static vm:HandheldTokens.EmptySlotDot}"
                                      CornerRadius="{x:Static vm:HandheldTokens.EmptySlotDotRadius}" Background="{x:Static vm:HandheldTokens.OnColour}"
                                      Opacity="{x:Static vm:HandheldTokens.EmptySlotDotOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Panel IsVisible="{Binding IsFocused}" Opacity="{x:Static vm:HandheldTokens.EmptySlotPlusOpacity}">
                                <Border Width="{x:Static vm:HandheldTokens.EmptySlotPlus}" Height="{x:Static vm:HandheldTokens.EmptySlotDot}" CornerRadius="{x:Static vm:HandheldTokens.EmptySlotDotRadius}"
                                        Background="{x:Static vm:HandheldTokens.OnColour}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Width="{x:Static vm:HandheldTokens.EmptySlotDot}" Height="{x:Static vm:HandheldTokens.EmptySlotPlus}" CornerRadius="{x:Static vm:HandheldTokens.EmptySlotDotRadius}"
                                        Background="{x:Static vm:HandheldTokens.OnColour}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Panel>
                            </Panel>
                            <!-- A missing file: the tile fades and carries a white mark with "!"; a new folder's mark holds a dot. -->
                            <Border Classes="corner-mark" IsVisible="{Binding IsUnavailable}">
                              <TextBlock Text="!" Foreground="{Binding GroundBrush}" />
                            </Border>
                            <Border Classes="corner-mark" IsVisible="{Binding IsNew}">
                              <Ellipse Width="{x:Static vm:HandheldTokens.CornerMarkDot}" Height="{x:Static vm:HandheldTokens.CornerMarkDot}" Fill="{Binding GroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Panel>
                          <!-- Move mode: the game or folder the carried game would merge with. -->
                          <!-- Move mode: a game held over another game or one of your folders, about to merge with it. -->
                          <Panel IsVisible="{Binding IsDropTarget}">
                            <Border CornerRadius="{x:Static vm:HandheldTokens.SlotRadius}" Margin="-3,17,-3,0" Background="{x:Static vm:HandheldTokens.ClassicDropFill}" />
                            <Panel Width="116" Height="116" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-18,0"
                                   RenderTransform="rotate(8deg)">
                              <vh:HandheldShadow Radius="{x:Static vm:HandheldTokens.ClassicCarriedShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicCarriedShadowBlur}" Margin="-14,-8,-14,-20" Color="{x:Static vm:HandheldTokens.ClassicDropShadow}" Filled="True" />
                              <Border CornerRadius="{x:Static vm:HandheldTokens.CarriedTileRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}" BorderBrush="{x:Static vm:HandheldTokens.ClassicEdge}" BorderThickness="4">
                                <Panel>
                                  <TextBlock Text="{Binding CarriedTitle}" IsVisible="{Binding !HasCarriedCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleCarried}"
                                             FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                             Margin="8" VerticalAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                  <Border IsVisible="{Binding HasCarriedCover}">
                                    <Border.Background>
                                      <ImageBrush Source="{Binding CarriedCover}" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Border.Background>
                                  </Border>
                                </Panel>
                              </Border>
                            </Panel>
                            <Border Width="52" Height="52" CornerRadius="{x:Static vm:HandheldTokens.ClassicMergeBadgeRadius}" Background="{x:Static vm:HandheldTokens.ClassicAccent}" BorderBrush="{x:Static vm:HandheldTokens.ClassicEdge}" BorderThickness="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Plus}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                            </Border>
                          </Panel>
                          <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusTile}" Margin="{x:Static vm:HandheldTokens.RingOutsetTile}" />
                        </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>

        <!-- Today's look: the page's name, the edge hints and the dots (Big Type puts "1 / 2" in the dock row's corner). -->
        <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <!-- The 16:9 screen's spare height above the 7×3 grid names the page (M45 H5). -->
        <TextBlock x:Name="PageLabel" Text="{Binding PageLabel}" IsVisible="{Binding IsWide}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                   FontSize="{x:Static vm:HandheldTokens.PageLabel}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" FontFeatures="+tnum" />

        <!-- Edge hints: another page that way (a tap turns to it). -->
        <Border x:Name="EdgeLeft" Classes="edge" IsVisible="{Binding CanPageLeft}" HorizontalAlignment="Left" Margin="8,0,0,0">
          <PathIcon Data="{x:Static vm:HandheldIcons.ChevronLeft}" />
        </Border>
        <Border x:Name="EdgeRight" Classes="edge" IsVisible="{Binding CanPageRight}" HorizontalAlignment="Right" Margin="0,0,8,0">
          <PathIcon Data="{x:Static vm:HandheldIcons.ChevronRight}" />
        </Border>
        </Panel>

        <!-- Page dots, with the current-page pill riding the track's position. -->
        <Panel Grid.Row="1" IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
        <Panel IsVisible="{Binding HasMultiplePages}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl x:Name="PageDots" ItemsSource="{Binding PageDots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.PageDotGap}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldPageDotViewModel">
                <Border Width="{x:Static vm:HandheldTokens.PageDotWidth}" Height="{x:Static vm:HandheldTokens.PageDotHeight}" CornerRadius="{x:Static vm:HandheldTokens.PageDotRadius}" Background="{x:Static vm:HandheldTokens.PageDot}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="PageIndicator" Width="{x:Static vm:HandheldTokens.PageIndicatorWidth}" Height="{x:Static vm:HandheldTokens.PageDotHeight}" CornerRadius="{x:Static vm:HandheldTokens.PageDotRadius}" Background="{x:Static vm:HandheldTokens.ClassicAccent}"
                  HorizontalAlignment="Left" />
        </Panel>
        </Panel>
      </Grid>

      <!-- ===== An open folder ===== -->
      <!--
        Clipped 32 px in from the canvas edge: the column behind the window waits out of sight there, and the
        lifted left column (1.13×, 15 px past its 48 px margin) still fits.
      -->
      <!--
        One surface for the Zoom through: header and grid scale together from the pressed folder's place.
      -->
      <Panel x:Name="FolderPage" IsVisible="{Binding IsFolderOpen}" ClipToBounds="True" Margin="{x:Static vm:HandheldTokens.FolderPageMargin}">
      <Grid RowDefinitions="Auto,*" Margin="{x:Static vm:HandheldTokens.FolderGridMargin}">
        <!-- Header: Back, the folder's name and count, the sort chip; aligned to the grid's left edge. -->
        <Grid x:Name="FolderHeader" ColumnDefinitions="Auto,*,Auto" Margin="0,0,48,0" IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
          <Border x:Name="BackShot" Classes="shot" Padding="24" Margin="-24">
          <Panel Classes="focusable" Classes.focused="{Binding OpenFolder.IsBackFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsBackFocused}">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.Glyph}" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusChip}" Margin="-16">
              <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusChip}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusChip}" /></Border>
            </Border>
          </Panel>
          </Border>
          <StackPanel x:Name="FolderTitle" Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="{x:Static vm:HandheldTokens.FolderDotRadius}" Background="{Binding OpenFolder.AccentBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding OpenFolder.Name}" FontSize="{x:Static vm:HandheldTokens.FolderHeading}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Text="{Binding OpenFolder.CountText}" FontSize="{x:Static vm:HandheldTokens.HeadingCount}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}"
                       VerticalAlignment="Center" FontFeatures="+tnum" />
          </StackPanel>
          <Border x:Name="SortShot" Grid.Column="2" Classes="shot" Padding="24" Margin="-24" IsVisible="{Binding OpenFolder.CanSort}">
          <Panel Classes="focusable" Classes.focused="{Binding OpenFolder.IsSortFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsSortFocused}">
            <Border Classes="chip">
              <TextBlock Classes="chip-text" Text="{Binding OpenFolder.SortLabel}" />
            </Border>
            <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusChip}" Margin="-16">
              <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusChip}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusChip}" /></Border>
            </Border>
          </Panel>
          </Border>
        </Grid>

        <!--
          The games: three rows of 232 px tiles on a 264 × 256 pitch, filled column by column, centred
          between the header and the dock. Only the visible window (four columns plus the one peeking in at
          the right edge, plus the one just behind the left edge) is realized; the track spring slides it.
        -->
        <ItemsControl x:Name="FolderTiles" Grid.Row="1" ItemsSource="{Binding OpenFolder.VisibleTiles}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                      ClipToBounds="False" VerticalAlignment="{x:Static vm:HandheldTokens.FolderTrackAlignment}" IsVisible="{Binding OpenFolder.HasGames}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Vertical" Height="{x:Static vm:HandheldTokens.FolderTrackHeight}" ItemWidth="{x:Static vm:HandheldTokens.FolderPitch}" ItemHeight="{x:Static vm:HandheldTokens.FolderRowPitch}" ClipToBounds="False" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldGameTileViewModel">
              <Border Classes="shot" Padding="48" Margin="-48" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Panel Classes="focusable folder-tile" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}" Width="{x:Static vm:HandheldTokens.TileFolder}" Height="{x:Static vm:HandheldTokens.TileFolder}"
                     HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- Today's look (M47 B3 keeps it whole behind the look switch). -->
                <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
                <vh:HandheldShadow Radius="{x:Static vm:HandheldTokens.ClassicFolderTileShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicFolderTileShadowBlur}" Margin="-20,-12,-20,-28" Filled="True" />
                <vh:HandheldShadow Classes="lift" Radius="{x:Static vm:HandheldTokens.ClassicFolderTileShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicLiftShadowBlur}" Margin="-32,-16,-32,-48" Color="{x:Static vm:HandheldTokens.ClassicLiftShadow}" Filled="True" />
                <!-- Settings, put in one of your folders: the same face as on home. -->
                <Border Classes="settings-face" CornerRadius="{x:Static vm:HandheldTokens.TileRadiusFolder}" IsVisible="{Binding IsSettings}">
                  <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="104" Height="104" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                </Border>
                <!-- Activity, put in one of your folders (M46 P4): the same face as on home. -->
                <Border Classes="activity-face" CornerRadius="{x:Static vm:HandheldTokens.TileRadiusFolder}" IsVisible="{Binding IsActivity}">
                  <PathIcon Data="{x:Static vm:HandheldIcons.Activity}" Width="104" Height="104" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                </Border>
                <!-- Covers crop from the top, where a box's title and art usually are. -->
                <Border CornerRadius="{x:Static vm:HandheldTokens.TileRadiusFolder}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}" IsVisible="{Binding IsGame}"
                        Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                  <Panel>
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding !HasCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleFolder}" FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}"
                               Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxLines="4"
                               TextTrimming="CharacterEllipsis" />
                    <Border IsVisible="{Binding HasCover}">
                      <Border.Background>
                        <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                      </Border.Background>
                    </Border>
                  </Panel>
                </Border>
                </Panel>
                <!-- Big Type (M47 B3): the cover cropped square and nothing else; Settings and Activity as flat tiles with their glyph. -->
                <Panel IsVisible="{x:Static vm:HandheldTokens.IsBigType}">
                  <Border IsVisible="{Binding IsApp}" CornerRadius="{x:Static vm:HandheldTokens.TileRadiusFolder}" Background="{Binding FaceBrush}">
                    <PathIcon Data="{Binding AppGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                              Width="{x:Static vm:HandheldTokens.GlyphFolder}" Height="{x:Static vm:HandheldTokens.GlyphFolder}" Foreground="{Binding InkBrush}" />
                  </Border>
                  <Border IsVisible="{Binding IsGame}" CornerRadius="{x:Static vm:HandheldTokens.TileRadiusFolder}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.TileRest}"
                          Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                    <Panel>
                      <TextBlock Classes="bt-tile-title" Text="{Binding Title}" IsVisible="{Binding !HasCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleBigFolder}"
                                 LineHeight="{x:Static vm:HandheldTokens.TileTitleBigFolderLine}" Margin="{x:Static vm:HandheldTokens.TileTitleBigFolderMargin}" />
                      <Border IsVisible="{Binding HasCover}">
                        <Border.Background>
                          <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                      </Border>
                    </Panel>
                  </Border>
                  <Border Classes="corner-mark" IsVisible="{Binding IsUnavailable}">
                    <TextBlock Text="!" Foreground="{Binding GroundBrush}" />
                  </Border>
                </Panel>
                <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusTileFolder}" Margin="{x:Static vm:HandheldTokens.RingOutsetTile}">
                  <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusTileFolder}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusTileFolder}" /></Border>
                </Border>
              </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty folder: say so rather than show nothing. -->
        <StackPanel x:Name="FolderEmpty" Grid.Row="1" IsVisible="{Binding OpenFolder.IsEmpty}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8" Margin="0,0,48,0">
          <TextBlock Text="This folder is empty" FontSize="{x:Static vm:HandheldTokens.FolderEmptyHeading}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.FolderEmptyInk}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding OpenFolder.EmptyHint}" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.FolderEmptyHintInk}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <!--
        Big Type (M47 B3): the header is plain type on the colour, the folder's name at the left and its count at the right, with
        no Back or sort chip. Up from the top row still reaches Back and the sort (B7 moves the sort into the Y menu): the ring
        then frames the name, or the sort's value in the dock row's corner.
      -->
      <Grid x:Name="BtFolderHeader" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" ColumnDefinitions="*,Auto" VerticalAlignment="Top"
            Margin="{x:Static vm:HandheldTokens.HeaderMargin}" Height="{x:Static vm:HandheldTokens.HeaderHeight}">
        <Border x:Name="BtBackShot" RenderOptions.TextRenderingMode="Antialias" Classes="shot" Padding="24" Margin="{x:Static vm:HandheldTokens.HeaderNameShotMargin}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <Panel vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsBackFocused}">
            <!-- M47 B8: the name's letters land as the folder opens (the mock's lettersIn(fname, .9)); set smaller to fit as setHead does. -->
            <vh:HandheldBigTypeHeading x:Name="BtFolderName" Text="{Binding OpenFolder.Name, FallbackValue={x:Null}}" Size="{x:Static vm:HandheldTokens.FolderHeading}"
                                       MaxTextWidth="{x:Static vm:HandheldTokens.HeaderNameMaxWidth}" FitsRoom="True" FixedSpacing="{x:Static vm:HandheldTokens.HeadingSpacing}"
                                       FromEm="{x:Static vm:HandheldTokens.HeadingInFromEm}" Foreground="{x:Static vm:HandheldTokens.OnColour}" HorizontalAlignment="Left" />
            <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusRow}" Margin="-16" />
          </Panel>
        </Border>
        <vh:HandheldRollingText x:Name="BtFolderCount" RenderOptions.TextRenderingMode="Antialias" Grid.Column="1" Text="{Binding OpenFolder.CountNumber}" VerticalAlignment="Bottom" Margin="{x:Static vm:HandheldTokens.HeaderCountMargin}"
                   FontSize="{x:Static vm:HandheldTokens.HeadingCount}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnColour}"
                   Opacity="{x:Static vm:HandheldTokens.HeadingCountOpacity}" LineHeight="{x:Static vm:HandheldTokens.HeaderLineHeight}" FontFeatures="+tnum"
                   LetterSpacing="{x:Static vm:HandheldTokens.HeadingSpacing}" />
      </Grid>
      </Panel>

      <!-- ===== Dock: All apps, the five pinned apps, the menu button ===== -->
      <vh:HandheldShadow x:Name="DockShadow" Grid.Row="1" IsVisible="{x:Static vm:HandheldTokens.IsClassic}" Margin="28,0,28,6" Height="152" Radius="{x:Static vm:HandheldTokens.ClassicDockShadowRadius}" Blur="{x:Static vm:HandheldTokens.ClassicDockShadowBlur}" Color="{x:Static vm:HandheldTokens.ClassicDockShadow}"
                         VerticalAlignment="Bottom" />
      <Border x:Name="DockPill" Grid.Row="1" Margin="48,0,48,32" Height="{x:Static vm:HandheldTokens.DockBarHeight}" CornerRadius="{x:Static vm:HandheldTokens.ClassicDockPillRadius}" Background="{x:Static vm:HandheldTokens.DockBarFill}"
              BorderBrush="{x:Static vm:HandheldTokens.DockBarEdge}" BorderThickness="1" ClipToBounds="False"
              VerticalAlignment="Bottom">
        <ItemsControl x:Name="DockItems" ItemsSource="{Binding DockItems}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                      ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.DockGap}" ClipToBounds="False" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldDockItemViewModel">
              <Border Classes="shot" Padding="16" Margin="-16">
              <Panel Classes="focusable dock-tile" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}" Width="{x:Static vm:HandheldTokens.DockTile}" Height="{x:Static vm:HandheldTokens.DockTile}">
                <!-- Today's look (M47 B3 keeps it whole behind the look switch). -->
                <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
                <!-- System buttons are quiet: a raised surface and a muted glyph, never a dark block. -->
                <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" Background="{x:Static vm:HandheldTokens.ClassicSurface}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1"
                        IsVisible="{Binding !IsApp}">
                  <Panel>
                    <PathIcon Data="{x:Static vm:HandheldIcons.AllApps}" Width="36" Height="36" Foreground="{x:Static vm:HandheldTokens.Glyph}"
                              IsVisible="{Binding IsAllApps}" />
                    <PathIcon Data="{x:Static vm:HandheldIcons.Menu}" Width="36" Height="36" Foreground="{x:Static vm:HandheldTokens.Glyph}"
                              IsVisible="{Binding IsMenu}" />
                  </Panel>
                </Border>
                <Panel IsVisible="{Binding IsApp}">
                  <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" BorderBrush="{x:Static vm:HandheldTokens.ClassicEmptySlotEdge}" BorderThickness="2" Background="{x:Static vm:HandheldTokens.ClassicEmptySlotFill}"
                          IsVisible="{Binding Slot.IsEmpty}" />
                  <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" ClipToBounds="True" IsVisible="{Binding Slot.HasIcon}">
                    <Image Source="{Binding Slot.Icon}" Stretch="Uniform" />
                  </Border>
                </Panel>
                </Panel>
                <!-- Big Type (M47 B3): each app is its own icon; All apps and the menu are flat buttons with white glyphs. -->
                <Panel IsVisible="{x:Static vm:HandheldTokens.IsBigType}">
                  <Border IsVisible="{Binding !IsApp}" CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" Background="{Binding FaceBrush}">
                    <Panel>
                      <PathIcon Data="{x:Static vm:HandheldIcons.AllApps}" Width="{x:Static vm:HandheldTokens.GlyphDock}" Height="{x:Static vm:HandheldTokens.GlyphDock}"
                                Foreground="{Binding InkBrush}" IsVisible="{Binding IsAllApps}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Menu}" Width="{x:Static vm:HandheldTokens.GlyphDock}" Height="{x:Static vm:HandheldTokens.GlyphDock}"
                                Foreground="{Binding InkBrush}" IsVisible="{Binding IsMenu}" />
                    </Panel>
                  </Border>
                  <Panel IsVisible="{Binding IsApp}">
                    <Border IsVisible="{Binding Slot.IsEmpty}" Width="{x:Static vm:HandheldTokens.EmptySlotDot}" Height="{x:Static vm:HandheldTokens.EmptySlotDot}"
                            CornerRadius="{x:Static vm:HandheldTokens.EmptySlotDotRadius}" Background="{x:Static vm:HandheldTokens.OnColour}"
                            Opacity="{x:Static vm:HandheldTokens.EmptySlotDotOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="{x:Static vm:HandheldTokens.DockRadius}" ClipToBounds="True" IsVisible="{Binding Slot.HasIcon}">
                      <Image Source="{Binding Slot.Icon}" Stretch="Uniform" />
                    </Border>
                  </Panel>
                </Panel>
                <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusDock}" Margin="{x:Static vm:HandheldTokens.RingOutsetDock}">
                  <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusDock}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusDock}" /></Border>
                </Border>
              </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!--
        Big Type (M47 B3): the dock row's two corners, plain type on the colour, centred on the dock's buttons. At the left the
        swap hint; at the right the page ("1 / 2") on home, or an open folder's sort, which the ring frames when Up from the
        top row reaches it (the sort chip's place in today's look).
      -->
      <!--
        Each piece pictured for the native Launcher sets grey-scale antialiasing on itself (a piece pictured alone does not inherit its
        parent's): on Android the default draws pictured text with a black box behind each glyph (M47 B6, as B4 found on the Stage).
      -->
      <Panel x:Name="BtCorners" Grid.Row="1" IsVisible="{x:Static vm:HandheldTokens.IsBigType}" Margin="{x:Static vm:HandheldTokens.DockCornerMargin}"
             Height="{x:Static vm:HandheldTokens.DockTile}" VerticalAlignment="Bottom">
        <!-- Only while X really swaps the screens (M47 B9): a sheet, a list, a keyboard, a held tile or a launch takes X for something else. -->
        <StackPanel x:Name="BtSwap" IsVisible="{Binding $parent[UserControl].((vm:HandheldShellViewModel)DataContext).XSwaps, FallbackValue=True}" RenderOptions.TextRenderingMode="Antialias" Orientation="Horizontal" Spacing="{x:Static vm:HandheldTokens.DockCornerGap}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Opacity="{x:Static vm:HandheldTokens.DockCornerOpacity}">
          <Border Width="{x:Static vm:HandheldTokens.DockCornerGlyph}" Height="{x:Static vm:HandheldTokens.DockCornerGlyph}" CornerRadius="{x:Static vm:HandheldTokens.DockCornerGlyphRadius}"
                  BorderBrush="{x:Static vm:HandheldTokens.OnColour}" BorderThickness="{x:Static vm:HandheldTokens.DockCornerGlyphStroke}" VerticalAlignment="Center">
            <TextBlock Text="X" FontSize="{x:Static vm:HandheldTokens.DockCornerGlyphLetter}" FontWeight="ExtraBold" Foreground="{x:Static vm:HandheldTokens.OnColour}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="dock-corner" Text="Swap" />
        </StackPanel>
        <!-- The page, or (M47 B7, the mock's) Settings' version while Settings is open: it rolls from one to the other. -->
        <vh:HandheldRollingText x:Name="BtPage" RenderOptions.TextRenderingMode="Antialias" Classes="dock-corner" x:DataType="vm:HandheldHomeScreenViewModel"
                   HorizontalAlignment="Right" Opacity="{x:Static vm:HandheldTokens.DockCornerOpacity}" >
          <vh:HandheldRollingText.Text>
            <MultiBinding Converter="{x:Static vm:HandheldViewConverters.FirstText}">
              <Binding Path="$parent[UserControl].((vm:HandheldShellViewModel)DataContext).Settings.Version" FallbackValue="" />
              <Binding Path="PageCountText" />
            </MultiBinding>
          </vh:HandheldRollingText.Text>
          <vh:HandheldRollingText.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="IsPageCountShown" />
              <Binding Path="$parent[UserControl].((vm:HandheldShellViewModel)DataContext).IsSettingsOpen" FallbackValue="False" />
            </MultiBinding>
          </vh:HandheldRollingText.IsVisible>
        </vh:HandheldRollingText>
        <Panel x:Name="BtSortCorner" IsVisible="{Binding IsFolderOpen}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="BtSortShot" RenderOptions.TextRenderingMode="Antialias" Classes="shot" Padding="24" Margin="-24" IsVisible="{Binding OpenFolder.CanSort}">
            <Panel vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsSortFocused}">
              <TextBlock Classes="dock-corner" Text="{Binding OpenFolder.SortLabel}" Opacity="{x:Static vm:HandheldTokens.DockCornerOpacity}" />
              <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusRow}" Margin="-16" />
            </Panel>
          </Border>
        </Panel>
      </Panel>

      <!-- A picture of a closing folder's page, shrinking back into its folder. -->
      <Canvas x:Name="GhostLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
  </Viewbox>

  <!--
    ===== The Title page (A on a game) =====
    Covers the grid and the dock, as the mockup's page does; the facts on the left of a row of big buttons,
    and the disc chooser, the screen chooser, the actions sheet and the launching panel as its states.
  -->
  <Panel x:Name="TitleLayer" IsVisible="{Binding ShowsTitlePage}">
    <Panel.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
        <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
      </LinearGradientBrush>
    </Panel.Background>
    <!-- The platform's colour as a soft wash from the top. -->
    <Border Background="{Binding TitlePage.AccentBrush}" Opacity="0.14">
      <Border.OpacityMask>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicWashOpaque}" />
          <GradientStop Offset="0.7" Color="{x:Static vm:HandheldTokens.ClassicWashClear}" />
        </LinearGradientBrush>
      </Border.OpacityMask>
    </Border>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid Width="1240" Height="1080" ClipToBounds="False">

        <Grid x:Name="TitleBody" IsVisible="{Binding TitlePage.IsBrowsable}" RowDefinitions="88,*,136,56" Margin="48,40,48,32">
          <!-- Header: Back and where the page came from. -->
          <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.Glyph}" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding TitlePage.CrumbLine}" FontSize="{x:Static vm:HandheldTokens.Crumb}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="860" />
          </StackPanel>

          <!-- Body: the cover, then the facts. -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,24">
            <Border Width="392" Height="552" CornerRadius="{x:Static vm:HandheldTokens.TitleCoverRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}"
                    BoxShadow="{x:Static vm:HandheldTokens.ClassicCoverShadow}" VerticalAlignment="Center">
              <Panel>
                <TextBlock Text="{Binding TitlePage.Title}" IsVisible="{Binding !TitlePage.HasCover}" FontSize="{x:Static vm:HandheldTokens.TileTitleCover}"
                           FontWeight="{x:Static vm:HandheldTokens.TileTitleWeight}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border IsVisible="{Binding TitlePage.HasCover}">
                  <Border.Background>
                    <ImageBrush Source="{Binding TitlePage.Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Margin="48,0,0,0" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="{Binding TitlePage.Title}" FontSize="{x:Static vm:HandheldTokens.TitleName}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                         TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TitlePage.PlatformLine}" FontSize="{x:Static vm:HandheldTokens.TitlePlatform}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}"
                         TextTrimming="CharacterEllipsis" />
              <!-- The play facts (first played and per session from the play log, M46 P4), then how it runs. -->
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,32,0,0">
                <TextBlock Classes="fact-label" Text="Last played" />
                <TextBlock Classes="fact-value" Grid.Column="1" Text="{Binding TitlePage.LastPlayedText}" />
                <TextBlock Classes="fact-label" Grid.Row="1" Text="First played" IsVisible="{Binding TitlePage.HasPlayed}" />
                <TextBlock Classes="fact-value" Grid.Row="1" Grid.Column="1" Text="{Binding TitlePage.FirstPlayedText}"
                           IsVisible="{Binding TitlePage.HasPlayed}" />
                <TextBlock Classes="fact-label" Grid.Row="2" Text="Play time" />
                <TextBlock Classes="fact-value" Grid.Row="2" Grid.Column="1" Text="{Binding TitlePage.PlaytimeText}" />
                <TextBlock Classes="fact-label" Grid.Row="3" Text="Per session" IsVisible="{Binding TitlePage.HasPlayed}" />
                <TextBlock Classes="fact-value" Grid.Row="3" Grid.Column="1" Text="{Binding TitlePage.AverageSessionText}"
                           IsVisible="{Binding TitlePage.HasPlayed}" />
                <TextBlock Classes="fact-label" Grid.Row="4" Text="Runs on" />
                <TextBlock Classes="fact-value" Grid.Row="4" Grid.Column="1" Text="{Binding TitlePage.ScreenText}" />
                <TextBlock Classes="fact-label" Grid.Row="5" Text="Discs" IsVisible="{Binding TitlePage.HasDiscs}" />
                <TextBlock Classes="fact-value" Grid.Row="5" Grid.Column="1" Text="{Binding TitlePage.DiscText}"
                           IsVisible="{Binding TitlePage.HasDiscs}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0" IsVisible="{Binding TitlePage.HasAchievements}">
                <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="32" Height="32" Foreground="{x:Static vm:HandheldTokens.Trophy}" />
                <TextBlock Text="{Binding TitlePage.AchievementLine}" FontSize="{x:Static vm:HandheldTokens.Facts}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}"
                           Foreground="{x:Static vm:HandheldTokens.OnGround}" VerticalAlignment="Center" FontFeatures="+tnum" />
                <ProgressBar Width="160" Height="{x:Static vm:HandheldTokens.ProgressHeight}" MinHeight="{x:Static vm:HandheldTokens.ProgressHeight}" CornerRadius="{x:Static vm:HandheldTokens.ProgressRadius}" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding TitlePage.AchievementRatio}"
                             Background="{x:Static vm:HandheldTokens.ProgressTrack}" Foreground="{x:Static vm:HandheldTokens.TrophyBright}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- The buttons: Play, Disc (multi-disc), Achievements. -->
          <ItemsControl x:Name="TitleButtons" Grid.Row="2" ItemsSource="{Binding TitlePage.Buttons}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                        ClipToBounds="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="32" ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldTitleButtonViewModel">
                <Border Classes="shot" Padding="32" Margin="-32">
                <Panel Classes="focusable" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}">
                  <Border Classes="title-button" Classes.play="{Binding IsPlay}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <PathIcon Data="{x:Static vm:HandheldIcons.Play}" IsVisible="{Binding IsPlay}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Disc}" IsVisible="{Binding IsDisc}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" IsVisible="{Binding IsAchievements}" />
                      <TextBlock Classes="label" Text="{Binding Label}" />
                      <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusButton}" Margin="-20">
                    <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusButton}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusButton}" /></Border>
                  </Border>
                </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Footer: the buttons that are not on the page. -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="32" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="hint-glyph">
                <TextBlock Text="Y" FontSize="{x:Static vm:HandheldTokens.HintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.HintGlyphWeight}" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="chip-text" Text="More actions" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="hint-glyph">
                <TextBlock Text="B" FontSize="{x:Static vm:HandheldTokens.HintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.HintGlyphWeight}" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="chip-text" Text="Back" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- State: the disc chooser or the actions sheet, a card over a scrim. -->
        <Border x:Name="OptionSheet" IsVisible="{Binding TitlePage.IsOptionList}" Background="{x:Static vm:HandheldTokens.Scrim}" Margin="-400">
          <Border x:Name="OptionCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" CornerRadius="{x:Static vm:HandheldTokens.ClassicSheetRadius}"
                  Background="{x:Static vm:HandheldTokens.ClassicSurface}" Padding="24,16,24,24" BoxShadow="{x:Static vm:HandheldTokens.ClassicSheetShadow}">
            <StackPanel Spacing="8">
              <StackPanel Margin="24,8,24,8" Spacing="4">
                <TextBlock Text="{Binding TitlePage.OptionsHeading}" FontSize="{x:Static vm:HandheldTokens.TitleOptionsTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" />
                <TextBlock Text="{Binding TitlePage.Title}" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding TitlePage.Options}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HandheldTitleOptionViewModel">
                    <Border CornerRadius="{x:Static vm:HandheldTokens.MenuRowRadius}" Height="80" Padding="24,0"
                            Background="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.MenuRow}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowText}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="{x:Static vm:HandheldTokens.MenuRowNote}"
                                   VerticalAlignment="Center" Margin="24,0,0,0" FontFeatures="+tnum"
                                   Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowNote}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Border>

        <!-- State: the launch-screen chooser — two screen cards and "Always use this screen". -->
        <Border x:Name="ScreenSheet" IsVisible="{Binding TitlePage.IsScreenChooser}" Background="{x:Static vm:HandheldTokens.Scrim}" Margin="-400">
          <Border x:Name="ScreenCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000" CornerRadius="{x:Static vm:HandheldTokens.ClassicChooserRadius}"
                  Background="{x:Static vm:HandheldTokens.ClassicSheetSurface}" Padding="48,40" BoxShadow="{x:Static vm:HandheldTokens.ClassicSheetShadow}" ClipToBounds="False">
            <StackPanel Spacing="32" ClipToBounds="False">
              <StackPanel Spacing="4">
                <TextBlock Text="Which screen?" FontSize="{x:Static vm:HandheldTokens.ChooserTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" />
                <TextBlock Text="{Binding TitlePage.Title}" FontSize="{x:Static vm:HandheldTokens.ChooserSubtitle}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" ClipToBounds="False">
                <Border x:Name="ScreenTopShot" Classes="shot" Padding="40" Margin="-40" ZIndex="{Binding TitlePage.IsTopScreenFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}">
                <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsTopScreenFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsTopScreenFocused}">
                  <Border Classes="screen-card">
                    <StackPanel Spacing="16" VerticalAlignment="Center">
                      <PathIcon Data="{x:Static vm:HandheldIcons.ScreenTop}" Width="96" Height="96" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}" />
                      <TextBlock Text="Top screen" FontSize="{x:Static vm:HandheldTokens.ScreenCardTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" HorizontalAlignment="Center" />
                      <TextBlock Text="The companion stays below" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusCard}" Margin="-20">
                    <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusCard}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusCard}" /></Border>
                  </Border>
                </Panel>
                </Border>
                <Border x:Name="ScreenBottomShot" Classes="shot" Padding="40" Margin="-40" ZIndex="{Binding TitlePage.IsBottomScreenFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}">
                <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsBottomScreenFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsBottomScreenFocused}">
                  <Border Classes="screen-card">
                    <StackPanel Spacing="16" VerticalAlignment="Center">
                      <PathIcon Data="{x:Static vm:HandheldIcons.ScreenBottom}" Width="96" Height="96" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}" />
                      <TextBlock Text="Bottom screen" FontSize="{x:Static vm:HandheldTokens.ScreenCardTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" HorizontalAlignment="Center" />
                      <TextBlock Text="The companion moves up" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusCard}" Margin="-20">
                    <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusCard}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusCard}" /></Border>
                  </Border>
                </Panel>
                </Border>
              </StackPanel>
              <!-- The remember toggle: a row with a check box. -->
              <Border x:Name="RememberShot" Classes="shot" Padding="24" Margin="-24" HorizontalAlignment="Center">
              <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsRememberFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsRememberFocused}" HorizontalAlignment="Center">
                <Border Classes="chip" Height="72" CornerRadius="{x:Static vm:HandheldTokens.ClassicRememberRadius}" Padding="24,0">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="40" Height="40" CornerRadius="{x:Static vm:HandheldTokens.CheckboxRadius}" BorderBrush="{x:Static vm:HandheldTokens.ClassicAccent}" BorderThickness="3" VerticalAlignment="Center"
                            Background="{Binding TitlePage.RememberScreen, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                      <PathIcon Data="{x:Static vm:HandheldIcons.Check}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.OnAccent}"
                                IsVisible="{Binding TitlePage.RememberScreen}" />
                    </Border>
                    <TextBlock Classes="chip-text" Text="{Binding TitlePage.RememberScreenLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="ring" CornerRadius="{x:Static vm:HandheldTokens.RingRadiusTitleChip}" Margin="-20">
                  <Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingBandRadiusRow}"><Border CornerRadius="{x:Static vm:HandheldTokens.ClassicRingInnerRadiusRow}" /></Border>
                </Border>
              </Panel>
              </Border>
            </StackPanel>
          </Border>
        </Border>

        <!-- State: launching — the pre-launch save sync (the blocking sync panel), then the emulator start. -->
        <StackPanel x:Name="LaunchPanel" IsVisible="{Binding TitlePage.IsLaunching}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
          <Border x:Name="LaunchCoverShot" Classes="shot" Padding="64" Margin="-64" HorizontalAlignment="Center">
          <Border x:Name="LaunchCover" Width="280" Height="392" CornerRadius="{x:Static vm:HandheldTokens.TitleCoverRadius}" ClipToBounds="True" Background="{x:Static vm:HandheldTokens.CoverPlaceholder}"
                  BoxShadow="{x:Static vm:HandheldTokens.ClassicCoverShadow}" HorizontalAlignment="Center">
            <Border IsVisible="{Binding TitlePage.HasCover}">
              <Border.Background>
                <ImageBrush Source="{Binding TitlePage.Cover}" Stretch="UniformToFill" AlignmentY="Top" />
              </Border.Background>
            </Border>
          </Border>
          </Border>
          <StackPanel x:Name="LaunchText" Spacing="8">
            <TextBlock Text="{Binding TitlePage.LaunchingHeading}" FontSize="{x:Static vm:HandheldTokens.LaunchHeading}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding TitlePage.LaunchingDetail}" FontSize="{x:Static vm:HandheldTokens.LaunchDetail}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1000" />
          </StackPanel>
          <ProgressBar x:Name="LaunchProgress" Classes="launch" Width="320" Height="{x:Static vm:HandheldTokens.LaunchProgressHeight}" MinHeight="{x:Static vm:HandheldTokens.LaunchProgressHeight}" CornerRadius="{x:Static vm:HandheldTokens.LaunchProgressRadius}"
                       HorizontalAlignment="Center" Background="{x:Static vm:HandheldTokens.ProgressTrack}" Foreground="{x:Static vm:HandheldTokens.ClassicAccent}" />
        </StackPanel>
      </Grid>
    </Viewbox>
  </Panel>

  <!--
    Big Type (M47 B7): the Start menu, the Y sheet, Settings and the panels as type on the colour, under the one ring (so drawn before
    it). Today's look keeps its cards below; Big Type still shows those for typing (the keyboard is B9's).
  -->
  <Viewbox Stretch="Uniform" ClipToBounds="False" IsVisible="{x:Static vm:HandheldTokens.IsBigType}">
    <vh:HandheldBigTypeLists x:Name="BtLists" Width="1240" Height="1080" />
  </Viewbox>

  <!--
    ===== The selector =====
    One frame for every focusable element (tiles, chips, dock buttons, Title page buttons and cards): a thick
    violet frame between white keylines, over a pre-rendered glow that breathes. It springs from element to
    element (HandheldLauncherMotion); the menu's scrim covers it.
  -->
  <Viewbox Stretch="Uniform" ClipToBounds="False" IsHitTestVisible="False">
    <Canvas x:Name="SelectorLayer" Width="1240" Height="1080" ClipToBounds="False">
      <vh:HandheldShadow x:Name="SelectorGlow" Blur="{x:Static vm:HandheldTokens.ClassicRingGlowBlur}" Color="{x:Static vm:HandheldTokens.ClassicRingGlow}" Width="1" Height="1" />
      <Panel x:Name="Selector">
        <Border x:Name="SelectorRing" Classes="selector-ring">
          <Border><Border /></Border>
        </Border>
      </Panel>
    </Canvas>
  </Viewbox>

  <!-- Today's look (Big Type draws the menu and the sheet as type, M47 B7). -->
  <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
  <!-- The menu's scrim covers the whole window, letterbox bands included. -->
      <Border IsVisible="{Binding IsMenuOpen}" Background="{x:Static vm:HandheldTokens.Scrim}">
        <Viewbox Stretch="Uniform">
        <Border Width="1240" Height="1080" Background="Transparent">
        <Border x:Name="MenuCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" CornerRadius="{x:Static vm:HandheldTokens.ClassicSheetRadius}"
                Background="{x:Static vm:HandheldTokens.ClassicSurface}" Padding="24,16,24,24" BoxShadow="{x:Static vm:HandheldTokens.ClassicSheetShadow}">
          <StackPanel Spacing="8">
            <TextBlock Text="Menu" FontSize="{x:Static vm:HandheldTokens.SheetTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" Margin="24,8,0,8" />
            <ItemsControl ItemsSource="{Binding MenuItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldMenuItemViewModel">
                  <!-- Card radius 40 − padding 24 = 16 for the rows inside it. -->
                  <Border CornerRadius="{x:Static vm:HandheldTokens.MenuRowRadius}" Height="80" Padding="24,0"
                          Background="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.MenuRow}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" VerticalAlignment="Center"
                                 Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowText}}" />
                      <!-- A switch's state (Sounds, M45 H6d). -->
                      <TextBlock Grid.Column="1" Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="{x:Static vm:HandheldTokens.MenuRowState}"
                                 VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.75"
                                 Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowText}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </Border>
        </Viewbox>
      </Border>

  <!--
    ===== The actions sheet (Y) and its confirmations (H4) =====
    Slides up over the Launcher's lower half on a scrim; the focused row is filled with the accent. Every
    "Remove" row names its place. A tap runs a row; a tap on the scrim closes the sheet.
  -->
  <Border x:Name="SheetLayer" IsVisible="{Binding IsSheetOpen}" Background="{x:Static vm:HandheldTokens.Scrim}">
    <Viewbox Stretch="Uniform">
      <Border Width="1240" Height="1080" Background="Transparent">
        <Border x:Name="SheetCard" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="880" Margin="0,0,0,48"
                CornerRadius="{x:Static vm:HandheldTokens.ClassicBottomSheetRadius}" Background="{x:Static vm:HandheldTokens.ClassicSurface}" Padding="24,32,24,24" BoxShadow="{x:Static vm:HandheldTokens.ClassicBottomSheetShadow}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" Margin="20,0,28,8">
              <!-- What the sheet acts on: the game's cover, or the folder's colour with its glyph. -->
              <Panel Width="104" Height="104" Margin="0,0,24,0" VerticalAlignment="Center"
                     IsVisible="{Binding Sheet.HasThumbnail}">
                <Border CornerRadius="{x:Static vm:HandheldTokens.SwatchRadius}" ClipToBounds="True" BoxShadow="{x:Static vm:HandheldTokens.ClassicThumbShadow}">
                  <Border.Background>
                    <ImageBrush Source="{Binding Sheet.Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                  </Border.Background>
                </Border>
              </Panel>
              <Border Width="104" Height="104" Margin="0,0,24,0" CornerRadius="{x:Static vm:HandheldTokens.SwatchRadius}" VerticalAlignment="Center"
                      Background="{Binding Sheet.Swatch}" BorderBrush="{x:Static vm:HandheldTokens.ClassicHairline}" BorderThickness="1"
                      IsVisible="{Binding Sheet.HasSwatch}" BoxShadow="{x:Static vm:HandheldTokens.ClassicSwatchShadow}">
                <Panel>
                  <PathIcon Data="{Binding Sheet.SwatchGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                            IsVisible="{Binding Sheet.HasSwatchGlyph}" Width="52" Height="52" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                  <TextBlock Text="{Binding Sheet.SwatchText}" FontSize="{x:Static vm:HandheldTokens.SwatchMonogram}" FontWeight="{x:Static vm:HandheldTokens.SwatchMonogramWeight}" Foreground="{x:Static vm:HandheldTokens.OnAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Sheet.Title}" FontSize="{x:Static vm:HandheldTokens.BottomSheetTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sheet.Subtitle}" IsVisible="{Binding Sheet.HasSubtitle}" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
              </StackPanel>
            </Grid>
            <!--
              A game's sheet holds every action (M45 H6c), more rows than fit: the list scrolls to keep the focus in view, and
              shows whole rows only (eight 88 px rows and their 4 px gaps), so a row is never cut at the edge.
            -->
            <ScrollViewer x:Name="SheetScroller" MaxHeight="732" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="SheetRows" ItemsSource="{Binding Sheet.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldSheetItemViewModel">
                  <Border Classes="sheet-row" Classes.focused="{Binding IsFocused}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Classes.destructive="{Binding IsDestructive}" Text="{Binding Label}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="note" Grid.Column="1" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                 VerticalAlignment="Center" Margin="24,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Border>
    </Viewbox>
  </Border>

  </Panel>

  <!--
    ===== A panel (M45 H6c): the scraper, the batch scraper, cover search, achievements, Search, Edit title =====
    Laid across the screens the way Settings is: its rows (or the keyboard) here, the focused row's card on the Stage. It
    takes this Launcher's canvas (1240 wide, or 1920 on the 16:9 screen): the view sets PanelCanvas's width.
  -->
  <!-- Today's look (Big Type draws a panel's rows as type, M47 B7, and its keyboard as the mock's, M47 B9). -->
  <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
  <Border x:Name="PanelLayer" IsVisible="{Binding IsPanelOpen}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
        <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid x:Name="PanelCanvas" Width="1240" Height="1080" ClipToBounds="False">
        <vh:HandheldPanelView x:Name="PanelView" DataContext="{Binding Panel}" />
      </Grid>
    </Viewbox>
  </Border>
  </Panel>

  <!--
    ===== Naming a folder (H4) =====
    The mockup's keyboard, on the bottom screen: the name as typed, the colour chips, then the keys. The pad
    moves over the keys (A types, B deletes, Y is a space, X or Start finishes) and up from the top row reaches
    the colours; taps work too. The Stage shows the folder with the name and colour as they change.
  -->
  <!-- Today's look (Big Type names a folder on the mock's keyboard, M47 B9). -->
  <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
  <Border x:Name="NamingLayer" IsVisible="{Binding IsNaming}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
        <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform">
      <Border Width="1240" Height="1080" Background="Transparent">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="64,48,64,40">
          <!-- The field: what the folder is called so far. -->
          <Border Classes="name-field" Classes.focused="True">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Naming.Heading}" FontSize="{x:Static vm:HandheldTokens.FieldLabel}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" VerticalAlignment="Center"
                         Margin="0,0,24,0" />
              <TextBox x:Name="NameField" Grid.Column="1" Classes="name-input" Text="{Binding Naming.Text, Mode=TwoWay}"
                       PlaceholderText="{Binding Naming.Placeholder}" MaxLength="24" FontSize="{x:Static vm:HandheldTokens.NamingField}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}"
                       Foreground="{x:Static vm:HandheldTokens.OnGround}" Background="Transparent" BorderThickness="0" MinHeight="80"
                       VerticalContentAlignment="Center" Focusable="True" />
            </Grid>
          </Border>
          <!-- Colour chips: up from the top row of keys. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="32" Margin="0,32,0,0">
            <TextBlock Text="Colour" FontSize="{x:Static vm:HandheldTokens.FieldLabel}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" VerticalAlignment="Center" Width="120" />
            <ItemsControl x:Name="ColourChips" ItemsSource="{Binding Naming.Colors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="32" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldColorChipViewModel">
                  <Border Classes="colour-chip" Classes.focused="{Binding IsFocused}" Background="{Binding Brush}">
                    <PathIcon Data="{x:Static vm:HandheldIcons.Check}" Width="40" Height="40" Foreground="{x:Static vm:HandheldTokens.OnAccent}"
                              IsVisible="{Binding IsChosen}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- The keys. -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Naming.KeyRows}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldKeyRowViewModel">
                <ItemsControl ItemsSource="{Binding Keys}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HandheldKeyViewModel">
                      <Border Classes="key" Classes.wide="{Binding IsWide}" Classes.done="{Binding IsDone}" Classes.focused="{Binding IsFocused}">
                        <TextBlock Text="{Binding Label}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- What the buttons do here. -->
          <ItemsControl Grid.Row="3" ItemsSource="{Binding Hints}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="40" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHint">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Classes="hint-glyph">
                    <TextBlock Text="{Binding Button}" FontSize="{x:Static vm:HandheldTokens.HintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.KeyboardHintGlyphWeight}" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.Hint}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Viewbox>
  </Border>
  </Panel>

  <!--
    ===== Settings (M45 H6a, decision 18) =====
    Master-detail across the screens: the sections and their rows here, and on the Stage what the focused one is, its
    value and its description. The rows are Gamepad mode's (HandheldSettingsViewModel over its projection), drawn in the
    Launcher's look; the choosers, the confirmations and the keyboard for text rows are states of this layer. It takes
    this Launcher's canvas (1240 wide, or 1920 on the 16:9 screen): the view sets SettingsCanvas's width.
  -->
  <!-- Today's look (Big Type draws Settings as type, M47 B7, and its keyboard as the mock's, M47 B9). -->
  <Panel IsVisible="{x:Static vm:HandheldTokens.IsClassic}">
  <Border x:Name="SettingsLayer" IsVisible="{Binding IsSettingsOpen}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="{x:Static vm:HandheldTokens.ClassicGroundTop}" />
        <GradientStop Offset="1" Color="{x:Static vm:HandheldTokens.ClassicGroundBottom}" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid x:Name="SettingsCanvas" Width="1240" Height="1080" ClipToBounds="False">

        <!-- The sections (left) and the section's rows (right). -->
        <Grid x:Name="SettingsBody" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
              IsVisible="{Binding !IsTyping}" Classes.rail="{Binding Projection.IsRailFocused}"
              ColumnDefinitions="360,*" RowDefinitions="64,*" Margin="48,40,48,32">
          <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <Border x:Name="SettingsBack" Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="{x:Static vm:HandheldTokens.Glyph}" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Heading}" FontSize="{x:Static vm:HandheldTokens.Heading}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding SectionTitle}" FontSize="{x:Static vm:HandheldTokens.Heading}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                     VerticalAlignment="Center" Margin="40,0,0,0" TextTrimming="CharacterEllipsis" />

          <!-- The setup wizard's way forward (M45 H6d): Start, or a tap here, goes to the next step (Finish on the last). -->
          <Border Grid.Row="1" x:Name="SettingsStart" IsVisible="{Binding IsSetup}" VerticalAlignment="Bottom" CornerRadius="{x:Static vm:HandheldTokens.StartButtonRadius}"
                  Padding="28,18" Background="{x:Static vm:HandheldTokens.ClassicAccent}" BoxShadow="{x:Static vm:HandheldTokens.ClassicStartShadow}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding StartLabel}" FontSize="{x:Static vm:HandheldTokens.StartLabel}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
                <TextBlock Text="{Binding StartDetail}" FontSize="{x:Static vm:HandheldTokens.StartDetail}" Foreground="{x:Static vm:HandheldTokens.OnAccentMuted}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="1" Width="52" Height="52" CornerRadius="{x:Static vm:HandheldTokens.StartGlyphRadius}" Background="{x:Static vm:HandheldTokens.ClassicStartGlyphFill}" VerticalAlignment="Center"
                      Margin="16,0,0,0">
                <PathIcon Data="{x:Static vm:HandheldIcons.Menu}" Width="26" Height="26" Foreground="{x:Static vm:HandheldTokens.OnAccent}" />
              </Border>
            </Grid>
          </Border>
          <Panel Grid.Row="1" x:Name="SettingsSectionHost" Classes.setup="{Binding IsSetup}">
          <ScrollViewer x:Name="SettingsSectionScroller" VerticalAlignment="Top" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="SettingsSections" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldSettingsSectionViewModel">
                  <Border Classes="settings-section" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                          Margin="0,0,0,8">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <vh:HandheldFitText Classes="title" Size="{x:Static vm:HandheldTokens.RailRow}" Text="{Binding Title}" />
                      <TextBlock Classes="status" Classes.warning="{Binding IsWarning}" Text="{Binding Status}"
                                 IsVisible="{Binding HasStatus}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Panel>

          <!-- The rows: label left, then the one thing that ends a row (a switch, ‹ a choice ›, a value, a chevron). -->
          <Panel Grid.Row="1" Grid.Column="1" x:Name="SettingsRowHost" Margin="40,24,0,0">
          <ScrollViewer x:Name="SettingsRowScroller" VerticalAlignment="Top" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="SettingsRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GamepadSettingsRowViewModel">
                  <Border Classes="settings-row" Classes.focused="{Binding IsFocused}" Classes.grouped="{Binding IsGrouped}"
                          Classes.save="{Binding IsSaveRow}" Classes.disabled="{Binding !IsEnabled}" Margin="0,0,0,12">
                    <vh:HandheldRowLine>
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="56" Height="56" CornerRadius="{x:Static vm:HandheldTokens.IconPlateRadius}" Background="{x:Static vm:HandheldTokens.ClassicIconPlate}" Margin="0,0,20,0"
                                IsVisible="{Binding HasPlatformIcon}" VerticalAlignment="Center">
                          <Image Width="40" Height="40" Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                 RenderOptions.BitmapInterpolationMode="None" />
                        </Border>
                        <vh:HandheldFitText Grid.Column="1" Classes="label" Classes.destructive="{Binding IsDestructive}" Size="{x:Static vm:HandheldTokens.Row}"
                                            Text="{Binding Label}" TextWrapping="Wrap" MaxLines="2" />
                      </Grid>
                      <Border Classes="switch" Classes.on="{Binding IsToggleOn}" IsVisible="{Binding IsToggle}" Margin="24,0,0,0">
                        <Border />
                      </Border>
                      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsToggle}" Margin="24,0,0,0" VerticalAlignment="Center">
                        <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronLeft}" IsVisible="{Binding IsChoice}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Classes="value" Classes.warning="{Binding IsWarning}" Text="{Binding RowValue}" />
                        <Panel Grid.Column="2" Margin="12,0,0,0">
                          <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding ShowsChevron}" />
                          <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding IsChoice}" />
                          <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding IsSummary}"
                                    RenderTransform="{Binding IsExpanded, Converter={x:Static vm:HandheldViewConverters.ExpandedTurn}}" />
                        </Panel>
                      </Grid>
                    </vh:HandheldRowLine>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Panel>
        </Grid>

        <!-- State: a choice's list, a card over a scrim (A picks, B leaves it as it was). -->
        <Border x:Name="SettingsChoiceSheet" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
                IsVisible="{Binding IsChoicePickerOpen}" Background="{x:Static vm:HandheldTokens.Scrim}" Margin="-400">
          <Border x:Name="SettingsChoiceCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="900"
                  CornerRadius="{x:Static vm:HandheldTokens.ClassicSheetRadius}" Background="{x:Static vm:HandheldTokens.ClassicSurface}" Padding="24,16,24,24" BoxShadow="{x:Static vm:HandheldTokens.ClassicSheetShadow}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{Binding Projection.ChoicePickerTitle}" FontSize="{x:Static vm:HandheldTokens.SheetTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                         Margin="24,8,24,12" TextTrimming="CharacterEllipsis" />
              <!-- Whole rows: eight 88 px choices with their 4 px gaps. -->
              <ScrollViewer Grid.Row="1" x:Name="SettingsChoiceScroller" MaxHeight="736" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="SettingsChoices" ItemsSource="{Binding ChoiceOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GamepadChoiceOptionViewModel">
                      <Border Classes="sheet-row" Classes.focused="{Binding IsFocused}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <PathIcon Grid.Column="1" Classes="pick" Data="{x:Static vm:HandheldIcons.Check}" Width="32" Height="32"
                                    IsVisible="{Binding IsSelected}" Margin="24,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Border>

        <!-- State: a confirmation (a destructive row, or one that disconnects), Cancel first. -->
        <Border x:Name="SettingsConfirmSheet" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
                IsVisible="{Binding IsConfirmationOpen}" Background="{x:Static vm:HandheldTokens.Scrim}" Margin="-400">
          <Border x:Name="SettingsConfirmCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"
                  CornerRadius="{x:Static vm:HandheldTokens.ClassicSheetRadius}" Background="{x:Static vm:HandheldTokens.ClassicSurface}" Padding="24,24,24,24" BoxShadow="{x:Static vm:HandheldTokens.ClassicSheetShadow}">
            <StackPanel Spacing="12">
              <StackPanel Margin="24,0,24,12" Spacing="8">
                <TextBlock Text="{Binding Projection.ConfirmationTitle}" FontSize="{x:Static vm:HandheldTokens.SheetTitle}" FontWeight="{x:Static vm:HandheldTokens.HeadingWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Projection.ConfirmationText}" FontSize="{x:Static vm:HandheldTokens.Note}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <Border x:Name="SettingsConfirmCancel" Classes="sheet-row" Classes.focused="{Binding IsCancelFocused}">
                <TextBlock Classes="label" Text="Cancel" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="SettingsConfirmGo" Classes="sheet-row" Classes.focused="{Binding IsConfirmFocused}">
                <TextBlock Classes="label" Text="{Binding ConfirmLabel}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
        </Border>

        <!--
          State: typing a text row (a name, a key, a password) on the drawn keyboard, the naming keyboard's look: Android's
          own keyboard cannot open on the Thor's second screen. The field takes a hardware keyboard too.
        -->
        <Grid x:Name="SettingsKeyboard" DataContext="{Binding Settings.Keyboard}" x:DataType="vm:HandheldTextKeyboardViewModel"
              IsVisible="{Binding $parent[UserControl].((vm:HandheldShellViewModel)DataContext).Settings.IsTyping, FallbackValue=False}"
              RowDefinitions="Auto,*,Auto" Width="1112" Margin="0,48,0,40" HorizontalAlignment="Center">
          <Border Classes="name-field" Classes.focused="True">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Title}" FontSize="{x:Static vm:HandheldTokens.FieldLabel}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" VerticalAlignment="Center"
                         Margin="0,0,24,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="SettingsField" Grid.Column="1" Classes="name-input" Text="{Binding Text, Mode=TwoWay}"
                       PasswordChar="{Binding MaskChar}" FontSize="{x:Static vm:HandheldTokens.KeyboardField}" FontWeight="{x:Static vm:HandheldTokens.RowWeight}" Foreground="{x:Static vm:HandheldTokens.OnGround}"
                       Background="Transparent" BorderThickness="0" MinHeight="80" VerticalContentAlignment="Center"
                       Focusable="True" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding KeyRows}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldKeyRowViewModel">
                <ItemsControl ItemsSource="{Binding Keys}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HandheldKeyViewModel">
                      <Border Classes="key" Classes.mid="{Binding IsMid}" Classes.space="{Binding IsSpace}"
                              Classes.done="{Binding IsDone}" Classes.focused="{Binding IsFocused}">
                        <TextBlock Text="{Binding Label}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding $parent[UserControl].((vm:HandheldShellViewModel)DataContext).Hints}"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="40" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHint">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Classes="hint-glyph">
                    <TextBlock Text="{Binding Button}" FontSize="{x:Static vm:HandheldTokens.HintGlyphLetter}" FontWeight="{x:Static vm:HandheldTokens.KeyboardHintGlyphWeight}" Foreground="{x:Static vm:HandheldTokens.HintGlyphInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Label}" FontSize="{x:Static vm:HandheldTokens.Hint}" Foreground="{x:Static vm:HandheldTokens.OnGroundMuted}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Viewbox>
  </Border>
  </Panel>
  </Panel>
</UserControl>
