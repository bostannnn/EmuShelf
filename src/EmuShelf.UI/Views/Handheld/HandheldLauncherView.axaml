<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:vh="using:EmuShelf.App.Views.Handheld"
             x:Class="EmuShelf.App.Views.HandheldLauncherView"
             x:DataType="vm:HandheldShellViewModel">

  <!--
    Handheld mode's bottom screen: home (5×4 slots, empty ones drawn faintly, page dots), an open folder
    (header bar + a 3-row grid scrolling by column), and the dock. A pure view onto
    HandheldShellViewModel, drawn on a fixed 1240×1080 canvas (the Thor's bottom panel) and fitted, never
    cropped. The colour lives in the covers and the platform folders; the chrome stays grey, and the one
    accent is the selector (a thick indigo frame with white keylines). H1 moves it with plain state
    changes; H3 made it travel: one selector (the layer at the end) springs between the focused elements,
    whose `Border.ring` children only say where it goes. The motion lives in HandheldLauncherMotion.

    Rhythm: a 48 px edge margin on every side (room for the selector ring and its future glow), a 4 px grid
    for every size, and radii that nest (a ring's radius is the tile's radius plus the ring's reach).
  -->

  <!-- The gradient fills the whole window, including any letterbox bands around the fitted canvas. -->
  <UserControl.Background>
    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Offset="0" Color="#FAFBFD" />
      <GradientStop Offset="1" Color="#E4E8EF" />
    </LinearGradientBrush>
  </UserControl.Background>

  <UserControl.Styles>
    <!-- The selector ring around whatever is focused: white keyline, indigo frame, white keyline. -->
    <!--
      Each focusable element's ring is an invisible anchor: its bounds and corner radius are where the one
      travelling selector frames it. The selector itself is drawn by the selector layer.
    -->
    <Style Selector="Border.ring">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.selector-ring">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <Style Selector="Border.selector-ring > Border">
      <Setter Property="BorderBrush" Value="#5B58D9" />
      <Setter Property="BorderThickness" Value="14" />
    </Style>
    <Style Selector="Border.selector-ring > Border > Border">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <!-- The focus lift lives on the element itself (fly-ins and pops live on its container). -->
    <Style Selector="Panel.focusable">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22">
            <TransformOperationsTransition.Easing>
              <SplineEasing X1="0.34" Y1="1.42" X2="0.64" Y2="1" />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.focusable.focused">
      <Setter Property="RenderTransform" Value="scale(1.13)" />
    </Style>
    <!-- A lifted tile casts a deeper shadow: a second pre-rendered shadow fades in under it. -->
    <Style Selector="vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.focusable.focused > vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      Native mode (Android, M45 H4 option 5): this view is only pictured, so nothing in it animates (an invisible
      transition still costs Avalonia frames) and nothing is lifted (the native Launcher lifts its pictures).
    -->
    <Style Selector="Panel.native Panel.focusable">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ProgressBar.launch">
      <Setter Property="IsIndeterminate" Value="True" />
    </Style>
    <!-- The native Launcher draws its own bar; a hidden indeterminate bar would still animate. -->
    <Style Selector="Panel.native ProgressBar.launch">
      <Setter Property="IsIndeterminate" Value="False" />
    </Style>
    <Style Selector="Panel.native vh|HandheldShadow.lift">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- Arranging home (H4): the carried tile rides high, empty slots light up, the New ribbon. -->
    <Style Selector="Panel.home-slot.carried">
      <Setter Property="RenderTransform" Value="translateY(-14px) scale(1.16)" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Border.empty-slot.landing">
      <Setter Property="BorderBrush" Value="#805B58D9" />
      <Setter Property="Background" Value="#265B58D9" />
    </Style>
    <Style Selector="Border.ribbon">
      <Setter Property="Background" Value="#5B58D9" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="0,6,-12,0" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="0 3 8 0 #405B58D9" />
    </Style>
    <Style Selector="Border.ribbon TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.edge">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="#B3FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.edge PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Foreground" Value="#5B6176" />
    </Style>
    <!-- The actions sheet's and the naming panel's rows. -->
    <Style Selector="Border.sheet-row">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.sheet-row.focused">
      <Setter Property="Background" Value="#5B58D9" />
    </Style>
    <Style Selector="Border.sheet-row TextBlock.label">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
    </Style>
    <Style Selector="Border.sheet-row TextBlock.note">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="#5B6176" />
    </Style>
    <Style Selector="Border.sheet-row.focused TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Remove from library: the one row that takes a game away, in the warning colour until focused. -->
    <Style Selector="Border.sheet-row TextBlock.label.destructive">
      <Setter Property="Foreground" Value="#C23B3B" />
    </Style>
    <Style Selector="Border.sheet-row.focused TextBlock.label.destructive">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.colour-chip">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="88" />
      <Setter Property="CornerRadius" Value="44" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <Style Selector="Border.colour-chip.focused">
      <Setter Property="BorderThickness" Value="6" />
      <Setter Property="BoxShadow" Value="0 0 0 6 #5B58D9" />
    </Style>
    <Style Selector="Border.name-field">
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="#F2F4F8" />
      <Setter Property="BorderBrush" Value="#29465088" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="24,8" />
    </Style>
    <Style Selector="Border.name-field.focused">
      <Setter Property="BorderBrush" Value="#5B58D9" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <!-- The name field is the panel's own pill: the TextBox inside draws no box of its own in any state. -->
    <Style Selector="TextBox.name-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.name-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.name-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Width" Value="100" />
      <Setter Property="Height" Value="100" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #12000000" />
    </Style>
    <Style Selector="Border.key TextBlock">
      <Setter Property="FontSize" Value="36" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.key.wide">
      <Setter Property="Width" Value="300" />
    </Style>
    <Style Selector="Border.key.wide TextBlock">
      <Setter Property="FontSize" Value="30" />
    </Style>
    <Style Selector="Border.key.done">
      <Setter Property="Background" Value="#E9E8FB" />
    </Style>
    <Style Selector="Border.key.focused">
      <Setter Property="Background" Value="#5B58D9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Border.key.focused TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Header chips: a raised white surface with a hairline. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #0F000000" />
    </Style>
    <!-- Title page: the big pill buttons (Play is the accent), the fact rows, the chooser cards. -->
    <Style Selector="Border.title-button">
      <Setter Property="Height" Value="88" />
      <Setter Property="CornerRadius" Value="44" />
      <Setter Property="Padding" Value="32,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #14000000" />
    </Style>
    <Style Selector="Border.title-button.play">
      <Setter Property="Background" Value="#5B58D9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #455B58D9" />
    </Style>
    <Style Selector="Border.title-button TextBlock.label">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.title-button TextBlock.note">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="#5B6176" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.title-button.play TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.title-button PathIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="#4B5274" />
    </Style>
    <Style Selector="Border.title-button.play PathIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.fact-label">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="Foreground" Value="#5B6176" />
      <Setter Property="Margin" Value="0,0,24,12" />
    </Style>
    <Style Selector="TextBlock.fact-value">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.hint-glyph">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="#4B5274" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.screen-card">
      <Setter Property="Width" Value="400" />
      <Setter Property="Height" Value="296" />
      <Setter Property="CornerRadius" Value="40" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #14000000" />
      <Setter Property="Padding" Value="32" />
    </Style>

    <!-- Settings (M45 H6a): the tile's face, the section list, the rows and their trailing controls. -->
    <Style Selector="Border.settings-face">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="#6865DE" />
          <GradientStop Offset="1" Color="#5450CF" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.settings-section">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.settings-section.selected">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #0F000000" />
    </Style>
    <Style Selector="Border.settings-section.focused">
      <Setter Property="Background" Value="#5B58D9" />
      <Setter Property="BorderBrush" Value="#5B58D9" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #455B58D9" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.status">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="Foreground" Value="#5B6176" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.settings-section TextBlock.status.warning">
      <Setter Property="Foreground" Value="#B4531A" />
    </Style>
    <Style Selector="Border.settings-section.focused TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.settings-row">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="MinHeight" Value="92" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-row.grouped">
      <Setter Property="Margin" Value="48,0,0,0" />
      <Setter Property="MinHeight" Value="84" />
    </Style>
    <Style Selector="Border.settings-row.save">
      <Setter Property="Background" Value="#E9E8FB" />
      <Setter Property="BorderBrush" Value="#335B58D9" />
    </Style>
    <Style Selector="Border.settings-row.focused">
      <Setter Property="Background" Value="#5B58D9" />
      <Setter Property="BorderBrush" Value="#5B58D9" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #455B58D9" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.label">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settings-row.disabled TextBlock.label">
      <Setter Property="Foreground" Value="#8A90A3" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.value">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="#5B6176" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.value.warning">
      <Setter Property="Foreground" Value="#B4531A" />
    </Style>
    <Style Selector="Border.settings-row TextBlock.destructive">
      <Setter Property="Foreground" Value="#C23B3B" />
    </Style>
    <Style Selector="Border.settings-row.focused TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- While the list of sections has the pad, the row it will come back to keeps only an outline. -->
    <Style Selector="Grid.rail Border.settings-row.focused">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#805B58D9" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.save.focused">
      <Setter Property="Background" Value="#E9E8FB" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused TextBlock.label">
      <Setter Property="Foreground" Value="#1C2033" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused TextBlock.value">
      <Setter Property="Foreground" Value="#5B6176" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused PathIcon">
      <Setter Property="Foreground" Value="#8A90A3" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch">
      <Setter Property="Background" Value="#D5D9E4" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch.on">
      <Setter Property="Background" Value="#5B58D9" />
    </Style>
    <Style Selector="Grid.rail Border.settings-row.focused Border.switch.on > Border">
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.settings-row PathIcon.chevron">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="#8A90A3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settings-row.focused PathIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- A switch: a pill with its knob left (off) or right (on). -->
    <Style Selector="Border.switch">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="#D5D9E4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.switch.on">
      <Setter Property="Background" Value="#5B58D9" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch">
      <Setter Property="Background" Value="#7F7CE6" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch.on">
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.switch > Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.switch.on > Border">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.settings-row.focused Border.switch.on > Border">
      <Setter Property="Background" Value="#5B58D9" />
    </Style>
    <Style Selector="Border.theme-card">
      <Setter Property="Width" Value="248" />
      <Setter Property="Height" Value="184" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#141C2033" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.theme-ring">
      <Setter Property="CornerRadius" Value="40" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="4" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.theme-ring.focused">
      <Setter Property="BorderBrush" Value="#5B58D9" />
    </Style>
    <Style Selector="Border.key.mid">
      <Setter Property="Width" Value="160" />
    </Style>
    <Style Selector="Border.key.space">
      <Setter Property="Width" Value="252" />
    </Style>
    <Style Selector="Border.key.space TextBlock">
      <Setter Property="FontSize" Value="28" />
    </Style>
    <Style Selector="Border.sheet-row PathIcon.pick">
      <Setter Property="Foreground" Value="#5B58D9" />
    </Style>
    <Style Selector="Border.sheet-row.focused PathIcon.pick">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.key.mid TextBlock">
      <Setter Property="FontSize" Value="28" />
    </Style>

    <Style Selector="TextBlock.chip-text">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C2033" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!--
      Each item sits in a ContentPresenter container, and siblings paint in order, so a ZIndex on the
      tile itself does nothing and the tiles after the focused one cover its ring. Raise the container.
    -->
    <ControlTheme x:Key="HandheldTileContainer" TargetType="ContentPresenter">
      <Setter Property="ZIndex" Value="{ReflectionBinding IsFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}" />
    </ControlTheme>
  </UserControl.Resources>

  <Panel x:Name="Root">
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid x:Name="Canvas" Width="1240" Height="1080" RowDefinitions="*,144">

      <!-- ===== Home: every page on one track that slides on the track spring ===== -->
      <!-- Home on this Launcher's screen: the view gives this layer its HandheldHomeScreenViewModel (M45 H5). -->
      <Grid x:Name="HomeLayer" RowDefinitions="*,40" Margin="0,48,0,0" x:DataType="vm:HandheldHomeScreenViewModel">
        <Panel x:Name="HomeClip" ClipToBounds="True">
          <ItemsControl x:Name="PageTrack" ItemsSource="{Binding Pages}" HorizontalAlignment="Left" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHomePageViewModel">
                <!--
                  5×4 slots (7×3 on the 16:9 screen, M45 H5): 176 px tiles on a 224 × 196 pitch, centred in the space
                  above the dock. A page is the canvas wide.
                -->
                <Panel Width="{Binding Width}">
                  <ItemsControl ItemsSource="{Binding Slots}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                                ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{ReflectionBinding $parent[ItemsControl].DataContext.Columns}"
                                     Rows="{ReflectionBinding $parent[ItemsControl].DataContext.Rows}" ClipToBounds="False" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HandheldHomeSlotViewModel">
                        <!-- Room for the folder's shadow when the native Launcher pictures it; layout unchanged. -->
                        <Border Classes="shot" Padding="48" Margin="-48">
                        <Panel Classes="focusable home-slot" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}"
                               Classes.carried="{Binding IsCarried}" Width="176" Height="176" Margin="24,10" Background="Transparent">
                          <!-- A folder (a platform's, yours, Recent): its flap tilts while focused so the first covers peek out. -->
                          <vh:HandheldFolderArt IsVisible="{Binding IsFolder}" Classes.peek="{Binding IsFocused}" Margin="-8" />
                          <!-- A game pinned to home: its cover, cropped to the tile; dimmed when its file is missing. -->
                          <!-- Same footprint as a folder beside it (its back plate starts lower and sits a little wider). -->
                          <Panel IsVisible="{Binding IsGame}" Margin="-3,17,-3,0">
                            <vh:HandheldShadow Radius="40" Blur="16" Margin="-16,-10,-16,-22" Filled="True" />
                            <Border CornerRadius="40" ClipToBounds="True" Background="#D5D9E4"
                                    Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                              <Panel>
                                <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasCover}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#5B6176" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxLines="4"
                                           TextTrimming="CharacterEllipsis" />
                                <Border IsVisible="{Binding HasCover}">
                                  <Border.Background>
                                    <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                                  </Border.Background>
                                </Border>
                              </Panel>
                            </Border>
                          </Panel>
                          <!--
                            Settings (decision 18): an app on the grid, its glyph on the indigo accent so it reads as neither a
                            platform's monogram nor your folder's star. Same footprint as a pinned game.
                          -->
                          <Panel IsVisible="{Binding IsSettings}" Margin="-3,17,-3,0">
                            <vh:HandheldShadow Radius="40" Blur="16" Margin="-16,-10,-16,-22" Filled="True" />
                            <Border Classes="settings-face" CornerRadius="40">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="80" Height="80" Foreground="White" />
                            </Border>
                          </Panel>
                          <!-- An empty slot: home is a place with slots, so it is drawn faintly, not left out; in move mode it lights up. -->
                          <Border IsVisible="{Binding IsEmpty}" Classes="empty-slot" Classes.landing="{Binding IsLandingPlace}"
                                  CornerRadius="44" BorderBrush="#29465088" BorderThickness="2" Background="#40FFFFFF" />
                          <!-- A platform folder that arrived since you last looked. -->
                          <Border IsVisible="{Binding IsNew}" Classes="ribbon" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="New" />
                          </Border>
                          <!-- Move mode: the game or folder the carried game would merge with. -->
                          <!-- Move mode: a game held over another game or one of your folders, about to merge with it. -->
                          <Panel IsVisible="{Binding IsDropTarget}">
                            <Border CornerRadius="44" Margin="-3,17,-3,0" Background="#335B58D9" />
                            <Panel Width="116" Height="116" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-18,0"
                                   RenderTransform="rotate(8deg)">
                              <vh:HandheldShadow Radius="28" Blur="14" Margin="-14,-8,-14,-20" Color="#40000000" Filled="True" />
                              <Border CornerRadius="28" ClipToBounds="True" Background="#D5D9E4" BorderBrush="White" BorderThickness="4">
                                <Panel>
                                  <TextBlock Text="{Binding CarriedTitle}" IsVisible="{Binding !HasCarriedCover}" FontSize="16"
                                             FontWeight="SemiBold" Foreground="#5B6176" TextWrapping="Wrap" TextAlignment="Center"
                                             Margin="8" VerticalAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                  <Border IsVisible="{Binding HasCarriedCover}">
                                    <Border.Background>
                                      <ImageBrush Source="{Binding CarriedCover}" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Border.Background>
                                  </Border>
                                </Panel>
                              </Border>
                            </Panel>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#5B58D9" BorderBrush="White" BorderThickness="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                              <PathIcon Data="{x:Static vm:HandheldIcons.Plus}" Width="28" Height="28" Foreground="White" />
                            </Border>
                          </Panel>
                          <Border Classes="ring" CornerRadius="68" Margin="-24" />
                        </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>

        <!-- The 16:9 screen's spare height above the 7×3 grid names the page (M45 H5). -->
        <TextBlock x:Name="PageLabel" Text="{Binding PageLabel}" IsVisible="{Binding IsWide}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                   FontSize="28" FontWeight="SemiBold" Foreground="#5B6176" FontFeatures="+tnum" />

        <!-- Edge hints: another page that way (a tap turns to it). -->
        <Border x:Name="EdgeLeft" Classes="edge" IsVisible="{Binding CanPageLeft}" HorizontalAlignment="Left" Margin="8,0,0,0">
          <PathIcon Data="{x:Static vm:HandheldIcons.ChevronLeft}" />
        </Border>
        <Border x:Name="EdgeRight" Classes="edge" IsVisible="{Binding CanPageRight}" HorizontalAlignment="Right" Margin="0,0,8,0">
          <PathIcon Data="{x:Static vm:HandheldIcons.ChevronRight}" />
        </Border>

        <!-- Page dots, with the current-page pill riding the track's position. -->
        <Panel Grid.Row="1" IsVisible="{Binding HasMultiplePages}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl x:Name="PageDots" ItemsSource="{Binding PageDots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldPageDotViewModel">
                <Border Width="18" Height="16" CornerRadius="8" Background="#38465088" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="PageIndicator" Width="52" Height="16" CornerRadius="8" Background="#5B58D9"
                  HorizontalAlignment="Left" />
        </Panel>
      </Grid>

      <!-- ===== An open folder ===== -->
      <!--
        Clipped 32 px in from the canvas edge: the column behind the window waits out of sight there, and the
        lifted left column (1.13×, 15 px past its 48 px margin) still fits.
      -->
      <!--
        One surface for the Zoom through: header and grid scale together from the pressed folder's place.
      -->
      <Panel x:Name="FolderPage" IsVisible="{Binding IsFolderOpen}" ClipToBounds="True" Margin="32,0,0,0">
      <Grid RowDefinitions="Auto,*" Margin="16,40,0,0">
        <!-- Header: Back, the folder's name and count, the sort chip; aligned to the grid's left edge. -->
        <Grid x:Name="FolderHeader" ColumnDefinitions="Auto,*,Auto" Margin="0,0,48,0">
          <Border x:Name="BackShot" Classes="shot" Padding="24" Margin="-24">
          <Panel Classes="focusable" Classes.focused="{Binding OpenFolder.IsBackFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsBackFocused}">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="#4B5274" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <Border Classes="ring" CornerRadius="44" Margin="-16">
              <Border CornerRadius="40"><Border CornerRadius="28" /></Border>
            </Border>
          </Panel>
          </Border>
          <StackPanel x:Name="FolderTitle" Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding OpenFolder.AccentBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding OpenFolder.Name}" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Text="{Binding OpenFolder.CountText}" FontSize="24" Foreground="#5B6176"
                       VerticalAlignment="Center" FontFeatures="+tnum" />
          </StackPanel>
          <Border x:Name="SortShot" Grid.Column="2" Classes="shot" Padding="24" Margin="-24" IsVisible="{Binding OpenFolder.CanSort}">
          <Panel Classes="focusable" Classes.focused="{Binding OpenFolder.IsSortFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding OpenFolder.IsSortFocused}">
            <Border Classes="chip">
              <TextBlock Classes="chip-text" Text="{Binding OpenFolder.SortLabel}" />
            </Border>
            <Border Classes="ring" CornerRadius="44" Margin="-16">
              <Border CornerRadius="40"><Border CornerRadius="28" /></Border>
            </Border>
          </Panel>
          </Border>
        </Grid>

        <!--
          The games: three rows of 232 px tiles on a 264 × 256 pitch, filled column by column, centred
          between the header and the dock. Only the visible window (four columns plus the one peeking in at
          the right edge, plus the one just behind the left edge) is realized; the track spring slides it.
        -->
        <ItemsControl x:Name="FolderTiles" Grid.Row="1" ItemsSource="{Binding OpenFolder.VisibleTiles}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                      ClipToBounds="False" VerticalAlignment="Center" IsVisible="{Binding OpenFolder.HasGames}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Vertical" Height="768" ItemWidth="264" ItemHeight="256" ClipToBounds="False" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldGameTileViewModel">
              <Border Classes="shot" Padding="48" Margin="-48" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Panel Classes="focusable folder-tile" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}" Width="232" Height="232"
                     HorizontalAlignment="Left" VerticalAlignment="Center">
                <vh:HandheldShadow Radius="56" Blur="20" Margin="-20,-12,-20,-28" Filled="True" />
                <vh:HandheldShadow Classes="lift" Radius="56" Blur="32" Margin="-32,-16,-32,-48" Color="#33000000" Filled="True" />
                <!-- Settings, put in one of your folders: the same face as on home. -->
                <Border Classes="settings-face" CornerRadius="56" IsVisible="{Binding IsSettings}">
                  <PathIcon Data="{x:Static vm:HandheldIcons.Settings}" Width="104" Height="104" Foreground="White" />
                </Border>
                <!-- Covers crop from the top, where a box's title and art usually are. -->
                <Border CornerRadius="56" ClipToBounds="True" Background="#D5D9E4" IsVisible="{Binding IsGame}"
                        Opacity="{Binding IsUnavailable, Converter={x:Static vm:HandheldViewConverters.UnavailableOpacity}}">
                  <Panel>
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding !HasCover}" FontSize="24" FontWeight="SemiBold"
                               Foreground="#5B6176" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxLines="4"
                               TextTrimming="CharacterEllipsis" />
                    <Border IsVisible="{Binding HasCover}">
                      <Border.Background>
                        <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                      </Border.Background>
                    </Border>
                  </Panel>
                </Border>
                <Border Classes="ring" CornerRadius="80" Margin="-24">
                  <Border CornerRadius="76"><Border CornerRadius="64" /></Border>
                </Border>
              </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty folder: say so rather than show nothing. -->
        <StackPanel x:Name="FolderEmpty" Grid.Row="1" IsVisible="{Binding OpenFolder.IsEmpty}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8" Margin="0,0,48,0">
          <TextBlock Text="This folder is empty" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding OpenFolder.EmptyHint}" FontSize="24" Foreground="#5B6176"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      </Panel>

      <!-- ===== Dock: All apps, the five pinned apps, the menu button ===== -->
      <vh:HandheldShadow x:Name="DockShadow" Grid.Row="1" Margin="28,0,28,6" Height="152" Radius="40" Blur="20" Color="#14000000"
                         VerticalAlignment="Bottom" />
      <Border x:Name="DockPill" Grid.Row="1" Margin="48,0,48,32" Height="112" CornerRadius="40" Background="#C7FFFFFF"
              BorderBrush="#141C2033" BorderThickness="1" ClipToBounds="False"
              VerticalAlignment="Bottom">
        <ItemsControl x:Name="DockItems" ItemsSource="{Binding DockItems}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                      ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="32" ClipToBounds="False" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandheldDockItemViewModel">
              <Border Classes="shot" Padding="16" Margin="-16">
              <Panel Classes="focusable" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}" Width="80" Height="80">
                <!-- System buttons are quiet: a raised surface and a muted glyph, never a dark block. -->
                <Border CornerRadius="24" Background="#FFFFFF" BorderBrush="#141C2033" BorderThickness="1"
                        IsVisible="{Binding !IsApp}">
                  <Panel>
                    <PathIcon Data="{x:Static vm:HandheldIcons.AllApps}" Width="36" Height="36" Foreground="#4B5274"
                              IsVisible="{Binding IsAllApps}" />
                    <PathIcon Data="{x:Static vm:HandheldIcons.Menu}" Width="36" Height="36" Foreground="#4B5274"
                              IsVisible="{Binding IsMenu}" />
                  </Panel>
                </Border>
                <Panel IsVisible="{Binding IsApp}">
                  <Border CornerRadius="24" BorderBrush="#29465088" BorderThickness="2" Background="#40FFFFFF"
                          IsVisible="{Binding Slot.IsEmpty}" />
                  <Border CornerRadius="24" ClipToBounds="True" IsVisible="{Binding Slot.HasIcon}">
                    <Image Source="{Binding Slot.Icon}" Stretch="Uniform" />
                  </Border>
                </Panel>
                <Border Classes="ring" CornerRadius="40" Margin="-16">
                  <Border CornerRadius="36"><Border CornerRadius="24" /></Border>
                </Border>
              </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- A picture of a closing folder's page, shrinking back into its folder. -->
      <Canvas x:Name="GhostLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
  </Viewbox>

  <!--
    ===== The Title page (A on a game) =====
    Covers the grid and the dock, as the mockup's page does; the facts on the left of a row of big buttons,
    and the disc chooser, the screen chooser, the actions sheet and the launching panel as its states.
  -->
  <Panel x:Name="TitleLayer" IsVisible="{Binding IsTitleOpen}">
    <Panel.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#FAFBFD" />
        <GradientStop Offset="1" Color="#E4E8EF" />
      </LinearGradientBrush>
    </Panel.Background>
    <!-- The platform's colour as a soft wash from the top. -->
    <Border Background="{Binding TitlePage.AccentBrush}" Opacity="0.14">
      <Border.OpacityMask>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="#FF000000" />
          <GradientStop Offset="0.7" Color="#00000000" />
        </LinearGradientBrush>
      </Border.OpacityMask>
    </Border>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid Width="1240" Height="1080" ClipToBounds="False">

        <Grid x:Name="TitleBody" IsVisible="{Binding TitlePage.IsBrowsable}" RowDefinitions="88,*,136,56" Margin="48,40,48,32">
          <!-- Header: Back and where the page came from. -->
          <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="#4B5274" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding TitlePage.CrumbLine}" FontSize="26" FontWeight="SemiBold" Foreground="#5B6176"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="860" />
          </StackPanel>

          <!-- Body: the cover, then the facts. -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,24">
            <Border Width="392" Height="552" CornerRadius="32" ClipToBounds="True" Background="#D5D9E4"
                    BoxShadow="0 16 40 0 #2E000000" VerticalAlignment="Center">
              <Panel>
                <TextBlock Text="{Binding TitlePage.Title}" IsVisible="{Binding !TitlePage.HasCover}" FontSize="32"
                           FontWeight="SemiBold" Foreground="#5B6176" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border IsVisible="{Binding TitlePage.HasCover}">
                  <Border.Background>
                    <ImageBrush Source="{Binding TitlePage.Cover}" Stretch="UniformToFill" AlignmentY="Top" />
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Margin="48,0,0,0" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="{Binding TitlePage.Title}" FontSize="48" FontWeight="SemiBold" Foreground="#1C2033"
                         TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TitlePage.PlatformLine}" FontSize="28" Foreground="#5B6176"
                         TextTrimming="CharacterEllipsis" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,32,0,0">
                <TextBlock Classes="fact-label" Text="Last played" />
                <TextBlock Classes="fact-value" Grid.Column="1" Text="{Binding TitlePage.LastPlayedText}" />
                <TextBlock Classes="fact-label" Grid.Row="1" Text="Play time" />
                <TextBlock Classes="fact-value" Grid.Row="1" Grid.Column="1" Text="{Binding TitlePage.PlaytimeText}" />
                <TextBlock Classes="fact-label" Grid.Row="2" Text="Runs on" />
                <TextBlock Classes="fact-value" Grid.Row="2" Grid.Column="1" Text="{Binding TitlePage.ScreenText}" />
                <TextBlock Classes="fact-label" Grid.Row="3" Text="Discs" IsVisible="{Binding TitlePage.HasDiscs}" />
                <TextBlock Classes="fact-value" Grid.Row="3" Grid.Column="1" Text="{Binding TitlePage.DiscText}"
                           IsVisible="{Binding TitlePage.HasDiscs}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0" IsVisible="{Binding TitlePage.HasAchievements}">
                <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" Width="32" Height="32" Foreground="#C98A12" />
                <TextBlock Text="{Binding TitlePage.AchievementLine}" FontSize="26" FontWeight="SemiBold"
                           Foreground="#1C2033" VerticalAlignment="Center" FontFeatures="+tnum" />
                <ProgressBar Width="160" Height="12" MinHeight="12" CornerRadius="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding TitlePage.AchievementRatio}"
                             Background="#29465088" Foreground="#F2AE2E" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- The buttons: Play, Disc (multi-disc), Achievements. -->
          <ItemsControl x:Name="TitleButtons" Grid.Row="2" ItemsSource="{Binding TitlePage.Buttons}" ItemContainerTheme="{StaticResource HandheldTileContainer}"
                        ClipToBounds="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="32" ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldTitleButtonViewModel">
                <Border Classes="shot" Padding="32" Margin="-32">
                <Panel Classes="focusable" Classes.focused="{Binding IsFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding IsFocused}">
                  <Border Classes="title-button" Classes.play="{Binding IsPlay}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <PathIcon Data="{x:Static vm:HandheldIcons.Play}" IsVisible="{Binding IsPlay}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Disc}" IsVisible="{Binding IsDisc}" />
                      <PathIcon Data="{x:Static vm:HandheldIcons.Trophy}" IsVisible="{Binding IsAchievements}" />
                      <TextBlock Classes="label" Text="{Binding Label}" />
                      <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="64" Margin="-20">
                    <Border CornerRadius="60"><Border CornerRadius="48" /></Border>
                  </Border>
                </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Footer: the buttons that are not on the page. -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="32" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="hint-glyph">
                <TextBlock Text="Y" FontSize="20" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="chip-text" Text="More actions" Foreground="#5B6176" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="hint-glyph">
                <TextBlock Text="B" FontSize="20" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Classes="chip-text" Text="Back" Foreground="#5B6176" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- State: the disc chooser or the actions sheet, a card over a scrim. -->
        <Border x:Name="OptionSheet" IsVisible="{Binding TitlePage.IsOptionList}" Background="#521C2033" Margin="-400">
          <Border x:Name="OptionCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" CornerRadius="40"
                  Background="#FFFFFF" Padding="24,16,24,24" BoxShadow="0 20 48 0 #33000000">
            <StackPanel Spacing="8">
              <StackPanel Margin="24,8,24,8" Spacing="4">
                <TextBlock Text="{Binding TitlePage.OptionsHeading}" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033" />
                <TextBlock Text="{Binding TitlePage.Title}" FontSize="24" Foreground="#5B6176" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding TitlePage.Options}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HandheldTitleOptionViewModel">
                    <Border CornerRadius="16" Height="80" Padding="24,0"
                            Background="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowText}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="24"
                                   VerticalAlignment="Center" Margin="24,0,0,0" FontFeatures="+tnum"
                                   Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowNote}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Border>

        <!-- State: the launch-screen chooser — two screen cards and "Always use this screen". -->
        <Border x:Name="ScreenSheet" IsVisible="{Binding TitlePage.IsScreenChooser}" Background="#521C2033" Margin="-400">
          <Border x:Name="ScreenCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000" CornerRadius="48"
                  Background="#F5F6F9" Padding="48,40" BoxShadow="0 20 48 0 #33000000" ClipToBounds="False">
            <StackPanel Spacing="32" ClipToBounds="False">
              <StackPanel Spacing="4">
                <TextBlock Text="Which screen?" FontSize="36" FontWeight="SemiBold" Foreground="#1C2033" />
                <TextBlock Text="{Binding TitlePage.Title}" FontSize="26" Foreground="#5B6176" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" ClipToBounds="False">
                <Border x:Name="ScreenTopShot" Classes="shot" Padding="40" Margin="-40" ZIndex="{Binding TitlePage.IsTopScreenFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}">
                <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsTopScreenFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsTopScreenFocused}">
                  <Border Classes="screen-card">
                    <StackPanel Spacing="16" VerticalAlignment="Center">
                      <PathIcon Data="{x:Static vm:HandheldIcons.ScreenTop}" Width="96" Height="96" Foreground="#5B58D9" />
                      <TextBlock Text="Top screen" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033" HorizontalAlignment="Center" />
                      <TextBlock Text="The companion stays below" FontSize="24" Foreground="#5B6176" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="60" Margin="-20">
                    <Border CornerRadius="56"><Border CornerRadius="44" /></Border>
                  </Border>
                </Panel>
                </Border>
                <Border x:Name="ScreenBottomShot" Classes="shot" Padding="40" Margin="-40" ZIndex="{Binding TitlePage.IsBottomScreenFocused, Converter={x:Static vm:HandheldViewConverters.FocusZIndex}}">
                <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsBottomScreenFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsBottomScreenFocused}">
                  <Border Classes="screen-card">
                    <StackPanel Spacing="16" VerticalAlignment="Center">
                      <PathIcon Data="{x:Static vm:HandheldIcons.ScreenBottom}" Width="96" Height="96" Foreground="#5B58D9" />
                      <TextBlock Text="Bottom screen" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033" HorizontalAlignment="Center" />
                      <TextBlock Text="The companion moves up" FontSize="24" Foreground="#5B6176" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="ring" CornerRadius="60" Margin="-20">
                    <Border CornerRadius="56"><Border CornerRadius="44" /></Border>
                  </Border>
                </Panel>
                </Border>
              </StackPanel>
              <!-- The remember toggle: a row with a check box. -->
              <Border x:Name="RememberShot" Classes="shot" Padding="24" Margin="-24" HorizontalAlignment="Center">
              <Panel Classes="focusable" Classes.focused="{Binding TitlePage.IsRememberFocused}" vh:HandheldSelectorAnchor.IsFocused="{Binding TitlePage.IsRememberFocused}" HorizontalAlignment="Center">
                <Border Classes="chip" Height="72" CornerRadius="36" Padding="24,0">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="40" Height="40" CornerRadius="12" BorderBrush="#5B58D9" BorderThickness="3" VerticalAlignment="Center"
                            Background="{Binding TitlePage.RememberScreen, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                      <PathIcon Data="{x:Static vm:HandheldIcons.Check}" Width="28" Height="28" Foreground="White"
                                IsVisible="{Binding TitlePage.RememberScreen}" />
                    </Border>
                    <TextBlock Classes="chip-text" Text="{Binding TitlePage.RememberScreenLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="ring" CornerRadius="56" Margin="-20">
                  <Border CornerRadius="52"><Border CornerRadius="40" /></Border>
                </Border>
              </Panel>
              </Border>
            </StackPanel>
          </Border>
        </Border>

        <!-- State: launching — the pre-launch save sync (the blocking sync panel), then the emulator start. -->
        <StackPanel x:Name="LaunchPanel" IsVisible="{Binding TitlePage.IsLaunching}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
          <Border x:Name="LaunchCoverShot" Classes="shot" Padding="64" Margin="-64" HorizontalAlignment="Center">
          <Border x:Name="LaunchCover" Width="280" Height="392" CornerRadius="32" ClipToBounds="True" Background="#D5D9E4"
                  BoxShadow="0 16 40 0 #2E000000" HorizontalAlignment="Center">
            <Border IsVisible="{Binding TitlePage.HasCover}">
              <Border.Background>
                <ImageBrush Source="{Binding TitlePage.Cover}" Stretch="UniformToFill" AlignmentY="Top" />
              </Border.Background>
            </Border>
          </Border>
          </Border>
          <StackPanel x:Name="LaunchText" Spacing="8">
            <TextBlock Text="{Binding TitlePage.LaunchingHeading}" FontSize="40" FontWeight="SemiBold" Foreground="#1C2033"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding TitlePage.LaunchingDetail}" FontSize="26" Foreground="#5B6176"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1000" />
          </StackPanel>
          <ProgressBar x:Name="LaunchProgress" Classes="launch" Width="320" Height="8" MinHeight="8" CornerRadius="4"
                       HorizontalAlignment="Center" Background="#29465088" Foreground="#5B58D9" />
        </StackPanel>
      </Grid>
    </Viewbox>
  </Panel>

  <!--
    ===== The selector =====
    One frame for every focusable element (tiles, chips, dock buttons, Title page buttons and cards): a thick
    violet frame between white keylines, over a pre-rendered glow that breathes. It springs from element to
    element (HandheldLauncherMotion); the menu's scrim covers it.
  -->
  <Viewbox Stretch="Uniform" ClipToBounds="False" IsHitTestVisible="False">
    <Canvas x:Name="SelectorLayer" Width="1240" Height="1080" ClipToBounds="False">
      <vh:HandheldShadow x:Name="SelectorGlow" Blur="28" Color="#B05B58D9" Width="1" Height="1" />
      <Panel x:Name="Selector">
        <Border x:Name="SelectorRing" Classes="selector-ring">
          <Border><Border /></Border>
        </Border>
      </Panel>
    </Canvas>
  </Viewbox>

  <!-- The menu's scrim covers the whole window, letterbox bands included. -->
      <Border IsVisible="{Binding IsMenuOpen}" Background="#521C2033">
        <Viewbox Stretch="Uniform">
        <Border Width="1240" Height="1080" Background="Transparent">
        <Border x:Name="MenuCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" CornerRadius="40"
                Background="#FFFFFF" Padding="24,16,24,24" BoxShadow="0 20 48 0 #33000000">
          <StackPanel Spacing="8">
            <TextBlock Text="Menu" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033" Margin="24,8,0,8" />
            <ItemsControl ItemsSource="{Binding MenuItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldMenuItemViewModel">
                  <!-- Card radius 40 − padding 24 = 16 for the rows inside it. -->
                  <Border CornerRadius="16" Height="80" Padding="24,0"
                          Background="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowBrush}}">
                    <TextBlock Text="{Binding Label}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding IsFocused, Converter={x:Static vm:HandheldViewConverters.MenuRowText}}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </Border>
        </Viewbox>
      </Border>

  <!--
    ===== The actions sheet (Y) and its confirmations (H4) =====
    Slides up over the Launcher's lower half on a scrim; the focused row is filled with the accent. Every
    "Remove" row names its place. A tap runs a row; a tap on the scrim closes the sheet.
  -->
  <Border x:Name="SheetLayer" IsVisible="{Binding IsSheetOpen}" Background="#521C2033">
    <Viewbox Stretch="Uniform">
      <Border Width="1240" Height="1080" Background="Transparent">
        <Border x:Name="SheetCard" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="880" Margin="0,0,0,48"
                CornerRadius="48" Background="#FFFFFF" Padding="24,32,24,24" BoxShadow="0 24 56 0 #40000000">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" Margin="20,0,28,8">
              <!-- What the sheet acts on: the game's cover, or the folder's colour with its glyph. -->
              <Panel Width="104" Height="104" Margin="0,0,24,0" VerticalAlignment="Center"
                     IsVisible="{Binding Sheet.HasThumbnail}">
                <Border CornerRadius="26" ClipToBounds="True" BoxShadow="0 4 12 0 #26000000">
                  <Border.Background>
                    <ImageBrush Source="{Binding Sheet.Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                  </Border.Background>
                </Border>
              </Panel>
              <Border Width="104" Height="104" Margin="0,0,24,0" CornerRadius="26" VerticalAlignment="Center"
                      Background="{Binding Sheet.Swatch}" BorderBrush="#141C2033" BorderThickness="1"
                      IsVisible="{Binding Sheet.HasSwatch}" BoxShadow="0 4 12 0 #1F000000">
                <Panel>
                  <PathIcon Data="{Binding Sheet.SwatchGlyph, Converter={x:Static vm:HandheldViewConverters.GlyphGeometry}}"
                            IsVisible="{Binding Sheet.HasSwatchGlyph}" Width="52" Height="52" Foreground="White" />
                  <TextBlock Text="{Binding Sheet.SwatchText}" FontSize="30" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Sheet.Title}" FontSize="36" FontWeight="SemiBold" Foreground="#1C2033"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sheet.Subtitle}" IsVisible="{Binding Sheet.HasSubtitle}" FontSize="24" Foreground="#5B6176"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
              </StackPanel>
            </Grid>
            <!-- A game's sheet holds every action (M45 H6c), more rows than fit: the list scrolls to keep the focus in view. -->
            <ScrollViewer x:Name="SheetScroller" MaxHeight="780" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="SheetRows" ItemsSource="{Binding Sheet.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldSheetItemViewModel">
                  <Border Classes="sheet-row" Classes.focused="{Binding IsFocused}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Classes.destructive="{Binding IsDestructive}" Text="{Binding Label}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="note" Grid.Column="1" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                 VerticalAlignment="Center" Margin="24,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Border>
    </Viewbox>
  </Border>

  <!--
    ===== A panel (M45 H6c): the scraper, the batch scraper, cover search, achievements, Search, Edit title =====
    Laid across the screens the way Settings is: its rows (or the keyboard) here, the focused row's card on the Stage. It
    takes this Launcher's canvas (1240 wide, or 1920 on the 16:9 screen): the view sets PanelCanvas's width.
  -->
  <Border x:Name="PanelLayer" IsVisible="{Binding IsPanelOpen}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#FAFBFD" />
        <GradientStop Offset="1" Color="#E4E8EF" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid x:Name="PanelCanvas" Width="1240" Height="1080" ClipToBounds="False">
        <vh:HandheldPanelView x:Name="PanelView" DataContext="{Binding Panel}" />
      </Grid>
    </Viewbox>
  </Border>

  <!--
    ===== Naming a folder (H4) =====
    The mockup's keyboard, on the bottom screen: the name as typed, the colour chips, then the keys. The pad
    moves over the keys (A types, B deletes, Y is a space, X or Start finishes) and up from the top row reaches
    the colours; taps work too. The Stage shows the folder with the name and colour as they change.
  -->
  <Border x:Name="NamingLayer" IsVisible="{Binding IsNaming}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#FAFBFD" />
        <GradientStop Offset="1" Color="#E4E8EF" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform">
      <Border Width="1240" Height="1080" Background="Transparent">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="64,48,64,40">
          <!-- The field: what the folder is called so far. -->
          <Border Classes="name-field" Classes.focused="True">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Naming.Heading}" FontSize="26" Foreground="#5B6176" VerticalAlignment="Center"
                         Margin="0,0,24,0" />
              <TextBox x:Name="NameField" Grid.Column="1" Classes="name-input" Text="{Binding Naming.Text, Mode=TwoWay}"
                       PlaceholderText="{Binding Naming.Placeholder}" MaxLength="24" FontSize="40" FontWeight="SemiBold"
                       Foreground="#1C2033" Background="Transparent" BorderThickness="0" MinHeight="80"
                       VerticalContentAlignment="Center" Focusable="True" />
            </Grid>
          </Border>
          <!-- Colour chips: up from the top row of keys. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="32" Margin="0,32,0,0">
            <TextBlock Text="Colour" FontSize="26" Foreground="#5B6176" VerticalAlignment="Center" Width="120" />
            <ItemsControl x:Name="ColourChips" ItemsSource="{Binding Naming.Colors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="32" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldColorChipViewModel">
                  <Border Classes="colour-chip" Classes.focused="{Binding IsFocused}" Background="{Binding Brush}">
                    <PathIcon Data="{x:Static vm:HandheldIcons.Check}" Width="40" Height="40" Foreground="White"
                              IsVisible="{Binding IsChosen}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- The keys. -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Naming.KeyRows}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldKeyRowViewModel">
                <ItemsControl ItemsSource="{Binding Keys}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HandheldKeyViewModel">
                      <Border Classes="key" Classes.wide="{Binding IsWide}" Classes.done="{Binding IsDone}" Classes.focused="{Binding IsFocused}">
                        <TextBlock Text="{Binding Label}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- What the buttons do here. -->
          <ItemsControl Grid.Row="3" ItemsSource="{Binding Hints}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="40" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHint">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Classes="hint-glyph">
                    <TextBlock Text="{Binding Button}" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Label}" FontSize="24" Foreground="#5B6176" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Viewbox>
  </Border>

  <!--
    ===== Settings (M45 H6a, decision 18) =====
    Master-detail across the screens: the sections and their rows here, and on the Stage what the focused one is, its
    value and its description. The rows are Gamepad mode's (HandheldSettingsViewModel over its projection), drawn in the
    Launcher's look; the choosers, the confirmations and the keyboard for text rows are states of this layer. It takes
    this Launcher's canvas (1240 wide, or 1920 on the 16:9 screen): the view sets SettingsCanvas's width.
  -->
  <Border x:Name="SettingsLayer" IsVisible="{Binding IsSettingsOpen}">
    <Border.Background>
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#FAFBFD" />
        <GradientStop Offset="1" Color="#E4E8EF" />
      </LinearGradientBrush>
    </Border.Background>
    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <Grid x:Name="SettingsCanvas" Width="1240" Height="1080" ClipToBounds="False">

        <!-- The sections (left) and the section's rows (right). -->
        <Grid x:Name="SettingsBody" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
              IsVisible="{Binding !IsTyping}" Classes.rail="{Binding Projection.IsRailFocused}"
              ColumnDefinitions="360,*" RowDefinitions="64,*" Margin="48,40,48,32">
          <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <Border x:Name="SettingsBack" Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static vm:HandheldIcons.Back}" Width="28" Height="28" Foreground="#4B5274" />
                <TextBlock Classes="chip-text" Text="Back" />
              </StackPanel>
            </Border>
            <TextBlock Text="Settings" FontSize="34" FontWeight="SemiBold" Foreground="#1C2033" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding SectionTitle}" FontSize="34" FontWeight="SemiBold" Foreground="#1C2033"
                     VerticalAlignment="Center" Margin="40,0,0,0" TextTrimming="CharacterEllipsis" />

          <ScrollViewer Grid.Row="1" x:Name="SettingsSectionScroller" Margin="0,24,0,0" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="SettingsSections" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandheldSettingsSectionViewModel">
                  <Border Classes="settings-section" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                          Margin="0,0,0,8">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="title" Text="{Binding Title}" />
                      <TextBlock Classes="status" Classes.warning="{Binding IsWarning}" Text="{Binding Status}"
                                 IsVisible="{Binding HasStatus}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- The rows: label left, then the one thing that ends a row (a switch, ‹ a choice ›, a value, a chevron). -->
          <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="SettingsRowScroller" Margin="40,24,0,0"
                        VerticalScrollBarVisibility="Hidden" IsVisible="{Binding IsRows}">
            <ItemsControl x:Name="SettingsRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GamepadSettingsRowViewModel">
                  <Border Classes="settings-row" Classes.focused="{Binding IsFocused}" Classes.grouped="{Binding IsGrouped}"
                          Classes.save="{Binding IsSaveRow}" Classes.disabled="{Binding !IsEnabled}" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="56" Height="56" CornerRadius="14" Background="#EEF0F5" Margin="0,0,20,0"
                              IsVisible="{Binding HasPlatformIcon}" VerticalAlignment="Center">
                        <Image Width="40" Height="40" Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                               RenderOptions.BitmapInterpolationMode="None" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="label" Classes.destructive="{Binding IsDestructive}" Text="{Binding Label}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="24,0,0,0" VerticalAlignment="Center">
                        <!-- A switch. -->
                        <Border Classes="switch" Classes.on="{Binding IsToggleOn}" IsVisible="{Binding IsToggle}">
                          <Border />
                        </Border>
                        <!-- ‹ A choice ›: Left/Right step it, A opens the list. -->
                        <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronLeft}" IsVisible="{Binding IsChoice}" />
                        <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding Value}" IsVisible="{Binding IsChoice}"
                                   MaxWidth="380" />
                        <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding IsChoice}" />
                        <!-- A value to edit (text, secret, folder, file), a platform's summary, or something to read. -->
                        <TextBlock Classes="value" Classes.warning="{Binding IsWarning}" Text="{Binding Value}" MaxWidth="420"
                                   IsVisible="{Binding IsEditableValue}" />
                        <TextBlock Classes="value" Classes.warning="{Binding IsWarning}" Text="{Binding Value}" MaxWidth="420"
                                   IsVisible="{Binding IsSummary}" />
                        <TextBlock Classes="value" Text="{Binding Value}" MaxWidth="460" IsVisible="{Binding IsInformation}" />
                        <!-- What an action does when its label does not say ("Sync now"), or that it is running. -->
                        <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding ActionText}" IsVisible="{Binding HasActionText}" />
                        <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding ShowsChevron}" />
                        <PathIcon Classes="chevron" Data="{x:Static vm:HandheldIcons.ChevronRight}" IsVisible="{Binding IsSummary}"
                                  RenderTransform="{Binding IsExpanded, Converter={x:Static vm:HandheldViewConverters.ExpandedTurn}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Themes: the gallery, three to a row as the pad moves through it. -->
          <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="SettingsThemeScroller" Margin="40,24,0,0"
                        VerticalScrollBarVisibility="Hidden" IsVisible="{Binding IsThemes}">
            <ItemsControl x:Name="SettingsThemes" ItemsSource="{Binding ThemeChoices}" HorizontalAlignment="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                  <Border Classes="theme-ring" Classes.focused="{Binding IsFocused}" Margin="0,0,16,16">
                    <StackPanel Spacing="10">
                      <Border Classes="theme-card" Background="{Binding PreviewBackground}">
                        <Grid RowDefinitions="Auto,*" Margin="18">
                          <Border Background="{Binding PreviewSurface}" CornerRadius="12" Height="48">
                            <Border Width="48" Height="12" CornerRadius="6" Background="{Binding PreviewAccent}"
                                    HorizontalAlignment="Left" Margin="14,0" />
                          </Border>
                          <TextBlock Grid.Row="1" Text="Aa" FontSize="34" FontWeight="SemiBold" Foreground="{Binding PreviewText}"
                                     VerticalAlignment="Bottom" />
                        </Grid>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <PathIcon Data="{x:Static vm:HandheldIcons.Check}" Width="24" Height="24" Foreground="#5B58D9"
                                  IsVisible="{Binding IsSelected}" />
                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="#1C2033"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- State: a choice's list, a card over a scrim (A picks, B leaves it as it was). -->
        <Border x:Name="SettingsChoiceSheet" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
                IsVisible="{Binding IsChoicePickerOpen}" Background="#521C2033" Margin="-400">
          <Border x:Name="SettingsChoiceCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="900"
                  CornerRadius="40" Background="#FFFFFF" Padding="24,16,24,24" BoxShadow="0 20 48 0 #33000000">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{Binding Projection.ChoicePickerTitle}" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033"
                         Margin="24,8,24,12" TextTrimming="CharacterEllipsis" />
              <ScrollViewer Grid.Row="1" x:Name="SettingsChoiceScroller" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="SettingsChoices" ItemsSource="{Binding ChoiceOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GamepadChoiceOptionViewModel">
                      <Border Classes="sheet-row" Classes.focused="{Binding IsFocused}" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="label" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <PathIcon Grid.Column="1" Classes="pick" Data="{x:Static vm:HandheldIcons.Check}" Width="32" Height="32"
                                    IsVisible="{Binding IsSelected}" Margin="24,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Border>

        <!-- State: a confirmation (a destructive row, or one that disconnects), Cancel first. -->
        <Border x:Name="SettingsConfirmSheet" DataContext="{Binding Settings}" x:DataType="vm:HandheldSettingsViewModel"
                IsVisible="{Binding IsConfirmationOpen}" Background="#521C2033" Margin="-400">
          <Border x:Name="SettingsConfirmCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"
                  CornerRadius="40" Background="#FFFFFF" Padding="24,24,24,24" BoxShadow="0 20 48 0 #33000000">
            <StackPanel Spacing="12">
              <StackPanel Margin="24,0,24,12" Spacing="8">
                <TextBlock Text="{Binding Projection.ConfirmationTitle}" FontSize="32" FontWeight="SemiBold" Foreground="#1C2033"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Projection.ConfirmationText}" FontSize="24" Foreground="#5B6176" TextWrapping="Wrap" />
              </StackPanel>
              <Border x:Name="SettingsConfirmCancel" Classes="sheet-row" Classes.focused="{Binding IsCancelFocused}">
                <TextBlock Classes="label" Text="Cancel" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="SettingsConfirmGo" Classes="sheet-row" Classes.focused="{Binding IsConfirmFocused}">
                <TextBlock Classes="label" Text="{Binding ConfirmLabel}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
        </Border>

        <!--
          State: typing a text row (a name, a key, a password) on the drawn keyboard, the naming keyboard's look: Android's
          own keyboard cannot open on the Thor's second screen. The field takes a hardware keyboard too.
        -->
        <Grid x:Name="SettingsKeyboard" DataContext="{Binding Settings.Keyboard}" x:DataType="vm:HandheldTextKeyboardViewModel"
              IsVisible="{Binding $parent[UserControl].((vm:HandheldShellViewModel)DataContext).Settings.IsTyping, FallbackValue=False}"
              RowDefinitions="Auto,*,Auto" Width="1112" Margin="0,48,0,40" HorizontalAlignment="Center">
          <Border Classes="name-field" Classes.focused="True">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Title}" FontSize="26" Foreground="#5B6176" VerticalAlignment="Center"
                         Margin="0,0,24,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
              <TextBox x:Name="SettingsField" Grid.Column="1" Classes="name-input" Text="{Binding Text, Mode=TwoWay}"
                       PasswordChar="{Binding MaskChar}" FontSize="36" FontWeight="SemiBold" Foreground="#1C2033"
                       Background="Transparent" BorderThickness="0" MinHeight="80" VerticalContentAlignment="Center"
                       Focusable="True" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding KeyRows}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldKeyRowViewModel">
                <ItemsControl ItemsSource="{Binding Keys}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HandheldKeyViewModel">
                      <Border Classes="key" Classes.mid="{Binding IsMid}" Classes.space="{Binding IsSpace}"
                              Classes.done="{Binding IsDone}" Classes.focused="{Binding IsFocused}">
                        <TextBlock Text="{Binding Label}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding $parent[UserControl].((vm:HandheldShellViewModel)DataContext).Hints}"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="40" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandheldHint">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Classes="hint-glyph">
                    <TextBlock Text="{Binding Button}" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Label}" FontSize="24" Foreground="#5B6176" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Viewbox>
  </Border>
  </Panel>
</UserControl>
