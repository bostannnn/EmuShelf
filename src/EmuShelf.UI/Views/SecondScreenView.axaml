<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EmuShelf.App.Controls"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             xmlns:ai="using:Avalonia.Input"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             x:Class="EmuShelf.App.Views.SecondScreenView"
             x:DataType="vm:SecondScreenViewModel"
             Background="{DynamicResource EmuWindowBackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock.spotlight-title">
      <Setter Property="Opacity" Value="0.22" />
      <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.spotlight-title.on-art">
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.media-control">
      <Setter Property="Background" Value="#661A2029" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Panel.media-gallery">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" /></Transitions></Setter>
    </Style>
    <Style Selector="Panel.media-gallery.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Image.media-photo.video"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.media-control:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DD303A49" />
    </Style>
    <!-- Achievement badge tiles: locked ones are dimmed, hardcore unlocks get the gold ring — the same
         treatment as the gamepad achievements grid. Scoped class names so they never touch other tiles. -->
    <Style Selector="Grid.ss-badge-inner.locked">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <!-- Base tile border. The default MUST live here, not as a local BorderThickness/BorderBrush on the
         tile: a local value outranks a class-selector style setter in Avalonia, so the .hardcore / .selected
         thickness overrides below are only honoured when the default is itself a (less-specific) style. -->
    <Style Selector="Border.ss-badge">
      <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.ss-badge.hardcore">
      <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- The tapped badge gets the accent ring so it's clear which one the title/subtitle strip describes.
         Placed after .hardcore so the accent wins over the gold ring while a hardcore tile is selected. -->
    <Style Selector="Border.ss-badge.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- ===================== Playing-elsewhere dim standby =====================
         While a game runs on the other screen this idle surface sits under a near-black wash with the
         running game's logo faintly visible — dark and easy on the panel (the Thor's Screen-2 is
         burn-in-prone) rather than the full-brightness browse spotlight. Mounted always and driven by an
         .on class (bound to IsStandby) so it dissolves in when a game starts and out when an overlay
         (achievements / drawer) opens over it, or when a touch wakes it (SecondScreenViewModel.NoteInteraction).

         It IS hit-testable while it is up, and only then: dimmed to near-black you cannot see what you are
         about to press, so the first touch has to buy you a look at the panel rather than launch the dock
         app that happens to be under your finger. Once the wash is gone it stops intercepting and every
         touch works normally again. -->
    <Style Selector="Border.ss-standby">
      <Setter Property="Background" Value="#F2000000" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ss-standby.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <!-- The mark that rides over the wash (see the bottom of this file). Same class-driven fade on the
         same curve, so wash and mark arrive and leave together. -->
    <Style Selector="Panel.ss-standby-mark">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.ss-standby-mark.on">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===================== Overlay scrim + floating sheet =====================
         The drawer and achievements overlays are floating rounded cards over a dim scrim, matching the
         couch shell's overlays instead of the old edge-to-edge opaque slab. Both layers stay mounted and
         are driven by an .open class (bound to IsDrawerOpen / IsAchievementsOpen) so opening reads as a
         soft dissolve + scale-in rather than a hard cut. Hit testing is gated on the same class so a
         closed overlay never swallows a tap on the resting surface. -->
    <Style Selector="Border.ss-scrim">
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ss-scrim.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.ss-sheet">
      <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="0 12 32 0 #5A000000" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(0.97)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ss-sheet.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- ===================== Soft controls =====================
         Rounded, touch-sized versions of the app's controls so the companion surface reads as the same
         app: pill icon buttons with a hover wash, rounded dock slots and drawer tiles. All pick up the
         same short Background transition the desktop toolbar buttons use. -->
    <Style Selector="Button.ss-icon">
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ss-icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
    </Style>
    <!-- Large, visibly bounded end controls for touch on the companion display. -->
    <Style Selector="Button.ss-bar-icon">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ss-bar-icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
    </Style>
    <Style Selector="Button.ss-bar-icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EmuStrongBorderBrush}" />
    </Style>
    <!-- Dock slots and drawer app tiles: rounded cards with a hover wash. -->
    <Style Selector="Button.ss-slot, Button.ss-app-tile">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ss-slot:pointerover /template/ ContentPresenter,
                     Button.ss-app-tile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The Thor companion surface: an embedded Avalonia top level on Screen-2, so it inherits the app's
       palette, Inter font, and controls. The resting surface shows the focused/running game's fan art
       with its logo staggered in on top (Cocoon-style); the bottom bar carries the app dock plus the
       drawer and achievements toggles. -->
  <Grid RowDefinitions="*,Auto" ClipToBounds="True">

    <!-- Art continues behind the floating dock, including its rounded corners and outer gutter. -->
    <Image Grid.RowSpan="2" Source="{Binding FanartImage}" Stretch="UniformToFill"
           Opacity="{Binding FanartOpacity}" IsVisible="{Binding HasFanart}" />
    <Border Grid.RowSpan="2" Background="#40000000" IsVisible="{Binding HasFanart}" />

    <Panel Grid.Row="0" ClipToBounds="True" Background="Transparent"
           PointerPressed="OnMediaPointerPressed" PointerReleased="OnMediaPointerReleased">

      <!-- ...and the logo on top, faded in after the art (the background never animates, so no blink).
           SpotlightLogoOpacity, not LogoOpacity: it drops to zero while the standby wash is up, because
           that wash paints its own faint copy of this logo over the whole surface and the two centres
           differ by half the dock bar — which is what made the logo look doubled on the companion. -->
      <Image Source="{Binding WheelImage}" Stretch="Uniform" MaxWidth="720" MaxHeight="300" Margin="72"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Opacity="{Binding SpotlightLogoOpacity}" IsVisible="{Binding HasWheel}">
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.30" Easing="CubicEaseOut" />
          </Transitions>
        </Image.Transitions>
      </Image>

      <!-- Fallback when the selected game has no art (or nothing is selected). Hidden under standby for
           the same reason as the logo above — the wash draws its own wordmark. -->
      <TextBlock Classes="spotlight-title" Classes.on-art="{Binding HasFanart}" Text="{Binding SpotlightTitle}" TextWrapping="Wrap" TextAlignment="Center" Margin="24" FontSize="32" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowRestingBranding}" />

      <!-- App drawer overlay: dim scrim (tap outside to dismiss) + a floating rounded sheet -->
      <Border Classes="ss-scrim" Classes.open="{Binding IsDrawerOpen}" Tapped="OnOverlayScrimTapped" />
      <Border Classes="ss-sheet" Classes.open="{Binding IsDrawerOpen}"
              Margin="20" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*" Margin="26,18,26,14">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding DrawerTitle}" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
            <Button Grid.Column="1" Classes="toolbar-button" Content="Clear slot" Padding="12,8"
                    IsVisible="{Binding CanClearSlot}"
                    Command="{Binding ClearSlotCommand}" />
            <Button Grid.Column="2" Classes="toolbar-button" Content="Close" Padding="12,8"
                    Command="{Binding CloseOverlayCommand}" />
          </Grid>
          <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Apps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Fixed column count that stretches to fill the width, so tiles pack the row
                       instead of leaving dead space on the right. -->
                  <UniformGrid Columns="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SecondScreenAppViewModel">
                  <Button Classes="ss-app-tile" Height="98" Margin="4" Padding="4"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Background="{DynamicResource EmuCardBrush}"
                          Command="{Binding DataContext.LaunchAppCommand, ElementName=Root}"
                          CommandParameter="{Binding}">
                    <StackPanel VerticalAlignment="Center" Spacing="5">
                      <Image Source="{Binding Icon}" Width="44" Height="44"
                             HorizontalAlignment="Center" IsVisible="{Binding HasIcon}" />
                      <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxLines="1"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Achievements overlay (square Thor panel, touch): one header row carries the game name, the
           progress summary, and the Refresh / Close icon buttons; the badge grid fills the middle; and —
           because touch has no hover tooltip — the tapped badge's title/subtitle/points sit in a detail
           strip beneath it. The app dock bar is hidden while this is up (see the bottom bar's IsVisible),
           giving the grid the full panel height. Locked badges are dimmed; hardcore unlocks get the gold
           ring; the tapped one gets the accent ring — see the styles at the top of this view. -->
      <Border Classes="ss-scrim" Classes.open="{Binding IsAchievementsOpen}" Tapped="OnOverlayScrimTapped" />
      <Border Classes="ss-sheet" Classes.open="{Binding IsAchievementsOpen}" Margin="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26,18,26,14">

          <!-- Header: game name (left), progress summary, and Refresh / Close as icon buttons. This is the
               only chrome — the old bottom footer is gone, so the grid + detail own the rest of the panel. -->
          <Grid Grid.Row="0" x:Name="AchievementsHeader" ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="10" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{Binding AchievementsTitle}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding AchievementsSummary}" FontSize="13"
                       IsVisible="{Binding HasSummary}" VerticalAlignment="Center"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <Button Grid.Column="2" Classes="ss-icon" Width="42" Height="42" Padding="0"
                    VerticalAlignment="Center" ToolTip.Tip="Refresh"
                    IsVisible="{Binding CanRefresh}" Command="{Binding RefreshCommand}">
              <PathIcon Width="18" Height="18" Data="{DynamicResource EmuRefreshGeometry}"
                        Foreground="{DynamicResource EmuTextPrimaryBrush}" />
            </Button>
            <Button Grid.Column="3" Classes="ss-icon" Width="42" Height="42" Padding="0"
                    VerticalAlignment="Center" ToolTip.Tip="Close"
                    Command="{Binding CloseOverlayCommand}">
              <PathIcon Width="16" Height="16" Data="{DynamicResource EmuCloseGeometry}"
                        Foreground="{DynamicResource EmuTextPrimaryBrush}" />
            </Button>
          </Grid>

          <!-- Transient status over a loaded grid ("Refreshing…", offline, an error). Hidden in the normal
               loaded case (the controller leaves status null) and for empty states (the centered message
               below handles those). -->
          <TextBlock Grid.Row="1" Text="{Binding AchievementsStatus}" IsVisible="{Binding HasInlineStatus}"
                     FontSize="13" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource EmuTextSecondaryBrush}" />

          <!-- Row-virtualized badge grid: a ListBox realizes one ROW per line (a vertical
               VirtualizingStackPanel), each row an ItemsControl of AchievementColumnCount tiles, so a
               400-badge set only realizes its on-screen rows. The column count is driven from the
               viewport width (SizeChanged) so the row stride matches what is rendered. The ListBox is a
               passive renderer — its own selection/focus visuals are styled away; the tapped badge is
               tracked on the view model (SelectAchievement) and shown by the .selected accent ring. -->
          <ListBox Grid.Row="2" x:Name="AchievementsBadgeList" IsVisible="{Binding IsAchievementsGridRealized}"
                   ItemsSource="{Binding AchievementRows}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   SizeChanged="OnAchievementsBadgeListSizeChanged"
                   AutoScrollToSelectedItem="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusAdorner" Value="{x:Null}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter,
                               ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementRowViewModel">
                      <!-- The tile size is computed to fill the row (SizeChanged → AchievementTileSize) so a
                           dense ~6-column grid packs the panel with no dead space on the right. The 5px
                           margin here must match the code-behind's TileMargin so the column math lines up. -->
                      <Border Width="{Binding DataContext.AchievementTileSize, ElementName=Root}"
                              Height="{Binding DataContext.AchievementTileSize, ElementName=Root}"
                              Margin="5" CornerRadius="12" ClipToBounds="True"
                              Classes="ss-badge" Classes.hardcore="{Binding IsHardcore}"
                              Classes.selected="{Binding IsFocused}"
                              Background="{DynamicResource EmuCoverWellBrush}"
                              Tapped="OnAchievementBadgeTapped"
                              AttachedToVisualTree="OnAchievementBadgeAttached"
                              DataContextChanged="OnAchievementBadgeDataContextChanged">
                        <Grid Classes="ss-badge-inner" Classes.locked="{Binding IsLocked}">
                          <PathIcon Width="28" Height="28" IsVisible="{Binding !HasBadge}"
                                    Data="{DynamicResource AchievementTrophyGeometry}"
                                    Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                          <Image Source="{Binding Badge}" IsVisible="{Binding HasBadge}" Stretch="UniformToFill" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty / message state (no set linked, not connected, loading, "select a game first"),
               centered in the grid area so the panel never reads as blank when there are no badges. -->
          <TextBlock Grid.Row="2" IsVisible="{Binding !HasAchievements}"
                     Text="{Binding AchievementsStatus}" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" FontSize="16"
                     Foreground="{DynamicResource EmuTextSecondaryBrush}" />

          <!-- Selected badge: title, description, and a compact "points · Earned date" line (Variant 2 —
               lock/hardcore state is omitted, the tile's dimming/gold ring already show it). This is the
               touch answer to the grid's missing hover tooltip. Auto-populated with the first badge.
               FIXED HEIGHT so navigating badges never resizes this strip (and, since the grid above is the
               "*" row, never reflows the grid either): the title is pinned to one line and the description
               reserves exactly two lines via an explicit LineHeight × Height. A shorter description leaves
               the second line blank; a longer one ellipsizes at the second line. -->
          <StackPanel Grid.Row="3" x:Name="AchievementsDetail" Margin="0,14,0,0" Spacing="3"
                      IsVisible="{Binding HasSelectedAchievement}">
            <TextBlock Text="{Binding SelectedAchievement.Title}" FontSize="19" FontWeight="SemiBold"
                       MaxLines="1" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
            <!-- LineHeight × MaxLines == Height, so the box is always exactly two lines tall regardless of
                 how many lines the text actually fills. -->
            <TextBlock Text="{Binding SelectedAchievement.Description}" FontSize="14"
                       TextWrapping="Wrap" MaxLines="2" LineHeight="20" Height="40"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <Button Content="Reveal hidden achievement" Command="{Binding SelectedAchievement.RevealCommand}" IsVisible="{Binding SelectedAchievement.CanReveal}" />
            <TextBlock Text="{Binding SelectedAchievementMeta}" FontSize="12"
                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <Button Classes="media-control" Width="40" Height="40" Margin="16"
              HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding OpenMediaCommand}"
              IsVisible="{Binding IsSpotlight}" AutomationProperties.Name="Open photos and videos">
        <PathIcon Width="18" Height="18" Foreground="White"
                  Data="F0 M2,3 H22 V21 H2 Z M4,5 V19 H20 V5 Z M5,17 L9,12 L12,15 L15,11 L19,17 Z M6,7 H9 V10 H6 Z" />
      </Button>
    </Panel>
    <!-- Bottom bar:  ☰  |  five dock slots  |  trophy. Hidden while the achievements overlay is open so the
         badge grid + detail strip own the full square panel; Close (or Back) returns to it. -->
    <Border x:Name="CompanionDock" Grid.Row="1" Height="80" Margin="12,0,12,12" Background="{DynamicResource EmuToolbarBrush}"
            IsVisible="{Binding IsDockVisible}"
            CornerRadius="24" BoxShadow="0 4 16 0 #33000000">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">

        <Button Grid.Column="0" Classes="ss-bar-icon" Width="64" Height="64" Padding="0"
                AutomationProperties.Name="All apps"
                VerticalAlignment="Center" ToolTip.Tip="All apps"
                Command="{Binding ToggleDrawerCommand}">
          <TextBlock Text="&#x2630;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource EmuTextPrimaryBrush}" />
        </Button>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding Dock}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SecondScreenSlotViewModel">
              <!-- Tap launches (or opens the picker if empty); long-press opens the picker to re-pin or
                   clear a filled slot (handled in code-behind via the Holding gesture). -->
              <Button Classes="ss-slot" Width="50" Height="50" Padding="2"
                      ai:InputElement.IsHoldingEnabled="True"
                      Background="{DynamicResource EmuCardBrush}"
                      BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1"
                      Command="{Binding DataContext.ActivateSlotCommand, ElementName=Root}"
                      CommandParameter="{Binding}">
                <!-- Clip the app icon to the slot's rounded corners so a square icon never pokes past them. -->
                <Border CornerRadius="12" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="+" FontSize="22" IsVisible="{Binding IsEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Column="2" Classes="ss-bar-icon" Width="64" Height="64" Padding="0"
                AutomationProperties.Name="Achievements"
                VerticalAlignment="Center" ToolTip.Tip="Achievements"
                Command="{Binding ToggleAchievementsCommand}">
          <PathIcon Width="28" Height="28"
                    Data="{DynamicResource AchievementTrophyGeometry}"
                    Foreground="{DynamicResource EmuAchievementBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- A dedicated full-display viewer. The dock is removed from layout while this is open. -->
    <Panel x:Name="MediaGallery" Grid.RowSpan="2" Background="#080A0D" Classes="media-gallery" Classes.open="{Binding IsMediaOpen}"
           ClipToBounds="True" PointerPressed="OnMediaPointerPressed" PointerReleased="OnMediaPointerReleased">
      <Panel x:Name="MediaViewport">
        <Image Classes="media-photo" Classes.video="{Binding IsSelectedVideo}" Source="{Binding MediaImage}" Stretch="Uniform" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsMediaLoading}" Height="2" Width="72"
                     Foreground="#B9C0CA" Background="#26303D" VerticalAlignment="Bottom" Margin="0,0,0,48" />
        <TextBlock Text="{Binding MediaStatus}" Foreground="#B9C0CA" FontSize="13" Margin="40"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel IsVisible="{Binding !HasMedia}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="40">
          <TextBlock Text="No media yet" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          <TextBlock Text="Photos and videos will appear here." Foreground="#9CA6B5" TextAlignment="Center" />
          <Button Content="Fetch missing artwork" Classes="media-control" Command="{Binding FetchMediaCommand}"
                  IsVisible="{Binding CanFetchMedia}" IsEnabled="{Binding !IsFetchingMedia}" HorizontalAlignment="Center" Padding="18,10" />
        </StackPanel>
        <Button Classes="media-control" Command="{Binding PlayMediaCommand}" IsVisible="{Binding ShowMediaPlay}"
                Width="68" Height="68" CornerRadius="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                AutomationProperties.Name="Play muted video">
          <PathIcon Width="24" Height="24" Foreground="White" Data="M5,2 L21,12 L5,22 Z" />
        </Button>
        <!-- Native Android views render above Avalonia: reserve only slim control bands for video. -->
        <ContentControl IsVisible="{Binding IsVideoPlaying}" Content="{Binding PlayingVideoPath}" Margin="0,56,0,44"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <ContentControl.ContentTemplate>
            <DataTemplate><controls:CompanionVideoHost Source="{Binding}" AttachedToVisualTree="OnVideoAttached" /></DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>
      <Border Height="110" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding IsMediaChromeVisible}">
        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#C0080A0D" Offset="0" /><GradientStop Color="#00080A0D" Offset="1" /></LinearGradientBrush></Border.Background>
      </Border>
      <Border Height="90" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding IsMediaChromeVisible}">
        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#00080A0D" Offset="0" /><GradientStop Color="#D9080A0D" Offset="1" /></LinearGradientBrush></Border.Background>
      </Border>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetchingMedia}" Height="2" Margin="20,0" VerticalAlignment="Top" Foreground="#B9C0CA" Background="Transparent" />
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="12,10" Height="36" VerticalAlignment="Top" IsVisible="{Binding IsMediaChromeVisible}">
        <Button Classes="media-control" Width="36" Height="36" Command="{Binding CloseOverlayCommand}" AutomationProperties.Name="Close media">
          <PathIcon Width="14" Height="14" Foreground="White" Data="M3,5 L5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 Z" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding MediaTitle}" FontSize="14" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="media-control" Width="36" Height="36" Command="{Binding FetchMediaCommand}"
                IsVisible="{Binding CanFetchMedia}" IsEnabled="{Binding !IsFetchingMedia}" AutomationProperties.Name="Fetch missing artwork" ToolTip.Tip="Fetch missing artwork for this game">
          <PathIcon Width="16" Height="16" Foreground="White" Data="M11,2 H13 V13 L17,9 L19,11 L12,18 L5,11 L7,9 L11,13 Z M3,19 H21 V22 H3 Z" />
        </Button>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,6" Height="32" VerticalAlignment="Bottom" IsVisible="{Binding IsMediaChromeVisible}">
        <Button Classes="media-control" Width="36" Height="32" Command="{Binding PreviousMediaCommand}" IsVisible="{Binding CanBrowseMedia}" AutomationProperties.Name="Previous media">
          <PathIcon Width="8" Height="12" Foreground="White" Data="M10,0 L0,10 L10,20 L12,18 L4,10 L12,2 Z" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding MediaCaption}" FontSize="11" Foreground="#B9C0CA" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Column="2" Classes="media-control" Width="36" Height="32" Command="{Binding NextMediaCommand}" IsVisible="{Binding CanBrowseMedia}" AutomationProperties.Name="Next media">
          <PathIcon Width="8" Height="12" Foreground="White" Data="M2,0 L12,10 L2,20 L0,18 L8,10 L0,2 Z" />
        </Button>
      </Grid>
    </Panel>

    <!-- Dim standby wash for "a game is playing on the other screen" (see the style above). Spans BOTH rows
         so the whole surface — spotlight and the dock bar below it — goes dark together. While it is up it
         swallows the touch that wakes it; once it is gone the trophy/dock are tappable as usual (tapping the
         trophy opens achievements, which lifts the dim on its own). IsStandby is false whenever an overlay
         is open, so the wash always reads clean. Childless: its Background is all it is. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Classes="ss-standby" Classes.on="{Binding IsStandby}" />

    <!-- The faint "what is playing" mark, over the wash. It lives in ROW 0 — the spotlight row — not in
         the wash that spans both rows, so it is centred on exactly the same rect as the resting logo it
         stands in for. That is the whole point: the two copies used to be centred half a dock bar apart,
         which made the logo look doubled on the companion, and even after the resting copy was faded out
         under standby the two still crossed over visibly for ~300ms on every dim and every tap-to-wake.
         Landing them on the same centre makes that crossfade invisible.
         Non-hit-test, so the wake tap falls through to the wash below it. -->
    <Panel Grid.Row="0" Classes="ss-standby-mark" Classes.on="{Binding IsStandby}" IsHitTestVisible="False">
      <!-- The running game's logo, faintly, as the "slightly visible logo" over the black. -->
      <Image Source="{Binding WheelImage}" Stretch="Uniform" MaxWidth="720" MaxHeight="300" Margin="72"
             Opacity="0.16" IsVisible="{Binding HasWheel}"
             HorizontalAlignment="Center" VerticalAlignment="Center" />
      <!-- No game logo: fall back to the app wordmark, equally faint. -->
      <TextBlock Text="EmuShelf" FontSize="40" FontWeight="Bold" Opacity="0.14"
                 IsVisible="{Binding !HasWheel}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource EmuTextPrimaryBrush}" />
    </Panel>

  </Grid>
</UserControl>
