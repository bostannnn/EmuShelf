<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EmuShelf.App.App"
             xmlns:local="using:EmuShelf.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://EmuShelf.UI/Styles/EmuShelfTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bundled couch display font (Exo 2, SIL OFL — see THIRD-PARTY-NOTICES.md). Applied to the
                 Gamepad shell only; Desktop keeps the default Inter UI font. -->
            <FontFamily x:Key="EmuGamepadFontFamily">avares://EmuShelf.UI/Assets/Fonts/Exo2.ttf#Exo 2</FontFamily>

            <!-- Gamepad type scale — deliberately larger than Desktop for TV / Steam Deck viewing
                 distance. The couch library views route their font sizes through these six tokens, so
                 rescaling the whole thing is a matter of nudging these numbers. -->
            <x:Double x:Key="EmuGpDisplaySize">52</x:Double>
            <x:Double x:Key="EmuGpTitleSize">30</x:Double>
            <x:Double x:Key="EmuGpHeadingSize">24</x:Double>
            <x:Double x:Key="EmuGpBodySize">22</x:Double>
            <x:Double x:Key="EmuGpLabelSize">18</x:Double>
            <x:Double x:Key="EmuGpCaptionSize">14</x:Double>

            <!-- Desktop type scale. The couch shell routes its font sizes through the EmuGp* tokens
                 above; the Desktop shell had no equivalent and sized text ad hoc — two dozen distinct
                 literals from 8 to 26 px — which is the root of its faintly-inconsistent feel. These
                 nine steps are the single source of truth: route a Desktop FontSize through the
                 nearest one rather than hard-coding a number, and the whole shell rescales from here.
                 (Values chosen to sit on the dominant existing sizes, so adopting them barely moves
                 any one control.) -->
            <x:Double x:Key="EmuTextDisplaySize">24</x:Double>
            <x:Double x:Key="EmuTextTitleSize">22</x:Double>
            <x:Double x:Key="EmuTextHeadingSize">17</x:Double>
            <x:Double x:Key="EmuTextSubheadingSize">15</x:Double>
            <x:Double x:Key="EmuTextLabelSize">13</x:Double>
            <x:Double x:Key="EmuTextBodyStrongSize">12</x:Double>
            <x:Double x:Key="EmuTextBodySize">11</x:Double>
            <x:Double x:Key="EmuTextSmallSize">10</x:Double>
            <x:Double x:Key="EmuTextCaptionSize">9</x:Double>

            <!-- Desktop corner-radius scale. Pairs with the type scale so cards, popovers, inputs and
                 pills round consistently rather than drifting between 2 and 18 px per view. Pill is
                 the "make it a capsule" radius for fully-rounded chips. -->
            <CornerRadius x:Key="EmuRadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="EmuRadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="EmuRadiusLarge">10</CornerRadius>
            <CornerRadius x:Key="EmuRadiusXLarge">18</CornerRadius>
            <CornerRadius x:Key="EmuRadiusPill">53</CornerRadius>

            <!-- Desktop spacing scale on a 4 px base step, for uniform padding and gaps. The single
                 source of truth for Desktop rhythm. Defined ahead of adoption: today's Desktop
                 spacing is off-grid (0,1,3,5,10,14,18…), so moving it onto these steps is a
                 deliberate per-view layout pass rather than a mechanical swap — the type and radius
                 scales migrated cleanly, spacing needs eyes on each container. (Note also that a
                 DynamicResource margin on the root of a SizeToContent dialog measures before it
                 resolves and collapses the auto-height, so adopt these inside the layout, not on it.) -->
            <Thickness x:Key="EmuSpaceXs">4</Thickness>
            <Thickness x:Key="EmuSpaceSm">8</Thickness>
            <Thickness x:Key="EmuSpaceMd">12</Thickness>
            <Thickness x:Key="EmuSpaceLg">16</Thickness>
            <Thickness x:Key="EmuSpaceXl">24</Thickness>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#7C6CE0" />
                <ColorPaletteResources x:Key="Dark" Accent="#5B58D9" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://EmuShelf.UI/Styles/EmuShelfStyles.axaml" />
    </Application.Styles>
</Application>
