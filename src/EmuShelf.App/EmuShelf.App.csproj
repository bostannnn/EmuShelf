<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EmuShelf</AssemblyName>
    <!-- The user-visible version (Settings → About, the version flag, logs) is stamped onto the
         EmuShelf.UI assembly, where AppBuildInfo reads it. This fallback only names the desktop
         executable when built without git history. -->
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows shell icon (Explorer, taskbar pinning). The icon asset lives with the rest of the
         shared assets in EmuShelf.UI; Avalonia windows set their own icon from the same file as an
         avares://EmuShelf.UI resource — see Icon= on each Window. -->
    <ApplicationIcon>..\EmuShelf.UI\Assets\emushelf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmuShelf.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuShelf.UI\EmuShelf.UI.csproj" />
  </ItemGroup>
</Project>
