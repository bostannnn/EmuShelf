<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EmuShelf</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets\ThirdParty\OpenEmu\LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ThirdParty\OpenEmu\LICENSE.txt" />
    <None Update="Assets\ThirdParty\RetroAchievements\LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ThirdParty\RetroAchievements\LICENSE.txt" />
    <None Update="Assets\ThirdParty\ZstdSharp-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ThirdParty\ZstdSharp\LICENSE.txt" />
    <None Update="Assets\ThirdParty\Shamisen.Codecs.Flac-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ThirdParty\Shamisen.Codecs.Flac\LICENSE.txt" />
    <None Update="Assets\ThirdParty\YamlDotNet-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="ThirdParty\YamlDotNet\LICENSE.txt" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmuShelf.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuShelf.Core\EmuShelf.Core.csproj" />
    <ProjectReference Include="..\EmuShelf.Infrastructure\EmuShelf.Infrastructure.csproj" />
    <ProjectReference Include="..\EmuShelf.Integrations\EmuShelf.Integrations.csproj" />
  </ItemGroup>
</Project>
