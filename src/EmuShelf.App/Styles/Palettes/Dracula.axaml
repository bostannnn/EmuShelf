<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dracula: The classic developer palette. Muted slate-purple base with vivid pink, purple and green highlights.
         Base variant follows its mode; every base token is redefined so the swap fully
         re-colors the UI. Generated from themes.json. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#282A36" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#2C2F3C" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#2A2C38" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#333544" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#2B2D3A" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#44475A" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#4F5264" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#414456" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#3D4051" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#44475A" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#414456" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#5A5E71" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B282A36" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#565872" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#6E6F86" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#4F5168" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#C4C5CD" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#8F92A8" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2EBD93F9" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#3F4254" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#6E6F86" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33BD93F9" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#70D3A4" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 12 0 #B0BD93F9</BoxShadows>
</ResourceDictionary>
