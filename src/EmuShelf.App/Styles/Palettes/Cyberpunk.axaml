<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cyberpunk: deep violet surfaces with neon magenta selection and cyan/gold status colors. Base
         variant is Dark. Every base Dark token is redefined so the swap fully re-colors the UI. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#0F0A1E" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#150D2A" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#120A24" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#17102E" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#140C28" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#1E1338" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#241645" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#1B1035" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#20143C" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#1E1338" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#241645" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#331E5C" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B0F0A1E" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#3A2360" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#5A3A8C" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#43286E" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F6ECFF" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#C3A9E6" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#9179B8" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#1AFF3FA4" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#2AFF3FA4" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#2A1750" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#5A3A8C" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#FF3FA4" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#33FF3FA4" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#FF3FA4" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#FFD447" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#37E0A0" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF5C57" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 28 2 #82FF3FA4</BoxShadows>
</ResourceDictionary>
