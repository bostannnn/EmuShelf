<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OLED: true black surfaces with an electric-blue accent. Base variant is Dark. Every token the
         base Dark palette defines is redefined here so the runtime swap fully re-colors the UI. -->
    <SolidColorBrush x:Key="EmuWindowBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="EmuSidebarBrush" Color="#060608" />
    <SolidColorBrush x:Key="EmuToolbarBrush" Color="#050506" />
    <SolidColorBrush x:Key="EmuLibraryBrush" Color="#0A0A0C" />
    <SolidColorBrush x:Key="EmuStatusBrush" Color="#060607" />
    <SolidColorBrush x:Key="EmuCardBrush" Color="#121215" />
    <SolidColorBrush x:Key="EmuPopoverBrush" Color="#16161A" />
    <SolidColorBrush x:Key="EmuInputBrush" Color="#101014" />
    <SolidColorBrush x:Key="EmuSegmentBrush" Color="#131317" />
    <SolidColorBrush x:Key="EmuAddButtonBrush" Color="#131316" />
    <SolidColorBrush x:Key="EmuCoverWellBrush" Color="#141418" />
    <SolidColorBrush x:Key="EmuPlaceholderMedallionBrush" Color="#1E1E24" />
    <SolidColorBrush x:Key="EmuPlaceholderLabelBrush" Color="#6B000000" />
    <SolidColorBrush x:Key="EmuFormatPillBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="EmuBorderBrush" Color="#202027" />
    <SolidColorBrush x:Key="EmuStrongBorderBrush" Color="#33333B" />
    <SolidColorBrush x:Key="EmuCoverBorderBrush" Color="#2A2A31" />
    <SolidColorBrush x:Key="EmuTextPrimaryBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="EmuTextSecondaryBrush" Color="#B4B6C0" />
    <SolidColorBrush x:Key="EmuTextTertiaryBrush" Color="#7E808C" />
    <SolidColorBrush x:Key="EmuHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="EmuNavSelectionBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="EmuNavIconWellBrush" Color="#1C1C22" />
    <SolidColorBrush x:Key="EmuNavIconBorderBrush" Color="#33333B" />
    <SolidColorBrush x:Key="EmuAccentBrush" Color="#5A8CFF" />
    <SolidColorBrush x:Key="EmuAccentMutedBrush" Color="#305A8CFF" />
    <SolidColorBrush x:Key="EmuSelectionBrush" Color="#5A8CFF" />
    <SolidColorBrush x:Key="EmuAchievementBrush" Color="#F0BD55" />
    <SolidColorBrush x:Key="EmuInfoBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuProgressBrush" Color="#6EBCE1" />
    <SolidColorBrush x:Key="EmuSuccessBrush" Color="#58D3A0" />
    <SolidColorBrush x:Key="EmuWarningBrush" Color="#F0AE54" />
    <SolidColorBrush x:Key="EmuDangerBrush" Color="#FF6673" />
    <BoxShadows x:Key="EmuFocusGlow">0 0 26 2 #705A8CFF</BoxShadows>
</ResourceDictionary>
