<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        x:Class="EmuShelf.App.Views.RescanRemovalsWindow"
        x:DataType="vm:RescanRemovalsViewModel"
        Title="Remove missing games"
        Icon="avares://EmuShelf.UI/Assets/emushelf.ico"
        Width="460" SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Text="Remove missing games?"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
        <Border Background="{DynamicResource EmuControlBackgroundBrush}"
                CornerRadius="6"
                Padding="12,8"
                MaxHeight="240">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Titles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2"
                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Keep them" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Remove" Command="{Binding ConfirmCommand}"
                    IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
