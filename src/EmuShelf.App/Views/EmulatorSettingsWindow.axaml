<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="620"
        x:Class="EmuShelf.App.Views.EmulatorSettingsWindow"
        x:DataType="vm:EmulatorSettingsViewModel"
        Title="Settings"
        Width="780" Height="620"
        MinWidth="640" MinHeight="440"
        CanResize="True"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ToggleButton.platform-header">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.platform-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.platform-header:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Spacing="5">
                <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                <TextBlock Text="Configure emulator launching, metadata, and imported library folders."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                <TextBlock Text="Placeholders: {GamePath}, {GameDirectory}, {GameFileName}, {EmulatorDirectory}, {CorePath}"
                           FontFamily="Monospace" FontSize="11"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="196,*">
            <Border Grid.Column="0" Background="{DynamicResource EmuSidebarBrush}"
                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="10,14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13.5" Padding="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" Background="{DynamicResource EmuLibraryBrush}">
                <Panel Margin="24,20,24,12">
                    <StackPanel IsVisible="{Binding IsGeneralSection}" Spacing="4">
                <Border Background="{DynamicResource EmuCardBrush}"
                        BorderBrush="{DynamicResource EmuBorderBrush}"
                        BorderThickness="1" CornerRadius="9"
                        Padding="16" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="LIBRARY MAINTENANCE" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Recheck every console's remembered folders. Individual rescans live inside each platform below."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Content="Rescan all consoles"
                                Command="{Binding RescanAllCommand}"
                                IsEnabled="{Binding CanRescanAll}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding MaintenanceStatusText}"
                                   IsVisible="{Binding HasMaintenanceStatus}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    </Grid>
                </Border>
                <Border Background="{DynamicResource EmuCardBrush}"
                        BorderBrush="{DynamicResource EmuBorderBrush}"
                        BorderThickness="1" CornerRadius="9"
                        Padding="16" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="METADATA AND ARTWORK" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Titles and individual covers are downloaded only after you opt in. Game files and paths are never uploaded."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      OnContent="Automatic" OffContent="Manual"
                                      IsChecked="{Binding AutomaticallyFetchMetadataAfterImport, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="0"
                                    Orientation="Horizontal" Spacing="10">
                            <HyperlinkButton Content="Libretro sources"
                                             NavigateUri="https://github.com/libretro/libretro-database"
                                             Padding="0" />
                            <HyperlinkButton Content="xlenore PS1/PS2 covers"
                                             NavigateUri="https://github.com/xlenore"
                                             Padding="0" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Fetch missing metadata"
                                Command="{Binding FetchAllMetadataCommand}"
                                IsEnabled="{Binding CanFetchAllMetadata}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding MetadataStatusText}"
                                   IsVisible="{Binding HasMetadataStatus}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"
                                    IsVisible="{Binding HasMetadataProgress}">
                            <ProgressBar Minimum="0" Maximum="{Binding MetadataProgressTotal}"
                                         Value="{Binding MetadataProgressCompleted}" Height="6" />
                            <TextBlock Text="{Binding MetadataProgressText}" FontSize="11"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsEmulatorsSection}" Spacing="4">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmulatorSettingsRowViewModel">
                            <Border Background="{DynamicResource EmuCardBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Margin="0,0,0,12" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,Auto">
                                    <ToggleButton Grid.Row="0" Classes="platform-header"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                        <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                                            <Grid Grid.Column="0" Width="30" Height="30">
                                                <Image Width="24" Height="24"
                                                       Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                       RenderOptions.BitmapInterpolationMode="None" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SystemName}" FontWeight="SemiBold"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding EmulatorName, StringFormat='— {0}'}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="20" Height="20"
                                                   VerticalAlignment="Center">
                                                <PathIcon Width="12" Height="12"
                                                          IsVisible="{Binding !IsExpanded}"
                                                          Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                          Data="M6,3 L13,10 L6,17 L4.5,15.5 L10,10 L4.5,4.5 Z" />
                                                <PathIcon Width="12" Height="12"
                                                          IsVisible="{Binding IsExpanded}"
                                                          Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                          Data="M3,6 L10,13 L17,6 L15.5,4.5 L10,10 L4.5,4.5 Z" />
                                            </Panel>
                                        </Grid>
                                    </ToggleButton>

                                    <StackPanel Grid.Row="1" IsVisible="{Binding IsExpanded}"
                                                Margin="16,0,16,16" Spacing="9">
                                        <Border Height="1" Background="{DynamicResource EmuBorderBrush}"
                                                Margin="0,0,0,5" />
                                        <TextBlock Text="{Binding ExecutableDescription}" FontSize="10" FontWeight="SemiBold"
                                                   LetterSpacing="0.7"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding ExecutablePath, Mode=TwoWay}"
                                                     Background="{DynamicResource EmuInputBrush}"
                                                     BorderBrush="{DynamicResource EmuBorderBrush}"
                                                     PlaceholderText="Not configured" />
                                            <Button Grid.Column="1" Content="Browse…"
                                                    Command="{Binding BrowseCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="LAUNCH ARGUMENTS" FontSize="10"
                                                       FontWeight="SemiBold" LetterSpacing="0.7"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Reset default"
                                                    Command="{Binding ResetArgumentsCommand}"
                                                    Padding="8,3" FontSize="11" />
                                        </Grid>
                                        <TextBox Text="{Binding LaunchArguments, Mode=TwoWay}"
                                                 Background="{DynamicResource EmuInputBrush}"
                                                 BorderBrush="{DynamicResource EmuBorderBrush}"
                                                 FontFamily="Monospace" />
                                        <StackPanel IsVisible="{Binding RequiresCorePath}" Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="RETROARCH CORE" FontSize="10" FontWeight="SemiBold"
                                                           LetterSpacing="0.7"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Clear"
                                                        Command="{Binding ClearCoreCommand}"
                                                        Padding="8,3" FontSize="11" />
                                            </Grid>
                                            <TextBox Text="{Binding CoreSearchText, Mode=TwoWay}"
                                                     Background="{DynamicResource EmuInputBrush}"
                                                     BorderBrush="{DynamicResource EmuBorderBrush}"
                                                     PlaceholderText="Filter installed cores" />
                                            <Border Height="132"
                                                    Background="{DynamicResource EmuInputBrush}"
                                                    BorderBrush="{DynamicResource EmuBorderBrush}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <ListBox ItemsSource="{Binding FilteredCores}"
                                                         SelectedItem="{Binding SelectedCore, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource EmuTextPrimaryBrush}"
                                                         Padding="3">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="6,3" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                            <TextBlock Text="Lists installed cores beside the configured RetroArch executable. EmuShelf never downloads or changes RetroArch cores or settings."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,5,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding MaintenanceStatusText}"
                                                       IsVisible="{Binding HasMaintenanceStatus}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <Button Grid.Column="1" Content="Sync RPCS3 library"
                                                    IsVisible="{Binding HasSyncLibrary}"
                                                    Command="{Binding SyncLibraryCommand}"
                                                    IsEnabled="{Binding CanSyncLibrary}"
                                                    ToolTip.Tip="Read the explicitly selected RPCS3 games.yml without changing it" />
                                            <Button Grid.Column="2" Content="Rescan library"
                                                    IsVisible="{Binding HasRescanLibrary}"
                                                    Command="{Binding RescanLibraryCommand}"
                                                    IsEnabled="{Binding CanRescan}"
                                                    ToolTip.Tip="Recheck this console's remembered folders" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsRetroAchievementsSection}" Spacing="12">
                        <Border Background="{DynamicResource EmuCardBrush}"
                                BorderBrush="{DynamicResource EmuBorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="18">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="RETROACHIEVEMENTS" FontSize="10"
                                               FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                               Text="Connect with your username and Web API key to see which games have achievements and your progress. EmuShelf only reads your progress — your emulator still unlocks achievements." />
                                </StackPanel>

                                <Grid IsVisible="{Binding IsRetroAchievementsConnected}"
                                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Connected" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ConnectedAccountName}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RefreshRetroAchievementsMatchesButton"
                                            Grid.Column="1" Content="Refresh matches"
                                            IsVisible="{Binding HasRetroAchievementsMatchRefresh}"
                                            VerticalAlignment="Center"
                                            Command="{Binding RefreshRetroAchievementsMatchesCommand}"
                                            IsEnabled="{Binding CanRefreshRetroAchievementsMatches}"
                                            ToolTip.Tip="Refresh RetroAchievements catalogues and retry every known game match. Unchanged ROMs are not rehashed." />
                                    <Button Grid.Column="2" Content="Disconnect" VerticalAlignment="Center"
                                            Command="{Binding DisconnectRetroAchievementsCommand}"
                                            IsEnabled="{Binding !IsRetroAchievementsBusy}" />
                                </Grid>

                                <StackPanel IsVisible="{Binding IsRetroAchievementsDisconnected}" Spacing="9">
                                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding RetroAchievementsUsername, Mode=TwoWay}"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="Your RetroAchievements username" />
                                    <TextBlock Text="WEB API KEY" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding RetroAchievementsApiKey, Mode=TwoWay}"
                                             PasswordChar="●"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="From your RA control panel → Keys" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                                        <HyperlinkButton Grid.Column="0" Content="Where's my Web API key?"
                                                         NavigateUri="https://retroachievements.org/controlpanel.php"
                                                         Padding="0" VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" />
                                        <Button Grid.Column="1" Content="Connect" Classes="accent"
                                                Command="{Binding ConnectRetroAchievementsCommand}"
                                                IsEnabled="{Binding !IsRetroAchievementsBusy}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasRetroAchievementsProgress}" Spacing="5">
                                    <TextBlock Text="{Binding RetroAchievementsProgressText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <ProgressBar Minimum="0"
                                                 Maximum="{Binding RetroAchievementsProgressTotal}"
                                                 Value="{Binding RetroAchievementsProgressCompleted}"
                                                 Height="6" />
                                </StackPanel>

                                <TextBlock Text="{Binding RetroAchievementsStatusText}"
                                           IsVisible="{Binding HasRetroAchievementsStatus}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource EmuDangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding !IsWorking}" />
                    <Button Content="Save" Classes="accent" IsDefault="True"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding !IsWorking}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
