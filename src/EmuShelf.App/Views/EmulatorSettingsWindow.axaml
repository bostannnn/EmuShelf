<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
        x:Class="EmuShelf.App.Views.EmulatorSettingsWindow"
        x:DataType="vm:EmulatorSettingsViewModel"
        Title="Settings"
        Icon="avares://EmuShelf/Assets/emushelf.ico"
        Width="880" Height="700"
        MinWidth="760" MinHeight="540"
        CanResize="True"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- One heading system for the whole window. section-eyebrow is the small all-caps label
             that leads every section/card; field-label is the slightly softer label above an input. -->
        <Style Selector="TextBlock.section-eyebrow">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <!-- One card token for every section panel, so padding and radius can't drift. -->
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="ToggleButton.platform-header">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.platform-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.platform-header:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.theme-card">
            <Setter Property="Margin" Value="6,0,6,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.theme-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
        </Style>
        <Style Selector="Button.theme-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Spacing="5">
                <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                <TextBlock Text="{Binding SectionSubtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="196,*">
            <Border Grid.Column="0" Background="{DynamicResource EmuSidebarBrush}"
                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="10,14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:SettingsSectionLabel.Converter}}"
                                       FontSize="13.5" Padding="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" Background="{DynamicResource EmuLibraryBrush}">
                <Panel Margin="24,20,24,12">
                    <StackPanel IsVisible="{Binding IsGeneralSection}">
                <Border Classes="settings-card" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="PLATFORM NAVIGATION" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Empty platforms stay available when adding games and configuring emulators. Platforms with temporarily unavailable games remain visible."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="general.empty-platforms"
                                      OnContent="Show empty" OffContent="Hide empty"
                                      IsChecked="{Binding ShowEmptyPlatforms, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="settings-card" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="LIBRARY MAINTENANCE" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Recheck every console's remembered folders. Individual rescans live inside each platform below."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Content="Rescan all consoles"
                                AutomationProperties.AutomationId="general.rescan"
                                Command="{Binding RescanAllCommand}"
                                IsEnabled="{Binding CanRescanAll}"
                                VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                            <!-- A rescan has no unit total to count, so it shows an indeterminate bar
                                 while it runs — the same "working" affordance the metadata, cloud, and
                                 account actions give — over its live per-console status line. -->
                            <ProgressBar IsIndeterminate="True" Height="4"
                                         IsVisible="{Binding IsRescanningAllConsoles}" />
                            <TextBlock Text="{Binding MaintenanceStatusText}"
                                       IsVisible="{Binding HasMaintenanceStatus}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="settings-card" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="METADATA AND ARTWORK" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Titles and individual covers are downloaded only after you opt in. Game files and paths are never uploaded."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      AutomationProperties.AutomationId="general.metadata-auto"
                                      OnContent="Automatic" OffContent="Manual"
                                      IsChecked="{Binding AutomaticallyFetchMetadataAfterImport, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="0"
                                    Orientation="Horizontal" Spacing="10">
                            <HyperlinkButton Content="Libretro sources"
                                             NavigateUri="https://github.com/libretro/libretro-database"
                                             Padding="0" />
                            <HyperlinkButton Content="xlenore PS1/PS2 covers"
                                             NavigateUri="https://github.com/xlenore"
                                             Padding="0" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="1"
                                AutomationProperties.AutomationId="general.fetch-metadata"
                                Content="Fetch missing metadata"
                                Command="{Binding FetchAllMetadataCommand}"
                                IsEnabled="{Binding CanFetchAllMetadata}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding MetadataStatusText}"
                                   IsVisible="{Binding HasMetadataStatus}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"
                                    IsVisible="{Binding HasMetadataProgress}">
                            <ProgressBar Minimum="0" Maximum="{Binding MetadataProgressTotal}"
                                         Value="{Binding MetadataProgressCompleted}" Height="6" />
                            <TextBlock Text="{Binding MetadataProgressText}" FontSize="11"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="settings-card" Margin="0,0,0,12"
                        IsVisible="{Binding HasDataDirectory}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="DATA FOLDER" FontSize="10"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            <TextBlock Text="Your library database, covers, settings, and saves live here. EmuShelf never touches your game files."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Content="Open data folder"
                                AutomationProperties.AutomationId="general.open-data-folder"
                                Command="{Binding OpenDataFolderCommand}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DataDirectory}"
                                   FontFamily="Monospace" FontSize="11" TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding DataDirectory}"
                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding DataFolderStatusText}"
                                   IsVisible="{Binding HasDataFolderStatus}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    </Grid>
                </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsEmulatorsSection}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmulatorSettingsRowViewModel">
                            <Border Classes="settings-card" Padding="0"
                                    Margin="0,0,0,12" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,Auto">
                                    <ToggleButton Grid.Row="0" Classes="platform-header"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                <Image Width="32" Height="32"
                                                       Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                       RenderOptions.BitmapInterpolationMode="None" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SystemName}" FontWeight="SemiBold"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding EmulatorName, StringFormat='— {0}'}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="20" Height="20"
                                                   VerticalAlignment="Center">
                                                <PathIcon Width="12" Height="12"
                                                          IsVisible="{Binding !IsExpanded}"
                                                          Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                          Data="M6,3 L13,10 L6,17 L4.5,15.5 L10,10 L4.5,4.5 Z" />
                                                <PathIcon Width="12" Height="12"
                                                          IsVisible="{Binding IsExpanded}"
                                                          Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                          Data="M3,6 L10,13 L17,6 L15.5,4.5 L10,10 L4.5,4.5 Z" />
                                            </Panel>
                                        </Grid>
                                    </ToggleButton>

                                    <StackPanel Grid.Row="1" IsVisible="{Binding IsExpanded}"
                                                Margin="18,0,18,16" Spacing="9">
                                        <Border Height="1" Background="{DynamicResource EmuBorderBrush}"
                                                Margin="0,0,0,5" />
                                        <StackPanel Spacing="5" IsVisible="{Binding HasMultipleProfiles}">
                                            <TextBlock Text="EMULATOR" FontSize="10" FontWeight="SemiBold"
                                                       LetterSpacing="0.7"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      Background="{DynamicResource EmuInputBrush}"
                                                      BorderBrush="{DynamicResource EmuBorderBrush}">
                                                <ComboBox.ItemTemplate>
                                                    <!-- Reflection binding (no x:DataType), matching the cores list template below;
                                                         the item is an EmulatorSettingsRowViewModel.EmulatorProfileOption. -->
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding EmulatorName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Text="LAUNCH TARGET" FontSize="10" FontWeight="SemiBold"
                                                   IsVisible="{Binding IsLaunchTargetPickerVisible}"
                                                   LetterSpacing="0.7"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <ComboBox SelectedItem="{Binding TargetKind, Mode=TwoWay}"
                                                  IsVisible="{Binding IsLaunchTargetPickerVisible}">
                                            <x:String>Direct</x:String>
                                            <x:String>Flatpak</x:String>
                                        </ComboBox>
                                        <TextBlock Text="{Binding DirectTargetLabel}" FontSize="10" FontWeight="SemiBold"
                                                   LetterSpacing="0.7" IsVisible="{Binding IsDirectTarget}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding ExecutablePath, Mode=TwoWay}"
                                                     AutomationProperties.AutomationId="{Binding ExecutableFieldId}"
                                                     IsVisible="{Binding IsDirectTarget}"
                                                     Background="{DynamicResource EmuInputBrush}"
                                                     BorderBrush="{DynamicResource EmuBorderBrush}"
                                                     PlaceholderText="Not configured" />
                                            <Button Grid.Column="1" Content="Browse…"
                                                    AutomationProperties.AutomationId="{Binding BrowseFieldId}"
                                                    IsVisible="{Binding IsDirectTarget}"
                                                    Command="{Binding BrowseCommand}" />
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding AvailableFlatpakApplicationIds}"
                                                  SelectedItem="{Binding FlatpakAppId, Mode=TwoWay}"
                                                  IsEditable="True"
                                                 IsVisible="{Binding IsEditableFlatpakTarget}"
                                                 Background="{DynamicResource EmuInputBrush}"
                                                 BorderBrush="{DynamicResource EmuBorderBrush}"
                                                 PlaceholderText="Installed Flatpak or manual app id" />
                                        <Border IsVisible="{Binding IsUnsupportedFlatpakTarget}"
                                                Background="{DynamicResource EmuInputBrush}"
                                                BorderBrush="{DynamicResource EmuDangerBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="11">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding UnsupportedFlatpakTargetMessage}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                <Button Content="Use direct executable"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding UseDirectTargetCommand}" />
                                            </StackPanel>
                                        </Border>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="LAUNCH ARGUMENTS" FontSize="10"
                                                       FontWeight="SemiBold" LetterSpacing="0.7"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Reset default"
                                                    AutomationProperties.AutomationId="{Binding ResetArgumentsFieldId}"
                                                    Command="{Binding ResetArgumentsCommand}"
                                                    Padding="8,3" FontSize="11" />
                                        </Grid>
                                        <TextBox Text="{Binding LaunchArguments, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding LaunchArgumentsFieldId}"
                                                 Background="{DynamicResource EmuInputBrush}"
                                                 BorderBrush="{DynamicResource EmuBorderBrush}"
                                                 FontFamily="Monospace" />
                                        <TextBlock Text="Placeholders: {GamePath}, {GameDirectory}, {GameFileName}, {EmulatorDirectory}, {CorePath}"
                                                   FontFamily="Monospace" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                        <StackPanel IsVisible="{Binding RequiresCorePath}" Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="RETROARCH CORE" FontSize="10" FontWeight="SemiBold"
                                                           LetterSpacing="0.7"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Clear"
                                                        Command="{Binding ClearCoreCommand}"
                                                        Padding="8,3" FontSize="11" />
                                            </Grid>
                                            <TextBox Text="{Binding CoreSearchText, Mode=TwoWay}"
                                                     AutomationProperties.AutomationId="{Binding CoreFilterFieldId}"
                                                     Background="{DynamicResource EmuInputBrush}"
                                                     BorderBrush="{DynamicResource EmuBorderBrush}"
                                                     PlaceholderText="Filter installed cores" />
                                            <Border Height="132"
                                                    Background="{DynamicResource EmuInputBrush}"
                                                    BorderBrush="{DynamicResource EmuBorderBrush}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <ListBox ItemsSource="{Binding FilteredCores}"
                                                         SelectedItem="{Binding SelectedCore, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource EmuTextPrimaryBrush}"
                                                         Padding="3">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="6,3" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                            <TextBlock Text="Lists cores already installed in RetroArch (download cores in RetroArch first). EmuShelf never downloads or changes RetroArch cores or settings."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding HasFolderManagement}"
                                                    IsEnabled="{Binding CanManageLibraryFolders}"
                                                    Spacing="7" Margin="0,5,0,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="GAME FOLDERS" FontSize="10" FontWeight="SemiBold"
                                                               LetterSpacing="0.7"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    <TextBlock Text="Recursive folders remembered for this platform's rescans."
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Add folder…"
                                                        AutomationProperties.AutomationId="{Binding AddFolderFieldId}"
                                                        Command="{Binding AddLibraryFolderCommand}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="No folders remembered. Add one here or from the library toolbar."
                                                       IsVisible="{Binding !HasRememberedFolders}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            <ItemsControl ItemsSource="{Binding LibraryFolders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LibraryFolderRowViewModel">
                                                        <Border Background="{DynamicResource EmuInputBrush}"
                                                                BorderBrush="{DynamicResource EmuBorderBrush}"
                                                                BorderThickness="1" CornerRadius="6"
                                                                Padding="10" Margin="0,0,0,5">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="{Binding Path}" FontFamily="Monospace"
                                                                               FontSize="11" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding AvailabilityText}" FontSize="10"
                                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="Change…"
                                                                        Command="{Binding ChangeCommand}"
                                                                        VerticalAlignment="Center" />
                                                                <Button Grid.Column="2" Content="Forget"
                                                                        Command="{Binding ForgetCommand}"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="Stop rescanning this folder; games and files stay in the library" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,5,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding MaintenanceStatusText}"
                                                       IsVisible="{Binding HasMaintenanceStatus}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <Button Grid.Column="1" Content="Sync RPCS3 library"
                                                    AutomationProperties.AutomationId="{Binding SyncFieldId}"
                                                    IsVisible="{Binding HasSyncLibrary}"
                                                    Command="{Binding SyncLibraryCommand}"
                                                    IsEnabled="{Binding CanSyncLibrary}"
                                                    ToolTip.Tip="Read the explicitly selected RPCS3 games.yml without changing it" />
                                            <Button Grid.Column="2" Content="Rescan library"
                                                    AutomationProperties.AutomationId="{Binding RescanFieldId}"
                                                    IsVisible="{Binding HasRescanLibrary}"
                                                    Command="{Binding RescanLibraryCommand}"
                                                    IsEnabled="{Binding CanRescan}"
                                                    ToolTip.Tip="Recheck this console's remembered folders" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsRetroAchievementsSection}" Spacing="12">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="RETROACHIEVEMENTS" FontSize="10"
                                               FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                               Text="Connect with your username and Web API key to see which games have achievements and your progress. EmuShelf only reads your progress — your emulator still unlocks achievements." />
                                </StackPanel>

                                <Grid IsVisible="{Binding IsRetroAchievementsConnected}"
                                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Connected" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ConnectedAccountName}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RefreshRetroAchievementsMatchesButton"
                                            AutomationProperties.AutomationId="retro.refresh"
                                            Grid.Column="1" Content="Refresh matches"
                                            IsVisible="{Binding HasRetroAchievementsMatchRefresh}"
                                            VerticalAlignment="Center"
                                            Command="{Binding RefreshRetroAchievementsMatchesCommand}"
                                            IsEnabled="{Binding CanRefreshRetroAchievementsMatches}"
                                            ToolTip.Tip="Refresh RetroAchievements catalogues and retry every known game match. Unchanged ROMs are not rehashed." />
                                    <Button Grid.Column="2" Content="Disconnect" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="retro.disconnect"
                                            Command="{Binding DisconnectRetroAchievementsCommand}"
                                            IsEnabled="{Binding !IsRetroAchievementsBusy}" />
                                </Grid>

                                <StackPanel IsVisible="{Binding IsRetroAchievementsDisconnected}" Spacing="9">
                                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding RetroAchievementsUsername, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="retro.username"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="Your RetroAchievements username" />
                                    <TextBlock Text="WEB API KEY" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding RetroAchievementsApiKey, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="retro.api-key"
                                             PasswordChar="●"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="From your RA control panel → Keys" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                                        <HyperlinkButton Grid.Column="0" Content="Where's my Web API key?"
                                                         NavigateUri="https://retroachievements.org/controlpanel.php"
                                                         Padding="0" VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" />
                                        <Button Grid.Column="1" Content="Connect" Classes="accent"
                                                AutomationProperties.AutomationId="retro.connect"
                                                Command="{Binding ConnectRetroAchievementsCommand}"
                                                IsEnabled="{Binding !IsRetroAchievementsBusy}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasRetroAchievementsProgress}" Spacing="5">
                                    <TextBlock Text="{Binding RetroAchievementsProgressText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <ProgressBar Minimum="0"
                                                 Maximum="{Binding RetroAchievementsProgressTotal}"
                                                 Value="{Binding RetroAchievementsProgressCompleted}"
                                                 Height="6" />
                                </StackPanel>

                                <TextBlock Text="{Binding RetroAchievementsStatusText}"
                                           IsVisible="{Binding HasRetroAchievementsStatus}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsScreenScraperSection}" Spacing="12">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SCREENSCRAPER" FontSize="10"
                                               FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                               Text="Connect your screenscraper.fr account to fetch game metadata and artwork. Right-click a game to scrape it, or select several to batch scrape." />
                                </StackPanel>

                                <Grid IsVisible="{Binding IsScreenScraperConnected}"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Connected" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ScreenScraperConnectedName}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Disconnect" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="scraper.disconnect"
                                            Command="{Binding DisconnectScreenScraperCommand}"
                                            IsEnabled="{Binding !IsScreenScraperBusy}" />
                                </Grid>

                                <StackPanel IsVisible="{Binding IsScreenScraperDisconnected}" Spacing="9">
                                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding ScreenScraperUsername, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="scraper.username"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="Your screenscraper.fr username" />
                                    <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBox Text="{Binding ScreenScraperPassword, Mode=TwoWay}"
                                             PasswordChar="●"
                                             AutomationProperties.AutomationId="scraper.password"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="Your screenscraper.fr password" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                                        <ProgressBar Grid.Column="0" IsIndeterminate="True" Height="3"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsScreenScraperBusy}" />
                                        <Button Grid.Column="1" Content="Connect" Classes="accent"
                                                AutomationProperties.AutomationId="scraper.connect"
                                                Command="{Binding ConnectScreenScraperCommand}"
                                                IsEnabled="{Binding !IsScreenScraperBusy}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding ScreenScraperStatusText}"
                                           IsVisible="{Binding HasScreenScraperStatus}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSavesSection}" Spacing="12">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-eyebrow" Text="CLOUD SAVE SYNC" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                               Text="Sync in-game saves between machines through your own Google Drive. Sign-in is handled by rclone — EmuShelf never sees your Google password or token." />
                                    <Expander Header="How save sync works" Padding="0" Margin="0,2,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                                   Text="In-game saves and opted-in, version-guarded save states sync before launch and after exit. Launch waits for the complete sync; a failure is advisory and uses the data currently on disk. Cheats and patches are not synced — on most emulators that folder holds the community database the emulator ships and can redownload, not your own files. Close externally launched emulators before a manual sync." />
                                    </Expander>
                                </StackPanel>

                                <Border IsVisible="{Binding IsRcloneMissing}"
                                        Background="{DynamicResource EmuInputBrush}"
                                        BorderBrush="{DynamicResource EmuDangerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}"
                                                   Text="rclone isn't installed, and cloud sync needs it. Download it automatically, or place the rclone executable at the exact path below and reopen Settings." />
                                        <TextBlock Text="{Binding RcloneExpectedPath, StringFormat='Expected at: {0}'}"
                                                   FontFamily="Monospace" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="Download rclone" Classes="accent"
                                                    AutomationProperties.AutomationId="saves.rclone"
                                                    Command="{Binding DownloadRcloneCommand}"
                                                    IsEnabled="{Binding !IsDownloadingRclone}" />
                                            <HyperlinkButton Content="Or get it manually"
                                                             NavigateUri="https://rclone.org/downloads/"
                                                             VerticalAlignment="Center" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Connection comes first: the Connect action (or, once connected,
                                     the remote summary + Sync all now) sits above the per-platform
                                     folder list, which is detail you set up once sync is on. -->
                                <StackPanel IsVisible="{Binding IsCloudDisconnected}" Spacing="9">
                                    <TextBlock Text="RCLONE REMOTE NAME" Classes="field-label" />
                                    <TextBox Text="{Binding CloudRemoteName, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="saves.remote"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="emushelf-gdrive" />
                                    <TextBlock Text="CLOUD FOLDER" Classes="field-label" />
                                    <TextBox Text="{Binding CloudFolder, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="saves.cloud-folder"
                                             Background="{DynamicResource EmuInputBrush}"
                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                             PlaceholderText="EmuShelf/Saves" />
                                    <Button Content="Connect Google Drive" Classes="accent"
                                            AutomationProperties.AutomationId="saves.connect"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ConnectCloudCommand}"
                                            IsEnabled="{Binding !IsCloudBusy}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsCloudConnected}" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Connected" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding CloudRemoteName, StringFormat='Remote: {0}'}"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Disconnect" VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="saves.disconnect"
                                                Command="{Binding DisconnectCloudCommand}"
                                                IsEnabled="{Binding !IsCloudBusy}" />
                                    </Grid>
                                    <Button Content="Sync all now" Classes="accent"
                                            AutomationProperties.AutomationId="saves.sync"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SyncCloudNowCommand}"
                                            IsEnabled="{Binding !IsCloudBusy}" />
                                </StackPanel>

                                <!-- One row per registered save platform. Adding a provider adds a
                                     row here automatically; this template names no emulator. -->
                                <ItemsControl ItemsSource="{Binding CloudPlatforms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudSavePlatformRowViewModel">
                                            <!-- Grouped per platform: a Saves block (folder + its detected
                                                 path/warning + replace actions) then a visually separated
                                                 Save states block (toggle + folder + its detected path), so
                                                 each control sits next to the text that describes it. -->
                                            <StackPanel Spacing="12" Margin="0,0,0,12">
                                                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                            Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                        <Image Width="32" Height="32"
                                                               Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding SaveShapeDescription}"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Saves group -->
                                                <StackPanel Margin="54,0,0,0" Spacing="7">
                                                    <TextBlock Classes="field-label" Text="SAVES" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBox Grid.Column="0" Text="{Binding OverrideDirectory, Mode=TwoWay}"
                                                                 AutomationProperties.AutomationId="{Binding FolderFieldId}"
                                                                 Background="{DynamicResource EmuInputBrush}"
                                                                 BorderBrush="{DynamicResource EmuBorderBrush}"
                                                                 PlaceholderText="{Binding OverridePlaceholder}" />
                                                        <Button Grid.Column="1" Content="Browse…"
                                                                AutomationProperties.AutomationId="{Binding FolderFieldId}"
                                                                Command="{Binding PickDirectoryCommand}"
                                                                IsEnabled="{Binding IsIdle}" />
                                                    </Grid>
                                                    <!-- Replace actions live on their own row so the path field never
                                                         collapses at narrow widths; they apply only once connected. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding IsCloudConnected}">
                                                        <Button Content="Replace cloud"
                                                                AutomationProperties.AutomationId="{Binding ReplaceCloudFieldId}"
                                                                Command="{Binding ReplaceCloudCommand}"
                                                                IsEnabled="{Binding CanReplace}"
                                                                ToolTip.Tip="Replace only this platform's cloud saves; overwritten cloud copies are backed up" />
                                                        <Button Content="Replace local"
                                                                AutomationProperties.AutomationId="{Binding ReplaceLocalFieldId}"
                                                                Command="{Binding ReplaceLocalCommand}"
                                                                IsEnabled="{Binding CanReplace}"
                                                                ToolTip.Tip="Replace only this platform's local saves; overwritten local copies are backed up" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DetectedDirectory, StringFormat='Syncing {0}'}"
                                                               IsVisible="{Binding HasDetectedDirectory}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding CompatibilityWarning}"
                                                               IsVisible="{Binding HasCompatibilityWarning}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DetectionErrorText}"
                                                               IsVisible="{Binding HasDetectionError}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuDangerBrush}" />
                                                </StackPanel>

                                                <!-- Save states group, separated from Saves so its folder and
                                                     detected path stay together instead of interleaving. -->
                                                <StackPanel Margin="54,0,0,0" Spacing="7"
                                                            IsVisible="{Binding HasOptionalContent}">
                                                    <Border Height="1" Margin="0,3,0,3"
                                                            Background="{DynamicResource EmuBorderBrush}" />
                                                    <TextBlock Text="SAVE STATES" FontSize="10" FontWeight="SemiBold"
                                                               LetterSpacing="0.7"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    <CheckBox Content="Automatically sync save states"
                                                              AutomationProperties.AutomationId="{Binding SaveStatesFieldId}"
                                                              IsVisible="{Binding SupportsSaveStates}"
                                                              IsChecked="{Binding SyncSaveStates, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsIdle}"
                                                              ToolTip.Tip="Only states from the same emulator version and CPU architecture are restored" />
                                                    <TextBlock Text="Manual states sync before launch, after exit, and during manual actions. Automatic, resume, undo, and backup states are excluded."
                                                               IsVisible="{Binding SupportsSaveStates}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <!-- Save states get their own folder override, mirroring the
                                                         save folder above, so a mis-detected state folder can be
                                                         corrected the same way. -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                                          IsVisible="{Binding SyncSaveStates}">
                                                        <TextBox Grid.Column="0" Text="{Binding StateOverrideDirectory, Mode=TwoWay}"
                                                                 AutomationProperties.AutomationId="{Binding StateFolderFieldId}"
                                                                 Background="{DynamicResource EmuInputBrush}"
                                                                 BorderBrush="{DynamicResource EmuBorderBrush}"
                                                                 PlaceholderText="Use the detected save-state folder, or choose one" />
                                                        <Button Grid.Column="1" Content="Browse…"
                                                                AutomationProperties.AutomationId="{Binding StateFolderFieldId}"
                                                                Command="{Binding PickStateDirectoryCommand}"
                                                                IsEnabled="{Binding IsIdle}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding OptionalContentSummary}"
                                                               IsVisible="{Binding HasOptionalContentSummary}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                </StackPanel>

                                                <!-- Platform-level sync outcome -->
                                                <StackPanel Margin="54,0,0,0" Spacing="7">
                                                    <TextBlock Text="{Binding LastResultText}"
                                                               IsVisible="{Binding HasLastResult}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding LastNoticeText}"
                                                               IsVisible="{Binding HasLastNotice}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel IsVisible="{Binding HasCloudSyncProgress}" Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding CloudSyncProgressText}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Button Grid.Column="1" Content="Stop"
                                                AutomationProperties.AutomationId="saves.stop"
                                                Command="{Binding CancelCloudSyncCommand}"
                                                ToolTip.Tip="Stop the sync; saves already transferred stay in the cloud and the next sync continues from there" />
                                    </Grid>
                                    <ProgressBar Minimum="0"
                                                 Maximum="{Binding CloudSyncProgressTotal}"
                                                 Value="{Binding CloudSyncProgressCompleted}"
                                                 IsIndeterminate="{Binding IsCloudTransferIndeterminate}"
                                                 Height="6" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasSyncLog}" Spacing="3">
                                    <TextBlock Text="SYNC ACTIVITY" FontSize="10" FontWeight="SemiBold"
                                               LetterSpacing="0.7"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <HyperlinkButton Content="Open sync activity log"
                                                     NavigateUri="{Binding SyncLogUri}"
                                                     HorizontalAlignment="Left" Padding="0" />
                                    <TextBlock Text="{Binding SyncLogPath}"
                                               FontFamily="Monospace" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="The portable save-sync activity log"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Text="{Binding CloudStatusText}"
                                           IsVisible="{Binding HasCloudStatus}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsHotkeysSection}" Spacing="12">
                        <Border Classes="settings-card" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="KEYBOARD HOTKEYS" FontSize="10" FontWeight="Bold"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                <TextBlock Text="{Binding HotkeySchemeSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                           Text="EmuShelf backs up each file before changing it. Close an emulator before applying — changes take effect the next time you open it." />
                                <Button Content="Apply to all emulators"
                                        AutomationProperties.AutomationId="hotkeys.apply-all"
                                        Command="{Binding ApplyAllHotkeysCommand}"
                                        IsEnabled="{Binding !IsHotkeyBusy}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding HotkeyEmulators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="settings-card" Margin="0,0,0,12">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="Preview"
                                                            Command="{Binding PreviewCommand}"
                                                            IsEnabled="{Binding CanRun}" />
                                                    <Button Content="Apply"
                                                            Command="{Binding ApplyCommand}"
                                                            IsEnabled="{Binding CanRun}" />
                                                    <Button Content="Revert"
                                                            Command="{Binding RevertCommand}"
                                                            IsEnabled="{Binding CanRun}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,1"
                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTexturePacksSection}" Spacing="12">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-eyebrow" Text="TEXTURE PACKS" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}"
                                               Text="Shows the replacement-texture packs your emulators already have installed and matches them to your library. Read-only — EmuShelf never installs, moves, or deletes a pack, and never edits emulator settings." />
                                    <Expander Header="About matching" Padding="0" Margin="0,2,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                                   Text="Packs are matched to games by the exact identifier each emulator uses. A pack with no matching game is not a problem — the game may simply not be in your library." />
                                    </Expander>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding TexturePackSummary}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding TexturePackLastScanText}" FontSize="11"
                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Rescan"
                                            AutomationProperties.AutomationId="textures.rescan"
                                            VerticalAlignment="Top"
                                            Command="{Binding RescanTexturePacksCommand}"
                                            IsEnabled="{Binding !IsTexturePackBusy}" />
                                </Grid>

                                <ProgressBar IsIndeterminate="True" Height="4"
                                             IsVisible="{Binding IsTexturePackBusy}" />
                                <TextBlock Text="{Binding TexturePackStatusText}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />

                                <!-- One row per registered texture platform. Adding a provider adds a
                                     row here automatically; this template names no emulator. -->
                                <ItemsControl ItemsSource="{Binding TexturePlatforms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TexturePackRowViewModel">
                                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                            Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                        <Image Width="32" Height="32"
                                                               Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                                      Margin="54,0,0,0">
                                                    <TextBox Grid.Column="0" Text="{Binding DirectoryOverride}"
                                                             AutomationProperties.AutomationId="{Binding FolderFieldId}"
                                                             IsReadOnly="True"
                                                             Background="{DynamicResource EmuInputBrush}"
                                                             BorderBrush="{DynamicResource EmuBorderBrush}"
                                                             PlaceholderText="{Binding OverridePlaceholder}" />
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            AutomationProperties.AutomationId="{Binding FolderFieldId}"
                                                            Command="{Binding BrowseOverrideCommand}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="54,0,0,0">
                                                    <Button Content="Use detected"
                                                            AutomationProperties.AutomationId="{Binding DetectedFieldId}"
                                                            Command="{Binding UseDetectedCommand}" />
                                                    <Button Content="Open folder"
                                                            IsEnabled="{Binding CanOpenFolder}"
                                                            Command="{Binding OpenFolderCommand}" />
                                                </StackPanel>
                                                <TextBlock Margin="54,0,0,0" Text="{Binding DetectedRoot}"
                                                           IsVisible="{Binding CanOpenFolder}"
                                                           FontFamily="Monospace" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                <TextBlock Margin="54,0,0,0" Text="{Binding LoadingText}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Emulator" VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              AutomationProperties.AutomationId="textures.emulator-filter"
                                              ItemsSource="{Binding TextureEmulatorFilters}"
                                              SelectedItem="{Binding TextureEmulatorFilter, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Status" VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              AutomationProperties.AutomationId="textures.status-filter"
                                              ItemsSource="{Binding TextureStatusFilters}"
                                              SelectedItem="{Binding TextureStatusFilter, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock IsVisible="{Binding HasNoTexturePacks}" TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                           Text="No texture packs to show. Use Rescan after configuring an emulator, or change the filters above." />

                                <!-- The per-pack inventory can be hundreds of entries; the totals above are
                                     what most users need. Keep the full list collapsed and reveal it on
                                     demand, and virtualize it so an expanded large library stays responsive. -->
                                <Expander IsVisible="{Binding !HasNoTexturePacks}" IsExpanded="False"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding TexturePackEntries.Count, StringFormat='Installed pack details ({0})'}"
                                                   FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <ListBox ItemsSource="{Binding TexturePackEntries}"
                                             MaxHeight="620" HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TexturePackEntryViewModel">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0" Text="{Binding PackKey}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   ToolTip.Tip="{Binding StatusTooltip}"
                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding MatchedGames}"
                                                               IsVisible="{Binding HasMatchedGames}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SourcePath}"
                                                               FontFamily="Monospace" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsThemesSection}">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section-eyebrow" Text="APPEARANCE" />
                                    <TextBlock Text="Pick a theme. It applies instantly and is shared with Gamepad mode."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>
                                <Border Background="{DynamicResource EmuInputBrush}"
                                        BorderBrush="{DynamicResource EmuBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Match colours to game artwork"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                            <TextBlock Text="In Gamepad mode the interface recolours from the highlighted game. The theme above is the fallback."
                                                       FontSize="12" TextWrapping="Wrap" MaxWidth="460"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                      IsChecked="{Binding AmbientThemeFromArtwork, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ThemeChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Fill the row evenly instead of leaving a wide right gutter;
                                                 cards stretch to the column width. -->
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                                            <Button Classes="theme-card"
                                                    Classes.selected="{Binding IsSelected}"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding SelectCommand}">
                                                <StackPanel Spacing="10">
                                                    <Border CornerRadius="9" Height="96" ClipToBounds="True"
                                                            Background="{Binding PreviewBackground}"
                                                            BorderBrush="{DynamicResource EmuBorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding PreviewAccent}" />
                                                                <Ellipse Width="6" Height="6" Fill="{Binding PreviewText}" Opacity="0.4" />
                                                            </StackPanel>
                                                            <Grid Grid.Row="1" ColumnDefinitions="*,2.2*,*" ColumnSpacing="6">
                                                                <Border Background="{Binding PreviewSurface}" CornerRadius="5" />
                                                                <Border Grid.Column="1" Background="{Binding PreviewSurface}" CornerRadius="5">
                                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                                            Background="{Binding PreviewAccent}"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Grid.Column="2" Background="{Binding PreviewSurface}" CornerRadius="5" />
                                                            </Grid>
                                                            <Border Grid.Row="2" Width="22" Height="6" CornerRadius="3"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{Binding PreviewAccent}" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                                        <Border Grid.Column="1" IsVisible="{Binding IsSelected}"
                                                                Width="22" Height="22" CornerRadius="11"
                                                                Background="{DynamicResource EmuAccentBrush}">
                                                            <TextBlock Text="✓" FontSize="13" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource EmuWindowBackgroundBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAboutSection}">
                        <Border Classes="settings-card" Margin="0,0,0,12">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ABOUT" FontSize="10"
                                               FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                    <TextBlock Text="EmuShelf" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="20" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                               AutomationProperties.AutomationId="about.version"
                                               Text="{Binding AppVersionDisplay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last commit"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                               AutomationProperties.AutomationId="about.commit"
                                               Text="{Binding AppCommitDisplay}"
                                               FontFamily="Monospace" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Committed"
                                               IsVisible="{Binding HasCommitDate}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1"
                                               IsVisible="{Binding HasCommitDate}"
                                               AutomationProperties.AutomationId="about.commit-date"
                                               Text="{Binding AppCommitDateDisplay}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                </Grid>

                                <TextBlock Text="The version follows the newest release tag on GitHub; the commit is the exact source this build was compiled from."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card" IsVisible="{Binding HasUpdateChecker}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="UPDATES" FontSize="10" FontWeight="Bold"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                <TextBlock Text="EmuShelf checks GitHub for new releases and installs them in place, then restarts itself. Only the public releases page is contacted."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for updates"
                                            AutomationProperties.AutomationId="about.check-updates"
                                            Command="{Binding CheckForUpdatesCommand}" />
                                    <Button Content="Download &amp; restart" Classes="accent"
                                            AutomationProperties.AutomationId="about.install-update"
                                            IsVisible="{Binding IsUpdateAvailable}"
                                            Command="{Binding InstallUpdateCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap"
                                           FontSize="12" IsVisible="{Binding HasUpdateStatus}"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource EmuDangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            IsCancel="True"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Save" Classes="accent" IsDefault="True"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
