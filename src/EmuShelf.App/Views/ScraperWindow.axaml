<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        x:Class="EmuShelf.App.Views.ScraperWindow"
        x:DataType="vm:GameScraperViewModel"
        x:Name="ScraperRoot"
        Title="Scrape with ScreenScraper"
        Icon="avares://EmuShelf/Assets/emushelf.ico"
        Width="1040" Height="840" MinWidth="760" MinHeight="580"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding GameTitle}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource EmuTextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="ScreenScraper" FontSize="13"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <TextBlock Text="{Binding QuotaText}"
                       IsVisible="{Binding QuotaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="11" Foreground="{DynamicResource EmuTextTertiaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource EmuLibraryBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <Grid>
                <!-- Loading -->
                <StackPanel IsVisible="{Binding ShowLoading}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12" Width="320">
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock Text="{Binding StatusMessage}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>

                <!-- Message states (not connected / disabled / unsupported / no match / failure / applied) -->
                <StackPanel IsVisible="{Binding ShowMessage}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="15" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>

                <!-- Fingerprint consent (kept distinct so its call to action is prominent) -->
                <StackPanel IsVisible="{Binding ShowConsent}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="15" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    <Button Content="Compute hash and match" Classes="accent"
                            HorizontalAlignment="Center"
                            Command="{Binding ComputeFingerprintCommand}" />
                </StackPanel>

                <!-- Connect (not connected / provider disabled) -->
                <StackPanel IsVisible="{Binding ShowConnect}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12" Width="330">
                    <TextBlock Text="Connect your ScreenScraper account" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in with your screenscraper.fr username and password."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    <TextBox Text="{Binding Username}" PlaceholderText="Username"
                             VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password"
                             VerticalContentAlignment="Center" />
                    <Button Content="Connect" Classes="accent" HorizontalAlignment="Stretch"
                            IsDefault="True" Command="{Binding ConnectCommand}" />
                    <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsConnecting}" />
                    <TextBlock Text="{Binding ConnectStatus}" TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding ConnectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>

                <!-- No exact match: title search + pick the right game -->
                <Grid IsVisible="{Binding ShowSearch}" RowDefinitions="Auto,Auto,*" Margin="18">
                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Margin="0,0,0,12" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="9" Margin="0,0,0,12">
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery}" PlaceholderText="Game title"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Search" Classes="accent"
                                IsDefault="True" Command="{Binding SearchCommand}" />
                    </Grid>
                    <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True"
                                 IsVisible="{Binding IsSearching}" />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,3" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding #ScraperRoot.DataContext.SelectCandidateCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding System}" FontSize="11"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Data + media review: metadata on the left, a reserved cover safe-zone on the right -->
                <Grid IsVisible="{Binding ShowData}" ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18" Spacing="16">
                        <CheckBox Content="Replace values ScreenScraper already set (otherwise only fill blanks)"
                                  IsChecked="{Binding RefreshOwnedValues}" />

                        <StackPanel Spacing="8" IsVisible="{Binding HasFields}">
                            <TextBlock Text="Details" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScraperFieldRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,4" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanApply}"
                                                      VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentValue}" TextWrapping="Wrap"
                                                           IsVisible="{Binding CurrentValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                                           TextDecorations="Strikethrough" />
                                                <TextBlock Text="{Binding ProposedValue}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                <TextBlock Text="Kept — you edited this" FontSize="11"
                                                           IsVisible="{Binding IsUserOwned}"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding HasOtherMedia}">
                            <TextBlock Text="Media" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                            <ItemsControl ItemsSource="{Binding OtherMedia}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScraperMediaRowViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,6" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanApply}"
                                                      VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Width="96" Height="128" CornerRadius="5"
                                                    Background="{DynamicResource EmuCoverWellBrush}"
                                                    ClipToBounds="True" VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="…" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="18"
                                                               IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProposedText}"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                <TextBlock Text="Kept — your image" FontSize="11"
                                                           IsVisible="{Binding IsUserOwned}"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Cover safe-zone: fixed area so the layout never shifts as the art loads -->
                    <StackPanel Grid.Column="1" Width="228" Margin="6,18,18,18" Spacing="8"
                                VerticalAlignment="Top">
                        <Border Width="204" Height="272" CornerRadius="8" ClipToBounds="True"
                                HorizontalAlignment="Center"
                                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource EmuCoverWellBrush}">
                            <Panel>
                                <TextBlock Text="No box art" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="12"
                                           IsVisible="{Binding BoxArtPreview, Converter={x:Static ObjectConverters.IsNull}}"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                <Image Source="{Binding BoxArtPreview}" Stretch="Uniform" />
                            </Panel>
                        </Border>
                        <CheckBox Content="Box art" HorizontalAlignment="Center"
                                  IsChecked="{Binding BoxArtRow.IsSelected}"
                                  IsEnabled="{Binding BoxArtRow.CanApply}"
                                  IsVisible="{Binding BoxArtRow, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="Wrong game?" IsVisible="{Binding ShowData}"
                    Command="{Binding SearchAgainCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       IsVisible="{Binding ShowData}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Grid.Column="3" Content="Apply" Classes="accent" IsDefault="True"
                    IsVisible="{Binding ShowData}" Command="{Binding ApplyCommand}" />
        </Grid>
    </Grid>
</Window>
