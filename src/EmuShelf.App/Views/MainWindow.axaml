<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        xmlns:sys="using:EmuShelf.Core.Systems"
        xmlns:settings="using:EmuShelf.Core.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="EmuShelf.App.Views.MainWindow"
        x:Name="MainHostWindow"
        x:DataType="vm:MainViewModel"
        Title="EmuShelf"
        Icon="avares://EmuShelf/Assets/emushelf.ico"
        Width="1240" Height="800"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="68"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Neutral trophy glyph (mdi-trophy) for the achievement mark; not RA branding. -->
        <!-- mdi-layers: a neutral "replacement images" mark. Not emulator or vendor branding. -->
        <StreamGeometry x:Key="TexturePackLayersGeometry">M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z</StreamGeometry>
        <!-- mdi-alert: marks a failed operation in the status toast. -->
        <StreamGeometry x:Key="StatusWarningGeometry">M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16</StreamGeometry>
        <StreamGeometry x:Key="AchievementTrophyGeometry">M18,2H6V4H2V9C2,11.21 3.79,13 6,13V13.5C6,15.43 7.5,17 9.34,17.15L9,18H7V20H17V18H15L14.66,17.15C16.5,17 18,15.43 18,13.5V13C20.21,13 22,11.21 22,9V4H18V2M6,11C4.9,11 4,10.1 4,9V6H6V11M20,9C20,10.1 19.1,11 18,11V6H20V9Z</StreamGeometry>
        <!-- The Fluent Button theme paints its internal presenter on pointer/pressed states even
             when Button.Background is transparent. Game tiles provide cover-sized hover/focus
             overlays, so their button template is deliberately content-only. -->
        <ControlTheme x:Key="GamepadGameButtonTheme" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      ClipToBounds="False"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- ============================ Motion ============================
             Durations are deliberately short. These transitions exist to keep state changes from
             snapping, not to be noticed: a cover appearing, a toast arriving, a hover landing.
             Every one is on Opacity or RenderTransform, which are composited and do not trigger
             layout, so they stay cheap across a fully realized grid.

             IsVisible cannot be animated — a collapsed element is not rendered at all — so the
             things that fade (covers, toasts) are always visible and driven by Opacity classes
             instead, with hit testing switched off separately where it matters. -->

        <!-- Covers crossfade over their placeholder. Both layers stay rendered so there is no
             frame in between showing an empty well, and virtualization recycling a tile onto a
             new game replays the fade rather than swapping artwork instantly. -->
        <!-- Grid in the cover views, Image in the list's small thumbnail well. -->
        <Style Selector="Grid.cover-placeholder, Image.cover-placeholder">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.cover-placeholder.covered, Image.cover-placeholder.covered">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Image.cover-image">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.cover-image.loaded">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The toast rises a few pixels as it fades in, so a message replacing another one reads
             as new rather than as text quietly changing in place. -->
        <Style Selector="Border.status-toast">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(8px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.status-toast.showing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Border.status-toast.progress">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuProgressBrush}" />
        </Style>
        <Style Selector="Border.status-toast.error">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
        </Style>

        <!-- Desktop cards reserve four pixels of row headroom and lift into it on hover. This
             keeps motion inside the virtualized cell instead of scaling beyond its clip bounds. -->
        <Style Selector="StackPanel.game-tile">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.game-tile:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>

        <!-- Deliberately NOT animated: the gamepad hover and focus rings. They are the only
             indication of where you are when navigating with a controller, and fading them in
             costs the input a frame of feedback for no visual gain. -->

        <Style Selector="Button.toolbar-button, Button.add-library, Button.collection-item">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <!-- ========================== End motion ========================== -->

        <Style Selector="Button.toolbar-button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.toolbar-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
        </Style>
        <Style Selector="Button.caption-button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.caption-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption-button.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.add-library">
            <Setter Property="Background" Value="{DynamicResource EmuAddButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.add-library:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.add-library /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.collection-item">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.collection-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.collection-item.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-game">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Gamepad controls draw one explicit logical-focus treatment. Keep native Avalonia
             focus for routing/accessibility, but suppress Fluent's second focus-adorners: on
             Linux/SteamOS that extra compositor layer can render as black corner rectangles. -->
        <Style Selector="Button.gamepad-game, Button.gamepad-platform, Button.gamepad-modal-option, Button.gamepad-play-action, Button.gamepad-empty-action, Button.gamepad-achievement-tab, Button.gamepad-achievement-command, Button.gamepad-settings-nav, Button.gamepad-settings-save, Button.gamepad-settings-row, Button.gamepad-settings-confirm, Panel.gamepad-achievement-tile">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gamepad-game.focused">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The button spans the shared mixed-platform shelf height, which can be much taller
             than a DS/GBA-style cover. Never paint that outer hit target; hover is rendered by
             the cover-sized overlay below so no grey cell appears around short artwork. -->
        <Style Selector="Button.gamepad-game:pointerover, Button.gamepad-game:focus, Button.gamepad-game:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-game:pointerover Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.gamepad-game.controller-input:pointerover Border.gamepad-hover-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Per-tile controller focus ring: hidden by default, shown on the focused tile. Opacity
             (not IsVisible) so it never disturbs layout. No transition — the selection must track the
             d-pad crisply and instantly, never lag or fade behind a fast move. -->
        <Style Selector="Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-game.focused Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.gamepad-root.overlay-open Border.gamepad-focus-ring">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-platform">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-platform:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
        </Style>
        <Style Selector="Button.gamepad-platform.controller-input:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-platform.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-platform.selected.controller-input:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-platform.focused">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.focused, Button.gamepad-modal-option:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.controller-input:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.focused.controller-input:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.destructive">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-modal-option.destructive.focused, Button.gamepad-modal-option.destructive:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-key TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-a">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadAButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-b">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadBButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadBButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-x">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadXButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadXButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-y">
            <Setter Property="Background" Value="{DynamicResource EmuGamepadYButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadYButtonBrush}" />
        </Style>
        <Style Selector="Border.gamepad-key.action-a TextBlock, Border.gamepad-key.action-b TextBlock, Border.gamepad-key.action-x TextBlock, Border.gamepad-key.action-y TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
        </Style>
        <Style Selector="StackPanel.gamepad-hint">
            <Setter Property="Spacing" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.gamepad-hint &gt; TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-play-action">
            <Setter Property="MinWidth" Value="144" />
            <Setter Property="Width" Value="144" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuGamepadAButtonBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-play-action:pointerover, Button.gamepad-play-action:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.gamepad-play-action Border.gamepad-key.action-a">
            <Setter Property="Background" Value="#25000000" />
            <Setter Property="BorderBrush" Value="#38000000" />
        </Style>
        <Style Selector="Button.gamepad-empty-action">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-dock-pill">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-overlay">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="620" />
        </Style>
        <Style Selector="Border.gamepad-overlay.system-menu">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Width" Value="460" />
        </Style>
        <Style Selector="Border.gamepad-overlay.side-sheet">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Width" Value="460" />
        </Style>
        <Style Selector="Border.gamepad-overlay.achievements">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="1120" />
            <Setter Property="Height" Value="640" />
        </Style>
        <Style Selector="Border.gamepad-overlay.scraper">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="1000" />
            <Setter Property="Height" Value="640" />
        </Style>
        <!-- One controller-focusable row in the scraper overlay (a field/media toggle or candidate). -->
        <Style Selector="Border.gamepad-scraper-row">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.gamepad-scraper-row.focused">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Border.gamepad-scraper-cover">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="294" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource EmuCoverWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.gamepad-scraper-field.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Border.gamepad-overlay.settings">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="{Binding #GamepadOverlayHost.Bounds.Width}" />
            <Setter Property="Height" Value="{Binding #GamepadOverlayHost.Bounds.Height}" />
        </Style>
        <Style Selector="Button.gamepad-settings-nav">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.gamepad-settings-nav.selected">
            <Setter Property="Background" Value="{DynamicResource EmuAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- When the rail owns focus, its selected section reads as the active column with a thicker,
             filled accent treatment; the content column dims to show it is inactive. -->
        <Style Selector="Button.gamepad-settings-nav.selected.rail-active">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuGamepadButtonTextBrush}" />
        </Style>
        <Style Selector="Grid.rail-dimmed">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.gamepad-settings-save">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-save.focused, Button.gamepad-settings-save:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-row">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.focused, Button.gamepad-settings-row:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <!-- Destructive rows read as ordinary settings until focused; the danger cue is the tinted
             action circle plus the confirmation gate, not a wall of red titles across the section. -->
        <Style Selector="Button.gamepad-settings-row.destructive.focused, Button.gamepad-settings-row.destructive:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <!-- Read-only rows (inventory, logs, connected account) are a flat list, not solid cards, so
             a long texture-pack inventory reads as reference data rather than dead action buttons. -->
        <Style Selector="Button.gamepad-settings-row.info">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.info.focused, Button.gamepad-settings-row.info:focus">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Grouped rows are indented beneath their platform header so the section reads as a tree. -->
        <Style Selector="Button.gamepad-settings-row.grouped">
            <Setter Property="Margin" Value="24,0,0,10" />
        </Style>
        <Style Selector="Button.gamepad-theme-card">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gamepad-theme-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-theme-card.focused, Button.gamepad-theme-card:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Border.gamepad-settings-switch">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.gamepad-settings-switch.on">
            <Setter Property="Background" Value="{DynamicResource EmuAccentMutedBrush}" />
        </Style>
        <Style Selector="Border.gamepad-settings-affordance">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.gamepad-settings-action-button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.gamepad-settings-row.destructive Border.gamepad-settings-action-button">
            <Setter Property="Background" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm.focused, Button.gamepad-settings-confirm:focus">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="Button.gamepad-settings-confirm.danger.focused, Button.gamepad-settings-confirm.danger:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuDangerBrush}" />
        </Style>
        <Style Selector="Button.gamepad-achievement-tab, Button.gamepad-achievement-command">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.gamepad-achievement-tab.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.gamepad-achievement-detail">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.gamepad-achievement">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EmuCoverWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ItemsControl.gamepad-overlay-options">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="ItemsControl.gamepad-overlay-options.top-aligned">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- Controller focus is the same accent-frame ring the library grid uses: a pad behind the
             tile revealed on .focused (styled at Border.gamepad-focus-tile-ring above), not a border
             recolour. Shown via opacity so it never disturbs layout and tracks the d-pad instantly. -->
        <Style Selector="Panel.gamepad-achievement-tile.focused Border.gamepad-focus-tile-ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.gamepad-achievement-badge.locked">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <!-- Fluent scrollbars overlay their content. Gamepad cards reserve a gutter so the
             thumb reads as scrolling chrome instead of a broken right-hand card border. -->
        <Style Selector="ScrollViewer.gamepad-scroll /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MaxWidth" Value="8" />
            <Setter Property="Margin" Value="7,0,1,0" />
        </Style>
        <Style Selector="ScrollViewer.gamepad-scroll /template/ ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="{DynamicResource EmuTextTertiaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="Button.achievement-mark">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.achievement-mark:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
        </Style>
        <!-- Texture-pack mark: informational only, so it is a Border rather than a Button. There
             is nothing to open, and EmuShelf never installs, repairs, or removes a pack. -->
        <Style Selector="Border.texture-mark">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:checked">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource EmuHoverBrush}" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EmuAccentBrush}" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <Style Selector="Border.nav-icon-well">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource EmuNavIconWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuNavIconBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.nav-icon-well Image">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.system-list ListBoxItem:selected Border.nav-icon-well, Button.collection-item.selected Border.nav-icon-well">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="StackPanel.game-tile.unavailable, Grid.game-row.unavailable">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <!-- Gamepad tiles dim the artwork and title rather than the whole button: the focus
             ring is the only way to tell where you are on a controller, so it stays full
             strength even when the game's files are missing. -->
        <Style Selector="Button.gamepad-game.unavailable Border.gamepad-cover-frame">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <Style Selector="Button.gamepad-game.unavailable TextBlock.gamepad-tile-title">
            <Setter Property="Opacity" Value="0.58" />
        </Style>
        <Style Selector="Border.gamepad-cover-frame">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #40000000" />
        </Style>
        <Style Selector="Button.gamepad-game.focused Border.gamepad-cover-frame">
            <Setter Property="BoxShadow" Value="0 16 36 0 #78000000" />
        </Style>
        <!-- Couch-distance counterpart to the desktop cover marks (Button.achievement-mark
             and Border.texture-mark), which are sized for a pointer at desk distance. -->
        <Style Selector="Border.gamepad-mark">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource EmuPopoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.cover-card">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuCoverBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 18 0 #38000000" />
        </Style>
        <Style Selector="StackPanel.game-tile:pointerover Border.cover-card">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BoxShadow" Value="0 13 30 0 #54000000" />
        </Style>
        <!-- Selection is shown by an overlay ring outside the fixed frame (see the tile),
             not by thickening this border — a thicker border would shrink the content box
             and reflow/rescale the cover on click. -->
        <Style Selector="StackPanel.game-tile.selected Border.cover-card">
            <Setter Property="BoxShadow" Value="0 12 30 0 #66000000" />
        </Style>
        <Style Selector="Grid.game-row.selected">
            <Setter Property="Background" Value="{DynamicResource EmuNavSelectionBrush}" />
        </Style>
        <Style Selector="ListBox.game-list ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Grid.list-header TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="{DynamicResource EmuTextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Clickable list-view column headers: no chrome, so they read as the header labels
             but sort the library on click (with a ▲/▼ direction glyph on the active column). -->
        <Style Selector="Button.sort-header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sort-header /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sort-header:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EmuTextSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid Width="{Binding #MainHostWindow.Bounds.Width}">
    <Grid IsVisible="{Binding !IsGamepadMode}" RowDefinitions="68,Auto,*" ColumnDefinitions="Auto,*">
        <!-- OpenEmu-inspired navigation rail, rebuilt for EmuShelf rather than copied.
             Collapses to a narrow icon rail (NavigationWidth) so the library grid reclaims
             the freed width. -->
        <Border Grid.RowSpan="3" Grid.Column="0"
                Width="{Binding NavigationWidth}"
                Background="{DynamicResource EmuSidebarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="68,Auto,Auto,Auto,Auto,*,Auto">
                <Border Grid.Row="0" BorderBrush="{DynamicResource EmuBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="18,0"
                        WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <Button x:Name="NavigationToggle" Grid.Column="0" Classes="toolbar-button"
                                Command="{Binding ToggleNavigationCommand}"
                                WindowDecorationProperties.ElementRole="User"
                                VerticalAlignment="Center" ToolTip.Tip="Toggle sidebar">
                            <PathIcon Width="16" Height="16"
                                      Data="M2,3 H18 V5 H2 Z M2,8.5 H18 V10.5 H2 Z M2,14 H18 V16 H2 Z" />
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="11"
                                    Margin="11,0,0,0" VerticalAlignment="Center"
                                    IsVisible="{Binding !IsNavigationCollapsed}">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{DynamicResource EmuAccentBrush}"
                                    BoxShadow="0 4 10 0 #36000000">
                                <Grid>
                                    <PathIcon Width="19" Height="19" Foreground="White"
                                              Data="M4,5 H16 A3,3 0 0 1 19,8 V15 A3,3 0 0 1 16,18 H4 A3,3 0 0 1 1,15 V8 A3,3 0 0 1 4,5 Z M5,10 H9 M7,8 V12 M14,9.5 A1,1 0 1 0 14,11.5 A1,1 0 1 0 14,9.5 M17,12 A1,1 0 1 0 17,14 A1,1 0 1 0 17,12" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="0">
                                <TextBlock Text="EmuShelf" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                <TextBlock Text="PORTABLE LIBRARY" FontSize="8.5" LetterSpacing="1.1"
                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="CONSOLES" Margin="18,17,18,7"
                           FontSize="10" FontWeight="Bold" LetterSpacing="1.3"
                           IsVisible="{Binding !IsNavigationCollapsed}"
                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />

                <ListBox Grid.Row="2" Classes="system-list" x:Name="SystemList"
                         ItemsSource="{Binding NavigationSystems}"
                         SelectedItem="{Binding SelectedSystem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="sys:GameSystem">
                            <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Classes="nav-icon-well">
                                    <Image Source="{Binding Id, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="13.5" FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding #SystemList.((vm:MainViewModel)DataContext).IsNavigationExpanded}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="COLLECTIONS" Margin="18,18,18,7"
                           FontSize="10" FontWeight="Bold" LetterSpacing="1.3"
                           IsVisible="{Binding !IsNavigationCollapsed}"
                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />

                <StackPanel Grid.Row="4">
                    <Button Classes="collection-item"
                            Classes.selected="{Binding IsAllGamesSelected}"
                            Command="{Binding ShowAllGamesCommand}">
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                            <Border Classes="nav-icon-well">
                                <Image Source="avares://EmuShelf/Assets/ThirdParty/OpenEmu/LibraryUi/collection-simple@2x.png"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="All Games" FontSize="13.5"
                                       FontWeight="Medium" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsNavigationCollapsed}" />
                        </Grid>
                    </Button>
                    <Button Classes="collection-item"
                            Classes.selected="{Binding IsRecentlyAddedSelected}"
                            Command="{Binding ShowRecentlyAddedCommand}">
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                            <Border Classes="nav-icon-well">
                                <Image Source="avares://EmuShelf/Assets/ThirdParty/OpenEmu/LibraryUi/collection-smart@2x.png"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Recently Added" FontSize="13.5"
                                       FontWeight="Medium" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsNavigationCollapsed}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Button Grid.Row="6" Classes="add-library" Margin="14,12,14,15"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsBusy}" Padding="12,8">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                        <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                  Data="M8,1 H11 V8 H18 V11 H11 V18 H8 V11 H1 V8 H8 Z" />
                        <TextBlock Grid.Column="1" Text="Add to Library" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsNavigationCollapsed}" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Add Files…" Command="{Binding AddGamesCommand}" />
                            <MenuItem Header="Add Folder…" Command="{Binding AddFolderCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Library toolbar. -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10,156,10"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,18,*,Auto,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" CornerRadius="9"
                        BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource EmuSegmentBrush}" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="GridViewToggle" Classes="view-toggle"
                                      IsChecked="{Binding IsGridView, Mode=TwoWay}"
                                      WindowDecorationProperties.ElementRole="User"
                                      ToolTip.Tip="Cover grid">
                            <PathIcon Width="14" Height="14"
                                      Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
                        </ToggleButton>
                        <ToggleButton x:Name="ListViewToggle" Classes="view-toggle"
                                      IsChecked="{Binding !IsGridView, Mode=TwoWay}"
                                      WindowDecorationProperties.ElementRole="User"
                                      ToolTip.Tip="List view">
                            <PathIcon Width="14" Height="14"
                                      Data="M2,3 H18 V6 H2 Z M2,8.5 H18 V11.5 H2 Z M2,14 H18 V17 H2 Z" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LibraryTitle}" FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LibraryCountText}" FontSize="10.5"
                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                </StackPanel>

                <Panel Grid.Column="3" WindowDecorationProperties.ElementRole="User">
                    <Button x:Name="SearchTrigger" Classes="toolbar-button" ToolTip.Tip="Search library"
                            IsVisible="{Binding !IsSearchOpen}"
                            Click="OnOpenSearchClick">
                        <PathIcon Width="16" Height="16"
                                  Data="F0 M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 Z M9,5 A4,4 0 1 1 9,13 A4,4 0 1 1 9,5 Z M13.2,12.5 L20,19.3 L19.3,20 L12.5,13.2 Z" />
                    </Button>
                    <Border x:Name="ExpandedSearch" Width="218" Height="36" CornerRadius="18"
                            IsVisible="{Binding IsSearchOpen}"
                            Background="{DynamicResource EmuInputBrush}"
                            BorderBrush="{DynamicResource EmuAccentBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="30,*,30" Margin="5,0">
                            <PathIcon Grid.Column="0" Width="14" Height="14"
                                      Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                      Data="F0 M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 Z M9,5 A4,4 0 1 1 9,13 A4,4 0 1 1 9,5 Z M13.2,12.5 L20,19.3 L19.3,20 L12.5,13.2 Z" />
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="0" VerticalContentAlignment="Center"
                                     PlaceholderText="Search"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     KeyDown="OnSearchKeyDown" />
                            <Button x:Name="CloseSearchButton" Grid.Column="2" Width="26" Height="26" Padding="3"
                                    CornerRadius="13" Background="Transparent" BorderThickness="0"
                                    Click="OnCloseSearchClick" ToolTip.Tip="Close search">
                                <PathIcon Width="10" Height="10"
                                          Data="M2,1 L10,9 L9,10 L1,2 Z M9,1 L10,2 L2,10 L1,9 Z" />
                            </Button>
                        </Grid>
                    </Border>
                </Panel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="GamepadModeButton" Classes="toolbar-button" ToolTip.Tip="Switch to Gamepad mode"
                            WindowDecorationProperties.ElementRole="User"
                            Command="{Binding SetInterfaceModeCommand}"
                            CommandParameter="{x:Static settings:InterfaceMode.Gamepad}">
                        <PathIcon Width="17" Height="17"
                                  Data="M4,6 H16 A3,3 0 0 1 19,9 V14 A3,3 0 0 1 16,17 H4 A3,3 0 0 1 1,14 V9 A3,3 0 0 1 4,6 Z M5,11 H9 M7,9 V13 M14,10 A1,1 0 1 0 14,12 A1,1 0 1 0 14,10 M17,12 A1,1 0 1 0 17,14 A1,1 0 1 0 17,12" />
                    </Button>
                    <Button x:Name="SettingsButton" Classes="toolbar-button" Command="{Binding OpenSettingsCommand}"
                            WindowDecorationProperties.ElementRole="User"
                            IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Settings">
                        <PathIcon Width="17" Height="17"
                                  Data="M8,2 H12 L13,5 L16,4 L18,8 L16,10 L18,13 L15,17 L12,15 L10,18 L6,17 L6,14 L2,13 L2,8 L5,7 L5,4 Z M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7" />
                    </Button>
                </StackPanel>

                <ProgressBar Grid.ColumnSpan="5" Height="2" Margin="0,0,0,-10"
                             IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                             VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- One shared selection surface for both desktop library layouts. -->
        <Border x:Name="SelectionBar" Grid.Row="1" Grid.Column="1"
                IsVisible="{Binding HasSelectedGames}"
                Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,7">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding SelectionSummaryText}"
                           VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                <Button Grid.Column="1" Content="Clear"
                        Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button x:Name="RemoveSelectionButton" Grid.Column="2"
                        Content="{Binding SelectionRemovalText}"
                        Command="{Binding RemoveSelectedGamesCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Foreground="{DynamicResource EmuDangerBrush}" />
            </Grid>
        </Border>

        <!-- Cover-first library content. -->
        <Panel Grid.Row="2" Grid.Column="1"
               Background="{DynamicResource EmuLibraryBrush}">
            <ScrollViewer x:Name="LibraryGridScroller" IsVisible="{Binding IsGridView}"
                          SizeChanged="OnLibrarySizeChanged">
                <ItemsRepeater x:Name="LibraryRepeater" ItemsSource="{Binding Games}"
                               Margin="32,28,28,34">
                    <ItemsRepeater.Layout>
                        <!-- Covers are sized responsively (GameViewModel.CoverWidth, recomputed
                             from the viewport width) so a whole number of columns fills the row with
                             no lopsided right gutter, and the last partial row still aligns left.
                             No MinItemHeight: every tile in a view shares one cover-shelf height. -->
                        <UniformGridLayout MinItemWidth="188"
                                           MinColumnSpacing="28" MinRowSpacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameViewModel">
                            <StackPanel Width="{Binding CoverWidth}" Margin="0,4,0,0"
                                        Spacing="8" Classes="game-tile"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.unavailable="{Binding !IsAvailable}"
                                        ContextRequested="OnGameContextRequested"
                                        DoubleTapped="OnGameDoubleTapped">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Launch" Command="{Binding LaunchCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Select disc" IsVisible="{Binding IsMultiDisc}"
                                                  ItemsSource="{Binding DiscOptions}">
                                            <MenuItem.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GameDiscOptionViewModel">
                                                    <MenuItem Header="{Binding Label}"
                                                              Click="OnSelectDiscMenuItemClick" />
                                                </DataTemplate>
                                            </MenuItem.ItemTemplate>
                                        </MenuItem>
                                        <MenuItem Header="Achievements…"
                                                  IsVisible="{Binding CanOpenAchievementDetails}"
                                                  Command="{Binding OpenAchievementsCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Edit title…"
                                                  Command="{Binding BeginEditTitleCommand}" />
                                        <MenuItem Header="Set cover…" Command="{Binding SetCoverCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Scrape with ScreenScraper…"
                                                  Command="{Binding ScrapeCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{Binding SelectionScrapeText}"
                                                  IsVisible="{Binding CanScrapeSelection}"
                                                  Command="{Binding ScrapeSelectedCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding SelectionRemovalText}"
                                                  Command="{Binding RemoveSelectedCommand}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>

                                <!-- One canonical frame per platform sizes the cover and the placeholder
                                     alike; real artwork fills it (UniformToFill) so a system's tiles are
                                     uniform and bottom-align on the shared mixed-library shelf. -->
                                <Grid Width="{Binding CoverWidth}" Height="{Binding ShelfCoverHeight}">
                                <Panel Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"
                                       VerticalAlignment="Bottom">
                                    <Border Classes="cover-card"
                                            Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"
                                            CornerRadius="5" Background="{DynamicResource EmuCoverWellBrush}"
                                            ClipToBounds="True"
                                            AttachedToVisualTree="OnGameCoverAttached"
                                            DataContextChanged="OnGameCoverDataContextChanged">
                                        <Panel>
                                            <Grid Classes="cover-placeholder"
                                                  Classes.covered="{Binding HasCoverImage}"
                                                  RowDefinitions="5,*,Auto">
                                                <Border Grid.Row="0" Background="{Binding AccentColor}" />
                                                <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Spacing="14">
                                                    <Border Width="104" Height="104" CornerRadius="52"
                                                            Background="{DynamicResource EmuPlaceholderMedallionBrush}"
                                                            BorderBrush="{DynamicResource EmuCoverBorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Width="76" Height="76"
                                                               Source="{Binding PlatformArtwork}"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    <TextBlock Text="ARTWORK MISSING" FontSize="8.5"
                                                               FontWeight="Bold" LetterSpacing="1.4"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Row="2" Margin="10" Padding="8,6"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource EmuPlaceholderLabelBrush}">
                                                    <TextBlock Text="{Binding SystemName}" FontSize="9"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <Image Source="{Binding CoverImage}"
                                                   Classes="cover-image"
                                                   Classes.loaded="{Binding HasCoverImage}"
                                                   Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <!-- Selection ring stays inside the fixed frame. UniformGridLayout
                                         may clip outside-rendered pixels at a row boundary. -->
                                    <Border Classes="selection-ring"
                                            IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                                            Margin="1" CornerRadius="5"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource EmuAccentBrush}"
                                            BorderThickness="3" />
                                    <Border IsVisible="{Binding !IsAvailable}"
                                            Background="#E1292D34" CornerRadius="4"
                                            Padding="7,4" Margin="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding UnavailableBadgeText}" FontSize="8" FontWeight="Bold"
                                                   LetterSpacing="0.9" Foreground="White" />
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding UnavailableTooltip}"
                                                       MaxWidth="260" TextWrapping="Wrap" />
                                        </ToolTip.Tip>
                                    </Border>
                                    <Border Classes="disc-badge" IsVisible="{Binding IsMultiDisc}"
                                            Background="#D9000000" CornerRadius="4"
                                            Padding="7,4" Margin="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding DiscBadgeText}" FontSize="8" FontWeight="Bold"
                                                   LetterSpacing="0.8" Foreground="White" />
                                    </Border>
                                    <!-- Cover marks, laid out together so the texture mark keeps its
                                         place beside the trophy whether or not the trophy shows. -->
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <!-- Achievement mark: shown only on a confirmed RA hash match. -->
                                        <Button Classes="achievement-mark"
                                                IsVisible="{Binding ShowAchievementMark}"
                                                Command="{Binding OpenAchievementsCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding AchievementsTooltip}">
                                            <PathIcon Width="13" Height="13"
                                                      Data="{StaticResource AchievementTrophyGeometry}"
                                                      Foreground="{DynamicResource EmuAchievementBrush}" />
                                        </Button>
                                        <!-- Texture mark: shown only for a usable, matched pack. -->
                                        <Border Classes="texture-mark"
                                                IsVisible="{Binding ShowTextureMark}">
                                            <ToolTip.Tip>
                                                <TextBlock Text="{Binding TexturesTooltip}"
                                                           MaxWidth="320" TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                            <PathIcon Width="13" Height="13"
                                                      Data="{StaticResource TexturePackLayersGeometry}"
                                                      Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Panel>
                                </Grid>

                                <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontSize="14"
                                           FontWeight="Medium" HorizontalAlignment="Center"
                                           MaxWidth="{Binding CoverWidth}"
                                           Foreground="{DynamicResource EmuTextPrimaryBrush}"
                                           ToolTip.Tip="{Binding Title}" />
                                <Border Padding="7,2" CornerRadius="7"
                                        Background="{DynamicResource EmuFormatPillBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FormatLabel}" FontSize="8.5"
                                               FontWeight="SemiBold" LetterSpacing="0.9"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                </Border>

                                <Popup IsOpen="{Binding IsEditingTitle, Mode=TwoWay}"
                                       Placement="Bottom" IsLightDismissEnabled="True">
                                    <Border Background="{DynamicResource EmuPopoverBrush}"
                                            BorderBrush="{DynamicResource EmuBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14"
                                            BoxShadow="0 10 30 0 #66000000">
                                        <StackPanel Width="270" Spacing="10">
                                            <TextBlock Text="Edit title" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding DraftTitle, Mode=TwoWay}"
                                                     MaxLength="300" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Spacing="7">
                                                <Button Content="Cancel"
                                                        Command="{Binding CancelEditTitleCommand}" />
                                                <Button Content="Save" Classes="accent" IsDefault="True"
                                                        Command="{Binding SaveTitleCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Grid IsVisible="{Binding !IsGridView}" RowDefinitions="38,*" Margin="20,14,20,20">
                <Border Grid.Row="0" BorderBrush="{DynamicResource EmuBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid Classes="list-header" ColumnDefinitions="84,*,150,90,96,92,100">
                        <Button Grid.Column="1" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Title}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="TITLE" />
                                <TextBlock Text="{Binding TitleSortGlyph}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Console}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="CONSOLE" />
                                <TextBlock Text="{Binding ConsoleSortGlyph}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Format}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="FORMAT" />
                                <TextBlock Text="{Binding FormatSortGlyph}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Achievements}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="ACHIEVEMENTS" />
                                <TextBlock Text="{Binding AchievementsSortGlyph}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Textures}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="TEXTURES" />
                                <TextBlock Text="{Binding TexturesSortGlyph}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Classes="sort-header"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:LibrarySortColumn.Status}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="STATUS" />
                                <TextBlock Text="{Binding StatusSortGlyph}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <ListBox x:Name="LibraryList" Grid.Row="1" Classes="game-list" ItemsSource="{Binding Games}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameViewModel">
                            <Grid ColumnDefinitions="84,*,150,90,96,92,100" Classes="game-row"
                                  Classes.selected="{Binding IsSelected}"
                                  Classes.unavailable="{Binding !IsAvailable}"
                                  ContextRequested="OnGameContextRequested"
                                  DoubleTapped="OnGameDoubleTapped">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Launch" Command="{Binding LaunchCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Select disc" IsVisible="{Binding IsMultiDisc}"
                                                  ItemsSource="{Binding DiscOptions}">
                                            <MenuItem.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GameDiscOptionViewModel">
                                                    <MenuItem Header="{Binding Label}"
                                                              Click="OnSelectDiscMenuItemClick" />
                                                </DataTemplate>
                                            </MenuItem.ItemTemplate>
                                        </MenuItem>
                                        <MenuItem Header="Achievements…"
                                                  IsVisible="{Binding CanOpenAchievementDetails}"
                                                  Command="{Binding OpenAchievementsCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Edit title…"
                                                  Command="{Binding BeginEditTitleCommand}" />
                                        <MenuItem Header="Set cover…" Command="{Binding SetCoverCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Scrape with ScreenScraper…"
                                                  Command="{Binding ScrapeCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{Binding SelectionScrapeText}"
                                                  IsVisible="{Binding CanScrapeSelection}"
                                                  Command="{Binding ScrapeSelectedCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding SelectionRemovalText}"
                                                  Command="{Binding RemoveSelectedCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Border Grid.Column="0"
                                        Width="{Binding ListCoverWidth}" Height="{Binding ListCoverHeight}"
                                        CornerRadius="4"
                                        Background="{DynamicResource EmuCoverWellBrush}"
                                        BorderBrush="{DynamicResource EmuCoverBorderBrush}"
                                        BorderThickness="1" ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        AttachedToVisualTree="OnGameCoverAttached"
                                        DataContextChanged="OnGameCoverDataContextChanged">
                                    <Panel>
                                        <Image Source="{Binding PlatformArtwork}" Width="29" Height="29"
                                               Classes="cover-placeholder"
                                               Classes.covered="{Binding HasCoverImage}"
                                               RenderOptions.BitmapInterpolationMode="None" />
                                        <Image Source="{Binding CoverImage}"
                                               Classes="cover-image"
                                               Classes.loaded="{Binding HasCoverImage}"
                                               Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock IsVisible="{Binding IsMultiDisc}" Text="{Binding DiscBadgeText}"
                                               FontSize="10" Foreground="{DynamicResource EmuAccentBrush}" />
                                    <TextBlock Text="{Binding Path}" FontSize="10"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SystemName}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding FormatLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding AchievementsTooltip}">
                                    <PathIcon IsVisible="{Binding ShowAchievementMark}"
                                              Width="11" Height="11"
                                              Data="{StaticResource AchievementTrophyGeometry}"
                                              Foreground="{DynamicResource EmuAchievementBrush}" />
                                    <TextBlock Text="{Binding AchievementsColumnText}"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5"
                                            VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding TexturesTooltip}"
                                                   MaxWidth="320" TextWrapping="Wrap" />
                                    </ToolTip.Tip>
                                    <PathIcon IsVisible="{Binding ShowTextureMark}"
                                              Width="11" Height="11"
                                              Data="{StaticResource TexturePackLayersGeometry}"
                                              Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TexturesColumnText}"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" VerticalAlignment="Center"
                                           Text="{Binding AvailabilityText}"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                <Popup Grid.Column="1" IsOpen="{Binding IsEditingTitle, Mode=TwoWay}"
                                       Placement="Bottom" IsLightDismissEnabled="True">
                                    <Border Background="{DynamicResource EmuPopoverBrush}"
                                            BorderBrush="{DynamicResource EmuBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14"
                                            BoxShadow="0 10 30 0 #66000000">
                                        <StackPanel Width="270" Spacing="10">
                                            <TextBlock Text="Edit title" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding DraftTitle, Mode=TwoWay}" MaxLength="300" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Spacing="7">
                                                <Button Content="Cancel"
                                                        Command="{Binding CancelEditTitleCommand}" />
                                                <Button Content="Save" Classes="accent" IsDefault="True"
                                                        Command="{Binding SaveTitleCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="13" MaxWidth="460">
                <Border Width="106" Height="106" CornerRadius="53"
                        Background="{DynamicResource EmuPlaceholderMedallionBrush}"
                        BorderBrush="{DynamicResource EmuCoverBorderBrush}" BorderThickness="1"
                        BoxShadow="0 8 22 0 #30000000">
                    <Image Width="76" Height="76"
                           Source="avares://EmuShelf/Assets/ThirdParty/OpenEmu/LibraryUi/missing-metadata@2x.png"
                           RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <TextBlock Text="{Binding EmptyLibraryTitle}"
                           FontSize="24" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                <TextBlock Text="{Binding EmptyLibraryDescription}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center"
                            Margin="0,7,0,0">
                    <Button Content="Add Files…" Classes="accent"
                            Command="{Binding AddGamesCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Add Folder…" Command="{Binding AddFolderCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSearchEmpty}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="9">
                <PathIcon Width="28" Height="28" Foreground="{DynamicResource EmuTextTertiaryBrush}"
                          Data="F0 M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 Z M9,5 A4,4 0 1 1 9,13 A4,4 0 1 1 9,5 Z M13.2,12.5 L20,19.3 L19.3,20 L12.5,13.2 Z" />
                <TextBlock Text="No matching games" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                <TextBlock Text="Try a different title or clear the search."
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                <Button Content="Clear Search" Command="{Binding ClearSearchCommand}" />
            </StackPanel>

            <!-- Operational feedback appears only when there is something useful to say. -->
            <Border Classes="status-toast" Classes.showing="{Binding HasStatusMessage}"
                    Classes.progress="{Binding IsStatusProgress}"
                    Classes.error="{Binding IsStatusError}"
                    IsHitTestVisible="{Binding HasStatusMessage}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    MaxWidth="520" Margin="18" Padding="11,8"
                    CornerRadius="9" Background="{DynamicResource EmuPopoverBrush}"
                    BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1"
                    BoxShadow="0 8 24 0 #50000000">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                    <!-- The app's accent is already red, so a red dot cannot carry "this failed".
                         The shape does it instead: a dot for results and progress, a warning
                         triangle for errors. -->
                    <Panel VerticalAlignment="Center" Width="12" Height="12">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource EmuInfoBrush}"
                                 IsVisible="{Binding IsStatusInfo}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource EmuProgressBrush}"
                                 IsVisible="{Binding IsStatusProgress}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <PathIcon Width="12" Height="12" IsVisible="{Binding IsStatusError}"
                                  Data="{StaticResource StatusWarningGeometry}"
                                  Foreground="{DynamicResource EmuDangerBrush}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                    <Button Grid.Column="2" Width="24" Height="24" Padding="5"
                            CornerRadius="12" Background="Transparent" BorderThickness="0"
                            Command="{Binding ClearStatusCommand}" ToolTip.Tip="Dismiss">
                        <PathIcon Width="9" Height="9"
                                  Data="M2,1 L10,9 L9,10 L1,2 Z M9,1 L10,2 L2,10 L1,9 Z" />
                    </Button>
                </Grid>
            </Border>
        </Panel>
    </Grid>

    <!-- Only the caption buttons sit above the toolbar. The root grid is constrained to the
         client width so these remain window-aligned without creating a full-width hit-test layer. -->
    <StackPanel x:Name="CaptionButtons" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="20"
                WindowDecorationProperties.ElementRole="User"
                IsVisible="{Binding !IsGamepadMode}"
                Background="{DynamicResource EmuToolbarBrush}">
            <Button x:Name="MinimizeWindowButton" Classes="caption-button" ToolTip.Tip="Minimize"
                    AutomationProperties.Name="Minimize window"
                    Click="OnMinimizeWindowClick">
                <PathIcon Width="12" Height="12" Data="M2,9 H14 V10 H2 Z" />
            </Button>
            <Button x:Name="MaximizeWindowButton" Classes="caption-button" ToolTip.Tip="Maximize or restore"
                    AutomationProperties.Name="Maximize or restore window"
                    Click="OnMaximizeRestoreWindowClick">
                <PathIcon Width="11" Height="11"
                          Data="M1,1 H10 V10 H1 Z M2,2 V9 H9 V2 Z" />
            </Button>
            <Button x:Name="CloseWindowButton" Classes="caption-button close" ToolTip.Tip="Close"
                    AutomationProperties.Name="Close window"
                    Click="OnCloseWindowClick">
                <PathIcon Width="12" Height="12"
                          Data="M2,1 L11,10 L10,11 L1,2 Z M10,1 L11,2 L2,11 L1,10 Z" />
            </Button>
    </StackPanel>

    <!-- Steam Input's keyboard contract drives this deliberately separate, large-target view.
         It does not replace the desktop selection model or list view. -->
    <Grid x:Name="GamepadRoot" Classes="gamepad-root" Classes.overlay-open="{Binding HasGamepadOverlay}"
          IsVisible="{Binding IsGamepadMode}" RowDefinitions="100,*,104"
          Background="{DynamicResource EmuLibraryBrush}" PointerMoved="OnGamepadPointerMoved">
        <Border Grid.Row="0" Padding="42,18,42,12" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
                <Border Classes="gamepad-key" VerticalAlignment="Center">
                    <TextBlock Text="LB" />
                </Border>
                <ScrollViewer x:Name="GamepadRailScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button x:Name="GamepadAllGamesTab" Classes="gamepad-platform"
                                Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                                Command="{Binding ShowAllGamesCommand}"
                                Classes.selected="{Binding IsAllGamesSelected}"
                                MinHeight="54" Padding="22,10">
                            <TextBlock Text="All Games" VerticalAlignment="Center" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding GamepadPlatforms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GamepadPlatformTabViewModel">
                                    <Button Classes="gamepad-platform"
                                            Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                            Classes.selected="{Binding IsActive}" MinHeight="54" Padding="18,10"
                                            Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).SelectPlatformCommand}"
                                            CommandParameter="{Binding System}">
                                        <Grid ColumnDefinitions="26,*" ColumnSpacing="9">
                                            <Image Grid.Column="0" Width="26" Height="26" Source="{Binding Artwork}"
                                                   RenderOptions.BitmapInterpolationMode="None" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Classes="gamepad-key" VerticalAlignment="Center">
                    <TextBlock Text="RB" />
                </Border>
            </Grid>
        </Border>
        <!-- Row-virtualized grid: a ListBox renders one ROW per line and its VirtualizingStackPanel
             realizes only the ~5 on-screen rows, so a 900-game library lays out ~40 tiles, not 900.
             Each row is a horizontal strip holding exactly GamepadColumnCount tiles, so the rendered
             column count always equals the navigation stride, and vertical virtualization has none of
             the phantom-cell defects a virtualized UniformGridLayout had. The ListBox is a passive
             renderer — navigation and the focus ring are driven by the flat Games list, not its
             selection — so its selection/focus visuals are styled away below. -->
        <ListBox x:Name="GamepadRowList" Grid.Row="1" Margin="52,26,52,26"
                 ItemsSource="{Binding GamepadRows}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 IsVisible="{Binding HasGames}"
                 SizeChanged="OnGamepadLibrarySizeChanged"
                 IsHitTestVisible="{Binding !HasGamepadOverlay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter,
                                 ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- One row of tiles. 40px side gutter + 28px inter-row spacing match the old grid.
                         The side gutter is Padding (not Margin) so the row container spans the full width:
                         a first/last-column tile's focus frame overflows 6px into the gutter and stays
                         INSIDE the container, so it is never clipped at the grid's edge.
                         The 28px vertical gap is split top(10)/bottom(18) instead of all-bottom, so EVERY
                         row — including the first and last against the scroll viewport — has room above and
                         below for the focus frame's 6px overflow. Inter-row spacing is unchanged (10+18=28). -->
                    <ItemsControl ItemsSource="{Binding}" Margin="0,10,0,18" Padding="40,0,40,0"
                                  ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="28" ClipToBounds="False" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameViewModel">
                        <Button Classes="gamepad-game" Classes.focused="{Binding IsFocused}"
                                Classes.unavailable="{Binding !IsAvailable}"
                                Theme="{StaticResource GamepadGameButtonTheme}"
                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                Width="{Binding CoverWidth}" Padding="0" Margin="0"
                                ClipToBounds="False" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="2"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).FocusGameCommand}"
                                CommandParameter="{Binding}"
                                DoubleTapped="OnGameDoubleTapped">
                            <Grid Width="{Binding CoverWidth}" RowDefinitions="Auto,58" ClipToBounds="False">
                                <!-- Each tile uses its platform's true cover frame (CoverHeight from
                                     GameSystem.CoverAspectRatio), matching the desktop grid. Frames
                                     bottom-align on a shared shelf sized to the tallest cover in the
                                     view, so mixed-platform All Games keeps one baseline and the
                                     titles still line up. -->
                                <Grid Width="{Binding CoverWidth}" Height="{Binding ShelfCoverHeight}" ClipToBounds="False">
                                  <Panel Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"
                                         Classes="gamepad-cover-stack" VerticalAlignment="Bottom" ClipToBounds="False">
                                    <!-- Controller focus frame. A solid accent pad BEHIND the cover, 6px
                                         larger on every side with a concentric corner radius (12 + 6), so
                                         the opaque cover masks its centre and the accent reads as an even
                                         6px frame. Its inner edge is the cover's own rounded corner, so
                                         corners can never mismatch and no artwork is ever hidden — unlike a
                                         stroked border on top, whose inner corner radius (radius − thickness)
                                         cannot follow the cover. Must stay first/bottom-most. Shown by
                                         opacity on .focused (styles below); no transition, tracks the d-pad. -->
                                    <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                                            Margin="-6" CornerRadius="18"
                                            Background="{DynamicResource EmuAccentBrush}"
                                            BoxShadow="{DynamicResource EmuFocusGlow}" />
                                    <!-- Opaque well between the focus pad and the cover, sized to the cover
                                         (the pad is 6px larger). It is never dimmed, so when an unavailable
                                         cover drops to 58% opacity its centre reveals this dark well rather
                                         than the accent pad behind it — the pad stays a clean 6px edge frame. -->
                                    <Border IsHitTestVisible="False" CornerRadius="12"
                                            Background="{DynamicResource EmuCoverWellBrush}" />
                                    <!-- Rows virtualize, so a tile attaches only when its row scrolls
                                         into view — loading the cover on attach fetches just the
                                         on-screen covers, and recycled tiles reload via DataContext. -->
                                    <Border Classes="gamepad-cover-frame" CornerRadius="12" Background="{DynamicResource EmuCoverWellBrush}"
                                            ClipToBounds="True"
                                            AttachedToVisualTree="OnGameCoverAttached"
                                            DataContextChanged="OnGameCoverDataContextChanged">
                                        <Panel>
                                            <Grid Classes="cover-placeholder"
                                                  Classes.covered="{Binding HasCoverImage}" RowDefinitions="5,*"
                                                  Background="{DynamicResource EmuCoverWellBrush}">
                                                <Border Grid.Row="0" Background="{Binding AccentColor}" />
                                                <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Spacing="12">
                                                    <Border Width="88" Height="88" CornerRadius="44"
                                                            Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                        <Image Width="62" Height="62" Source="{Binding PlatformArtwork}"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    <TextBlock Text="ARTWORK MISSING" FontSize="8" FontWeight="Bold"
                                                               LetterSpacing="1.2" Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- The frame is the platform's true scan ratio, so filling it
                                                 bleeds a hair rather than letterboxing. -->
                                            <Image Source="{Binding CoverImage}" Classes="cover-image"
                                                   Classes.loaded="{Binding HasCoverImage}"
                                                   Stretch="UniformToFill" />
                                            <Border IsVisible="{Binding IsMultiDisc}" Background="#D9000000"
                                                    CornerRadius="4" Padding="9,5" Margin="10"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding DiscBadgeText}" FontSize="10" FontWeight="Bold"
                                                           LetterSpacing="0.8" Foreground="White" />
                                            </Border>
                                        </Panel>
                                    </Border>
                                    <!-- Same marks the desktop grid shows, sized for a couch viewing
                                         distance. Both are Borders here: a focusable button inside a
                                         tile button would capture controller focus, and every gamepad
                                         action for a game is reached through the Y actions overlay. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="10"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border Classes="gamepad-mark" IsVisible="{Binding ShowAchievementMark}">
                                            <PathIcon Width="16" Height="16"
                                                      Data="{StaticResource AchievementTrophyGeometry}"
                                                      Foreground="{DynamicResource EmuAchievementBrush}" />
                                        </Border>
                                        <Border Classes="gamepad-mark" IsVisible="{Binding ShowTextureMark}">
                                            <PathIcon Width="16" Height="16"
                                                      Data="{StaticResource TexturePackLayersGeometry}"
                                                      Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Border IsVisible="{Binding !IsAvailable}"
                                            Background="#E1292D34" CornerRadius="5"
                                            Padding="9,5" Margin="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding UnavailableBadgeText}" FontSize="10" FontWeight="Bold"
                                                   LetterSpacing="0.9" Foreground="White" />
                                    </Border>
                                    <Border Classes="gamepad-hover-ring" IsHitTestVisible="False"
                                            CornerRadius="12" BorderBrush="{DynamicResource EmuStrongBorderBrush}"
                                            BorderThickness="2" />
                                  </Panel>
                                </Grid>
                                <TextBlock Grid.Row="1" Classes="gamepad-tile-title" Text="{Binding Title}"
                                           Margin="2,10,2,0" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"
                                           TextAlignment="Center" HorizontalAlignment="Stretch"
                                           VerticalAlignment="Top" MaxWidth="{Binding CoverWidth}" />
                            </Grid>
                        </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsLibraryEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
            <TextBlock Text="{Binding EmptyLibraryTitle}" FontSize="30" FontWeight="Bold"
                       TextAlignment="Center" />
            <TextBlock Text="No games are available in this view. Use Menu to switch to Desktop mode and add games."
                       FontSize="17" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            <Button x:Name="GamepadEmptyMenuButton"
                    Classes="gamepad-empty-action" HorizontalAlignment="Center"
                    Command="{Binding OpenGamepadMenuCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Classes="gamepad-key"><TextBlock Text="Start" /></Border>
                    <TextBlock Text="Menu" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsSearchEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="No matching games" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Press X to edit or clear the search."
                       FontSize="17" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Classes="status-toast" Classes.showing="{Binding HasStatusMessage}"
                Classes.progress="{Binding IsStatusProgress}"
                Classes.error="{Binding IsStatusError}"
                IsHitTestVisible="{Binding HasStatusMessage}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="560"
                Margin="36" Padding="16,12" CornerRadius="10"
                Background="{DynamicResource EmuPopoverBrush}"
                BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Panel VerticalAlignment="Center" Width="16" Height="16">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource EmuInfoBrush}"
                             IsVisible="{Binding IsStatusInfo}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource EmuProgressBrush}"
                             IsVisible="{Binding IsStatusProgress}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <PathIcon Width="16" Height="16" IsVisible="{Binding IsStatusError}"
                              Data="{StaticResource StatusWarningGeometry}"
                              Foreground="{DynamicResource EmuDangerBrush}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="15"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <!-- Messages expire on their own here as they do on the desktop, but a pointer is
                     still usable in Gamepad mode and this was previously the one toast with no
                     way at all to get rid of it. -->
                <Button Grid.Column="2" Width="30" Height="30" Padding="7"
                        CornerRadius="15" Background="Transparent" BorderThickness="0"
                        Command="{Binding ClearStatusCommand}" ToolTip.Tip="Dismiss">
                    <PathIcon Width="11" Height="11"
                              Data="M2,1 L10,9 L9,10 L1,2 Z M9,1 L10,2 L2,10 L1,9 Z" />
                </Button>
            </Grid>
        </Border>
        <Border x:Name="GamepadFocusedDock" Grid.Row="2" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,1,0,0"
                Padding="36,12">
            <Grid x:Name="GamepadDockPrimaryRow" IsVisible="{Binding HasGames}"
                  ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <StackPanel MinWidth="0" Margin="0,0,12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FocusedGame.SystemName}" FontSize="11" FontWeight="Bold"
                               LetterSpacing="1.2" Foreground="{DynamicResource EmuAccentBrush}" />
                    <TextBlock Text="{Binding FocusedGame.Title}" FontSize="23" FontWeight="Bold"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="GamepadFocusedSubtitle" Text="{Binding FocusedGame.GamepadSubtitle}"
                               FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>

                <Border x:Name="GamepadAchievementWidget" Grid.Column="1" Classes="gamepad-dock-pill"
                        ToolTip.Tip="{Binding FocusedGame.AchievementsTooltip}"
                        IsVisible="{Binding FocusedGame.ShowAchievementMark}"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource EmuFormatPillBrush}"
                                VerticalAlignment="Center">
                            <PathIcon Width="18" Height="18"
                                      Data="{StaticResource AchievementTrophyGeometry}"
                                      Foreground="{DynamicResource EmuAchievementBrush}" />
                        </Border>
                        <Grid Grid.Column="1" RowDefinitions="Auto,4" RowSpacing="5"
                              VerticalAlignment="Center">
                            <TextBlock Text="{Binding FocusedGame.GamepadAchievementCountText}"
                                       FontSize="15" FontWeight="Bold" />
                            <Border x:Name="GamepadAchievementTrack" Grid.Row="1"
                                    Width="122" Height="4" CornerRadius="2"
                                    HorizontalAlignment="Left" ClipToBounds="True"
                                    Background="{DynamicResource EmuFormatPillBrush}">
                                <Border x:Name="GamepadAchievementFill"
                                        Background="{DynamicResource EmuAchievementBrush}"
                                        RenderTransformOrigin="0%,50%">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding FocusedGame.GamepadAchievementProgressRatio}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="GamepadPlayButton" Grid.Column="2" Classes="gamepad-play-action"
                        Classes.controller-input="{Binding IsGamepadControllerInputActive}"
                        Command="{Binding LaunchFocusedGameCommand}"
                        IsEnabled="{Binding FocusedGame.IsAvailable}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="gamepad-key action-a" Width="32" Height="32">
                            <TextBlock Text="A" FontSize="13" />
                        </Border>
                        <TextBlock Text="PLAY" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!-- One in-window host owns all controller input while open. No Gamepad workflow opens a child window. -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding HasGamepadOverlay}" Background="#B9000000">
            <!-- The panel is the overlay's height budget: it keeps a margin off the screen edges,
                 and the overlay's MaxHeight tracks it so a 720p or windowed viewport shrinks the
                 sheet instead of clipping it. Height is the preferred size, not the actual one. -->
            <Panel x:Name="GamepadOverlayHost" Margin="36">
            <Border Classes="gamepad-overlay" Classes.system-menu="{Binding IsGamepadSystemMenuOpen}"
                    Classes.side-sheet="{Binding IsGameActionsOpen}"
                    Classes.achievements="{Binding IsGamepadAchievementsOpen}"
                    Classes.scraper="{Binding IsGamepadScraperOpen}"
                    Classes.settings="{Binding IsGamepadSettingsOpen}"
                    VerticalAlignment="Center"
                    MaxHeight="{Binding #GamepadOverlayHost.Bounds.Height}"
                    MaxWidth="{Binding #GamepadOverlayHost.Bounds.Width}"
                    Padding="28" CornerRadius="16" Background="{DynamicResource EmuPopoverBrush}"
                    BorderBrush="{DynamicResource EmuStrongBorderBrush}" BorderThickness="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <Grid>
                        <Grid IsVisible="{Binding IsGamepadAchievementsOpen}"
                              ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Achievements" FontSize="26" FontWeight="Bold" />
                                <TextBlock Text="{Binding GamepadAchievementDetails.GameTitle}"
                                           FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="16,9" CornerRadius="21"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource EmuFormatPillBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Width="17" Height="17"
                                              Data="{StaticResource AchievementTrophyGeometry}"
                                              Foreground="{DynamicResource EmuAchievementBrush}" />
                                    <TextBlock Text="{Binding GamepadAchievementDetails.ProgressAndPointsText}"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2" Classes="gamepad-achievement-command"
                                    Command="{Binding GamepadAchievementDetails.RefreshCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="gamepad-key action-x"><TextBlock Text="X" /></Border>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock IsVisible="{Binding ShowsGamepadOverlayChromeTitle}" Text="{Binding GamepadOverlayTitle}"
                                   FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="18">
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadAchievementsOpen}"
                              RowDefinitions="Auto,*" RowSpacing="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsAllFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.AllFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowAllAchievementsCommand}" />
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsLockedFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.LockedFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowLockedAchievementsCommand}" />
                                    <Button Classes="gamepad-achievement-tab"
                                            Classes.selected="{Binding GamepadAchievementDetails.IsUnlockedFilterSelected}"
                                            Content="{Binding GamepadAchievementDetails.UnlockedFilterText}"
                                            Command="{Binding GamepadAchievementDetails.ShowUnlockedAchievementsCommand}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="gamepad-achievement-command"
                                        Command="{Binding CycleGamepadAchievementSortCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="gamepad-key action-y"><TextBlock Text="Y" /></Border>
                                        <TextBlock Text="Sort:" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding GamepadAchievementDetails.SortText}"
                                                   VerticalAlignment="Center" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="24"
                                  IsVisible="{Binding GamepadAchievementDetails.HasVisibleAchievements}">
                                <Border Classes="gamepad-achievement-detail">
                                    <Grid>
                                        <StackPanel IsVisible="{Binding HasFocusedGamepadAchievement}"
                                                    Spacing="10">
                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                                                <Border Width="96" Height="96" CornerRadius="15"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource EmuCoverWellBrush}">
                                                    <Grid Classes="gamepad-achievement-badge"
                                                          Classes.locked="{Binding FocusedGamepadAchievement.IsLocked}">
                                                        <PathIcon Width="32" Height="32"
                                                                  IsVisible="{Binding !FocusedGamepadAchievement.HasBadge}"
                                                                  Data="{StaticResource AchievementTrophyGeometry}"
                                                                  Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                        <Image Source="{Binding FocusedGamepadAchievement.Badge}"
                                                               IsVisible="{Binding FocusedGamepadAchievement.HasBadge}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="5"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FocusedGamepadAchievement.Title}"
                                                               FontSize="21" FontWeight="Bold"
                                                               TextWrapping="Wrap" MaxLines="2"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FocusedGamepadAchievement.Description}"
                                                               FontSize="14" TextWrapping="Wrap" MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Padding="10,5" CornerRadius="12"
                                                        Background="{DynamicResource EmuFormatPillBrush}">
                                                    <TextBlock Text="{Binding FocusedGamepadAchievement.PointsText}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Border Padding="10,5" CornerRadius="12"
                                                        Background="{DynamicResource EmuFormatPillBrush}">
                                                    <TextBlock Text="{Binding FocusedGamepadAchievement.UnlockStateText}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FocusedGamepadAchievement.EarnedText}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row-virtualized grid: a ListBox renders one ROW per line and its
                                     VirtualizingStackPanel realizes only the on-screen rows. Each row
                                     holds exactly GamepadAchievementColumnCount tiles, so the rendered
                                     column count always equals the navigation stride, and it has none of
                                     the phantom-cell / top-left-hole defects a virtualized
                                     UniformGridLayout had (which dropped achievement tiles). The ListBox
                                     is a passive renderer — the focus ring is driven by IsFocused on the
                                     flat VisibleAchievements list, not its selection — so its
                                     selection/focus visuals are styled away below. -->
                                <ListBox x:Name="GamepadAchievementRowList" Grid.Column="1"
                                         ItemsSource="{Binding GamepadAchievementRows}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         SizeChanged="OnGamepadAchievementsSizeChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FocusAdorner" Value="{x:Null}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter,
                                                         ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- One row of badge tiles. 6px side padding gives the first/last
                                                 tile's focus glow room inside the row container; 12px gutters
                                                 match the old grid. -->
                                            <ItemsControl ItemsSource="{Binding}" Margin="0,6,0,6" Padding="6,0,6,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AchievementRowViewModel">
                                                        <Panel Classes="gamepad-achievement-tile"
                                                               Classes.focused="{Binding IsFocused}"
                                                               ClipToBounds="False" Focusable="True"
                                                               PointerPressed="OnGamepadAchievementPointerPressed"
                                                               AttachedToVisualTree="OnGamepadAchievementAttached"
                                                               DataContextChanged="OnGamepadAchievementDataContextChanged">
                                                            <!-- Same accent frame as the library grid: a solid pad
                                                                 BEHIND the tile, 6px larger with a concentric radius
                                                                 (14 + 6), so the opaque tile masks its centre and it
                                                                 reads as an even 6px accent frame. Must stay
                                                                 first/bottom-most; shown by opacity on .focused. -->
                                                            <Border Classes="gamepad-focus-tile-ring" IsHitTestVisible="False"
                                                                    Margin="-6" CornerRadius="20"
                                                                    Background="{DynamicResource EmuAccentBrush}"
                                                                    BoxShadow="{DynamicResource EmuFocusGlow}" />
                                                            <Border Classes="gamepad-achievement">
                                                                <Grid Classes="gamepad-achievement-badge"
                                                                      Classes.locked="{Binding IsLocked}">
                                                                    <PathIcon Width="30" Height="30"
                                                                              IsVisible="{Binding !HasBadge}"
                                                                              Data="{StaticResource AchievementTrophyGeometry}"
                                                                              Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    <Image Source="{Binding Badge}" IsVisible="{Binding HasBadge}"
                                                                           Stretch="UniformToFill" />
                                                                </Grid>
                                                            </Border>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Grid.Row="1"
                                    IsVisible="{Binding GamepadAchievementDetails.HasFilteredEmptyState}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="24,20" CornerRadius="12"
                                    Background="{DynamicResource EmuCardBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding GamepadAchievementDetails.FilterEmptyStateText}"
                                           FontSize="18" FontWeight="SemiBold" />
                            </Border>

                            <Border Grid.Row="1"
                                    IsVisible="{Binding !GamepadAchievementDetails.HasAchievements}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="390" Padding="24,20" CornerRadius="12"
                                    Background="{DynamicResource EmuCardBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <ProgressBar IsVisible="{Binding GamepadAchievementDetails.IsRefreshing}"
                                                 IsIndeterminate="True" Height="4" />
                                    <TextBlock Text="{Binding GamepadAchievementDetails.EmptyStateTitle}"
                                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding GamepadAchievementDetails.EmptyStateDescription}"
                                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadSettingsOpen}"
                              ColumnDefinitions="1*,3*" ColumnSpacing="26">
                            <Border Grid.Column="0" Padding="16" CornerRadius="14"
                                    Background="{DynamicResource EmuWindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
                                        <TextBlock Text="‹ or LB / RB for sections" FontSize="12"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource EmuBorderBrush}" />
                                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <Button Grid.Row="0" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsGeneralSection}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.General}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsGeneralSection}" />
                                                <TextBlock Grid.Column="1" Text="General" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="1" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsRetroAchievementsSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasRetroAchievements}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.RetroAchievements}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsRetroAchievementsSection}" />
                                                <TextBlock Grid.Column="1" Text="RetroAchievements" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="2" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsSavesSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasCloudSaves}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.Saves}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsSavesSection}" />
                                                <TextBlock Grid.Column="1" Text="Saves" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="3" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsTexturePacksSection}"
                                                IsVisible="{Binding GamepadSettings.Settings.HasTexturePacks}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectSectionCommand}"
                                                CommandParameter="{x:Static vm:SettingsSection.TexturePacks}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsTexturePacksSection}" />
                                                <TextBlock Grid.Column="1" Text="Texture Packs" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="4" Classes="gamepad-settings-nav" Classes.rail-active="{Binding GamepadSettings.IsRailFocused}"
                                                Classes.selected="{Binding GamepadSettings.IsThemesSection}"
                                                IsVisible="{Binding GamepadSettings.ShowThemes}"
                                                Focusable="False"
                                                Command="{Binding GamepadSettings.SelectThemesCommand}">
                                            <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                                <Border Width="5" CornerRadius="3"
                                                        Background="{DynamicResource EmuAccentBrush}"
                                                        IsVisible="{Binding GamepadSettings.IsThemesSection}" />
                                                <TextBlock Grid.Column="1" Text="Themes" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Button x:Name="GamepadSettingsSaveButton" Grid.Row="3"
                                            Classes="gamepad-settings-save"
                                            Classes.focused="{Binding GamepadSettings.SaveRow.IsFocused}"
                                            IsEnabled="{Binding GamepadSettings.SaveRow.IsEnabled}"
                                            Command="{Binding GamepadSettings.SaveRow.SelectCommand}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Classes="gamepad-key"><TextBlock Text="START" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Save and close" FontWeight="Bold" />
                                                <TextBlock Text="Apply changes" FontSize="11"
                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16"
                                  Classes.rail-dimmed="{Binding GamepadSettings.IsRailFocused}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding GamepadSettings.SectionTitle}"
                                                   FontSize="24" FontWeight="Bold" />
                                        <TextBlock Text="{Binding GamepadSettings.SectionDescription}"
                                                   FontSize="13" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" IsVisible="{Binding GamepadSettings.HasStatus}"
                                            MaxWidth="430" Padding="14,9" CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource EmuFormatPillBrush}"
                                            BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding GamepadSettings.StatusText}"
                                                   FontSize="12" TextWrapping="Wrap" MaxLines="3"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="GamepadSettingsScroller"
                                                  IsVisible="{Binding GamepadSettings.IsRowsVisible}"
                                                  Classes="gamepad-scroll"
                                                  SizeChanged="OnGamepadSettingsScrollerSizeChanged"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsRepeater x:Name="GamepadSettingsRows"
                                                       HorizontalAlignment="Left"
                                                       ItemsSource="{Binding GamepadSettings.Rows}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GamepadSettingsRowViewModel">
                                                    <Panel>
                                                        <!-- Non-focusable platform group header: artwork + name give the
                                                             section a visible hierarchy over a flat list of equal rows. -->
                                                        <Grid IsVisible="{Binding IsHeader}"
                                                              ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                                              Margin="0,16,0,8">
                                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                                <Image Width="26" Height="26"
                                                                       Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                                       RenderOptions.BitmapInterpolationMode="None" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15"
                                                                       FontWeight="Bold" LetterSpacing="0.4" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </Grid>

                                                        <Button Classes="gamepad-settings-row"
                                                                Classes.focused="{Binding IsFocused}"
                                                                Classes.destructive="{Binding IsDestructive}"
                                                                Classes.info="{Binding IsInformation}"
                                                                Classes.grouped="{Binding IsGrouped}"
                                                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                                IsVisible="{Binding IsNormalRow}"
                                                                IsEnabled="{Binding IsEnabled}"
                                                                HorizontalAlignment="Stretch"
                                                                AutomationProperties.AutomationId="{Binding ParityId}"
                                                                Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                                            <!-- Leading icon: platform artwork for platform-scoped rows,
                                                                 otherwise a glyph that categorises the row. Read-only info
                                                                 rows stay icon-free so inventory reads as a light list. -->
                                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding !IsInformation}"
                                                                    Background="{DynamicResource EmuPlaceholderMedallionBrush}">
                                                                <Panel>
                                                                    <Image Width="30" Height="30"
                                                                           IsVisible="{Binding HasPlatformIcon}"
                                                                           Source="{Binding SystemId, Converter={x:Static vm:PlatformArtwork.Converter}}"
                                                                           RenderOptions.BitmapInterpolationMode="None" />
                                                                    <TextBlock IsVisible="{Binding !HasPlatformIcon}"
                                                                               Text="{Binding LeadingGlyph}" FontSize="19"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                </Panel>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="{Binding Label}" FontSize="17"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" FontSize="12.5"
                                                                           TextWrapping="Wrap" MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                            </StackPanel>

                                                            <Border Grid.Column="2" Classes="gamepad-settings-switch"
                                                                    Classes.on="{Binding IsToggleOn}"
                                                                    IsVisible="{Binding IsToggle}"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Value}"
                                                                               IsVisible="{Binding !IsToggleOn}"
                                                                               Margin="0,0,14,0" HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding Value}"
                                                                               IsVisible="{Binding IsToggleOn}"
                                                                               Margin="14,0,0,0" HorizontalAlignment="Left"
                                                                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
                                                                    <Border Width="40" Height="40" Margin="4"
                                                                            IsVisible="{Binding !IsToggleOn}"
                                                                            HorizontalAlignment="Left" CornerRadius="20"
                                                                            Background="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    <Border Width="40" Height="40" Margin="4"
                                                                            IsVisible="{Binding IsToggleOn}"
                                                                            HorizontalAlignment="Right" CornerRadius="20"
                                                                            Background="{DynamicResource EmuAccentBrush}">
                                                                        <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" Foreground="{DynamicResource EmuWindowBackgroundBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Column="2" Classes="gamepad-settings-affordance"
                                                                    IsVisible="{Binding IsChoice}"
                                                                    VerticalAlignment="Center" MinWidth="250">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <TextBlock Text="‹" FontSize="24" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuAccentBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               TextAlignment="Center" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuAccentBrush}" />
                                                                </Grid>
                                                            </Border>

                                                            <Grid Grid.Column="2" IsVisible="{Binding IsEditableValue}"
                                                                  Width="380" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                                                  VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                                                                           TextAlignment="Right" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                <Border Grid.Column="1" Classes="gamepad-settings-action-button">
                                                                    <TextBlock Text="{Binding ActionGlyph}" FontSize="24" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuWindowBackgroundBrush}" />
                                                                </Border>
                                                            </Grid>

                                                            <Border Grid.Column="2" Classes="gamepad-settings-action-button"
                                                                    IsVisible="{Binding IsAction}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ActionGlyph}" FontSize="24" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EmuWindowBackgroundBrush}" />
                                                            </Border>

                                                            <TextBlock Grid.Column="2" IsVisible="{Binding IsInformation}"
                                                                       Text="{Binding Value}" MaxWidth="390"
                                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                                       TextWrapping="Wrap" MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </Grid>
                                                    </Button>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="GamepadThemeScroller"
                                                  IsVisible="{Binding GamepadSettings.IsThemesVisible}"
                                                  Classes="gamepad-scroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="GamepadThemeGallery"
                                                      ItemsSource="{Binding GamepadSettings.ThemeChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                                                    <Button Classes="gamepad-theme-card"
                                                            Classes.focused="{Binding IsFocused}"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).GamepadSettings.SelectThemeChoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                                            <!-- A miniature app window rendered from the palette's own
                                                                 swatches, so the card previews the theme without a
                                                                 hardcoded color anywhere. -->
                                                            <Border Grid.Row="0" CornerRadius="12" Height="112" ClipToBounds="True"
                                                                    Background="{Binding PreviewBackground}"
                                                                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                                                                <Grid Margin="14" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewAccent}" />
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewText}" Opacity="0.45" />
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding PreviewText}" Opacity="0.25" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Row="1" ColumnDefinitions="*,2.4*,*" ColumnSpacing="8">
                                                                        <Border Background="{Binding PreviewSurface}" CornerRadius="6" />
                                                                        <Border Grid.Column="1" Background="{Binding PreviewSurface}" CornerRadius="6">
                                                                            <Border Width="34" Height="34" CornerRadius="17"
                                                                                    Background="{Binding PreviewAccent}"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="2" Background="{Binding PreviewSurface}" CornerRadius="6" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                                                        <Border Width="26" Height="8" CornerRadius="4" Background="{Binding PreviewAccent}" />
                                                                        <Border Width="46" Height="8" CornerRadius="4"
                                                                                Background="{Binding PreviewText}" Opacity="0.3" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="1" IsVisible="{Binding IsSelected}"
                                                                        Width="26" Height="26" CornerRadius="13"
                                                                        Background="{DynamicResource EmuAccentBrush}">
                                                                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource EmuWindowBackgroundBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border IsVisible="{Binding GamepadSettings.IsTextEntryOpen}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            MaxWidth="700" Margin="24" Padding="24" CornerRadius="16"
                                            Background="{DynamicResource EmuCardBrush}"
                                            BorderBrush="{DynamicResource EmuAccentBrush}" BorderThickness="2">
                                        <StackPanel Spacing="13">
                                            <TextBlock Text="{Binding GamepadSettings.TextEntryTitle}"
                                                       FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{Binding GamepadSettings.TextEntryDescription}"
                                                       TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <TextBox x:Name="GamepadSettingsTextBox"
                                                     IsVisible="{Binding !GamepadSettings.IsSecretEntry}"
                                                     Text="{Binding GamepadSettings.DraftText, Mode=TwoWay}"
                                                     FontSize="22" KeyDown="OnGamepadTextInputKeyDown" />
                                            <TextBox x:Name="GamepadSettingsSecretBox"
                                                     IsVisible="{Binding GamepadSettings.IsSecretEntry}"
                                                     Text="{Binding GamepadSettings.DraftText, Mode=TwoWay}"
                                                     PasswordChar="●" FontSize="22"
                                                     KeyDown="OnGamepadTextInputKeyDown" />
                                            <TextBlock Text="{Binding GamepadSettings.KeyboardHint}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                                <Button Classes="gamepad-settings-confirm" Content="Cancel"
                                                        Command="{Binding GamepadSettings.DismissTextEntryCommand}" />
                                                <Button Classes="gamepad-settings-confirm focused" Content="Save entry"
                                                        Command="{Binding GamepadSettings.SaveTextEntryCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding GamepadSettings.IsConfirmationOpen}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            MaxWidth="700" Margin="24" Padding="26" CornerRadius="16"
                                            Background="{DynamicResource EmuCardBrush}"
                                            BorderBrush="{DynamicResource EmuDangerBrush}" BorderThickness="2">
                                        <StackPanel Spacing="15">
                                            <TextBlock Text="{Binding GamepadSettings.ConfirmationTitle}"
                                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GamepadSettings.ConfirmationText}"
                                                       FontSize="15" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                                <Button x:Name="GamepadSettingsKeepButton"
                                                        Classes="gamepad-settings-confirm"
                                                        Classes.focused="{Binding !GamepadSettings.IsConfirmChoiceSelected}"
                                                        Content="Keep current"
                                                        Command="{Binding GamepadSettings.ChooseConfirmationCancelCommand}" />
                                                <Button x:Name="GamepadSettingsConfirmButton"
                                                        Classes="gamepad-settings-confirm danger"
                                                        Classes.focused="{Binding GamepadSettings.IsConfirmChoiceSelected}"
                                                        Content="Confirm"
                                                        Command="{Binding GamepadSettings.ChooseConfirmationConfirmCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid x:Name="GamepadSystemMenuShortcuts"
                              IsVisible="{Binding IsGamepadSystemMenuOpen}"
                              ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Classes="gamepad-hint" Orientation="Horizontal">
                                    <Border Classes="gamepad-key"><TextBlock Text="LB/RB" /></Border>
                                    <TextBlock Text="Platforms" />
                                </StackPanel>
                                <StackPanel Classes="gamepad-hint" Orientation="Horizontal">
                                    <Border Classes="gamepad-key action-x"><TextBlock Text="X" /></Border>
                                    <TextBlock Text="Search" />
                                </StackPanel>
                                <StackPanel x:Name="GamepadSystemMenuActionsShortcut"
                                            Classes="gamepad-hint" Orientation="Horizontal"
                                            IsVisible="{Binding HasGames}">
                                    <Border Classes="gamepad-key action-y"><TextBlock Text="Y" /></Border>
                                    <TextBlock Text="Actions" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding LibraryCountText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsGamepadSearchOpen}" Spacing="14">
                            <TextBlock Text="Search your library" FontSize="17" />
                            <TextBox x:Name="GamepadSearchBox" Text="{Binding SearchText, Mode=TwoWay}" FontSize="24"
                                     PlaceholderText="Enter a game title" KeyDown="OnGamepadTextInputKeyDown" />
                            <TextBlock Text="{Binding LibraryCountText}" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGamepadRenameOpen}" Spacing="14">
                            <TextBlock Text="Enter a new title" FontSize="17" />
                            <TextBlock Text="{Binding FocusedGame.Title}" FontSize="16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                            <TextBox x:Name="GamepadRenameBox" Text="{Binding FocusedGame.DraftTitle, Mode=TwoWay}" FontSize="24"
                                     PlaceholderText="Steam + X opens the on-screen keyboard" KeyDown="OnGamepadTextInputKeyDown" />
                        </StackPanel>
                        <StackPanel x:Name="GamepadRemoveBody" IsVisible="{Binding IsGamepadRemoveOpen}" Spacing="12">
                            <TextBlock Text="Remove this game from your library?" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FocusedGame.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="This removes only EmuShelf’s library record. Your game files and cover files are not deleted."
                                       TextWrapping="Wrap" Foreground="{DynamicResource EmuTextSecondaryBrush}" FontSize="16" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGamepadCoverHandoffOpen}" Spacing="12">
                            <TextBlock Text="Set cover in Desktop mode" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Choosing an image needs the platform file picker, which is not controller-safe in Gamepad mode. Continue only if you want to leave Gamepad mode."
                                       TextWrapping="Wrap" Foreground="{DynamicResource EmuTextSecondaryBrush}" FontSize="16" />
                        </StackPanel>
                        <!-- Controller-native ScreenScraper scraper: the shared GameScraperViewModel
                             with a D-pad focus model layered on top; never hands off to Desktop. -->
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsGamepadScraperOpen}">
                            <Grid DataContext="{Binding GamepadScraperDetails}" x:DataType="vm:GamepadScraperViewModel"
                                  RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Scraper.GameTitle}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Scraper.QuotaText}" FontSize="12"
                                               IsVisible="{Binding Scraper.QuotaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                </StackPanel>

                                <Panel Grid.Row="1">
                                    <!-- Loading -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowLoading}" Width="360"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <ProgressBar IsIndeterminate="True" Height="4" />
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Terminal messages: applied / failure / unsupported -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowMessage}" Width="470"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="16" />
                                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Border Classes="gamepad-key action-b"><TextBlock Text="B" /></Border>
                                            <TextBlock Text="Back to library" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Fingerprint consent (auto-hash is default, but handle it) -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowConsent}" Width="450"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <TextBlock Text="{Binding Scraper.StatusMessage}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="15"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsComputeFocused}"
                                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                                Command="{Binding Scraper.ComputeFingerprintCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Compute hash and match" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Connect (not connected / provider disabled) -->
                                    <StackPanel IsVisible="{Binding Scraper.ShowConnect}" Width="440"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <TextBlock Text="Connect your ScreenScraper account" FontSize="18"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Sign in with your screenscraper.fr username and password. Press Steam + X for the on-screen keyboard."
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <TextBox x:Name="GamepadScraperUsernameBox" Classes="gamepad-scraper-field"
                                                 Classes.focused="{Binding IsUsernameFocused}" FontSize="18"
                                                 Text="{Binding Scraper.Username, Mode=TwoWay}" PlaceholderText="Username"
                                                 KeyDown="OnGamepadScraperTextKeyDown" />
                                        <TextBox x:Name="GamepadScraperPasswordBox" Classes="gamepad-scraper-field"
                                                 Classes.focused="{Binding IsPasswordFocused}" FontSize="18"
                                                 Text="{Binding Scraper.Password, Mode=TwoWay}" PasswordChar="•"
                                                 PlaceholderText="Password" KeyDown="OnGamepadScraperTextKeyDown" />
                                        <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsConnectFocused}"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding Scraper.ConnectCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                <TextBlock Text="Connect" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar IsIndeterminate="True" Height="3"
                                                     IsVisible="{Binding Scraper.IsConnecting}" />
                                        <TextBlock Text="{Binding Scraper.ConnectStatus}" TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   IsVisible="{Binding Scraper.ConnectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- No exact match: title search + candidate list -->
                                    <Grid IsVisible="{Binding Scraper.ShowSearch}" RowDefinitions="Auto,Auto,*" Margin="4">
                                        <TextBlock Grid.Row="0" Text="{Binding Scraper.StatusMessage}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                            <TextBox Grid.Column="0" x:Name="GamepadScraperSearchBox"
                                                     Classes="gamepad-scraper-field"
                                                     Classes.focused="{Binding IsSearchFieldFocused}" FontSize="18"
                                                     Text="{Binding Scraper.SearchQuery, Mode=TwoWay}"
                                                     PlaceholderText="Game title" KeyDown="OnGamepadScraperTextKeyDown" />
                                            <Button Grid.Column="1" Classes="gamepad-modal-option" MinWidth="130"
                                                    Classes.focused="{Binding IsSearchFocused}"
                                                    HorizontalContentAlignment="Center"
                                                    Command="{Binding Scraper.SearchCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                    <TextBlock Text="Search" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2"
                                                     IsIndeterminate="True" IsVisible="{Binding Scraper.IsSearching}" />
                                        <ScrollViewer Grid.Row="2" Classes="gamepad-scroll"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Candidates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GamepadScraperCandidateViewModel">
                                                        <Button Classes="gamepad-modal-option" Margin="0,3,0,0"
                                                                Classes.focused="{Binding IsFocused}"
                                                                Command="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).GamepadScraperDetails.Scraper.SelectCandidateCommand}"
                                                                CommandParameter="{Binding Match}">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding System}" FontSize="11"
                                                                           IsVisible="{Binding HasSystem}"
                                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Ready: pick fields + media, box art alongside, then Apply -->
                                    <Grid IsVisible="{Binding Scraper.ShowData}" ColumnDefinitions="*,Auto"
                                          RowDefinitions="*,Auto" ColumnSpacing="20">
                                        <ScrollViewer Grid.Row="0" Grid.Column="0" Classes="gamepad-scroll"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="2">
                                                <ItemsControl ItemsSource="{Binding Scraper.Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ScraperFieldRowViewModel">
                                                            <Border Classes="gamepad-scraper-row"
                                                                    Classes.focused="{Binding IsFocused}">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                                              IsEnabled="{Binding CanApply}"
                                                                              VerticalAlignment="Top" />
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ProposedValue}"
                                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                        <TextBlock Text="Kept — you edited this"
                                                                                   FontSize="11"
                                                                                   IsVisible="{Binding IsUserOwned}"
                                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Classes="gamepad-scraper-row"
                                                        Classes.focused="{Binding Scraper.BoxArtRow.IsFocused}"
                                                        IsVisible="{Binding Scraper.BoxArtRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                        <CheckBox IsChecked="{Binding Scraper.BoxArtRow.IsSelected}"
                                                                  IsEnabled="{Binding Scraper.BoxArtRow.CanApply}"
                                                                  VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="64" Height="84" CornerRadius="5"
                                                                ClipToBounds="True" VerticalAlignment="Center"
                                                                Background="{DynamicResource EmuCoverWellBrush}">
                                                            <Image Source="{Binding Scraper.BoxArtRow.Preview}"
                                                                   Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Scraper.BoxArtRow.Label}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Scraper.BoxArtRow.ProposedText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Scraper.OtherMedia}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ScraperMediaRowViewModel">
                                                            <Border Classes="gamepad-scraper-row"
                                                                    Classes.focused="{Binding IsFocused}">
                                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                                              IsEnabled="{Binding CanApply}"
                                                                              VerticalAlignment="Center" />
                                                                    <Border Grid.Column="1" Width="64" Height="84"
                                                                            CornerRadius="5" ClipToBounds="True"
                                                                            VerticalAlignment="Center"
                                                                            Background="{DynamicResource EmuCoverWellBrush}">
                                                                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="2" Spacing="2"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ProposedText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                                        <TextBlock Text="Kept — your image" FontSize="11"
                                                                                   IsVisible="{Binding IsUserOwned}"
                                                                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,12,0,0">
                                            <Border Classes="gamepad-scraper-row"
                                                    Classes.focused="{Binding IsRefreshFocused}">
                                                <CheckBox Content="Replace values ScreenScraper already set"
                                                          IsChecked="{Binding Scraper.RefreshOwnedValues}" />
                                            </Border>
                                            <Button Classes="gamepad-modal-option" Classes.focused="{Binding IsApplyFocused}"
                                                    HorizontalContentAlignment="Center"
                                                    Command="{Binding Scraper.ApplyCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                                                    <TextBlock Text="Apply selected" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding Scraper.StatusMessage}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Border Classes="gamepad-scraper-cover">
                                                <Panel>
                                                    <TextBlock Text="No box art" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="12"
                                                               IsVisible="{Binding Scraper.BoxArtPreview, Converter={x:Static ObjectConverters.IsNull}}"
                                                               Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                    <Image Source="{Binding Scraper.BoxArtPreview}" Stretch="Uniform" />
                                                </Panel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Grid>
                        </Grid>
                        <StackPanel IsVisible="{Binding IsGamepadDesktopModeConfirmationOpen}" Spacing="12">
                            <TextBlock Text="Gamepad mode will close and the desktop library will be shown."
                                       TextWrapping="Wrap" FontSize="18" />
                            <TextBlock Text="Press B to stay in Gamepad mode."
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" FontSize="16" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsGamepadQuitConfirmationOpen}" Spacing="12">
                            <TextBlock Text="Any running library work will stop and EmuShelf will close. Your game files are never changed."
                                       TextWrapping="Wrap" FontSize="18" />
                            <TextBlock Text="Press B to keep EmuShelf open."
                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" FontSize="16" />
                        </StackPanel>

                        <ScrollViewer x:Name="GamepadOverlayOptionsScroller" Classes="gamepad-scroll"
                                      Grid.Row="1" MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding ShowsGamepadOverlayOptions}">
                            <ItemsControl x:Name="GamepadOverlayOptions" Classes="gamepad-overlay-options"
                                          Margin="0,0,18,0"
                                          Classes.top-aligned="{Binding AreGamepadOverlayOptionsTopAligned}"
                                          ItemsSource="{Binding GamepadOverlayOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamepadOverlayOptionViewModel">
                                        <Button Classes="gamepad-modal-option"
                                                Classes.destructive="{Binding IsDestructive}"
                                                Classes.controller-input="{Binding #GamepadRoot.((vm:MainViewModel)DataContext).IsGamepadControllerInputActive}"
                                                Classes.focused="{Binding IsFocused}" Content="{Binding Label}" Command="{Binding Command}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel x:Name="GamepadOverlayHints" Grid.Row="2" Orientation="Horizontal" Spacing="18">
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding UsesGamepadDefaultOverlayHints}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Choose" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadAchievementsOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="LB/RB" /></Border>
                            <TextBlock Text="Filter" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Browse" />
                            <Border Classes="gamepad-key action-y" Margin="8,0,0,0"><TextBlock Text="Y" /></Border>
                            <TextBlock Text="Sort" />
                            <Border Classes="gamepad-key action-x" Margin="8,0,0,0"><TextBlock Text="X" /></Border>
                            <TextBlock Text="Refresh" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSearchOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="Steam+X" /></Border>
                            <TextBlock Text="Keyboard" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                     IsVisible="{Binding IsGamepadRenameOpen}">
                            <Border Classes="gamepad-key action-a"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Save" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadScraperOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Move" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="Steam+X" /></Border>
                            <TextBlock Text="Keyboard" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                        <StackPanel Classes="gamepad-hint" Orientation="Horizontal"
                                    IsVisible="{Binding IsGamepadSettingsOpen}">
                            <Border Classes="gamepad-key"><TextBlock Text="D-pad" /></Border>
                            <TextBlock Text="Navigate" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="‹" /></Border>
                            <TextBlock Text="Sections" />
                            <Border Classes="gamepad-key action-a" Margin="8,0,0,0"><TextBlock Text="A" /></Border>
                            <TextBlock Text="Select" />
                            <Border Classes="gamepad-key" Margin="8,0,0,0"><TextBlock Text="START" /></Border>
                            <TextBlock Text="Save" />
                            <Border Classes="gamepad-key action-b" Margin="8,0,0,0"><TextBlock Text="B" /></Border>
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </Panel>
        </Grid>
    </Grid>

    <!-- Borderless chrome keeps the theme continuous on Windows 10/11. Thin native-role grips
         retain ordinary edge and corner resizing without putting platform behavior in the view
         model or replacing Avalonia's window sizing implementation. -->
    <Border Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeW" />
    <Border Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeE" />
    <Border Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeN" />
    <Border Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeS" />
    <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNW" />
    <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNE" />
    <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSW" />
    <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>
</Window>
