<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmuShelf.App.ViewModels"
        x:Class="EmuShelf.App.Views.AchievementDetailsWindow"
        x:DataType="vm:AchievementDetailsViewModel"
        Title="Achievements"
        Icon="avares://EmuShelf/Assets/emushelf.ico"
        Width="660" Height="590"
        MinWidth="470" MinHeight="390"
        Background="{DynamicResource EmuWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.achievement-row">
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.achievement-badge-panel">
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="Border.achievement-badge">
            <Setter Property="Background" Value="{DynamicResource EmuCoverWellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.achievement-reward-panel">
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.achievement-state">
            <Setter Property="Background" Value="{DynamicResource EmuCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EmuStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style Selector="Border.achievement-state.unlocked">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
            <Setter Property="Background" Value="{DynamicResource EmuFormatPillBrush}" />
        </Style>
        <Style Selector="Border.achievement-state.unlocked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EmuAchievementBrush}" />
        </Style>
        <!-- A hardcore unlock is marked by a gold ring around the badge (a hardcore unlock always
             implies the softcore one, so the list stays the standard softcore view). -->
        <Style Selector="Border.achievement-badge.hardcore">
            <Setter Property="BorderBrush" Value="{DynamicResource EmuAchievementBrush}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ACHIEVEMENTS" FontSize="10" FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                        <TextBlock Text="{Binding GameTitle}" FontSize="21" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsRefreshing}"
                            VerticalAlignment="Center" />
                </Grid>
                <!-- Softcore (silver) and hardcore (gold) as two parallel rows: mode + count, a bar, and
                     that mode's points, aligned in shared columns so the two read as a matched pair. A
                     hardcore unlock implies the softcore one, so the gold bar can only trail the silver. -->
                <Border Background="{DynamicResource EmuFormatPillBrush}" CornerRadius="10"
                        Padding="14,12" IsVisible="{Binding HasAchievements}">
                    <Grid ColumnDefinitions="132,*,96" RowDefinitions="Auto,Auto"
                          ColumnSpacing="16" RowSpacing="11">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProgressText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                        <ProgressBar x:Name="AchievementProgress" Grid.Row="0" Grid.Column="1"
                                     Minimum="0" Maximum="{Binding ProgressMaximum}"
                                     Value="{Binding UnlockedCount}" Height="7" VerticalAlignment="Center"
                                     Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PointsText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{DynamicResource EmuAchievementSoftcoreBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding HardcoreProgressText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource EmuAchievementBrush}" />
                        <ProgressBar x:Name="AchievementHardcoreProgress" Grid.Row="1" Grid.Column="1"
                                     Minimum="0" Maximum="{Binding ProgressMaximum}"
                                     Value="{Binding HardcoreUnlockedCount}" Height="7" VerticalAlignment="Center"
                                     Foreground="{DynamicResource EmuAchievementBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HardcorePointsText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{DynamicResource EmuAchievementBrush}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding LastRefreshText}" IsVisible="{Binding HasAchievements}"
                           FontSize="10.5" HorizontalAlignment="Right"
                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource EmuTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="AchievementScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AchievementList" ItemsSource="{Binding Achievements}"
                              HorizontalAlignment="Stretch"
                              Width="{Binding Viewport.Width, ElementName=AchievementScrollViewer}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementRowViewModel">
                            <!-- Console achievement pattern: a fixed icon tile, a readable
                                 description field, and a dedicated reward/status dock. -->
                            <Border Classes="achievement-row" Height="128" Margin="16,6">
                                <Grid ColumnDefinitions="88,*,152" ClipToBounds="True">
                                    <Border Classes="achievement-badge-panel">
                                        <Border Classes="achievement-badge" Width="64" Height="64"
                                                Classes.hardcore="{Binding IsHardcore}"
                                                ClipToBounds="True" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Panel>
                                                <TextBlock Text="★" FontSize="26" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource EmuAchievementBrush}" />
                                                <Image Source="{Binding Badge}" IsVisible="{Binding HasBadge}"
                                                       Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                    </Border>

                                    <Border Grid.Column="1" Padding="16,13">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                            <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Text="{Binding EarnedText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                        </Grid>
                                    </Border>

                                    <!-- These two cells are deliberately independent of the
                                         description, mirroring the fixed reward dock in console
                                         achievement lists. -->
                                    <Border Grid.Column="2" Classes="achievement-reward-panel">
                                        <Grid RowDefinitions="*,1,*">
                                            <StackPanel Classes="achievement-points-zone"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="REWARD" FontSize="8.5" FontWeight="Bold"
                                                           LetterSpacing="0.8" TextAlignment="Center"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                <TextBlock Text="{Binding PointsText}" FontSize="13"
                                                           FontWeight="SemiBold" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Row="1"
                                                    Background="{DynamicResource EmuStrongBorderBrush}" />
                                            <StackPanel Grid.Row="2" Classes="achievement-status-zone"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="STATUS" FontSize="8.5" FontWeight="Bold"
                                                           LetterSpacing="0.8" TextAlignment="Center"
                                                           Foreground="{DynamicResource EmuTextTertiaryBrush}" />
                                                <Border Classes="achievement-state"
                                                        Classes.unlocked="{Binding IsUnlocked}">
                                                    <TextBlock Text="{Binding UnlockStateText}" FontSize="10"
                                                               FontWeight="SemiBold" TextAlignment="Center"
                                                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border IsVisible="{Binding !HasAchievements}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330"
                    Padding="22,18" CornerRadius="10"
                    Background="{DynamicResource EmuCardBrush}"
                    BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding EmptyStateTitle}" FontSize="15" FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource EmuTextPrimaryBrush}" />
                    <TextBlock Text="{Binding EmptyStateDescription}" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource EmuTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource EmuToolbarBrush}"
                BorderBrush="{DynamicResource EmuBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button Content="Close" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" IsCancel="True" />
        </Border>
    </Grid>
</Window>
