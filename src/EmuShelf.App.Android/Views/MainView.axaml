<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EmuShelf.App.Views"
             xmlns:vm="using:EmuShelf.App.ViewModels"
             x:Class="EmuShelf.App.Android.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0b0d12">

    <!--
      The Android single-view head hosts the real gamepad shell — the same GamepadShellView extracted
      from the desktop MainWindow (couch UI subtree + GLES CRT tube). The head forces Gamepad mode, so
      GamepadShellView's GamepadRoot (IsVisible=IsGamepadMode) is always shown and its shelf renders
      through the same OpenGlControlBase path proven on the AVD. GamepadShellView inherits this view's
      DataContext (the shared MainViewModel the composition root builds), so it wires its own couch
      subscriptions exactly as it does inside the desktop window.

      Couch input is handled at the Activity level (MainActivity.DispatchKeyEvent), because Android
      gamepad buttons arrive as Activity key events that Avalonia's own KeyDown does not surface. Full
      native analog-stick reading and IME are the rest of Milestone C.
    -->
    <Panel>
        <views:GamepadShellView />

        <!--
          While a game runs on the external screen, the second-screen companion swaps onto this built-in
          panel (SecondScreenController.SwapCompanionToMainScreen sets MainScreenCompanion). It is a
          full-bleed overlay over the library so the player looks down at the running game's spotlight and
          achievements while the game itself is on Screen-2. Hidden — and null — otherwise, so it never
          shows during normal browsing or when the game is on the built-in screen.
        -->
        <ContentControl Content="{Binding MainScreenCompanion}"
                        IsVisible="{Binding IsCompanionOnMainScreen}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:SecondScreenViewModel">
                    <views:SecondScreenView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Panel>
</UserControl>
