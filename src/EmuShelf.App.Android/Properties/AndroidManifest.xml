<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode/versionName are intentionally NOT set here: a hardcoded value in the manifest overrides
     the ApplicationVersion/ApplicationDisplayVersion MSBuild properties (and the CI override that derives
     them from git — commit count + tag). Omitting them lets those properties populate the manifest, so a
     new tag alone bumps the shipped app. See package-android in .github/workflows/build.yml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.emushelf.app">
  <!-- INTERNET is harmless and lets the metadata/achievement HttpClients that the shared composition
       root builds exist without a runtime surprise later. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- In-app update: the applier hands a downloaded, checksum-verified EmuShelf APK to the system package
       installer (AndroidUpdateApplier). Sideload self-update needs this permission; the OS still shows the
       user an install confirmation, and the first time also an "allow unknown apps" prompt. See the About →
       Check for updates flow and the package-android release APK in .github/workflows/build.yml. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Keeps the Presentation process alive only while an emulator owns the main screen. Android 13
       may otherwise reclaim the background frontend and tear down Screen-2 mid-session. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- All-files access: the SAF folder picker resolves to a real path only when EmuShelf itself can
       read it, and the shared FolderScanner/disc readers do random access over multi-gigabyte files by
       absolute path. Declaring it is also what makes `appops set … MANAGE_EXTERNAL_STORAGE allow` stick
       on the AVD (see the spike). The full grant UX — directing the user to the all-files Settings
       screen — and the SAF-backed fallback for devices without it are Milestone D
       (docs/android-port-plan.md). READ_EXTERNAL_STORAGE covers the legacy pre-scoped path on API ≤32. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                   android:maxSdkVersion="32" />
  <!-- Package visibility (API 30+): without an explicit <queries> entry, PackageManager cannot see
       another app, so EmuShelf's presence detection would report every emulator "not installed" and a
       launch intent would fail to resolve. Each package here mirrors an AndroidEmulatorLaunchProfiles
       entry (kept in sync by AndroidEmulatorLaunchProfilesTests). Declaring packages individually is
       deliberately narrower than QUERY_ALL_PACKAGES, which is a Play policy-flagged permission. Adding a
       new emulator is therefore a manifest change, not just data — the regression against the desktop
       model the plan calls out (Milestone B). -->
  <queries>
    <!-- The companion screen's all-apps drawer. This narrow launcher-intent query exposes only apps
         with user-launchable activities and avoids the Play-policy-sensitive QUERY_ALL_PACKAGES. -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <package android:name="com.github.stenzek.duckstation" /> <!-- PS1  DuckStation -->
    <package android:name="com.armsx2" />                     <!-- PS2  ARMSX2 -->
    <package android:name="org.dolphinemu.dolphinemu" />      <!-- GC/Wii Dolphin -->
    <package android:name="org.ppsspp.ppsspp" />              <!-- PSP  PPSSPP -->
    <package android:name="org.azahar_emu.azahar" />          <!-- 3DS  Azahar -->
    <package android:name="me.magnum.melondualds" />          <!-- DS   WatermelonDS -->
    <package android:name="com.retroarch.aarch64" />          <!-- multi RetroArch -->
  </queries>
  <application android:label="EmuShelf"
               android:allowBackup="false"
               android:hardwareAccelerated="true">
    <!-- Android 14+ requires every foreground service to declare a type. Keeping a user-visible
         companion display alive is not one of the canned media/location/data types, so it uses the
         platform's specialUse bucket with a narrowly stated subtype. On the Thor (Android 13) this is
         simply ignored; the ordinary FOREGROUND_SERVICE permission remains the active rule. -->
    <service android:name="com.emushelf.app.SecondScreenKeepAliveService"
             android:exported="false"
             android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-visible dual-screen companion surface alive while a game runs" />
    </service>
    <!-- Mints the content:// URI the package installer reads the downloaded update APK from. The installer
         is a separate process, so a file:// URI is rejected since API 24 — only a granted FileProvider URI
         works. Authority mirrors AndroidUpdateApplier.FileProviderAuthority; exported=false + a per-URI read
         grant keeps it reachable only by whoever we hand the intent to. Uses the AndroidX Core FileProvider
         class shipped by Xamarin.AndroidX.Core (referenced by the head). -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="com.emushelf.app.updateprovider"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                 android:resource="@xml/emushelf_update_paths" />
    </provider>
  </application>
</manifest>
