<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The single-view (Android) head. DELIBERATELY NOT in EmuShelf.slnx: .slnx has no Condition
    support and the android workload error fires at restore, so listing this project would fail
    `dotnet build`/`test`/`restore` for the whole solution on the macOS dev loop. Build it from its
    own path instead — see docs/android-port-plan.md (Milestone A1, "Build gating — one option").

    TFM is not a choice: Avalonia.Android 12.1.0 ships exactly one asset, lib/net10.0-android36.0,
    so this pins Android SDK platform 36 and JDK 21 (Development setup table in the plan).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.emushelf.app</ApplicationId>
    <!-- ApplicationVersion is Android's integer versionCode; it must strictly increase for a build to
         install over the previous one (an in-place update also needs the same signing key — the release
         keystore, DECISIONS 2026-08-20). These values are the LOCAL-dev defaults only: the CI release job
         OVERRIDES them from git (versionCode = commit count, versionName = the tag), so a new tag alone
         bumps the shipped app with no edit here. See package-android in .github/workflows/build.yml. -->
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.1</ApplicationDisplayVersion>
    <!-- Reflection {Binding} is used throughout the shared XAML (x:CompileBindings appears zero
         times), so cap the link mode at SdkOnly for Release — raising it further silently blanks
         bindings rather than failing the build (the plan's "Compiled bindings are the trimming trap").
         Debug keeps linking off so fast deployment works without the XA0119 warning. -->
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <!-- Ahead-of-time compile the managed code to native for Release. On the AYN Thor (and weak handheld
         GPUs/CPUs generally) the JIT'd/interpreted couch runs per-row tile realization slowly enough to
         stall the grid scroll AND to hang the "All Games" pack past Android's ANR threshold. Measured on
         the Thor: AOT roughly halves the scroll stalls, flattens the frame-time tail (p90 50ms -> 17ms),
         and removes the All-Games ANR — it is the single biggest couch-performance lever (see
         DECISIONS 2026-08-30). Cost: Release builds need the Android NDK (26.3.11579264, the Microsoft.
         Android.Sdk 36.1.69 default) on the build machine, are much slower, and the APK is larger
         (~123MB vs ~93MB). Non-profiled so the whole app is compiled, not just a startup profile. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Android only. Avalonia.Desktop must NOT reach the head: it has no android asset but
         restores via lib/net10.0 and would silently ship Win32/X11/Native backends into the APK. -->
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <!-- FileProvider for the in-app update installer (AndroidUpdateApplier). Already present transitively
         via Avalonia.Android → AppCompat → Core; referenced explicitly at the resolved version so the
         AndroidX.Core.Content.FileProvider type is a first-class compile dependency, not an incidental one. -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shizuku: the only rootless way to *actually* force-stop a launched emulator on return (the
         deprecated killBackgroundProcesses cannot touch a foreground-service emulator — see
         AndroidEmulatorProcessTerminator / DECISIONS 2026-08-26). Pulled from Maven Central. Bind="false":
         the Java classes are dexed into the APK (so the manifest's ShizukuProvider resolves and the binder
         handshake works) but NO C# binding is generated — AndroidShizuku reaches rikka.shizuku.Shizuku
         entirely through java.lang.reflect, which needs the classes present, not bound. All four modules are
         required (provider → api → aidl + shared); AndroidMavenLibrary does not resolve transitive Maven
         deps, and androidx.annotation is already supplied by Xamarin.AndroidX.Core above. -->
    <AndroidMavenLibrary Include="dev.rikka.shizuku:aidl" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:shared" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:api" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:provider" Version="13.1.5" Bind="false" />
    <!-- The Shizuku POMs declare a compile-time dependency on androidx.annotation (NonNull/Nullable/
         RestrictTo — CLASS-retention annotations, not needed at runtime and never referenced by our
         reflection-only usage). AndroidX.Core already ships it, so mark the Java-dependency verifier's
         requirement satisfied instead of pinning a second AndroidX.Annotation version that could drift. -->
    <AndroidIgnoredJavaDependency Include="androidx.annotation:annotation:1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuShelf.UI\EmuShelf.UI.csproj" />
  </ItemGroup>
</Project>
