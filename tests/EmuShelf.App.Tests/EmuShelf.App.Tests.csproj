<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmuShelf.App\EmuShelf.App.csproj" />
    <!-- The shared UI library (App, view models, controls, rendering). The desktop head above pulls
         it in transitively, but most tests target these types directly, so reference it explicitly. -->
    <ProjectReference Include="..\..\src\EmuShelf.UI\EmuShelf.UI.csproj" />
    <!-- The headless preview tool keeps a hand-copy of MediaShellMap's profiles, because it cannot
         reference the app. This project can see both, so it is the only place the two tables can be
         compared — see MediaShellTests.PreviewShelf_RendersTheSameProfilesTheAppDoes. Referencing
         the tool loads its assembly, never its Main. -->
    <ProjectReference Include="..\..\tools\EmuShelf.Rendering.Preview\EmuShelf.Rendering.Preview.csproj" />
    <ProjectReference Include="..\..\src\EmuShelf.Core\EmuShelf.Core.csproj" />
    <ProjectReference Include="..\..\src\EmuShelf.Infrastructure\EmuShelf.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\EmuShelf.Integrations\EmuShelf.Integrations.csproj" />
  </ItemGroup>

</Project>
